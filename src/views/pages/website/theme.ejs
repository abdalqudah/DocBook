<%
  // Website → Theme & brand: a template (starting layout), a theme (presentation preset) and the brand kit. Changing
  // any of them never touches the content; everything goes to the draft.
  var br = doc.brand || {};
  var imgOf = function (id) { return id && media[id] ? media[id] : null; };
  var allowed = function (k) { return allowedTemplates === '*' || (Array.isArray(allowedTemplates) && allowedTemplates.indexOf(k) !== -1); };
%>
<div class="page-head"><div><div class="breadcrumbs"><a href="/app/website"><%= t('navx.sec_website') %></a></div><h1><%= t('website.theme_title') %></h1><p><%= t('website.theme_lead') %></p></div>
  <div class="page-actions"><a class="btn btn-secondary" href="/app/website/preview" target="_blank" rel="noopener"><%- icon('eye', 'icon-sm') %><%= t('website.preview') %></a><a class="btn btn-primary" href="/app/website/builder"><%- icon('layout-template', 'icon-sm') %><%= t('website.builder_title') %></a></div></div>

<section class="panel">
  <div class="panel-head"><div><h2><%= t('website.themes') %></h2><p class="panel-sub"><%= t('website.themes_sub') %></p></div></div>
  <form class="panel-body" method="post" action="/app/website/theme">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ws-choice-grid">
      <% THEMES.forEach(function (k) { %>
      <label class="ws-choice ws-choice-theme ws-swatch-<%= k %>"><input type="radio" name="theme" value="<%= k %>"<%= doc.theme === k ? ' checked' : '' %>><span class="ws-choice-art" aria-hidden="true"><i></i><i></i><i></i></span><span class="strong"><%= t('website.theme.' + k) %></span><span class="small muted"><%= t('website.theme_desc.' + k) %></span></label>
      <% }) %>
    </div>
    <div class="form-actions mt-4"><button class="btn btn-primary" type="submit"><%= t('website.apply_theme') %></button></div>
  </form>
</section>

<% var darkOn = !(doc.header && doc.header.dark_mode === false); %>
<section class="panel mt-6" id="dark">
  <div class="panel-head"><div><h2><%- icon('moon', 'icon-sm') %> <%= t('website.dark.title') %></h2><p class="panel-sub"><%= t('website.dark.sub') %></p></div>
    <span class="badge badge-dot <%= darkOn ? 'badge-success' : 'badge-neutral' %>"><%= darkOn ? t('website.dark.on') : t('website.dark.off') %></span></div>
  <form class="panel-body row between wrap" method="post" action="/app/website/dark" style="gap:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dark_mode" value="<%= darkOn ? '0' : '1' %>">
    <span class="small muted grow" style="min-width:240px"><%= darkOn ? t('website.dark.on_text') : t('website.dark.off_text') %></span>
    <button class="btn <%= darkOn ? 'btn-secondary' : 'btn-primary' %>" type="submit"><%- icon(darkOn ? 'sun' : 'moon', 'icon-sm') %><%= darkOn ? t('website.dark.turn_off') : t('website.dark.turn_on') %></button>
  </form>
</section>

<section class="panel mt-6">
  <div class="panel-head"><div><h2><%= t('website.brand_kit') %></h2><p class="panel-sub"><%= t('website.brand_kit_sub') %></p></div></div>
  <form class="panel-body stack" method="post" action="/app/website/brand">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-3">
      <% [['logo_media_id', 'logoMediaId', 'logo'], ['logo_dark_media_id', 'logoDarkMediaId', 'logo_dark'], ['favicon_media_id', 'faviconMediaId', 'favicon']].forEach(function (m) { var im = imgOf(br[m[1]]); %>
      <div class="stack-sm"><span class="label"><%= t('website.brand.' + m[2]) %></span>
        <div class="pm-cover ws-pick-preview ws-pick-small<%= m[2] === 'logo_dark' ? ' ws-pick-dark' : '' %>" data-media-preview="<%= m[0] %>"><% if (im) { %><img src="<%= im.url %>" alt=""><% } else { %><span class="pm-empty"><%- icon('image') %></span><% } %></div>
        <input type="hidden" name="<%= m[0] %>" value="<%= br[m[1]] || '' %>">
        <div class="row-sm wrap"><button class="btn btn-secondary btn-sm" type="button" data-media-pick="<%= m[0] %>"><%- icon('image', 'icon-sm') %><%= t('media_lib.choose') %></button><button class="btn btn-ghost btn-sm" type="button" data-media-clear="<%= m[0] %>"<%= im ? '' : ' hidden' %>><%= t('media_lib.remove') %></button></div>
        <span class="help"><%= t('website.brand.' + m[2] + '_help') %></span></div>
      <% }) %>
    </div>
    <div class="grid grid-2">
      <% [['primary', br.primary], ['secondary', br.secondary]].forEach(function (c) { %>
      <fieldset class="ws-color"><legend class="label"><%= t('website.brand.' + c[0]) %></legend>
        <label class="check"><input type="checkbox" name="use_<%= c[0] %>" value="1"<%= c[1] ? ' checked' : '' %>><span><%= t('website.brand.custom_color') %></span></label>
        <input class="input ws-color-input" type="color" name="<%= c[0] %>" value="<%= c[1] || colorDefaults[c[0]] %>" aria-label="<%= t('website.brand.' + c[0]) %>">
        <span class="help"><%= t('website.brand.' + c[0] + '_help') %></span></fieldset>
      <% }) %>
    </div>
    <h3 class="ws-seo-h"><%- icon('type', 'icon-sm') %><%= t('website.typo.title') %></h3>
    <% var fontOpts = function (cur) { %><% FONTS.forEach(function (f) { %><option value="<%= f %>"<%= cur === f ? ' selected' : '' %>><%= t('website.font.' + f) %></option><% }) %><% if (fonts.length) { %><optgroup label="<%= t('website.typo.uploaded') %>"><% var seenFam = {}; fonts.forEach(function (f) { if (seenFam[f.family]) return; seenFam[f.family] = 1; %><option value="f<%= f.id %>"<%= cur === 'f' + f.id ? ' selected' : '' %>><%= f.family %></option><% }) %></optgroup><% } %><% }; %>
    <input type="hidden" name="font" value="<%= br.font || 'system' %>">
    <div class="grid grid-2">
      <div class="field"><label class="label" for="ws-bfont"><%= t('website.typo.body_font') %></label><select class="select" id="ws-bfont" name="body_font"><% fontOpts(br.bodyFont || br.font) %></select><span class="help"><%= t('website.brand.font_help') %></span></div>
      <div class="field"><label class="label" for="ws-hfont"><%= t('website.typo.heading_font') %></label><select class="select" id="ws-hfont" name="heading_font"><% fontOpts(br.headingFont || br.bodyFont || br.font) %></select></div>
      <div class="field"><label class="label" for="ws-size"><%= t('website.typo.size') %></label><select class="select" id="ws-size" name="size"><% ['s', 'm', 'l'].forEach(function (z) { %><option value="<%= z %>"<%= (br.size || 'm') === z ? ' selected' : '' %>><%= t('website.typo.size_' + z) %></option><% }) %></select></div>
      <div class="field"><label class="label" for="ws-hw"><%= t('website.typo.heading_weight') %></label><select class="select" id="ws-hw" name="heading_weight"><% ['500', '600', '700', '800'].forEach(function (w) { %><option value="<%= w %>"<%= String(br.headingWeight || '700') === w ? ' selected' : '' %>><%= t('website.typo.w' + w) %></option><% }) %></select></div>
    </div>
    <div class="grid grid-3">
      <% ['text', 'heading', 'link'].forEach(function (k) { %>
      <fieldset class="ws-color"><legend class="label"><%= t('website.typo.color_' + k) %></legend>
        <label class="check"><input type="checkbox" name="use_<%= k %>" value="1"<%= br[k] ? ' checked' : '' %>><span><%= t('website.brand.custom_color') %></span></label>
        <input class="input ws-color-input" type="color" name="<%= k %>" value="<%= br[k] || (k === 'link' ? colorDefaults.primary : colorDefaults.text) %>" aria-label="<%= t('website.typo.color_' + k) %>">
        <% if (contrast[k] !== null && contrast[k] < 4.5) { %><span class="help warn-text"><%- icon('triangle-alert', 'icon-sm') %> <%= t('website.typo.low_contrast', { ratio: contrast[k] }) %></span><% } %>
      </fieldset>
      <% }) %>
    </div>
    <p class="help"><%= t('website.typo.colors_help') %></p>
    <div class="grid grid-2">
      <div class="field"><label class="label" for="ws-radius"><%= t('website.brand.radius') %></label><select class="select" id="ws-radius" name="radius"><% RADII.forEach(function (r) { %><option value="<%= r %>"<%= br.radius === r ? ' selected' : '' %>><%= t('website.radius.' + r) %></option><% }) %></select></div>
    </div>
    <fieldset class="ws-color"><legend class="label"><%= t('website.brand.motion') %></legend>
      <div class="segmented" role="radiogroup"><% MOTION.forEach(function (m) { %><label><input type="radio" name="motion" value="<%= m %>"<%= (br.motion || 'none') === m ? ' checked' : '' %>><span><%= t('website.motion.' + m) %></span></label><% }) %></div>
      <span class="help"><%= t('website.brand.motion_help') %></span>
    </fieldset>
    <div class="form-actions"><button class="btn btn-primary" type="submit"><%= t('website.save_brand') %></button></div>
  </form>
</section>

<section class="panel mt-6" id="fonts">
  <div class="panel-head"><div><h2><%= t('website.typo.fonts_title') %></h2><p class="panel-sub"><%= t('website.typo.fonts_sub') %></p></div></div>
  <div class="panel-body stack">
    <% if (fonts.length) { %>
    <ul class="action-list ws-font-list">
      <% fonts.forEach(function (f) { %><li><div><span class="action-icon"><%- icon('type', 'icon-sm') %></span><div class="grow"><div class="strong"><%= f.family %></div><div class="small muted"><%= t('website.typo.w' + (f.weight >= 800 ? '800' : f.weight >= 700 ? '700' : f.weight >= 600 ? '600' : '500')) %> · <%= f.style === 'italic' ? t('website.typo.italic') : t('website.typo.normal') %> · <span dir="ltr"><%= f.format.toUpperCase() %> · <%= Math.round(f.size / 1024) %> KB</span></div></div>
        <form method="post" action="/app/website/fonts/<%= f.id %>/delete" data-confirm="<%= t('website.typo.remove_confirm', { name: f.family }) %>" data-confirm-tone="danger"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('media_lib.remove') %></button></form></div></li><% }) %>
    </ul>
    <% } %>
    <% if (fonts.length < MAX_FONTS) { %>
    <form class="stack" method="post" action="/app/website/fonts" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid-2">
        <div class="field"><label class="label" for="font-file"><%= t('website.typo.file') %></label><input class="input" type="file" id="font-file" name="file" accept=".woff2,.woff,.ttf,.otf" required><span class="help"><%= t('website.typo.file_help') %></span></div>
        <div class="field"><label class="label" for="font-family"><%= t('website.typo.family') %></label><input class="input" id="font-family" name="family" maxlength="60" placeholder="Tajawal"><span class="help"><%= t('website.typo.family_help') %></span></div>
        <div class="field"><label class="label" for="font-weight"><%= t('website.typo.weight') %></label><select class="select" id="font-weight" name="weight"><% WEIGHTS.forEach(function (w) { %><option value="<%= w %>"<%= w === 400 ? ' selected' : '' %>><%= w %></option><% }) %></select></div>
        <div class="field"><label class="label" for="font-style"><%= t('website.typo.style') %></label><select class="select" id="font-style" name="style"><option value="normal"><%= t('website.typo.normal') %></option><option value="italic"><%= t('website.typo.italic') %></option></select></div>
      </div>
      <div class="alert alert-info small"><%- icon('info', 'icon-sm') %><div class="grow"><%= t('website.typo.license') %></div></div>
      <div class="form-actions"><button class="btn btn-secondary" type="submit"><%- icon('upload', 'icon-sm') %><%= t('website.typo.upload') %></button></div>
    </form>
    <% } %>
  </div>
</section>

<section class="panel mt-6">
  <div class="panel-head"><div><h2><%= t('website.templates') %></h2><p class="panel-sub"><%= t('website.templates_sub') %></p></div></div>
  <form class="panel-body" method="post" action="/app/website/builder/template" data-confirm="<%= t('website.template_confirm') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ws-choice-grid">
      <% TEMPLATES.forEach(function (k) { var ok = allowed(k); %>
      <label class="ws-choice<%= ok ? '' : ' is-locked' %>"><input type="radio" name="template" value="<%= k %>"<%= doc.template === k ? ' checked' : '' %><%= ok ? '' : ' disabled' %>><span class="strong"><%= t('website.template.' + k) %></span><% if (!ok) { %><span class="badge badge-neutral"><%- icon('lock', 'icon-sm') %><%= t('website.not_in_package') %></span><% } %></label>
      <% }) %>
    </div>
    <label class="check mt-4"><input type="checkbox" name="add_missing" value="1"><span><%= t('website.template_add_missing') %></span></label>
    <div class="form-actions mt-4"><button class="btn btn-secondary" type="submit"><%= t('website.apply_template') %></button></div>
  </form>
</section>
<%- include('../integrations/_media-picker') %>
