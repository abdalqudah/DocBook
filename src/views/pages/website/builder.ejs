<%
  // Website → Builder: a full-screen editor (layout "builder", no app menu).
  //   start pane: the page's sections (order, show/hide) and the gallery of sections to add;
  //   middle: the live preview of the draft (click a section to edit it; desktop / tablet / phone; ar / en);
  //   end pane: the selected section — Content (words, pictures, items) and Design (layout, alignment, background,
  //   spacing, width, edge shapes, picture options). Changes save to the draft as you type; "Publish" puts it live.
  var L2 = function (ar, en) { return locale === 'en' && en ? en : ar; };
  var secName = function (type) { return t('website.sec.' + type); };
  var used = {}; list.forEach(function (x) { used[x.type] = true; });
  var sel = selected; var def = sel ? TYPES[sel.type] : null;
  var fieldLabel = function (k) { return t('website.field.' + k); };
  var optLabel = function (o) { return t('website.opt.' + o); };
  var itemLabel = function (k) { var key = 'website.item_field.' + k; var s = t(key); return s === key ? fieldLabel(k) : s; };
  var val = function (lang, k) { return sel && sel.content[lang] && sel.content[lang][k] !== undefined ? sel.content[lang][k] : ''; };
  var imgOf = function (id) { return id && media[id] ? media[id] : null; };
  // A link to one of the site's own pages (action "page"): a list of the pages.
  var pageSelect = function (nm, cur, fid) { var out = '<div class="field"><label class="label"' + (fid ? ' for="' + fid + '"' : '') + '>' + escapeHtml(fieldLabel('page')) + '</label><select class="select"' + (fid ? ' id="' + fid + '"' : '') + ' name="' + nm + '"><option value="">—</option>';
    pages.forEach(function (p) { var title = p.key === 'home' ? t('website.page_home') : ((p.title && (p.title[locale] || p.title.ar || p.title.en)) || p.slug); out += '<option value="' + p.key + '"' + (cur === p.key ? ' selected' : '') + '>' + escapeHtml(title) + '</option>'; });
    return out + '</select><span class="help">' + escapeHtml(t('website.b.page_link_help')) + '</span></div>'; };
  var clinicName = locale === 'en' && business.name_en ? business.name_en : business.name;
  var startIcon = dir === 'rtl' ? 'align-right' : 'align-left'; var endIcon = dir === 'rtl' ? 'align-left' : 'align-right';
  var alignIcon = { auto: 'sparkles', start: startIcon, center: 'align-center', end: endIcon };
  var blocks = TYPE_KEYS.filter(function (k) { return TYPES[k].group === 'blocks'; });
  var clinicTypes = TYPE_KEYS.filter(function (k) { return TYPES[k].group !== 'blocks'; });
  var sty = sel ? (sel.settings.style || {}) : {};
  var hint = function (k) { var key = 'website.hint.' + sel.type + '_' + k; var s = t(key); return s === key ? '' : s; };
  var pageTitle = function (p) { return p.key === 'home' ? t('website.page_home') : (L2(p.title.ar, p.title.en) || p.title.ar || p.title.en || p.slug); };
  var pq = page.key === 'home' ? '' : 'page=' + page.key;
%>
<div class="wsb<%= sel ? ' has-selection' : '' %>" data-ws-builder data-page="<%= page.key %>" data-pane="<%= sel || panel ? 'settings' : 'preview' %>" data-t-saving="<%= t('website.b.saving') %>" data-t-saved="<%= t('website.b.saved') %>" data-t-failed="<%= t('website.b.save_failed') %>">
  <header class="wsb-top">
    <div class="wsb-top-start">
      <a class="btn btn-ghost btn-sm" href="/app/website"><%- icon('arrow-right', 'icon-sm' + (dir === 'rtl' ? '' : ' flip-rtl')) %><span class="hide-sm"><%= t('website.b.back') %></span></a>
      <div class="wsb-title"><strong class="truncate"><%= clinicName %></strong><span class="small muted truncate"><%= t('website.builder_title') %> · <%= row.draft_updated_at ? t('website.draft_saved_at', { date: fmt.date(row.draft_updated_at, { dateStyle: 'medium', timeStyle: 'short' }) }) : t('website.draft_new') %></span></div>
      <span class="wsb-save small" data-ws-save-state aria-live="polite"></span>
    </div>
    <div class="wsb-top-mid">
      <button class="btn btn-ghost btn-icon btn-sm hide-md" type="button" data-ws-toggle="sections" title="<%= t('website.b.toggle_sections') %>" aria-label="<%= t('website.b.toggle_sections') %>"><%- icon('panel-left', 'icon-sm') %></button>
      <div class="segmented" role="group" aria-label="<%= t('website.device') %>">
        <button type="button" class="active" data-ws-device="desktop" title="<%= t('website.desktop') %>"><%- icon('monitor', 'icon-sm') %><span class="sr-only"><%= t('website.desktop') %></span></button>
        <button type="button" data-ws-device="tablet" title="<%= t('website.b.tablet') %>"><%- icon('tablet', 'icon-sm') %><span class="sr-only"><%= t('website.b.tablet') %></span></button>
        <button type="button" data-ws-device="mobile" title="<%= t('website.mobile') %>"><%- icon('smartphone', 'icon-sm') %><span class="sr-only"><%= t('website.mobile') %></span></button>
      </div>
      <div class="segmented" role="group" aria-label="<%= t('common.language') %>"><button type="button" class="<%= locale === 'ar' ? 'active' : '' %>" data-ws-lang="ar">ع</button><button type="button" class="<%= locale === 'en' ? 'active' : '' %>" data-ws-lang="en">EN</button></div>
      <button class="btn btn-ghost btn-icon btn-sm hide-md" type="button" data-ws-toggle="settings" title="<%= t('website.b.toggle_settings') %>" aria-label="<%= t('website.b.toggle_settings') %>"><%- icon('panel-right', 'icon-sm') %></button>
    </div>
    <div class="wsb-top-end">
      <a class="btn btn-ghost btn-sm" href="/app/website/theme" title="<%= t('website.theme_title') %>"><%- icon('palette', 'icon-sm') %><span class="hide-sm"><%= t('website.theme_title') %></span></a>
      <a class="btn btn-ghost btn-sm hide-sm" href="/app/website/preview" target="_blank" rel="noopener"><%- icon('eye', 'icon-sm') %><%= t('website.preview_full') %></a>
      <% if (st.draftChanged) { %><form method="post" action="/app/website/builder/discard" data-confirm="<%= t('website.discard_confirm') %>" data-confirm-tone="danger"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit" title="<%= t('website.discard') %>"><%- icon('refresh-cw', 'icon-sm') %><span class="hide-sm"><%= t('website.discard') %></span></button></form><% } %>
      <% if (can('website.publish')) { %><form method="post" action="/app/website/publish" data-confirm="<%= st.status === 'live' ? t('website.publish_confirm_update') : t('website.publish_confirm_first') %>" data-confirm-yes="<%= t('website.publish') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-sm" type="submit"><%- icon('rocket', 'icon-sm') %><%= t('website.publish') %></button></form><% } %>
    </div>
  </header>

  <nav class="wsb-panes segmented" aria-label="<%= t('website.builder_title') %>">
    <button type="button" data-ws-pane="sections"><%- icon('layers', 'icon-sm') %><%= t('website.b.pane_sections') %></button>
    <button type="button" data-ws-pane="preview"><%- icon('eye', 'icon-sm') %><%= t('website.b.pane_preview') %></button>
    <button type="button" data-ws-pane="settings"<%= sel || panel ? '' : ' disabled' %>><%- icon('sliders-horizontal', 'icon-sm') %><%= t('website.b.pane_settings') %></button>
  </nav>

  <div class="wsb-main">
    <!-- start pane: sections + add -->
    <aside class="wsb-side wsb-start" data-pane-id="sections" aria-label="<%= t('website.sections') %>">
      <form class="wsb-page-pick" method="get" action="/app/website/builder" data-ws-page-pick>
        <label class="sr-only" for="wsb-page"><%= t('website.b.page') %></label>
        <%- icon('file-text', 'icon-sm muted') %>
        <select class="select" id="wsb-page" name="page"><% pages.forEach(function (p) { %><option value="<%= p.key %>"<%= p.key === page.key ? ' selected' : '' %>><%= pageTitle(p) %></option><% }) %></select>
        <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.open') %></button></noscript>
      </form>
      <div class="wsb-tabs" role="tablist">
        <button type="button" role="tab" class="active" aria-selected="true" data-ws-tab="list"><%= t('website.b.tab_sections') %> <span class="badge"><%= fmt.number(list.length) %></span></button>
        <button type="button" role="tab" aria-selected="false" data-ws-tab="add"><%- icon('plus', 'icon-sm') %><%= t('website.b.tab_add') %></button>
        <button type="button" role="tab" aria-selected="false" data-ws-tab="site"><%- icon('layers', 'icon-sm') %><%= t('website.b.tab_site') %></button>
      </div>
      <div class="wsb-tab-body" data-ws-tab-body="list">
        <ol class="ws-sec-list" data-ws-order>
          <% list.forEach(function (x, i) { %>
          <li class="ws-sec<%= sel && sel.id === x.id ? ' is-selected' : '' %><%= x.visible ? '' : ' is-hidden' %>" data-id="<%= x.id %>" draggable="true">
            <span class="ws-grip" aria-hidden="true"><%- icon('grip-vertical', 'icon-sm') %></span>
            <a class="ws-sec-name" href="/app/website/builder?s=<%= x.id %>"<% if (sel && sel.id === x.id) { %> aria-current="true"<% } %>><%- icon(TYPES[x.type].icon, 'icon-sm') %><span class="truncate"><%= secName(x.type) %></span><% if (!x.visible) { %><span class="badge badge-neutral"><%= t('website.hidden') %></span><% } %></a>
            <span class="ws-sec-tools">
              <form method="post" action="/app/website/builder/sections/<%= x.id %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up"><button class="btn btn-ghost btn-icon btn-sm" type="submit"<%= i === 0 ? ' disabled' : '' %> aria-label="<%= t('website.move_up') %>" title="<%= t('website.move_up') %>"><%- icon('arrow-up', 'icon-sm') %></button></form>
              <form method="post" action="/app/website/builder/sections/<%= x.id %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down"><button class="btn btn-ghost btn-icon btn-sm" type="submit"<%= i === list.length - 1 ? ' disabled' : '' %> aria-label="<%= t('website.move_down') %>" title="<%= t('website.move_down') %>"><%- icon('arrow-down', 'icon-sm') %></button></form>
              <form method="post" action="/app/website/builder/sections/<%= x.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-icon btn-sm" type="submit" aria-label="<%= x.visible ? t('website.hide') : t('website.show') %>" title="<%= x.visible ? t('website.hide') : t('website.show') %>"><%- icon(x.visible ? 'eye' : 'eye-off', 'icon-sm') %></button></form>
            </span>
          </li>
          <% }) %>
        </ol>
        <p class="small muted wsb-hint"><%= t('website.b.pick_hint') %></p>
      </div>
      <div class="wsb-tab-body" data-ws-tab-body="add" hidden>
        <% [['group_blocks', blocks], ['group_clinic', clinicTypes]].forEach(function (g) { %>
        <h3 class="wsb-group"><%= t('website.b.' + g[0]) %></h3>
        <div class="wsb-add-grid">
          <% g[1].forEach(function (k) { var taken = TYPES[k].single && used[k]; var there = taken ? list.find(function (x) { return x.type === k; }) : null; %>
          <% if (there) { %>
          <a class="wsb-add-tile is-there" href="/app/website/builder?s=<%= there.id %>"><span class="wsb-add-icon"><%- icon(TYPES[k].icon) %></span><span class="wsb-add-text"><strong><%= secName(k) %></strong><span class="small muted"><%= t('website.b.on_page_open') %></span></span><%- icon(dir === 'rtl' ? 'chevron-left' : 'chevron-right', 'icon-sm muted') %></a>
          <% } else { %>
          <form method="post" action="/app/website/builder/sections"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="type" value="<%= k %>"><input type="hidden" name="page" value="<%= page.key %>"><% if (sel) { %><input type="hidden" name="after" value="<%= sel.id %>"><% } %>
            <button class="wsb-add-tile" type="submit"><span class="wsb-add-icon"><%- icon(TYPES[k].icon) %></span><span class="wsb-add-text"><strong><%= secName(k) %></strong><span class="small muted"><%= t('website.sec_desc.' + k) %></span></span><%- icon('plus', 'icon-sm muted') %></button>
          </form>
          <% } %>
          <% }) %>
        </div>
        <% }) %>
      </div>
      <div class="wsb-tab-body" data-ws-tab-body="site" hidden>
        <h3 class="wsb-group"><%= t('website.b.pages') %></h3>
        <ul class="wsb-pages">
          <% pages.forEach(function (p, i) { %>
          <li class="<%= p.key === page.key ? 'is-current' : '' %>">
            <a class="wsb-page-name" href="/app/website/builder?page=<%= p.key %><%= p.key === 'home' ? '' : '&panel=page' %>"><%- icon(p.key === 'home' ? 'house' : 'file-text', 'icon-sm') %><span class="truncate"><%= pageTitle(p) %></span><% if (p.key !== 'home') { %><span class="small muted" dir="ltr">/p/<%= p.slug %></span><% } %></a>
            <% if (p.key !== 'home') { %><span class="ws-sec-tools">
              <form method="post" action="/app/website/builder/pages/<%= p.key %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up"><button class="btn btn-ghost btn-icon btn-sm" type="submit"<%= i <= 1 ? ' disabled' : '' %> aria-label="<%= t('website.move_up') %>"><%- icon('arrow-up', 'icon-sm') %></button></form>
              <form method="post" action="/app/website/builder/pages/<%= p.key %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down"><button class="btn btn-ghost btn-icon btn-sm" type="submit"<%= i === pages.length - 1 ? ' disabled' : '' %> aria-label="<%= t('website.move_down') %>"><%- icon('arrow-down', 'icon-sm') %></button></form>
            </span><% } %>
          </li>
          <% }) %>
        </ul>
        <% if (pages.length < MAX_PAGES) { %>
        <form class="wsb-add-page stack-sm" method="post" action="/app/website/builder/pages">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="label"><%= t('website.b.new_page') %></span>
          <div class="ws-lang-row"><span class="ws-lang-tag">ع</span><input class="input" name="title[ar]" maxlength="60" dir="rtl" placeholder="<%= t('website.b.page_title_ph') %>"></div>
          <div class="ws-lang-row"><span class="ws-lang-tag">EN</span><input class="input" name="title[en]" maxlength="60" dir="ltr" placeholder="About us"></div>
          <button class="btn btn-secondary btn-sm" type="submit"><%- icon('plus', 'icon-sm') %><%= t('website.b.add_page') %></button>
        </form>
        <% } %>
        <h3 class="wsb-group"><%= t('website.b.chrome') %></h3>
        <a class="wsb-add-tile" href="/app/website/builder?panel=header<%= pq ? '&' + pq : '' %>"><span class="wsb-add-icon"><%- icon('panel-top') %></span><span class="wsb-add-text"><strong><%= t('website.b.header') %></strong><span class="small muted"><%= t('website.b.header_desc') %></span></span></a>
        <a class="wsb-add-tile" href="/app/website/builder?panel=footer<%= pq ? '&' + pq : '' %>"><span class="wsb-add-icon"><%- icon('panel-bottom') %></span><span class="wsb-add-text"><strong><%= t('website.b.footer') %></strong><span class="small muted"><%= t('website.b.footer_desc') %></span></span></a>
      </div>
    </aside>

    <!-- middle: preview -->
    <section class="wsb-stage" data-pane-id="preview" aria-label="<%= t('website.preview') %>">
      <div class="wsb-frame-wrap" data-ws-frame-wrap data-device="desktop"><iframe class="wsb-frame" data-ws-frame src="/app/website/preview?lang=<%= locale %><%= pq ? '&' + pq : '' %><%= sel ? '#s-' + sel.id : '' %>" title="<%= t('website.preview') %>"></iframe></div>
    </section>

    <!-- end pane: the selected section -->
    <aside class="wsb-side wsb-end" data-pane-id="settings" aria-label="<%= t('website.section_settings') %>">
    <% if (!sel && panel) { %>
      <%- include('_site-panels', { pageTitle: pageTitle }) %>
    <% } else if (!sel) { %>
      <div class="wsb-empty"><%- icon('mouse-pointer-click') %><p><%= t('website.b.pick_hint') %></p></div>
    <% } else { %>
      <div class="wsb-sel-head"><span class="wsb-add-icon"><%- icon(def.icon) %></span><div class="grow"><strong><%= secName(sel.type) %></strong><div class="small muted"><%= t('website.sec_desc.' + sel.type) %></div></div></div>
      <div class="wsb-tabs" role="tablist">
        <button type="button" role="tab" class="active" aria-selected="true" data-ws-tab="content"><%= t('website.b.tab_content') %></button>
        <button type="button" role="tab" aria-selected="false" data-ws-tab="design"><%= t('website.b.tab_design') %></button>
      </div>
      <form class="wsb-form" method="post" action="/app/website/builder/sections/<%= sel.id %>" data-ws-section-form novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="wsb-tab-body stack" data-ws-tab-body="content">
          <% if (def.variants.length > 1) { %>
          <fieldset class="wsb-field"><legend class="label"><%= t('website.layout') %></legend>
            <div class="wsb-choices"><% def.variants.forEach(function (v) { %><label class="wsb-choice"><input type="radio" name="variant" value="<%= v %>"<%= sel.variant === v ? ' checked' : '' %>><span><%= t('website.variant.' + v) %></span></label><% }) %></div>
          </fieldset>
          <% } else { %><input type="hidden" name="variant" value="<%= sel.variant %>"><% } %>

          <% def.text.forEach(function (f) { %>
          <fieldset class="ws-i18n"><legend class="label"><%= fieldLabel(f.key) %></legend>
            <% ['ar', 'en'].forEach(function (lang) { var id = 'f-' + f.key + '-' + lang; %>
            <div class="ws-lang-row"><label class="ws-lang-tag" for="<%= id %>"><%= lang === 'ar' ? 'ع' : 'EN' %></label>
              <% if (f.kind === 'textarea') { %><textarea class="textarea" id="<%= id %>" name="content[<%= lang %>][<%= f.key %>]" rows="3" maxlength="<%= f.max %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>" placeholder="<%= hint(f.key) %>"><%= val(lang, f.key) %></textarea>
              <% } else { %><input class="input" id="<%= id %>" name="content[<%= lang %>][<%= f.key %>]" value="<%= val(lang, f.key) %>" maxlength="<%= f.max %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>"><% } %>
            </div>
            <% }) %>
          </fieldset>
          <% }) %>

          <% def.settings.filter(function (f) { return f.group !== 'image' && f.group !== 'carousel'; }).forEach(function (f) { var v = sel.settings[f.key]; var fid = 's-' + f.key; %>
            <% if (f.only) { %><div class="stack-sm" data-ws-only="<%= f.only %>"<%= sel.variant === f.only ? '' : ' hidden' %>><% } %>
            <% if (f.kind === 'bool') { %><input type="hidden" name="settings[<%= f.key %>]" value="0"><label class="check"><input type="checkbox" name="settings[<%= f.key %>]" value="1"<%= v ? ' checked' : '' %>><span><%= fieldLabel(f.key) %></span></label>
            <% } else if (f.kind === 'select' && f.options.length <= 4) { %><fieldset class="wsb-field"><legend class="label"><%= fieldLabel(f.key) %></legend><div class="wsb-choices"><% f.options.forEach(function (o) { %><label class="wsb-choice"><input type="radio" name="settings[<%= f.key %>]" value="<%= o %>"<%= v === o ? ' checked' : '' %>><span><%= optLabel(o) %></span></label><% }) %></div></fieldset>
            <% } else if (f.kind === 'select' && f.key === 'shape') { %><fieldset class="wsb-field"><legend class="label"><%= fieldLabel(f.key) %></legend><div class="wsb-shapes"><% f.options.forEach(function (o) { %><label class="wsb-shape-tile" title="<%= optLabel(o) %>"><input type="radio" name="settings[<%= f.key %>]" value="<%= o %>"<%= v === o ? ' checked' : '' %>><span class="wsb-shape-pic"><% if (['line', 'dots', 'space'].indexOf(o) === -1) { %><%- include('../portal/sections/_shape', { shape: o, edge: 'tile' }) %><% } else { %><%- icon(o === 'line' ? 'minus' : o === 'dots' ? 'ellipsis' : 'move-vertical', 'icon-sm') %><% } %></span><span class="small"><%= optLabel(o) %></span></label><% }) %></div></fieldset>
            <% } else if (f.kind === 'select') { %><div class="field"><label class="label" for="<%= fid %>"><%= fieldLabel(f.key) %></label><select class="select" id="<%= fid %>" name="settings[<%= f.key %>]"><% f.options.forEach(function (o) { %><option value="<%= o %>"<%= v === o ? ' selected' : '' %>><%= optLabel(o) %></option><% }) %></select></div>
            <% } else if (f.kind === 'number') { %><div class="field"><label class="label" for="<%= fid %>"><%= fieldLabel(f.key) %></label><input class="input" type="number" id="<%= fid %>" name="settings[<%= f.key %>]" value="<%= v %>" min="<%= f.min %>" max="<%= f.max %>" dir="ltr"></div>
            <% } else if (f.kind === 'url') { %><div class="field"><label class="label" for="<%= fid %>"><%= fieldLabel(f.key) %></label><input class="input" type="url" id="<%= fid %>" name="settings[<%= f.key %>]" value="<%= v || '' %>" maxlength="<%= f.max || 300 %>" dir="ltr" placeholder="https://www.youtube.com/watch?v=…"><span class="help"><%= t('website.b.url_help') %></span></div>
            <% } else if (f.kind === 'page') { %><%- pageSelect('settings[' + f.key + ']', v, fid) %>
            <% } else if (f.kind === 'date') { %><div class="field"><label class="label" for="<%= fid %>"><%= fieldLabel(f.key) %></label><input class="input" type="date" id="<%= fid %>" name="settings[<%= f.key %>]" value="<%= v || '' %>"></div>
            <% } else if (f.kind === 'media') { var im = imgOf(v); %>
              <div class="stack-sm"><span class="label"><%= fieldLabel(f.key) %></span>
                <div class="pm-cover ws-pick-preview" data-media-preview="settings[<%= f.key %>]"><% if (im) { %><img src="<%= im.url %>" alt=""><% } else { %><span class="pm-empty"><%- icon('image') %></span><% } %></div>
                <input type="hidden" name="settings[<%= f.key %>]" value="<%= v || '' %>">
                <div class="row-sm wrap"><button class="btn btn-secondary btn-sm" type="button" data-media-pick="settings[<%= f.key %>]"><%- icon('image', 'icon-sm') %><%= t('media_lib.choose') %></button><button class="btn btn-ghost btn-sm" type="button" data-media-clear="settings[<%= f.key %>]"<%= im ? '' : ' hidden' %>><%= t('media_lib.remove') %></button></div></div>
            <% } else if (f.kind === 'media_list') { %>
              <div class="stack-sm"><span class="label"><%= fieldLabel(f.key) %></span>
                <ul class="pm-gallery" data-media-list="settings[<%= f.key %>]"><% (v || []).forEach(function (id) { var im = imgOf(id); if (!im) return; %><li class="pm-item"><img src="<%= im.url %>" alt=""><input type="hidden" name="settings[<%= f.key %>]" value="<%= id %>"><button class="btn btn-secondary btn-sm btn-icon pm-remove" type="button" data-media-remove aria-label="<%= t('media_lib.remove') %>"><%- icon('x', 'icon-sm') %></button></li><% }) %></ul>
                <input type="hidden" name="settings[<%= f.key %>]" value="">
                <div><button class="btn btn-secondary btn-sm" type="button" data-media-pick="settings[<%= f.key %>]" data-media-multiple data-media-max="<%= f.max || 12 %>"><%- icon('images', 'icon-sm') %><%= t('media_lib.choose') %></button></div></div>
            <% } else if (f.kind === 'doctors') { %>
              <fieldset class="ws-doctors-pick"><legend class="label"><%= fieldLabel(f.key) %></legend><input type="hidden" name="settings[<%= f.key %>]" value="">
                <% doctors.forEach(function (d) { %><label class="check"><input type="checkbox" name="settings[<%= f.key %>]" value="<%= d.id %>"<%= (v || []).indexOf(d.id) !== -1 ? ' checked' : '' %>><span><%= L2(d.full_name, d.full_name_en) %></span></label><% }) %>
                <span class="help"><%= t('website.doctors_pick_help') %></span></fieldset>
            <% } %>
            <% if (f.only) { %></div><% } %>
          <% }) %>

          <% if (def.list) {
               var items = { ar: sel.content.ar[def.list.key] || [], en: sel.content.en[def.list.key] || [] };
               var extras = sel.settings[def.list.key] || [];
               var count = Math.max(items.ar.length, items.en.length, extras.length);
               // One list item's fields; i is a number or the "__i__" placeholder of the "add" template.
               var itemHtml = function (i, n) { %>
            <details class="wsb-item" data-ws-item open>
              <summary><span class="strong small"><%= t('website.item_n', { n: n }) %></span><button class="btn btn-ghost btn-icon btn-sm" type="button" data-ws-item-remove aria-label="<%= t('website.b.remove_item') %>" title="<%= t('website.b.remove_item') %>"><%- icon('trash-2', 'icon-sm') %></button></summary>
              <div class="stack-sm">
              <% def.list.fields.forEach(function (f) { %>
                <% if (f.i18n === false) { var cur = (extras[i] || {})[f.key]; var nm = 'settings[' + def.list.key + '][' + i + '][' + f.key + ']'; %>
                  <% if (f.kind === 'icon') { var curIc = cur || (f.none ? 'none' : ICONS[0]);
                       // Open on the library holding the chosen icon, else the clinic's specialty.
                       var openLib = curIc !== 'none' && ICON_LIBS[iconLibDefault].indexOf(curIc) === -1 ? (ICON_LIB_KEYS.find(function (k) { return ICON_LIBS[k].indexOf(curIc) !== -1; }) || iconLibDefault) : iconLibDefault; %>
                  <div class="field" data-ws-iconlibs><div class="row between wrap"><span class="label"><%= fieldLabel('icon') %></span>
                    <select class="select select-sm wsb-iconlib-select" data-ws-iconlib-select aria-label="<%= t('website.b.icon_library') %>"><% [iconLibDefault].concat(ICON_LIB_KEYS.filter(function (k) { return k !== iconLibDefault; })).forEach(function (k) { %><option value="<%= k %>"<%= k === openLib ? ' selected' : '' %>><%= t('website.iconlib.' + k) %><%= k === iconLibDefault && k !== 'general' ? ' ★' : '' %></option><% }) %></select></div>
                    <% if (f.none) { %><div class="wsb-icons"><label class="wsb-icon-pick" title="<%= optLabel('none') %>"><input type="radio" name="<%= nm %>" value="none"<%= curIc === 'none' ? ' checked' : '' %>><span><%- icon('x', 'icon-sm') %></span></label></div><% } %>
                    <% ICON_LIB_KEYS.forEach(function (k) { %><div class="wsb-icons" data-ws-iconlib="<%= k %>"<%= k === openLib ? '' : ' hidden' %>><% ICON_LIBS[k].forEach(function (ic) { %><label class="wsb-icon-pick" title="<%= ic %>"><input type="radio" name="<%= nm %>" value="<%= ic %>"<%= curIc === ic && k === openLib ? ' checked' : '' %>><span><%- icon(ic, 'icon-sm') %></span></label><% }) %></div><% }) %>
                  </div>
                  <% } else if (f.kind === 'media') { var im = imgOf(cur); %><div class="stack-sm"><span class="label"><%= itemLabel(f.key) %></span><div class="pm-cover ws-pick-preview is-small" data-media-preview="<%= nm %>"><% if (im) { %><img src="<%= im.url %>" alt=""><% } else { %><span class="pm-empty"><%- icon('image') %></span><% } %></div><input type="hidden" name="<%= nm %>" value="<%= cur || '' %>"><div class="row-sm wrap"><button class="btn btn-secondary btn-sm" type="button" data-media-pick="<%= nm %>"><%- icon('image', 'icon-sm') %><%= t('media_lib.choose') %></button><button class="btn btn-ghost btn-sm" type="button" data-media-clear="<%= nm %>"<%= im ? '' : ' hidden' %>><%= t('media_lib.remove') %></button></div></div>
                  <% } else if (f.kind === 'page') { %><%- pageSelect(nm, cur, null) %>
                  <% } else if (f.kind === 'select') { %><div class="field"><label class="label"><%= fieldLabel(f.key) %></label><select class="select" name="<%= nm %>"><% f.options.forEach(function (o) { %><option value="<%= o %>"<%= (cur || f.options[0]) === o ? ' selected' : '' %>><%= optLabel(o) %></option><% }) %></select></div>
                  <% } else { %><div class="field"><label class="label"><%= itemLabel(f.key) %></label><input class="input" name="<%= nm %>" value="<%= cur || '' %>" maxlength="<%= f.max || 80 %>" dir="auto"></div><% } %>
                <% } else { ['ar', 'en'].forEach(function (lang) { var cv = (items[lang][i] || {})[f.key] || ''; var nm = 'content[' + lang + '][' + def.list.key + '][' + i + '][' + f.key + ']'; %>
                  <div class="ws-lang-row"><span class="ws-lang-tag"><%= lang === 'ar' ? 'ع' : 'EN' %></span><% if (f.kind === 'textarea') { %><textarea class="textarea" rows="2" name="<%= nm %>" maxlength="<%= f.max %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>" aria-label="<%= itemLabel(f.key) %>" placeholder="<%= itemLabel(f.key) %>"><%= cv %></textarea><% } else { %><input class="input" name="<%= nm %>" value="<%= cv %>" maxlength="<%= f.max %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>" aria-label="<%= itemLabel(f.key) %>" placeholder="<%= itemLabel(f.key) %>"><% } %></div>
                <% }); } %>
              <% }) %>
              </div>
            </details>
          <% }; %>
          <fieldset class="ws-list wsb-field" data-ws-list data-max="<%= def.list.max %>" data-next="<%= count %>"<% if (def.list.only) { %> data-ws-only="<%= def.list.only %>"<%= sel.variant === def.list.only ? '' : ' hidden' %><% } %>><legend class="label"><%= fieldLabel(def.list.key) %></legend>
            <div class="stack-sm" data-ws-items><% for (var i = 0; i < count; i += 1) { itemHtml(i, i + 1); } %></div>
            <template data-ws-item-template><% itemHtml('__i__', '#'); %></template>
            <button class="btn btn-secondary btn-sm" type="button" data-ws-item-add<%= count >= def.list.max ? ' disabled' : '' %>><%- icon('plus', 'icon-sm') %><%= t('website.b.add_item') %></button>
          </fieldset>
          <% } %>

          <% if (['doctors', 'services', 'reviews', 'insurance', 'contact', 'hours'].indexOf(sel.type) !== -1) { %><div class="alert alert-info small"><%- icon('info', 'icon-sm') %><div class="grow"><%= t('website.live_data.' + sel.type) %></div></div><% } %>
        </div>

        <div class="wsb-tab-body stack" data-ws-tab-body="design" hidden>
          <% var imgOpts = def.settings.filter(function (f) { return f.group === 'image'; }); if (imgOpts.length) { %>
          <h3 class="wsb-group"><%= t('website.b.image_group') %></h3>
          <% imgOpts.forEach(function (f) { var v = sel.settings[f.key]; %>
          <fieldset class="wsb-field"><legend class="label"><%= fieldLabel(f.key) %></legend><div class="wsb-choices"><% f.options.forEach(function (o) { %><label class="wsb-choice"><input type="radio" name="settings[<%= f.key %>]" value="<%= o %>"<%= v === o ? ' checked' : '' %>><span><%= optLabel(o) %></span></label><% }) %></div></fieldset>
          <% }) %>
          <% } %>

          <% var carOpts = def.settings.filter(function (f) { return f.group === 'carousel'; }); if (carOpts.length) { %>
          <h3 class="wsb-group"><%= t('website.b.carousel') %></h3>
          <% carOpts.forEach(function (f) { var v = sel.settings[f.key]; %>
            <% if (f.kind === 'bool') { %><input type="hidden" name="settings[<%= f.key %>]" value="0"><label class="check"><input type="checkbox" name="settings[<%= f.key %>]" value="1"<%= v ? ' checked' : '' %><%- f.key === 'carousel' ? ' data-ws-car-toggle' : '' %>><span><%= fieldLabel(f.key) %></span></label>
            <% } else { %><fieldset class="wsb-field" data-ws-car-opt><legend class="label"><%= fieldLabel(f.key) %></legend><div class="wsb-choices"><% f.options.forEach(function (o) { %><label class="wsb-choice"><input type="radio" name="settings[<%= f.key %>]" value="<%= o %>"<%= v === o ? ' checked' : '' %>><span><%= f.key === 'per_view' ? fmt.number(Number(o)) : optLabel(f.key === 'car_dir' ? 'car_' + o : o) %></span></label><% }) %></div></fieldset><% } %>
          <% }) %>
          <p class="help"><%= t('website.b.carousel_help') %></p>
          <% } %>

          <h3 class="wsb-group"><%= t('website.b.look') %></h3>
          <fieldset class="wsb-field"><legend class="label"><%= t('website.style.align') %></legend>
            <div class="wsb-choices is-icons"><% ['auto', 'start', 'center', 'end'].forEach(function (o) { %><label class="wsb-choice" title="<%= t('website.style_opt.align.' + o) %>"><input type="radio" name="settings[style][align]" value="<%= o %>"<%= sty.align === o ? ' checked' : '' %>><span><%- icon(alignIcon[o], 'icon-sm') %><span class="sr-only"><%= t('website.style_opt.align.' + o) %></span></span></label><% }) %></div>
          </fieldset>
          <fieldset class="wsb-field"><legend class="label"><%= t('website.style.bg') %></legend>
            <div class="wsb-swatches"><% ['auto', 'none', 'soft', 'accent', 'brand', 'dark', 'image'].forEach(function (o) { %><label class="wsb-swatch" title="<%= t('website.style_opt.bg.' + o) %>"><input type="radio" name="settings[style][bg]" value="<%= o %>"<%= sty.bg === o ? ' checked' : '' %> data-ws-bg><span class="wsb-sw wsb-sw-<%= o %>"><% if (o === 'image') { %><%- icon('image', 'icon-sm') %><% } else if (o === 'auto') { %><%- icon('sparkles', 'icon-sm') %><% } else if (o === 'none') { %><%- icon('x', 'icon-sm') %><% } %></span><span class="small"><%= t('website.style_opt.bg.' + o) %></span></label><% }) %></div>
          </fieldset>
          <div class="stack-sm" data-ws-bg-image<%= sty.bg === 'image' ? '' : ' hidden' %>>
            <% var bgim = imgOf(sty.bg_image); %>
            <span class="label"><%= t('website.style.bg_image') %></span>
            <div class="pm-cover ws-pick-preview" data-media-preview="settings[style][bg_image]"><% if (bgim) { %><img src="<%= bgim.url %>" alt=""><% } else { %><span class="pm-empty"><%- icon('image') %></span><% } %></div>
            <input type="hidden" name="settings[style][bg_image]" value="<%= sty.bg_image || '' %>">
            <div class="row-sm wrap"><button class="btn btn-secondary btn-sm" type="button" data-media-pick="settings[style][bg_image]"><%- icon('image', 'icon-sm') %><%= t('media_lib.choose') %></button><button class="btn btn-ghost btn-sm" type="button" data-media-clear="settings[style][bg_image]"<%= bgim ? '' : ' hidden' %>><%= t('media_lib.remove') %></button></div>
            <fieldset class="wsb-field"><legend class="label"><%= t('website.style.overlay') %></legend><div class="wsb-choices"><% ['dark', 'light', 'brand', 'none'].forEach(function (o) { %><label class="wsb-choice"><input type="radio" name="settings[style][overlay]" value="<%= o %>"<%= sty.overlay === o ? ' checked' : '' %>><span><%= t('website.style_opt.overlay.' + o) %></span></label><% }) %></div></fieldset>
          </div>
          <% ['spacing', 'width'].forEach(function (k) { var opts = k === 'spacing' ? ['compact', 'normal', 'roomy', 'none'] : ['narrow', 'normal', 'wide']; %>
          <fieldset class="wsb-field"><legend class="label"><%= t('website.style.' + k) %></legend><div class="wsb-choices"><% opts.forEach(function (o) { %><label class="wsb-choice"><input type="radio" name="settings[style][<%= k %>]" value="<%= o %>"<%= sty[k] === o ? ' checked' : '' %>><span><%= t('website.style_opt.' + k + '.' + o) %></span></label><% }) %></div></fieldset>
          <% }) %>
          <% ['shape_top', 'shape_bottom'].forEach(function (k) { %>
          <fieldset class="wsb-field"><legend class="label"><%= t('website.style.' + k) %></legend>
            <div class="wsb-shapes"><% SHAPES.forEach(function (o) { %><label class="wsb-shape-tile<%= k === 'shape_top' ? ' is-top' : '' %>" title="<%= optLabel(o) %>"><input type="radio" name="settings[style][<%= k %>]" value="<%= o %>"<%= sty[k] === o ? ' checked' : '' %>><span class="wsb-shape-pic"><% if (o !== 'none') { %><%- include('../portal/sections/_shape', { shape: o, edge: 'tile' }) %><% } else { %><%- icon('x', 'icon-sm') %><% } %></span><span class="small"><%= optLabel(o) %></span></label><% }) %></div>
          </fieldset>
          <% }) %>
          <p class="help"><%= t('website.style.shapes_help') %></p>
          <fieldset class="wsb-field"><legend class="label"><%= t('website.style.anim') %></legend>
            <div class="wsb-choices"><% ['auto', 'none', 'fade', 'up', 'zoom', 'side'].forEach(function (o) { %><label class="wsb-choice"><input type="radio" name="settings[style][anim]" value="<%= o %>"<%= sty.anim === o ? ' checked' : '' %>><span><%= t('website.style_opt.anim.' + o) %></span></label><% }) %></div>
            <span class="help"><%= t('website.style.anim_help') %></span>
          </fieldset>
        </div>

        <div class="wsb-form-foot"><button class="btn btn-primary btn-sm" type="submit" data-ws-save-btn><%= t('website.save_section') %></button></div>
      </form>
      <div class="wsb-sel-foot"><form method="post" action="/app/website/builder/sections/<%= sel.id %>/delete" data-confirm="<%= t('website.remove_confirm', { name: secName(sel.type) }) %>" data-confirm-tone="danger"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('website.remove_section') %></button></form></div>
    <% } %>
    </aside>
  </div>
</div>
<%- include('../integrations/_media-picker') %>
