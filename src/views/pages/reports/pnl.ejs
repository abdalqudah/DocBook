<% var m = metrics; var cats = Object.keys(byCategory).sort(function (a, b) { return byCategory[b] - byCategory[a]; }); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs no-print"><a href="/app/reports"><%= t('nav.reports') %></a></div>
    <h1><%= t('reports.pnl_title') %></h1>
    <p><%= month ? fmt.month(month) : t('common.all_time') %> · <%= currency %></p>
  </div>
  <div class="page-actions no-print">
    <%- include('../../partials/period') %>
    <% if (can('data.export')) { %><details class="dropdown"><summary class="btn btn-secondary"><%- icon('download', 'icon-sm') %><%= t('common.export') %><%- icon('chevron-down', 'icon-sm') %></summary><div class="menu"><a href="?month=<%= month || 'all' %>&format=xlsx"><%- icon('file-spreadsheet', 'icon-sm') %><%= t('common.export_xlsx') %></a><a href="?month=<%= month || 'all' %>&format=csv"><%- icon('table', 'icon-sm') %><%= t('common.export_csv') %></a></div></details><% } %>
    <a class="btn btn-primary" href="?month=<%= month || 'all' %>&print=1"><%- icon('printer', 'icon-sm') %><%= t('reports.print_pdf') %></a>
  </div>
</div>
<div class="grid grid-main">
  <div class="panel flush">
    <table class="statement">
      <tr><td></td><td class="small muted"><%= month ? fmt.month(month) : t('common.all_time') %></td><% if (prevLines) { %><td class="small muted no-print" style="text-align:end"><%= t('reports.prev_month') %></td><% } %></tr>
      <% lines.forEach(function (l, i) { %>
        <tr class="<%= l.kind === 'sub' ? 'sub' : l.kind %>">
          <td><%= t('reports.pnl.' + l.key) %><% if (l.pct !== undefined) { %> <span class="small muted">(<%= fmt.pct(l.pct) %>)</span><% } %></td>
          <td class="<%= l.value < 0 && l.kind !== 'line' && l.kind !== 'sub' ? 'neg' : '' %>"><%= fmt.amount(l.value) %></td>
          <% if (prevLines) { %><td class="small muted no-print" style="text-align:end"><%= fmt.amount(prevLines[i].value) %></td><% } %>
        </tr>
        <% if (l.key === 'opex_daily' && cats.length) { cats.forEach(function (k) { %><tr class="sub"><td>· <%= label('categories', k) %></td><td><%= fmt.amount(-byCategory[k]) %></td><% if (prevLines) { %><td class="no-print"></td><% } %></tr><% }) } %>
      <% }) %>
    </table>
  </div>
  <div class="stack">
    <div class="panel"><div class="panel-head"><h2><%= t('reports.cash_view') %></h2></div><div class="panel-body"><dl class="dl">
      <dt><%= t('kpi.cash_outflow') %></dt><dd class="num"><%= fmt.money(m.totalCashOutflow) %></dd>
      <dt><%= t('purchases.paid_total') %></dt><dd class="num"><%= fmt.money(m.totalInventoryPurchased) %></dd>
      <dt><%= t('purchases.payables') %></dt><dd class="num"><%= fmt.money(m.totalInventoryDue) %></dd>
      <dt><%= t('delivery.fees_collected') %></dt><dd class="num"><%= fmt.money(m.totalDeliveryFeeCollected) %></dd>
      <dt><%= t('reports.payroll_obligation') %></dt><dd class="num"><%= fmt.money(m.totalPayrollObligation) %></dd>
    </dl></div></div>
    <div class="alert alert-info"><%- icon('info') %><div class="grow small"><%= t('reports.pnl_note') %></div></div>
  </div>
</div>
<div class="panel flush mt-4">
  <div class="panel-head"><h2><%= t('reports.allocation') %></h2></div>
  <% if (!m.partnerAllocations.length) { %><div class="panel-body small muted"><%= t('partners.empty_title') %></div><% } else { %>
  <div class="table-wrap"><table class="table responsive"><thead><tr><th><%= t('partners.partner') %></th><th class="num"><%= t('partners.equity') %></th><th class="num"><%= t('partners.allocated') %></th><th class="num"><%= t('partners.withdrawn') %></th><th class="num"><%= t('partners.net_payable') %></th></tr></thead>
  <tbody><% m.partnerAllocations.forEach(function (a) { %><tr><td class="primary-cell strong"><%= a.partnerName %></td><td class="num" data-label="<%= t('partners.equity') %>"><%= fmt.pct(a.equityPercent, 2) %></td><td class="num <%= a.allocatedProfit < 0 ? 'neg' : 'pos' %>" data-label="<%= t('partners.allocated') %>"><%= fmt.amount(a.allocatedProfit) %></td><td class="num" data-label="<%= t('partners.withdrawn') %>"><%= fmt.amount(a.withdrawn) %></td><td class="num strong" data-label="<%= t('partners.net_payable') %>"><%= fmt.amount(a.netPayable) %></td></tr><% }) %></tbody></table></div>
  <% } %>
</div>
