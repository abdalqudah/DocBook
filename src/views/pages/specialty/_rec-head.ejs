<%# Header of the specialty forms screens. Locals: patient, visit, age, form (or null), crumb (text, optional), actions (html, optional), L. %>
<% var pt = patient; var fTitle = typeof form !== 'undefined' && form ? L(form.ar, form.en) : null; %>
<div class="page-head no-print">
  <div style="min-width:0">
    <div class="breadcrumbs"><a href="/app/patients"><%= t('patients.title') %></a><%- icon('chevron-right', 'flip-rtl') %><a href="/app/patients/<%= pt.id %>" dir="auto"><%= pt.full_name %></a><%- icon('chevron-right', 'flip-rtl') %><a href="<%= recUrl('') %>"><%= t('spforms.title') %></a><% if (fTitle) { %><%- icon('chevron-right', 'flip-rtl') %><span><%= fTitle %></span><% } %></div>
    <h1><%= typeof crumb !== 'undefined' && crumb ? crumb : (fTitle || t('spforms.title')) %></h1>
    <p class="sp-meta"><span dir="auto" class="strong"><%= pt.full_name %></span><% if (age !== null) { %><span><%= t('patients.years', { n: age }) %></span><% } %><% if (pt.gender) { %><span><%= t('patients.genders.' + pt.gender) %></span><% } %><% if (pt.date_of_birth) { %><span><%= t('patients.dob') %>: <%= fmt.date(pt.date_of_birth) %></span><% } %></p>
  </div>
  <div class="page-actions"><%- typeof actions !== 'undefined' ? actions : '' %></div>
</div>
<% if (visit) { %>
<div class="alert alert-info sp-visit no-print"><%- icon('stethoscope') %><div class="grow"><div><%= t('specialty_mod.from_visit', { date: fmt.date(visit.appointment_date), doctor: visit.doctor_name || '—' }) %></div></div><a class="btn btn-ghost btn-sm" href="/app/visits/<%= visit.id %>"><%- icon('arrow-left', 'icon-sm flip-rtl') %><%= t('specialty_mod.back_to_visit') %></a></div>
<% } %>
