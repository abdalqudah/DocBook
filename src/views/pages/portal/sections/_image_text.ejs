<% var im = img(s.settings.image); var a = act(s.settings.action, s.settings.page); var back = s.variant === 'image_back' && im; if (c.title || c.text || im) { %>
<section class="ws-section ws-it ws-it-<%= s.variant %><%= im ? ' has-image' : '' %>" id="s-<%= s.id %>">
  <% if (back) { %><img class="ws-hero-back" src="<%= im.url %>" alt="<%= altOf(im) %>" loading="lazy"><% } %>
  <div class="container ws-it-inner">
    <% if (im && !back) { %><figure class="ws-it-media <%= imgCls(s.settings) %>"><img src="<%= im.url %>" alt="<%= altOf(im) %>" loading="lazy"></figure><% } %>
    <div class="ws-it-text">
      <% if (c.title) { %><h2 class="ws-title"><%= c.title %></h2><% } %>
      <% if (c.text) { %><div class="lp-prose"><% String(c.text).split(/\n\s*\n/).forEach(function (p) { if (p.trim()) { %><p><%= p.trim() %></p><% } }) %></div><% } %>
      <% if (a) { %><div class="ws-hero-actions"><a class="btn btn-primary" href="<%= a.href %>"<%- a.ext ? ' target="_blank" rel="noopener"' : '' %>><%- icon(a.icon, 'icon-sm') %><%= c.button || a.label %></a></div><% } %>
    </div>
  </div>
</section>
<% } %>
