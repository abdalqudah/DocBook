<%# Columns of content side by side (2 / 3 / 4): picture or icon, title, text, button. %>
<% var extra = s.settings.items || [];
   var cols = (c.items || []).map(function (x, i) { var e = extra[i] || {}; return { title: x && x.title, text: x && x.text, button: x && x.button, icon: e.icon, image: img(e.image), action: act(e.action) }; })
     .filter(function (x) { return x.title || x.text || x.image; }); %>
<% if (cols.length) { %>
<section class="ws-section ws-columns-sec" id="s-<%= s.id %>">
  <div class="container">
    <% if (c.title || c.intro) { %><div class="ws-head"><% if (c.title) { %><h2 class="ws-title"><%= c.title %></h2><% } %><% if (c.intro) { %><p><%= c.intro %></p><% } %></div><% } %>
    <div class="ws-columns ws-columns-<%= s.variant %> ws-cols-<%= s.settings.columns || '2' %> ws-ratio-<%= s.settings.image_ratio || 'landscape' %>">
      <% cols.forEach(function (x) { %>
      <div class="ws-column">
        <% if (x.image) { %><figure class="ws-column-media"><img src="<%= x.image.url %>" alt="<%= altOf(x.image) %>" loading="lazy"></figure><% } else if (x.icon && x.icon !== 'none') { %><span class="ws-feature-icon"><%- icon(x.icon) %></span><% } %>
        <% if (x.title) { %><h3><%= x.title %></h3><% } %>
        <% if (x.text) { %><p class="pre-line"><%= x.text %></p><% } %>
        <% if (x.action) { %><a class="btn btn-secondary btn-sm" href="<%= x.action.href %>"<%- x.action.ext ? ' target="_blank" rel="noopener"' : '' %>><%- icon(x.action.icon, 'icon-sm') %><%= x.button || x.action.label %></a><% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
