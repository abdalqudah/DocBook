<%
  var extra = s.settings.items || [];
  // media: mixed = the card's picture, else its icon · images = pictures only · icons = icons only · none = text only.
  var mode = s.settings.media || 'mixed';
  var items = (c.items || []).map(function (x, i) { var e = extra[i] || {}; return { title: x && x.title, text: x && x.text, button: x && x.button, icon: mode === 'images' || mode === 'none' ? null : e.icon, image: mode === 'icons' || mode === 'none' ? null : img(e.image), action: act(e.action, e.page, e.link) }; })
    .filter(function (x) { return x.title || x.text || x.image; });
%>
<% if (items.length) { %>
<section class="ws-section ws-cards-sec" id="s-<%= s.id %>">
  <div class="container">
    <% if (c.title || c.intro) { %><div class="ws-head"><% if (c.title) { %><h2 class="ws-title"><%= c.title %></h2><% } %><% if (c.intro) { %><p><%= c.intro %></p><% } %></div><% } %>
    <ul class="ws-cards ws-cards-<%= s.variant %> ws-cols-<%= s.settings.columns || '3' %> ws-card-<%= s.settings.card_style || 'shadow' %> ws-ratio-<%= s.settings.image_ratio || 'landscape' %>">
      <% items.forEach(function (x) { %>
      <li class="ws-card">
        <% if (x.image) { %><figure class="ws-card-media"><img src="<%= x.image.url %>" alt="<%= altOf(x.image) %>" loading="lazy"></figure><% } else if (x.icon && x.icon !== 'none') { %><span class="ws-feature-icon"><%- icon(x.icon) %></span><% } %>
        <div class="ws-card-body">
          <% if (x.title) { %><h3><%= x.title %></h3><% } %>
          <% if (x.text) { %><p><%= x.text %></p><% } %>
          <% if (x.action) { %><a class="btn btn-secondary btn-sm" href="<%= x.action.href %>"<%- x.action.ext ? ' target="_blank" rel="noopener"' : '' %>><%- icon(x.action.icon, 'icon-sm') %><%= x.button || x.action.label %></a><% } %>
        </div>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>
