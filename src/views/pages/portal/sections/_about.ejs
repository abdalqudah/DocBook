<% var text = c.text || clinic.aboutText; var im = img(s.settings.image); if (text || im) { %>
<section class="ws-section ws-about ws-about-<%= s.variant %>" id="s-<%= s.id %>">
  <div class="container ws-about-inner<%= im && s.variant === 'image_side' ? ' has-image' : '' %>">
    <div>
      <h2 class="ws-title"><%= c.title || t('portal.about') %></h2>
      <div class="lp-prose"><% String(text || '').split(/\n\s*\n/).forEach(function (p) { if (p.trim()) { %><p><%= p.trim() %></p><% } }) %></div>
    </div>
    <% if (im) { %><figure class="ws-about-media <%= imgCls(s.settings) %>"><img src="<%= im.url %>" alt="<%= altOf(im) %>" loading="lazy"></figure><% } %>
  </div>
</section>
<% } %>
