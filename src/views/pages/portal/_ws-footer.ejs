<%# Footer of a builder site (doc.footer): about text, contact, hours, menu, social profiles, copyright. %>
<% var f = wsSite.footer || {}; var c = clinic; var L = wsSite.L;
   // Profiles: the footer's own links plus the clinic's Website → Connections (one icon per network).
   var ICON = { facebook: 'facebook', instagram: 'instagram', x: 'twitter', tiktok: 'music', snapchat: 'ghost', youtube: 'youtube', linkedin: 'linkedin', whatsapp: 'message-circle', telegram: 'send', google: 'map-pin' };
   var links = {}; Object.keys(f.social || {}).forEach(function (k) { if (f.social[k]) links[k === 'twitter' ? 'x' : k] = f.social[k]; });
   var conn = typeof wsConnections !== 'undefined' && wsConnections ? wsConnections : null;
   if (conn) { Object.keys(conn.social || {}).forEach(function (k) { if (conn.social[k]) links[k] = conn.social[k]; }); if (conn.google && conn.google.business) links.google = conn.google.business; }
   var social = Object.keys(links).filter(function (k) { return ICON[k]; });
   var label = function (k) { return k === 'google' ? t('clinic_mkt.google_profile') : t('growth.social_' + k); };
   var about = L(f.about) || ''; var copy = L(f.copyright) || c.displayName; %>
<% var _logoUrl = wsSite.logo ? wsSite.logo.url : (c.logo_mime ? '/' + c.slug + '/logo?v=' + c.logo_version : null);
   var _dark = Boolean(wsSite.logoDark && wsSite.logo); // the white logo, shown on dark backgrounds (dark mode)
   var _showLogo = f.show_logo !== false && _logoUrl; var _showName = f.show_name !== false; var _fh = Number(f.logo_height) || 48; if (_fh < 20) _fh = 20;
   // The logo and the name (shared by every footer style; the simple one shows it at the start of its single row).
   var _brand = (_showLogo || _showName) ? '<div class="ws-fbrand ws-fbrand-' + (f.name_pos === 'beside' ? 'beside' : 'below') + '">'
     + (_showLogo ? '<span class="ws-flogo ws-flogo-' + (f.logo_shape === 'badge' ? 'badge' : 'free') + '" style="--ws-flogo-h: ' + _fh + 'px">'
       + (_dark ? '<img class="logo-light" src="' + escapeHtml(_logoUrl) + '" alt="' + (_showName ? '' : escapeHtml(c.displayName)) + '"><img class="logo-dark" src="' + escapeHtml(wsSite.logoDark.url) + '" alt="">'
         : '<img src="' + escapeHtml(_logoUrl) + '" alt="' + (_showName ? '' : escapeHtml(c.displayName)) + '">') + '</span>' : '')
     + (_showName ? '<strong>' + escapeHtml(c.displayName) + '</strong>' : '') + '</div>' : ''; %>
<footer class="footer portal-footer ws-footer ws-footer-<%= f.style || 'columns' %>"<% if (wsSite.preview) { %> data-ws-sec="__footer" data-ws-label="<%= t('website.b.footer') %>"<% } %>>
  <div class="container">
    <% if (f.style !== 'simple') { %>
    <div class="ws-footer-grid">
      <div class="ws-footer-brand">
        <%- _brand %>
        <% if (about) { %><p><%= about %></p><% } %>
        <% if (f.show_social !== false && social.length) { %><div class="ws-social"><% social.forEach(function (k) { %><a class="btn btn-ghost btn-icon" href="<%= links[k] %>" target="_blank" rel="noopener me" aria-label="<%= label(k) %>" title="<%= label(k) %>"><%- icon(ICON[k]) %></a><% }) %></div><% } %>
        <% if (conn && conn.google && conn.google.review) { %><a class="btn btn-secondary btn-sm ws-review-g" href="<%= conn.google.review %>" target="_blank" rel="noopener"><%- icon('star', 'icon-sm') %><%= t('clinic_mkt.review_us') %></a><% } %>
      </div>
      <% if (f.show_menu !== false && wsSite.items.length) { %>
      <nav class="ws-footer-col" aria-label="<%= t('site.nav_label') %>"><h3><%= t('website.b.footer_links') %></h3><ul><% wsSite.items.forEach(function (n) { %><li><a href="<%= n.href %>"<%- n.ext ? ' target="_blank" rel="noopener"' : '' %>><%= n.label %></a></li><% }) %></ul></nav>
      <% } %>
      <% if (f.show_contact !== false && (c.address || c.phone || c.email)) { %>
      <div class="ws-footer-col"><h3><%= t('portal.info') %></h3><ul class="site-contact">
        <% if (c.address) { %><li><%- icon('map-pin', 'icon-sm') %><span><%= c.address %></span></li><% } %>
        <% if (c.phone) { %><li><%- icon('phone', 'icon-sm') %><a href="<%= c.telHref %>" dir="ltr"><%= c.phone %></a></li><% } %>
        <% if (c.email) { %><li><%- icon('mail', 'icon-sm') %><a href="mailto:<%= c.email %>" dir="ltr"><%= c.email %></a></li><% } %>
      </ul></div>
      <% } %>
      <% if (f.show_hours !== false && c.working_hours_text) { %>
      <div class="ws-footer-col"><h3><%= t('portal.hours') %></h3><p class="pre-line" dir="auto"><%= c.working_hours_text %></p></div>
      <% } %>
    </div>
    <% } %>
    <div class="ws-footer-bottom">
      <% if (f.style === 'simple' && _brand) { %><div class="ws-footer-simple-brand"><%- _brand %></div><% } %>
      <span>© <%= new Date().getFullYear() %> <%= copy %></span>
      <% if (f.style === 'simple' && f.show_social !== false && social.length) { %><span class="ws-social"><% social.forEach(function (k) { %><a class="btn btn-ghost btn-icon btn-sm" href="<%= links[k] %>" target="_blank" rel="noopener me" aria-label="<%= label(k) %>"><%- icon(ICON[k], 'icon-sm') %></a><% }) %></span><% } %>
      <% if (!edition.single && (f.show_powered !== false || !wsSite.whiteLabel)) { %><a class="row-sm" href="/"><%= t('portal.powered', { brand: brandName }) %></a><% } %>
    </div>
  </div>
</footer>
