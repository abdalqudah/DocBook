<%
  var base = '/r/' + token;
  var dayLabel = function (d) { return fmt.date(d, { weekday: 'short', day: 'numeric', month: 'short' }); };
%>
<div class="container eg-page">
  <div class="eg-back"><a class="link small" href="<%= base %>"><%- icon('arrow-left', 'icon-sm flip-rtl') %><%= t('messaging.back_to_appointment') %></a></div>
  <% if (error) { %><div class="alert alert-error mb-4" role="alert"><%- icon('circle-alert') %><div class="grow"><%= error %></div></div><% } %>

  <section class="eg-card">
    <span class="tiny muted"><%= t('messaging.reschedule') %></span>
    <h1 class="eg-h1"><%= t('messaging.pick_new_time') %></h1>
    <p class="small muted"><%= t('messaging.current_time') %>: <strong><%= fmt.date(a.appointment_date, { weekday: 'long', day: 'numeric', month: 'long' }) %></strong> · <bdi class="num" dir="ltr"><%= a.appointment_time %></bdi><% if (doctor) { %> · <%= doctor %><% } %></p>

    <% if (!st.canReschedule) { %>
      <div class="alert alert-info small mt-3"><%- icon('info', 'icon-sm') %><div class="grow"><%= st.locked ? t('messaging.locked', { n: cfg.cancel_cutoff_hours }) : t('messaging.closed_text') %></div></div>
    <% } else { %>
    <nav class="eg-days" aria-label="<%= t('common.date') %>">
      <% days.forEach(function (d) { %>
      <a href="<%= base %>/reschedule?date=<%= d %>" class="eg-day<%= d === date ? ' active' : '' %>"<% if (d === date) { %> aria-current="date"<% } %>><%= dayLabel(d) %></a>
      <% }) %>
    </nav>

    <h2 class="eg-h2"><%= fmt.date(date, { weekday: 'long', day: 'numeric', month: 'long' }) %></h2>
    <% if (!slots.length) { %>
      <p class="small muted"><%= t('messaging.no_slots') %></p>
    <% } else { %>
    <form method="post" action="<%= base %>/reschedule" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="date" value="<%= date %>">
      <div class="eg-slots" role="radiogroup" aria-label="<%= t('common.time') %>">
        <% slots.forEach(function (s, i) { %>
        <label class="eg-slot"><input type="radio" name="time" value="<%= s %>" required<%= i === 0 ? '' : '' %>><span class="num" dir="ltr"><%= s %></span></label>
        <% }) %>
      </div>
      <div><button class="btn btn-primary btn-lg" type="submit"><%- icon('check') %><%= t('messaging.move_here') %></button></div>
    </form>
    <% } %>
    <% } %>
  </section>
</div>
