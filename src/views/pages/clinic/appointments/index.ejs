<%
  var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
  var canManage = can('appointments.manage');
  var SB = { pending: 'badge-warning', confirmed: 'badge-info', completed: 'badge-success', cancelled: 'badge-neutral', no_show: 'badge-danger' };
  var own = Boolean(ctx.ownDoctorId);
  var qs = function (o) { var m = Object.assign({}, { view: view === 'list' ? 'list' : undefined, doctor: f.doctor || undefined, status: f.status || undefined, q: f.q || undefined }, o); return '?' + Object.keys(m).filter(function (k) { return m[k] !== undefined && m[k] !== null && m[k] !== ''; }).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(m[k]); }).join('&'); };
  var bookDate = view === 'day' && !isPast ? date : clinicToday;
%>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><%= t('nav.group_clinic') %></div>
    <h1><%= own ? t('appointments.my_title') : t('appointments.title') %></h1>
    <p><%= t('appointments.lead') %></p>
  </div>
  <div class="page-actions">
    <nav class="segmented" aria-label="<%= t('appointments.view_mode') %>">
      <a class="<%= view === 'day' ? 'active' : '' %>" href="/app/appointments<%= qs({ view: undefined, date: view === 'day' ? date : undefined }) %>"<% if (view === 'day') { %> aria-current="page"<% } %>><%= t('appointments.view_day') %></a>
      <a class="<%= view === 'list' ? 'active' : '' %>" href="/app/appointments<%= qs({ view: 'list', from: view === 'day' ? date : from }) %>"<% if (view === 'list') { %> aria-current="page"<% } %>><%= t('appointments.view_list') %></a>
    </nav>
    <% if (view === 'list') { %><%- include('../../../partials/export-menu', { href: '/app/appointments/export' }) %><% } %>
    <% if (canManage && doctors.length) { %><button class="btn btn-secondary" type="button" data-open-dialog="block-dialog" data-reset-form><%- icon('lock', 'icon-sm') %><%= t('appointments.block_time') %></button><% } %>
    <% if (canManage) { %><a class="btn btn-primary" href="/app/appointments/new?date=<%= bookDate %><%= f.doctor ? '&doctor=' + f.doctor : '' %>"><%- icon('calendar-plus', 'icon-sm') %><%= t('appointments.new') %></a><% } %>
  </div>
</div>

<% if (view === 'day') { %>
<div class="panel appt-toolbar">
  <div class="appt-datebar">
    <div class="row-sm">
      <a class="btn btn-secondary btn-icon btn-sm" href="/app/appointments<%= qs({ date: prev }) %>" aria-label="<%= t('appointments.prev_day') %>" title="<%= t('appointments.prev_day') %>"><%- icon('chevron-left', 'icon-sm flip-rtl') %></a>
      <a class="btn btn-secondary btn-icon btn-sm" href="/app/appointments<%= qs({ date: next }) %>" aria-label="<%= t('appointments.next_day') %>" title="<%= t('appointments.next_day') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a>
      <% if (date !== clinicToday) { %><a class="btn btn-ghost btn-sm" href="/app/appointments<%= qs({}) %>"><%= t('common.today') %></a><% } %>
    </div>
    <div class="appt-date-title">
      <h2><%= fmt.date(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></h2>
      <% if (date === clinicToday) { %><span class="badge badge-brand"><%= t('common.today') %></span><% } else if (isPast) { %><span class="badge badge-neutral"><%= t('appointments.past_day') %></span><% } %>
    </div>
  </div>
  <form class="table-toolbar appt-filters" method="get" data-autosubmit role="search">
    <input class="input" type="date" name="date" value="<%= date %>" aria-label="<%= t('common.date') %>">
    <% if (!own && doctors.length > 1) { %><select class="select" name="doctor" aria-label="<%= t('common.doctor') %>"><option value=""><%= t('common.all_doctors') %></option><% doctors.forEach(function (d) { %><option value="<%= d.id %>"<%= f.doctor === d.id ? ' selected' : '' %>><%= L(d.full_name, d.full_name_en) %></option><% }) %></select><% } %>
    <select class="select" name="status" aria-label="<%= t('common.status') %>"><option value=""><%= t('appointments.all_statuses') %></option><% statuses.forEach(function (s) { %><option value="<%= s %>"<%= f.status === s ? ' selected' : '' %>><%= t('appointments.statuses.' + s) %></option><% }) %></select>
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= f.q || '' %>" placeholder="<%= t('appointments.search') %>" aria-label="<%= t('common.search') %>"></div>
    <% if (f.doctor || f.status || f.q) { %><a class="btn btn-ghost btn-sm" href="/app/appointments?date=<%= date %>"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.apply') %></button></noscript>
  </form>
</div>

<div class="summary-strip mt-4">
  <span class="chip"><strong><%= fmt.number(stats.total) %></strong><%= t('appointments.stat_total') %></span>
  <span class="chip"><span class="badge badge-dot badge-info"></span><strong><%= fmt.number(stats.confirmed) %></strong><%= t('appointments.statuses.confirmed') %></span>
  <span class="chip"><span class="badge badge-dot badge-warning"></span><strong><%= fmt.number(stats.pending) %></strong><%= t('appointments.statuses.pending') %></span>
  <span class="chip"><span class="badge badge-dot badge-success"></span><strong><%= fmt.number(stats.completed) %></strong><%= t('appointments.statuses.completed') %></span>
  <span class="chip"><span class="badge badge-dot badge-danger"></span><strong><%= fmt.number(stats.missed) %></strong><%= t('appointments.stat_missed') %></span>
</div>

<% if (!doctors.length && !columns.length) { %>
  <div class="panel mt-4"><%- include('../../../partials/empty', { emptyIcon: 'stethoscope', emptyTitle: t('appointments.no_doctors_title'), emptyText: t('appointments.no_doctors_text'), emptyAction: can('doctors.manage') ? '<a class="btn btn-primary btn-sm" href="/app/doctors/new">' + t('doctors.add') + '</a>' : '' }) %></div>
<% } else { %>
<div class="appt-board mt-4" style="--cols:<%= Math.max(1, columns.length) %>">
  <% columns.forEach(function (col) { var visitCount = col.items.filter(function (a) { return a.appointment_type !== 'blocked' && a.status !== 'cancelled'; }).length; %>
  <section class="appt-col" aria-label="<%= col.unassigned ? t('appointments.unassigned') : L(col.name, col.name_en) %>" style="<%= col.color ? '--doc:' + col.color : '' %>">
    <header class="appt-col-head">
      <span class="avatar" style="<%= col.color ? 'background:' + col.color + ';color:var(--surface)' : '' %>"><%= col.unassigned ? '?' : initials(L(col.name, col.name_en)) %></span>
      <div class="grow">
        <div class="strong truncate"><%= col.unassigned ? t('appointments.unassigned') : L(col.name, col.name_en) %></div>
        <div class="tiny muted">
          <% if (col.unassigned) { %><%= t('appointments.unassigned_hint') %>
          <% } else if (col.off) { %><span style="color:var(--warning)"><%= t('appointments.day_off') %></span>
          <% } else if (!col.works) { %><%= t('appointments.not_working') %>
          <% } else if (col.shifts.length) { %><span dir="ltr"><%= col.shifts.map(function (s) { return s.start + '–' + s.end; }).join(' · ') %></span><% if (col.breaks.length) { %> · <%= t('appointments.break') %> <span dir="ltr"><%= col.breaks[0].start %>–<%= col.breaks[0].end %></span><% } %><% } %>
        </div>
      </div>
      <span class="badge" title="<%= t('appointments.stat_total') %>"><%= fmt.number(visitCount) %></span>
    </header>
    <div class="appt-col-body">
      <% if (!col.items.length) { %>
        <div class="appt-col-empty">
          <%- icon('calendar', 'icon-sm') %><span><%= col.off || !col.works ? t('appointments.no_schedule') : t('appointments.no_appointments') %></span>
          <% if (canManage && !isPast && !col.unassigned && col.works && !col.off) { %><a class="btn btn-ghost btn-sm" href="/app/appointments/new?doctor=<%= col.id %>&date=<%= date %>"><%- icon('plus', 'icon-sm') %><%= t('appointments.book_here') %></a><% } %>
        </div>
      <% } %>
      <% col.items.forEach(function (a) { %>
        <% if (a.appointment_type === 'blocked') { %>
          <div class="appt-card is-block">
            <div class="appt-time" dir="ltr"><%= a.appointment_time %><span><%= a.end_time %></span></div>
            <div class="appt-main"><div class="row-sm small strong"><%- icon('lock', 'icon-sm') %><span class="truncate"><%= a.notes || t('appointments.blocked') %></span></div><div class="tiny muted"><%= t('appointments.blocked_len', { n: a.length }) %></div></div>
            <% if (canManage) { %><form method="post" action="/app/appointments/blocks/<%= a.id %>/delete" data-confirm="<%= t('appointments.block_delete_confirm') %>" data-confirm-title="<%= t('appointments.block_delete') %>" data-confirm-yes="<%= t('common.delete') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-icon btn-sm" type="submit" aria-label="<%= t('appointments.block_delete') %>" title="<%= t('appointments.block_delete') %>"><%- icon('x', 'icon-sm') %></button></form><% } %>
          </div>
        <% } else { %>
          <a class="appt-card st-<%= a.status %>" href="/app/appointments/<%= a.id %>">
            <div class="appt-time" dir="ltr"><%= a.appointment_time %><span><%= a.end_time %></span></div>
            <div class="appt-main">
              <div class="strong truncate"><%= a.patient_name %></div>
              <% if (a.patient_phone) { %><div class="small muted truncate"><bdi dir="ltr"><%= a.patient_phone %></bdi></div><% } %>
              <% if (a.service_name) { %><div class="tiny muted truncate"><%= L(a.service_name, a.service_name_en) %></div><% } %>
              <div class="appt-badges">
                <span class="badge badge-dot <%= SB[a.status] %>"><%= t('appointments.statuses.' + a.status) %></span>
                <% if (a.source === 'website') { %><span class="badge badge-brand"><%- icon('globe', 'icon-sm') %><%= t('appointments.sources.website') %></span><% } %>
                <% if (a.appointment_type === 'online') { %><span class="badge badge-info"><%- icon('monitor', 'icon-sm') %><%= t('appointments.types.online') %></span><% } %>
                <% if (a.payment_status === 'paid') { %><span class="badge badge-success"><%- icon('check', 'icon-sm') %><%= t('appointments.payment_statuses.paid') %></span><% } else if (a.checked_in && a.status !== 'cancelled') { %><span class="badge"><%- icon('armchair', 'icon-sm') %><%= a.with_doctor ? t('appointments.with_doctor') : t('appointments.arrived') %></span><% } %>
              </div>
            </div>
          </a>
        <% } %>
      <% }) %>
    </div>
  </section>
  <% }) %>
</div>
<% if (!columns.length) { %><div class="panel mt-4"><%- include('../../../partials/empty', { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: '', emptyAction: '<a class="btn btn-secondary btn-sm" href="/app/appointments?date=' + date + '">' + t('table.clear_filters') + '</a>' }) %></div><% } %>
<% } %>

<% } else { /* ---------------- list view ---------------- */ %>
<div class="panel flush">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <input type="hidden" name="view" value="list">
    <input class="input" type="date" name="from" value="<%= from %>" aria-label="<%= t('common.from') %>" title="<%= t('common.from') %>">
    <input class="input" type="date" name="to" value="<%= to %>" aria-label="<%= t('common.to') %>" title="<%= t('common.to') %>">
    <% if (!own && doctors.length > 1) { %><select class="select" name="doctor" aria-label="<%= t('common.doctor') %>"><option value=""><%= t('common.all_doctors') %></option><% doctors.forEach(function (d) { %><option value="<%= d.id %>"<%= f.doctor === d.id ? ' selected' : '' %>><%= L(d.full_name, d.full_name_en) %></option><% }) %></select><% } %>
    <select class="select" name="status" aria-label="<%= t('common.status') %>"><option value=""><%= t('appointments.all_statuses') %></option><% statuses.forEach(function (s) { %><option value="<%= s %>"<%= f.status === s ? ' selected' : '' %>><%= t('appointments.statuses.' + s) %></option><% }) %></select>
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= f.q || '' %>" placeholder="<%= t('appointments.search') %>" aria-label="<%= t('common.search') %>"></div>
    <% if (f.doctor || f.status || f.q) { %><a class="btn btn-ghost btn-sm" href="/app/appointments?view=list&from=<%= from %>&to=<%= to %>"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.apply') %></button></noscript>
  </form>
  <% if (!rows.length) { %>
    <%- include('../../../partials/empty', { emptyIcon: 'calendar-days', emptyTitle: t('appointments.list_empty_title'), emptyText: t('appointments.list_empty_text'), emptyAction: canManage ? '<a class="btn btn-primary btn-sm" href="/app/appointments/new">' + t('appointments.new') + '</a>' : '' }) %>
  <% } else { %>
  <% if (capped) { %><div class="alert alert-info" style="margin:12px 16px 0"><%- icon('info') %><div class="grow small"><%= t('appointments.capped') %></div></div><% } %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th><%= t('common.date') %></th><th><%= t('common.patient') %></th><th><%= t('common.doctor') %></th><th><%= t('common.service') %></th><th><%= t('common.status') %></th><th class="num"><%= t('appointments.amount_due') %> (<%= currency %>)</th><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody>
      <% rows.forEach(function (a) { %>
        <tr data-href="/app/appointments/<%= a.id %>">
          <td data-label="<%= t('common.date') %>" class="nowrap"><div class="strong"><%= fmt.date(a.appointment_date, { weekday: 'short', day: 'numeric', month: 'short' }) %></div><div class="small muted"><bdi dir="ltr"><%= a.appointment_time %>–<%= a.end_time %></bdi></div></td>
          <td class="primary-cell"><a class="strong" href="/app/appointments/<%= a.id %>"><%= a.patient_name %></a><div class="small muted"><bdi dir="ltr"><%= a.patient_phone || '' %></bdi></div></td>
          <td data-label="<%= t('common.doctor') %>"><span class="row-sm"><span class="swatch" style="<%= a.doctor_color ? 'background:' + a.doctor_color : '' %>"></span><%= a.doctor_id ? L(a.doctor_name, a.doctor_name_en) : t('appointments.unassigned') %></span></td>
          <td data-label="<%= t('common.service') %>"><%= a.service_name ? L(a.service_name, a.service_name_en) : '—' %></td>
          <td data-label="<%= t('common.status') %>"><span class="row-sm wrap"><span class="badge badge-dot <%= SB[a.status] %>"><%= t('appointments.statuses.' + a.status) %></span><% if (a.source === 'website') { %><span class="badge badge-brand"><%= t('appointments.sources.website') %></span><% } %><% if (a.appointment_type === 'online') { %><span class="badge badge-info"><%= t('appointments.types.online') %></span><% } %></span></td>
          <td data-label="<%= t('appointments.amount_due') %>" class="num"><%= fmt.amount(a.amount_due) %><% if (a.payment_status === 'paid') { %><div class="tiny" style="color:var(--success)"><%= t('appointments.payment_statuses.paid') %></div><% } %></td>
          <td class="actions"><a class="btn btn-ghost btn-icon btn-sm" href="/app/appointments/<%= a.id %>" aria-label="<%= t('common.open') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a></td>
        </tr>
      <% }) %>
      </tbody>
      <tfoot><tr><td colspan="5"><%= t('appointments.list_total', { n: fmt.number(totals.count) }) %></td><td class="num"><%= fmt.amount(totals.due) %></td><td></td></tr></tfoot>
    </table>
  </div>
  <% } %>
</div>
<% } %>

<% if (canManage && doctors.length) { var bOld = (typeof old !== 'undefined' && old) || {}; var bDoc = bOld.doctor_id || (f.doctor || (doctors.length === 1 ? doctors[0].id : '')); %>
<dialog class="dialog" id="block-dialog" aria-labelledby="block-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'block-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="/app/appointments/blocks" novalidate data-booking>
    <div class="dialog-head"><div><h2 id="block-title"><%= t('appointments.block_time') %></h2><p class="small muted"><%= t('appointments.block_help') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../../../partials/form-error') %>
      <div class="form-grid">
        <%- include('../../../partials/field', { name: 'doctor_id', id: 'b-doctor', label: t('common.doctor'), type: 'select', required: true, value: bDoc, placeholder: t('appointments.choose_doctor'), options: doctors.map(function (d) { return { value: d.id, label: L(d.full_name, d.full_name_en) }; }), attrs: 'data-default="' + bDoc + '" data-doctor-field' }) %>
        <%- include('../../../partials/field', { name: 'appointment_date', id: 'b-date', label: t('common.date'), type: 'date', required: true, value: view === 'day' && !isPast ? date : clinicToday, attrs: 'min="' + clinicToday + '" data-date-field data-default="' + (view === 'day' && !isPast ? date : clinicToday) + '"' }) %>
        <%- include('../../../partials/field', { name: 'duration_minutes', id: 'b-duration', label: t('appointments.duration'), value: 60, suffix: t('common.minutes'), required: true, attrs: 'inputmode="numeric" data-default="60" data-duration-input' }) %>
        <%- include('../../../partials/field', { name: 'label', id: 'b-label', label: t('appointments.block_label'), placeholder: t('appointments.block_label_ph') }) %>
        <%- include('_slots', { slotId: 'b-slots', selected: bOld.appointment_time || '', exclude: '' }) %>
      </div>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%- icon('lock', 'icon-sm') %><%= t('appointments.block_save') %></button></div>
  </form>
</dialog>
<% } %>
