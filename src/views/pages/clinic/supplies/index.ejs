<%
  var canManage = can('supplies.manage'); var showCost = can('finance.view');
  var lowOnly = query.low === 'yes';
  var level = function (r) { var cur = Number(r.current_stock), lvl = Number(r.reorder_level); if (cur <= 0) return 'out'; if (cur <= lvl) return 'low'; return 'ok'; };
  var _open = typeof openDialog !== 'undefined' ? openDialog : '';
  var _action = typeof formAction !== 'undefined' && formAction ? formAction : null;
%>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><%= t('navx.sec_stock') %></div>
    <h1><%= t('supplies.title') %></h1>
    <p><%= t('supplies.lead') %></p>
  </div>
  <div class="page-actions">
    <% if (tab === 'items' && summary.count) { %><%- include('../../../partials/export-menu', { href: '/app/supplies/export' }) %><% } %>
    <a class="btn btn-secondary" href="/app/supplies/orders"><%- icon('clipboard-list', 'icon-sm') %><%= t('purchasing.orders_link') %></a>
    <% if (canManage && tab === 'items') { %><button class="btn btn-primary" type="button" data-open-dialog="item-dialog" data-reset-form data-action="/app/supplies/items" data-dialog-title="<%= t('supplies.add_item') %>"><%- icon('plus', 'icon-sm') %><%= t('supplies.add_item') %></button><% } %>
    <% if (canManage && tab === 'suppliers') { %><button class="btn btn-primary" type="button" data-open-dialog="supplier-dialog" data-reset-form data-action="/app/supplies/suppliers" data-dialog-title="<%= t('supplies.add_supplier') %>"><%- icon('plus', 'icon-sm') %><%= t('supplies.add_supplier') %></button><% } %>
  </div>
</div>

<% if (summary.low && !lowOnly) { %>
<div class="alert alert-warning mb-4" role="status"><%- icon('triangle-alert') %><div class="grow"><div class="alert-title"><%= t('supplies.low_banner', { n: fmt.number(summary.low) }) %></div><div class="small"><%= t('supplies.low_banner_text') %></div></div><div class="row-sm wrap"><a class="btn btn-secondary btn-sm" href="/app/supplies?low=yes"><%= t('supplies.show_low') %></a><% if (canManage) { %><form method="post" action="/app/supplies/orders/low-stock" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" type="submit"><%- icon('clipboard-list', 'icon-sm') %><%= t('purchasing.order_low_short') %></button></form><% } %></div></div>
<% } %>

<div class="stats ops-stats">
  <div class="stat"><div class="stat-label"><%= t('supplies.items_count') %><span class="stat-icon"><%- icon('package') %></span></div><div class="stat-value"><%= fmt.number(summary.count) %></div><div class="stat-meta"><%= t('supplies.suppliers_count', { n: fmt.number(suppliers.length) }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('supplies.low_stock') %><span class="stat-icon"><%- icon('triangle-alert') %></span></div><div class="stat-value<%= summary.low ? ' ops-warn' : '' %>"><%= fmt.number(summary.low) %></div><div class="stat-meta"><%= t('supplies.at_or_below') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('supplies.out_of_stock') %><span class="stat-icon"><%- icon('circle-x') %></span></div><div class="stat-value<%= summary.out ? ' ops-danger' : '' %>"><%= fmt.number(summary.out) %></div><div class="stat-meta"><%= t('supplies.zero_left') %></div></div>
  <% if (showCost) { %><div class="stat"><div class="stat-label"><%= t('supplies.stock_value') %><span class="stat-icon"><%- icon('coins') %></span></div><div class="stat-value"><%= fmt.money(summary.value) %></div><div class="stat-meta"><%= t('supplies.stock_value_hint') %></div></div><% } %>
</div>

<nav class="tabs mt-6" aria-label="<%= t('supplies.title') %>">
  <a href="/app/supplies" class="<%= tab === 'items' ? 'active' : '' %>"<%= tab === 'items' ? ' aria-current="page"' : '' %>><%- icon('package', 'icon-sm') %><%= t('supplies.tab_items') %> <span class="count"><%= fmt.number(summary.count) %></span></a>
  <a href="/app/supplies?tab=suppliers" class="<%= tab === 'suppliers' ? 'active' : '' %>"<%= tab === 'suppliers' ? ' aria-current="page"' : '' %>><%- icon('building-2', 'icon-sm') %><%= t('supplies.tab_suppliers') %> <span class="count"><%= fmt.number(suppliers.length) %></span></a>
</nav>

<% if (tab === 'items') { %>
<div class="panel flush mt-4">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('supplies.search') %>" aria-label="<%= t('common.search') %>"></div>
    <% if (suppliers.length) { %><select class="select" name="supplier" aria-label="<%= t('supplies.supplier') %>"><option value="all"><%= t('supplies.all_suppliers') %></option><% suppliers.forEach(function (s) { %><option value="<%= s.id %>"<%= String(query.supplier) === String(s.id) ? ' selected' : '' %>><%= s.name %></option><% }) %></select><% } %>
    <label class="check low-toggle"><input type="checkbox" name="low" value="yes"<%= lowOnly ? ' checked' : '' %>><span><%= t('supplies.low_only') %></span></label>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.apply') %></button></noscript>
    <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="/app/supplies"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
  </form>
  <% if (!rows.length) { %>
    <% if (filtered) { %>
      <%- include('../../../partials/empty', { emptyIcon: lowOnly ? 'circle-check' : 'filter', emptyTitle: lowOnly && !query.q ? t('supplies.no_low') : t('table.no_matches'), emptyText: '', emptyAction: '<a class="btn btn-secondary btn-sm" href="/app/supplies">' + t('table.clear_filters') + '</a>' }) %>
    <% } else { %>
      <%- include('../../../partials/empty', { emptyIcon: 'package', emptyTitle: t('supplies.empty_title'), emptyText: t('supplies.empty_text'), emptyAction: canManage ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="item-dialog" data-reset-form>' + t('supplies.add_item') + '</button>' : '' }) %>
    <% } %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th><%= t('supplies.item') %></th><th><%= t('supplies.supplier') %></th><th class="stock-col"><%= t('supplies.stock_level') %></th><th class="num"><%= t('supplies.reorder_level') %></th><% if (showCost) { %><th class="num"><%= t('supplies.unit_cost') %> (<%= currency %>)</th><% } %><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { var lv = level(r); var cur = Number(r.current_stock), lvl = Number(r.reorder_level); var scale = Math.max(cur, lvl * 2, 1); %>
        <tr>
          <td class="primary-cell item-cell"><a class="strong" href="/app/supplies/items/<%= r.id %>"><%= r.name %></a><div class="tiny muted"><%= r.unit || '—' %></div></td>
          <td data-label="<%= t('supplies.supplier') %>"><%= supplierName[r.supplier_id] || '—' %></td>
          <td data-label="<%= t('supplies.stock_level') %>" class="stock-col">
            <div class="stock-cell">
              <div class="stock-top"><span class="strong"><%= fmt.number(cur) %></span> <span class="tiny muted"><%= r.unit || '' %></span>
                <% if (lv === 'out') { %><span class="badge badge-danger"><%= t('supplies.level.out') %></span><% } else if (lv === 'low') { %><span class="badge badge-warning"><%= t('supplies.level.low') %></span><% } %></div>
              <div class="stock-bar <%= lv %>" role="img" aria-label="<%= t('supplies.bar_label', { cur: fmt.number(cur), lvl: fmt.number(lvl) }) %>"><span style="width:<%= Math.min(100, cur / scale * 100).toFixed(1) %>%"></span><% if (lvl > 0) { %><i style="inset-inline-start:<%= Math.min(100, lvl / scale * 100).toFixed(1) %>%"></i><% } %></div>
            </div>
          </td>
          <td class="num" data-label="<%= t('supplies.reorder_level') %>"><%= fmt.number(lvl) %></td>
          <% if (showCost) { %><td class="num" data-label="<%= t('supplies.unit_cost') %>"><%= fmt.amount(r.unit_cost) %></td><% } %>
          <td class="actions">
            <% if (canManage) { %>
              <button class="btn btn-secondary btn-icon btn-sm" aria-label="<%= t('supplies.move') %>" title="<%= t('supplies.move') %>" type="button" data-open-dialog="move-dialog" data-action="/app/supplies/items/<%= r.id %>/move" data-fill="<%= json({ _item_label: r.name, _item_stock: fmt.number(cur) + ' ' + (r.unit || ''), type: 'in' }) %>"><%- icon('arrow-up-down', 'icon-sm') %></button>
              <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" title="<%= t('common.edit') %>" data-open-dialog="item-dialog" data-action="/app/supplies/items/<%= r.id %>" data-dialog-title="<%= t('supplies.edit_item') %>" data-fill="<%= json({ name: r.name, unit: r.unit, supplier_id: r.supplier_id, current_stock: Number(r.current_stock), reorder_level: Number(r.reorder_level), unit_cost: Number(r.unit_cost) }) %>"><%- icon('pencil', 'icon-sm') %></button>
            <% } %>
            <a class="btn btn-ghost btn-icon btn-sm" href="/app/supplies/items/<%= r.id %>" aria-label="<%= t('supplies.history') %>" title="<%= t('supplies.history') %>"><%- icon('history', 'icon-sm') %></a>
            <% if (canManage) { %><%- include('../../../partials/delete-form', { action: '/app/supplies/items/' + r.id + '/delete', confirmText: t('supplies.delete_item_confirm', { name: r.name }) }) %><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../../partials/pagination', { meta: meta }) %>
  <% } %>
</div>
<% } else { %>
<div class="panel flush mt-4">
  <% if (!suppliers.length) { %>
    <%- include('../../../partials/empty', { emptyIcon: 'building-2', emptyTitle: t('supplies.no_suppliers'), emptyText: t('supplies.no_suppliers_text'), emptyAction: canManage ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="supplier-dialog" data-reset-form>' + t('supplies.add_supplier') + '</button>' : '' }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th><%= t('supplies.supplier') %></th><th><%= t('common.phone') %></th><th><%= t('common.email') %></th><th class="num"><%= t('supplies.items_count') %></th><th><%= t('common.status') %></th><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody>
        <% suppliers.forEach(function (s) { %>
        <tr>
          <td class="primary-cell"><div class="strong"><%= s.name %></div><% if (s.notes) { %><div class="tiny muted truncate" style="max-width:340px"><%= s.notes %></div><% } %></td>
          <td data-label="<%= t('common.phone') %>"><% if (s.phone) { %><a class="link" dir="ltr" href="tel:<%= s.phone.replace(/[^0-9+]/g, '') %>"><%= s.phone %></a><% } else { %>—<% } %></td>
          <td data-label="<%= t('common.email') %>"><% if (s.email) { %><a class="link" href="mailto:<%= s.email %>"><%= s.email %></a><% } else { %>—<% } %></td>
          <td class="num" data-label="<%= t('supplies.items_count') %>"><% if (s.items) { %><a class="link" href="/app/supplies?supplier=<%= s.id %>"><%= fmt.number(s.items) %></a><% } else { %>0<% } %></td>
          <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= s.is_active ? 'badge-success' : 'badge-neutral' %>"><%= s.is_active ? t('common.active') : t('common.inactive') %></span></td>
          <td class="actions">
            <% if (canManage) { %>
              <a class="btn btn-ghost btn-icon btn-sm" href="/app/supplies/orders/new?supplier=<%= s.id %>" aria-label="<%= t('purchasing.new_for_supplier') %>" title="<%= t('purchasing.new_for_supplier') %>"><%- icon('clipboard-plus', 'icon-sm') %></a>
              <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" title="<%= t('common.edit') %>" data-open-dialog="supplier-dialog" data-action="/app/supplies/suppliers/<%= s.id %>" data-dialog-title="<%= t('supplies.edit_supplier') %>" data-fill="<%= json({ name: s.name, email: s.email, phone: s.phone, notes: s.notes, is_active: !!s.is_active }) %>"><%- icon('pencil', 'icon-sm') %></button>
              <% if (s.items) { %><button class="btn btn-ghost btn-icon btn-sm" type="button" disabled aria-label="<%= t('common.delete') %>" title="<%= t('errors_ops.SUPPLIER_IN_USE', { n: s.items }) %>"><%- icon('trash-2', 'icon-sm') %></button>
              <% } else { %><%- include('../../../partials/delete-form', { action: '/app/supplies/suppliers/' + s.id + '/delete', confirmText: t('supplies.delete_supplier_confirm', { name: s.name }) }) %><% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<% } %>

<% if (canManage) { %>
<%- include('_dialogs', { from: 'list', newItem: tab === 'items' }) %>
<dialog class="dialog" id="supplier-dialog"<% if (tab === 'suppliers') { %> data-new-dialog<% } %> aria-labelledby="supplier-dialog-title"<% if (_open === 'supplier-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="<%= _open === 'supplier-dialog' && _action ? _action : '/app/supplies/suppliers' %>" novalidate>
    <div class="dialog-head"><h2 id="supplier-dialog-title" data-dialog-title-target><%= _open === 'supplier-dialog' && _action && _action !== '/app/supplies/suppliers' ? t('supplies.edit_supplier') : t('supplies.add_supplier') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (_open === 'supplier-dialog') { %><%- include('../../../partials/form-error') %><% } %>
      <div class="form-grid">
        <%- include('../../../partials/field', { name: 'name', label: t('supplies.supplier_name'), required: true, cls: 'full', errors: _open === 'supplier-dialog' ? errors : {} }) %>
        <%- include('../../../partials/field', { name: 'phone', label: t('common.phone'), type: 'tel', attrs: 'dir="ltr"', errors: _open === 'supplier-dialog' ? errors : {} }) %>
        <%- include('../../../partials/field', { name: 'email', label: t('common.email'), type: 'email', attrs: 'dir="ltr"', help: t('supplies.email_help'), errors: _open === 'supplier-dialog' ? errors : {} }) %>
        <%- include('../../../partials/field', { name: 'notes', label: t('common.notes'), type: 'textarea', cls: 'full', errors: _open === 'supplier-dialog' ? errors : {} }) %>
        <label class="check"><input type="checkbox" name="is_active" value="1"<%= _open === 'supplier-dialog' && typeof old !== 'undefined' && old && !old.is_active ? '' : ' checked' %>><span><%= t('common.active') %></span></label>
      </div>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
<% } %>
