<% var d = doctor || {}; var v = function (k, def) { return old[k] !== undefined ? old[k] : (d[k] !== undefined && d[k] !== null ? d[k] : def); }; %>
<div class="page-head">
  <div><div class="breadcrumbs"><a href="/app/doctors"><%= t('nav.doctors') %></a><%- icon('chevron-right', 'flip-rtl') %><%= doctor ? doctor.full_name : t('doctors.add') %></div><h1><%= doctor ? t('doctors.edit') : t('doctors.add') %></h1></div>
</div>
<form method="post" action="<%= doctor ? '/app/doctors/' + doctor.id + '/edit' : '/app/doctors/new' %>" class="stack" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../../partials/form-error') %>
  <div class="panel"><div class="panel-head"><h2><%= t('doctors.section_profile') %></h2><span class="small muted"><%= t('doctors.bilingual_hint') %></span></div>
    <div class="panel-body form-grid">
      <%- include('../../../partials/field', { name: 'full_name', label: t('doctors.name_ar'), required: true, value: v('full_name', ''), attrs: 'dir="rtl"' }) %>
      <%- include('../../../partials/field', { name: 'full_name_en', label: t('doctors.name_en'), value: v('full_name_en', ''), attrs: 'dir="ltr"' }) %>
      <%- include('../../../partials/field', { name: 'specialization', label: t('doctors.specialization_ar'), value: v('specialization', ''), attrs: 'dir="rtl"' }) %>
      <%- include('../../../partials/field', { name: 'specialization_en', label: t('doctors.specialization_en'), value: v('specialization_en', ''), attrs: 'dir="ltr"' }) %>
      <%- include('../../../partials/field', { name: 'bio', label: t('doctors.bio_ar'), type: 'textarea', value: v('bio', '') }) %>
      <%- include('../../../partials/field', { name: 'bio_en', label: t('doctors.bio_en'), type: 'textarea', value: v('bio_en', '') }) %>
      <%- include('../../../partials/field', { name: 'education', label: t('doctors.education_ar'), type: 'textarea', value: v('education', '') }) %>
      <%- include('../../../partials/field', { name: 'education_en', label: t('doctors.education_en'), type: 'textarea', value: v('education_en', '') }) %>
      <%- include('../../../partials/field', { name: 'phone', label: t('common.phone'), type: 'tel', value: v('phone', '') }) %>
      <%- include('../../../partials/field', { name: 'whatsapp', label: t('doctors.whatsapp'), type: 'tel', value: v('whatsapp', '') }) %>
      <%- include('../../../partials/field', { name: 'email', label: t('common.email'), type: 'email', value: v('email', '') }) %>
      <%- include('../../../partials/field', { name: 'license_number', label: t('doctors.license'), value: v('license_number', '') }) %>
    </div></div>
  <div class="panel"><div class="panel-head"><h2><%= t('doctors.section_booking') %></h2></div>
    <div class="panel-body form-grid cols-3">
      <%- include('../../../partials/field', { name: 'consultation_fee', label: t('doctors.fee'), value: v('consultation_fee', 0), suffix: currency, attrs: 'inputmode="decimal"' }) %>
      <%- include('../../../partials/field', { name: 'slot_duration_minutes', label: t('doctors.slot'), value: v('slot_duration_minutes', 30), suffix: t('common.minutes'), attrs: 'inputmode="numeric"', help: t('doctors.slot_help') }) %>
      <%- include('../../../partials/field', { name: 'base_salary', label: t('doctors.base_salary'), value: v('base_salary', 0), suffix: currency, attrs: 'inputmode="decimal"' }) %>
      <%- include('../../../partials/field', { name: 'sort_order', label: t('doctors.sort_order'), value: v('sort_order', 0), attrs: 'inputmode="numeric"' }) %>
      <div class="field"><label class="label" for="f-color"><%= t('doctors.color') %></label><input class="color-input" id="f-color" type="color" name="color" value="<%= v('color', '') || '#0e7c6b' %>"></div>
      <div class="stack-sm" style="justify-content:flex-end">
        <label class="check"><input type="checkbox" name="is_active" value="1"<%= v('is_active', true) && v('is_active', true) !== '0' ? ' checked' : '' %>><span><%= t('doctors.active') %></span></label>
        <label class="check"><input type="checkbox" name="show_consultation_fee" value="1"<%= v('show_consultation_fee', true) && v('show_consultation_fee', true) !== '0' ? ' checked' : '' %>><span><%= t('doctors.show_fee') %></span></label>
      </div>
    </div></div>
  <div class="panel flush"><div class="panel-head"><div><h2><%= t('doctors.schedule') %></h2><div class="panel-sub"><%= t('doctors.schedule_help') %></div></div></div>
    <div class="table-wrap"><table class="table responsive">
      <thead><tr><th><%= t('doctors.day') %></th><th><%= t('doctors.shift1') %></th><th><%= t('doctors.shift2') %></th><th><%= t('doctors.break') %></th></tr></thead>
      <tbody><% days.forEach(function (k) { var day = wh[k] || {}; var sh = day.shifts || (day.start ? [{ start: day.start, end: day.end }] : []); var br = (day.breaks || [])[0] || {}; var on = day.enabled !== false && sh.length > 0; %>
        <tr>
          <td class="primary-cell"><label class="check"><input type="checkbox" name="wh[<%= k %>][enabled]" value="1"<%= on ? ' checked' : '' %>><span class="strong"><%= t('days.' + k) %></span></label></td>
          <td data-label="<%= t('doctors.shift1') %>"><div class="row-sm"><input class="input" type="time" name="wh[<%= k %>][s1]" value="<%= (sh[0] || {}).start || '' %>" aria-label="<%= t('common.from') %>"><span class="muted">–</span><input class="input" type="time" name="wh[<%= k %>][e1]" value="<%= (sh[0] || {}).end || '' %>" aria-label="<%= t('common.to') %>"></div></td>
          <td data-label="<%= t('doctors.shift2') %>"><div class="row-sm"><input class="input" type="time" name="wh[<%= k %>][s2]" value="<%= (sh[1] || {}).start || '' %>" aria-label="<%= t('common.from') %>"><span class="muted">–</span><input class="input" type="time" name="wh[<%= k %>][e2]" value="<%= (sh[1] || {}).end || '' %>" aria-label="<%= t('common.to') %>"></div></td>
          <td data-label="<%= t('doctors.break') %>"><div class="row-sm"><input class="input" type="time" name="wh[<%= k %>][bs]" value="<%= br.start || '' %>" aria-label="<%= t('common.from') %>"><span class="muted">–</span><input class="input" type="time" name="wh[<%= k %>][be]" value="<%= br.end || '' %>" aria-label="<%= t('common.to') %>"></div></td>
        </tr>
      <% }) %></tbody>
    </table></div>
  </div>
  <div class="form-actions"><a class="btn btn-ghost" href="<%= doctor ? '/app/doctors/' + doctor.id : '/app/doctors' %>"><%= t('common.cancel') %></a><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
</form>
