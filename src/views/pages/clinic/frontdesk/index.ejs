<%
  /* Reception board: Expected → Arrived → With the doctor. Payment is not shown here (paid / to pay live on the cash
     screen, invoices and accounts): a visit the doctor has finished leaves the board. One main action per patient;
     the rest sits in a "⋯" menu. Live: live.js reloads the board ([data-auto-refresh]) when the agenda changes. */
  var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
  var canPay = can('billing.manage');
  var canBook = can('appointments.manage');
  var canVisit = canAny('clinical.view', 'vitals.edit', 'frontdesk.use');
  var filterInput = doctor ? '<input type="hidden" name="doctor_filter" value="' + escapeHtml(doctor) + '">' : '';
  var post = function (id, path, label, iconName, cls, onVal, confirmMsg) {
    return '<form method="post" action="/app/front-desk/' + id + '/' + path + '"' + (confirmMsg ? ' data-confirm="' + escapeHtml(confirmMsg) + '" data-confirm-title="' + escapeHtml(label) + '" data-confirm-yes="' + escapeHtml(label) + '"' : '') + '>'
      + '<input type="hidden" name="_csrf" value="' + csrfToken + '">' + filterInput + (onVal !== undefined ? '<input type="hidden" name="on" value="' + onVal + '">' : '')
      + '<button class="' + cls + '" type="submit">' + icon(iconName, 'icon-sm') + '<span>' + escapeHtml(label) + '</span></button></form>';
  };
  var main = function (id, path, label, iconName, onVal) { return post(id, path, label, iconName, 'btn btn-secondary fx-main', onVal); };
  var item = function (id, path, label, iconName, onVal, confirmMsg) { return post(id, path, label, iconName, '', onVal, confirmMsg); };
  var cols = [
    { key: 'expected', items: group.expected },
    { key: 'arrived', items: group.arrived },
    { key: 'with_doctor', items: group.with_doctor },
  ];
  var finished = group.ready.length + group.paid.length; // visits the doctor has finished today (no payment state here)
  var total = cols.reduce(function (s, c) { return s + c.items.length; }, 0);
%>
<div class="page-head fx-head" data-auto-refresh="60">
  <div>
    <h1><%= t('frontdesk.title') %></h1>
    <p><%= fmt.date(clinicToday, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %> · <span class="muted"><%= t('cashx.board_live') %></span></p>
  </div>
  <div class="page-actions">
    <% if (canPay) { %><a class="btn btn-secondary" href="/app/cashier/screen?fs=1"><%- icon('maximize', 'icon-sm') %><%= t('cashx.open_screen') %></a><% } %>
    <% if (canBook) { %><button class="btn btn-primary" type="button" data-open-dialog="fx-walkin"><%- icon('user-plus', 'icon-sm') %><%= t('cashx.walkin') %></button><% } %>
  </div>
</div>

<div class="fx-bar panel">
  <nav class="fx-flow" aria-label="<%= t('cashx.flow_label') %>">
    <% cols.forEach(function (c, i) { %><a class="fx-step" href="#fx-<%= c.key %>"><span class="fx-step-n num"><%= fmt.number(c.items.length) %></span><span class="fx-step-l"><%= t('cashx.col.' + c.key) %></span></a><% if (i < cols.length - 1) { %><%- icon('chevron-right', 'icon-sm fx-step-arrow flip-rtl') %><% } %><% }) %>
  </nav>
  <% if (!ownDoctor && doctors.length > 1) { %>
  <form class="fx-filter" method="get" action="/app/front-desk" data-autosubmit>
    <label class="sr-only" for="fx-doctor"><%= t('common.doctor') %></label>
    <select class="select" id="fx-doctor" name="doctor">
      <option value=""><%= t('common.all_doctors') %></option>
      <% doctors.forEach(function (d) { %><option value="<%= d.id %>"<%= String(doctor) === String(d.id) ? ' selected' : '' %>><%= L(d.full_name, d.full_name_en) %></option><% }) %>
      <option value="none"<%= doctor === 'none' ? ' selected' : '' %>><%= t('appointments.unassigned') %></option>
    </select>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.apply') %></button></noscript>
  </form>
  <% } %>
  <div class="fx-done small"><span class="muted"><%= t('frontdesk.finished_today') %></span> <strong class="num"><%= fmt.number(finished) %></strong><% if (canPay && finished) { %> · <a class="link" href="/app/cashier/screen"><%= t('frontdesk.to_cash') %></a><% } %></div>
</div>

<% if (!total && !group.missed.length && !finished) { %>
<div class="panel mt-4"><div class="panel-body"><%- include('../../../partials/empty', { emptyIcon: 'calendar-days', emptyTitle: t('cashx.board_empty_title'), emptyText: t('cashx.board_empty_text'), emptyAction: canBook ? '<button class="btn btn-secondary" type="button" data-open-dialog="fx-walkin">' + icon('user-plus', 'icon-sm') + escapeHtml(t('cashx.walkin')) + '</button>' : '' }) %></div></div>
<% } else { %>
<div class="fx-board">
  <% cols.forEach(function (c) { %>
  <section class="fx-col" id="fx-<%= c.key %>" aria-labelledby="fx-h-<%= c.key %>">
    <header class="fx-col-head"><i class="cx-sdot is-<%= c.key %>" aria-hidden="true"></i><h2 id="fx-h-<%= c.key %>"><%= t('cashx.col.' + c.key) %></h2><span class="fx-count num"><%= fmt.number(c.items.length) %></span></header>
    <div class="fx-col-body">
      <% if (!c.items.length) { %><p class="fx-empty"><%= t('cashx.empty.' + c.key) %></p><% } %>
      <% c.items.forEach(function (a) {
        var action = ''; var more = []; var meta = ''; var flag = '';
        var online = a.appointment_type === 'online';
        if (c.key === 'expected') {
          if (online) {
            action = onlineLinks[a.id] ? '<button class="btn btn-secondary fx-main" type="button" data-tele-copy="' + escapeHtml(onlineLinks[a.id]) + '" title="' + escapeHtml(t('telehealth.staff.copied_hint')) + '">' + icon('copy', 'icon-sm') + '<span>' + escapeHtml(t('telehealth.staff.copy')) + '</span></button>' : '';
            if (canVisit) more.push('<a href="/app/visits/' + a.id + '#online">' + icon('video', 'icon-sm') + escapeHtml(t('telehealth.staff.go_video')) + '</a>');
          } else action = main(a.id, 'check-in', t('cashx.do.check_in'), 'user-check', 1);
          if (a.appointment_time < nowTime) flag = '<span class="fx-flag is-late">' + escapeHtml(t('frontdesk.late')) + '</span>';
          if (a.patient_phone && canBook) more.push('<a href="/app/messaging/wa/' + a.id + '" target="_blank" rel="noopener">' + icon('message-circle', 'icon-sm') + escapeHtml(t('messaging.wa_send')) + '</a>');
          more.push(item(a.id, 'no-show', t('frontdesk.no_show'), 'user-x', undefined, t('frontdesk.no_show_confirm', { name: a.patient_name })));
        } else if (c.key === 'arrived') {
          meta = a.waited !== null && a.waited !== undefined && a.arrived_at ? t('cashx.waiting_for', { n: a.waited }) : '';
          if (a.waited >= 30) flag = '<span class="fx-flag is-late">' + escapeHtml(t('cashx.waiting_long')) + '</span>';
          action = a.doctor_id ? main(a.id, 'call-in', t('cashx.do.send_in'), 'door-open', 1) : '<a class="btn btn-secondary fx-main" href="/app/appointments/' + a.id + '/edit?return=%2Fapp%2Ffront-desk">' + icon('stethoscope', 'icon-sm') + '<span>' + escapeHtml(t('cashx.do.pick_doctor')) + '</span></a>';
          // The nurse takes vital signs while the patient waits (the visit screen's vitals panel).
          if (canVisit && can('vitals.edit')) more.push('<a href="/app/visits/' + a.id + '#vitals">' + icon('heart-pulse', 'icon-sm') + escapeHtml(t('frontdesk.take_vitals')) + '</a>');
          more.push(item(a.id, 'check-in', t('cashx.do.undo_check_in'), 'refresh-cw', 0));
        } else if (c.key === 'with_doctor') {
          meta = a.called_at ? t('cashx.in_room_for', { n: a.inRoom || 0 }) : '';
          action = '<span class="fx-wait">' + icon('stethoscope', 'icon-sm') + escapeHtml(t('cashx.with_doctor_now')) + '</span>';
          more.push(item(a.id, 'call-in', t('frontdesk.back_to_waiting'), 'refresh-cw', 0));
        }
        if (canVisit) more.push('<a href="/app/visits/' + a.id + '">' + icon('file-text', 'icon-sm') + escapeHtml(t('cashx.open_visit')) + '</a>');
      %>
      <article class="fx-card is-<%= c.key %>">
        <div class="fx-card-top">
          <span class="fx-time num" dir="ltr"><%= a.appointment_time %></span>
          <% if (a.status === 'pending') { %><span class="st"><i class="st-dot st-pending"></i><%= t('appointments.statuses.pending') %></span><% } %>
          <% if (online) { %><span class="fd-tag"><%- icon('monitor', 'icon-sm') %><%= t('appointments.types.online') %></span><% } %>
          <%- flag %>
        </div>
        <div class="fx-name"><% if (canVisit) { %><a href="/app/visits/<%= a.id %>"><bdi><%= a.patient_name %></bdi></a><% } else { %><bdi><%= a.patient_name %></bdi><% } %></div>
        <div class="fx-meta"><% if (a.doctor_id) { %><span class="doc-dot" aria-hidden="true"<% if (a.doctor_color) { %> style="background:<%= a.doctor_color %>"<% } %>></span><%= L(a.doctor_name, a.doctor_name_en) %><% } else { %><%= t('appointments.unassigned') %><% } %><% if (a.service_name) { %> · <%= L(a.service_name, a.service_name_en) %><% } %></div>
        <% if (meta) { %><div class="fx-sub"><%= meta %></div><% } %>
        <div class="fx-actions">
          <%- action %>
          <% if ((a.rxs && a.rxs.length) || (a.certs && a.certs.length)) { %><%- include('../cashier/_papers', { v: a, menuUp: false }) %><% } %>
          <% if (more.length) { %>
          <details class="dropdown fx-more">
            <summary class="btn btn-ghost btn-icon btn-sm" aria-label="<%= t('cashx.more_actions') %> — <%= a.patient_name %>" title="<%= t('cashx.more_actions') %>"><%- icon('ellipsis', 'icon-sm') %></summary>
            <div class="menu" role="menu"><%- more.join('') %></div>
          </details>
          <% } %>
        </div>
      </article>
      <% }) %>
    </div>
  </section>
  <% }) %>
</div>
<% } %>

<% if (group.missed.length) { %>
<details class="panel fd-missed mt-4">
  <summary class="panel-head"><h2><%- icon('calendar-x', 'icon-sm') %> <%= t('frontdesk.missed') %> <span class="badge"><%= fmt.number(group.missed.length) %></span></h2><%- icon('chevron-down', 'icon-sm muted') %></summary>
  <ul class="action-list">
    <% group.missed.forEach(function (a) { %>
    <li><div><span class="small strong" dir="ltr" style="min-width:48px"><%= a.appointment_time %></span><div class="grow"><div class="strong"><%= a.patient_name %></div><div class="small muted"><%= a.doctor_id ? L(a.doctor_name, a.doctor_name_en) : t('appointments.unassigned') %></div></div><span class="st"><i class="st-dot st-<%= a.status %>"></i><%= t('appointments.statuses.' + a.status) %></span><%- post(a.id, 'restore', t('frontdesk.restore'), 'refresh-cw', 'btn btn-ghost btn-sm') %></div></li>
    <% }) %>
  </ul>
</details>
<% } %>

<% if (canBook) { %>
<dialog class="dialog" id="fx-walkin" aria-labelledby="fx-walkin-h">
  <form method="post" action="/app/front-desk/walk-in">
    <div class="dialog-head"><div><h2 id="fx-walkin-h"><%= t('cashx.walkin') %></h2><p class="small muted"><%= t('cashx.walkin_help') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <%- include('../../../partials/field', { name: 'patient_name', id: 'fx-wi-name', label: t('cashx.walkin_name'), required: true, attrs: 'autocomplete="off" maxlength="190"' }) %>
        <%- include('../../../partials/field', { name: 'patient_phone', id: 'fx-wi-phone', label: t('cashx.walkin_phone'), required: true, type: 'tel', attrs: 'autocomplete="off" dir="ltr" inputmode="tel" maxlength="40"' }) %>
        <% if (walkInDoctors.length) { %>
        <%- include('../../../partials/field', { name: 'doctor_id', id: 'fx-wi-doctor', label: t('common.doctor'), type: 'select', required: true, value: doctor && doctor !== 'none' ? doctor : walkInDoctors[0].id, options: walkInDoctors.map(function (d) { return { value: d.id, label: L(d.full_name, d.full_name_en) }; }), attrs: '' }) %>
        <% } else { %><p class="help full"><%= t('cashx.walkin_no_doctor') %></p><% } %>
      </div>
      <p class="small mt-2"><a class="link" href="/app/appointments/new?date=today&return=%2Fapp%2Ffront-desk"><%= t('cashx.walkin_more') %></a></p>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"<%= walkInDoctors.length ? '' : ' disabled' %>><%- icon('user-check', 'icon-sm') %><%= t('cashx.walkin_submit') %></button></div>
  </form>
</dialog>
<% } %>

<% if (canPay) { %>
<dialog class="dialog cx-dialog" id="cx-pay-dialog" aria-label="<%= t('cashx.panel_title') %>" data-cx-dialog<% if (typeof panel !== 'undefined' && panel) { %> data-open-on-load<% } %>>
  <div class="dialog-inner" data-cx-dialog-body><% if (typeof panel !== 'undefined' && panel) { %><%- include('../cashier/_panel', panel) %><% } %></div>
</dialog>
<% } %>
<% if (typeof done !== 'undefined' && done) { %>
<dialog class="dialog cx-dialog cx-done-dialog" id="cx-done-dialog" data-open-on-load data-cx-done>
  <div class="dialog-inner"><%- include('../cashier/_done', { done: done }) %></div>
</dialog>
<% } %>
<script type="application/json" id="cx-texts"><%- json({ loading: t('cashx.loading'), failed: t('cashx.panel_failed') }) %></script>
