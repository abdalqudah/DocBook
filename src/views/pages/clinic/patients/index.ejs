<% var P = '../../../partials/'; var canCreate = can('patients.create'); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><%= t('navx.sec_patients') %></div>
    <h1><%= t('patients.title') %></h1>
    <p><%= ctx.ownDoctorId ? t('patients.lead_doctor') : t('patients.lead') %></p>
  </div>
  <div class="page-actions">
    <%- include(P + 'export-menu', { href: '/app/patients/export', more: (can('patients.view') ? [{ href: '/app/patients/export-all', icon: 'package', label: t('patient_export.bulk.menu') }] : []).concat(can('data.manage') ? [{ href: '/app/import/legacy-clinica', icon: 'archive-restore', label: t('legacy.title') }] : []) }) %>
    <% var _pq = Object.assign({}, query); delete _pq.page; delete _pq.new; _pq.print = '1'; %><a class="btn btn-secondary" href="/app/patients/print?<%= Object.keys(_pq).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(_pq[k]); }).join('&') %>" target="_blank" rel="noopener"><%- icon('printer', 'icon-sm') %><%= t('common.print') %></a>
    <% if (canCreate) { %><button class="btn btn-primary" type="button" data-open-dialog="patient-dialog" data-reset-form><%- icon('user-plus', 'icon-sm') %><%= t('patients.add') %></button><% } %>
  </div>
</div>

<div class="panel flush">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('patients.search') %>" aria-label="<%= t('common.search') %>"></div>
    <select class="select" name="insurance" aria-label="<%= t('patients.insurance') %>">
      <option value="all"><%= t('patients.all_insurance') %></option>
      <option value="none"<%= query.insurance === 'none' ? ' selected' : '' %>><%= t('patients.no_insurance') %></option>
      <% insurance.forEach(function (i) { %><option value="<%= i.id %>"<%= String(query.insurance) === String(i.id) ? ' selected' : '' %>><%= i.name %></option><% }) %>
    </select>
    <select class="select" name="sort" aria-label="<%= t('patients.sort') %>">
      <option value="created"><%= t('patients.sort_newest') %></option>
      <option value="name"<%= query.sort === 'name' ? ' selected' : '' %>><%= t('patients.sort_name') %></option>
      <option value="last"<%= query.sort === 'last' ? ' selected' : '' %>><%= t('patients.sort_last') %></option>
      <option value="file"<%= query.sort === 'file' ? ' selected' : '' %>><%= t('pfilter.sort_file') %></option>
      <option value="dob"<%= query.sort === 'dob' ? ' selected' : '' %>><%= t('pfilter.sort_dob') %></option>
      <option value="visits"<%= query.sort === 'visits' ? ' selected' : '' %>><%= t('pfilter.sort_visits') %></option>
    </select>
    <select class="select" name="dir" aria-label="<%= t('pfilter.direction') %>">
      <option value=""><%= t('pfilter.dir_default') %></option>
      <option value="asc"<%= query.dir === 'asc' ? ' selected' : '' %>><%= t('pfilter.asc') %></option>
      <option value="desc"<%= query.dir === 'desc' ? ' selected' : '' %>><%= t('pfilter.desc') %></option>
    </select>
    <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="/app/patients"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
    <details class="pf-more"<%= advanced ? ' open' : '' %>>
      <summary class="btn btn-secondary btn-sm"><%- icon('filter', 'icon-sm') %><%= t('pfilter.more') %></summary>
      <div class="pf-grid">
        <% var Q = function (k) { return query[k] || ''; };
           var sel = function (name, label, opts, all) { return '<label class="field"><span class="label">' + escapeHtml(label) + '</span><select class="select" name="' + name + '"><option value="">' + escapeHtml(all || t('pfilter.all')) + '</option>' + opts.map(function (o) { return '<option value="' + escapeHtml(String(o.value)) + '"' + (String(Q(name)) === String(o.value) ? ' selected' : '') + '>' + escapeHtml(o.label) + '</option>'; }).join('') + '</select></label>'; };
           var inp = function (name, label, type, attrs) { return '<label class="field"><span class="label">' + escapeHtml(label) + '</span><input class="input" type="' + (type || 'text') + '" name="' + name + '" value="' + escapeHtml(Q(name)) + '" ' + (attrs || '') + '></label>'; };
           var months = []; for (var m = 1; m <= 12; m++) months.push({ value: m, label: new Intl.DateTimeFormat(locale, { month: 'long' }).format(new Date(2026, m - 1, 1)) }); %>
        <%- inp('file', t('pprofile.file_number'), 'text', 'dir="ltr"') %>
        <%- inp('name', t('pfilter.name')) %>
        <%- sel('gender', t('patients.gender'), [{ value: 'male', label: t('patients.genders.male') }, { value: 'female', label: t('patients.genders.female') }]) %>
        <%- inp('mobile', t('pfilter.mobile'), 'tel', 'dir="ltr" inputmode="tel"') %>
        <%- inp('email', t('common.email'), 'text', 'dir="ltr"') %>
        <%- sel('group', t('pprofile.groups'), [{ value: 'none', label: t('pfilter.no_group') }].concat(fl.groups.map(function (g) { return { value: g.id, label: g.name }; }))) %>
        <%- sel('nationality', t('pprofile.nationality'), fl.choices.countries) %>
        <%- inp('note', t('pfilter.note')) %>
        <%- sel('category', t('pprofile.category'), fl.choices.categories) %>
        <%- inp('from', t('pfilter.created_from'), 'date') %>
        <%- inp('to', t('pfilter.created_to'), 'date') %>
        <%- inp('city', t('pfilter.city_area')) %>
        <%- sel('month', t('pfilter.birth_month'), months) %>
        <%- sel('manager', t('pprofile.case_manager'), fl.managers.map(function (u) { return { value: u.id, label: u.name }; })) %>
        <%- sel('referral', t('pprofile.referral_source'), fl.choices.referral) %>
        <%- sel('blood', t('pprofile.blood_group'), fl.choices.blood) %>
        <%- sel('tag', t('pfilter.flags'), [{ value: 'important', label: t('pfilter.flag_important') }, { value: 'allergy', label: t('pfilter.flag_allergy') }, { value: 'discount', label: t('pfilter.flag_discount') }, { value: 'no_reminders', label: t('pfilter.flag_no_reminders') }]) %>
        <%- sel('moved', t('ptransfer.filter_moved'), [{ value: '1', label: t('ptransfer.filter_moved_only') }]) %>
        <div class="pf-actions"><button class="btn btn-primary btn-sm" type="submit"><%- icon('search', 'icon-sm') %><%= t('pfilter.apply') %></button></div>
      </div>
    </details>
  </form>
  <% if (!rows.length) { %>
    <% if (filtered) { %>
      <%- include(P + 'empty', { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: t('patients.no_match_text'), emptyAction: '<a class="btn btn-secondary btn-sm" href="/app/patients">' + t('table.clear_filters') + '</a>' }) %>
    <% } else { %>
      <%- include(P + 'empty', { emptyIcon: 'users', emptyTitle: t('patients.empty_title'), emptyText: ctx.ownDoctorId ? t('patients.empty_doctor') : t('patients.empty_text'), emptyAction: canCreate ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="patient-dialog" data-reset-form>' + t('patients.add') + '</button>' : '' }) %>
    <% } %>
  <% } else { var _tx = transferTargets && transferTargets.length && !movedView;
     var _qs = Object.keys(query).filter(function (k) { return k !== 'page' && typeof query[k] === 'string' && query[k] !== ''; }).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(query[k]); }).join('&'); %>
  <% if (_tx) { %>
  <form id="pt-select" class="pt-bar" method="get" action="/app/patients/transfer" data-transfer-select>
    <span class="small"><%- icon('send', 'icon-sm') %> <%= t('ptransfer.bar', { clinics: transferTargets.map(function (b) { return b.name; }).join('، ') }) %></span>
    <span class="grow"></span>
    <span class="small muted" data-transfer-count data-text="<%= t('ptransfer.selected_n', { n: '{n}' }) %>"><%= t('ptransfer.selected_n', { n: 0 }) %></span>
    <button class="btn btn-primary btn-sm" type="submit" data-transfer-go disabled><%= t('ptransfer.transfer_selected') %></button>
    <a class="btn btn-secondary btn-sm" href="/app/patients/transfer?all=1<%= _qs ? '&' + _qs : '' %>"><%= t('ptransfer.transfer_all', { n: fmt.number(meta.total) }) %></a>
  </form>
  <% } %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><% if (_tx) { %><th class="pt-check"><input type="checkbox" data-transfer-all aria-label="<%= t('ptransfer.select_page') %>"></th><% } %><th><%= t('common.patient') %></th><th><%= t('patients.age_gender') %></th><th><%= t('patients.insurance') %></th><th class="num"><%= t('patients.visits') %></th><th><%= t('patients.last_visit') %></th><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { var age = ageOf(r.date_of_birth); %>
        <tr>
          <% if (_tx) { %><td class="pt-check"><input type="checkbox" name="ids" value="<%= r.id %>" form="pt-select" aria-label="<%= r.full_name %>"></td><% } %>
          <td class="primary-cell"><a class="person" href="/app/patients/<%= r.id %>"><span class="avatar"><%= initials(r.full_name) %></span><span style="min-width:0"><span class="person-name" dir="auto"><%= r.full_name %></span><% if (r.category && r.category !== 'standard') { %> <span class="badge badge-warning"><%= t('pprofile.categories.' + r.category) %></span><% } %><% if (r.important_note) { %> <span class="badge badge-danger" title="<%= r.important_note %>"><%- icon('triangle-alert', 'icon-sm') %>!</span><% } %><% if (r.allergies) { %> <span class="badge badge-danger" title="<%= t('patients.allergies') %>: <%= r.allergies %>"><%- icon('triangle-alert', 'icon-sm') %><%= t('patients.allergy_short') %></span><% } %><span class="person-sub" style="display:block"><% if (r.file_number) { %><span dir="ltr">#<%= r.file_number %></span> · <% } %><span dir="ltr"><%= r.phone || '—' %></span><% if (r.national_id) { %> · <span dir="ltr"><%= r.national_id %></span><% } %></span></span></a></td>
          <td data-label="<%= t('patients.age_gender') %>"><%= [age !== null ? t('patients.years', { n: age }) : null, r.gender ? t('patients.genders.' + r.gender) : null].filter(Boolean).join(' · ') || '—' %></td>
          <td data-label="<%= t('patients.insurance') %>"><% if (r.insurance_name) { %><span class="badge badge-info"><%= r.insurance_name %></span><% if (r.insurance_number) { %> <span class="small muted" dir="ltr"><%= r.insurance_number %></span><% } %><% } else { %><span class="muted">—</span><% } %></td>
          <td data-label="<%= t('patients.visits') %>" class="num"><%= fmt.number(r.visits) %></td>
          <td data-label="<%= t('patients.last_visit') %>" class="nowrap"><%= r.last_visit ? fmt.date(r.last_visit) : '—' %><% if (r.next_visit) { %><div class="tiny muted"><%= t('patients.next_on', { date: fmt.date(r.next_visit) }) %></div><% } %></td>
          <td class="actions">
            <% if (can('appointments.manage')) { %><a class="btn btn-ghost btn-icon btn-sm" href="/app/appointments/new?patient=<%= r.id %>" aria-label="<%= t('patients.book') %>" title="<%= t('patients.book') %>"><%- icon('calendar-plus', 'icon-sm') %></a><% } %>
            <a class="btn btn-ghost btn-icon btn-sm" href="/app/patients/<%= r.id %>" aria-label="<%= t('common.open') %>" title="<%= t('common.open') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include(P + 'pagination', { meta: meta }) %>
  <% } %>
</div>

<% if (canCreate) { %>
<dialog class="dialog wide" id="patient-dialog" data-new-dialog aria-labelledby="patient-dialog-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'patient-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="/app/patients" novalidate>
    <div class="dialog-head"><div><h2 id="patient-dialog-title"><%= t('patients.add') %></h2><p class="panel-sub"><%= t('patients.add_lead') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include(P + 'form-error') %>
      <%- include('_form', { p: null }) %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('patients.save') %></button></div>
  </form>
</dialog>
<% } %>
