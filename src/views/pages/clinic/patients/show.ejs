<% var p = patient; var P = '../../../partials/'; var acc = typeof access !== 'undefined' && access ? access : { clinical: true, reason: 'open' };
   var canClinical = can('clinical.view') && acc.clinical; var restrictedView = can('clinical.view') && !acc.clinical; var canBilling = can('billing.view');
   var dxTitle = typeof icdTitle === 'function' ? icdTitle : function (r) { return r.title_ar || r.title_en || ''; };
   var opened = typeof lastOpened !== 'undefined' && lastOpened ? lastOpened : [];
   var visitHref = function (id) { return can('clinical.view') ? '/app/visits/' + id : '/app/appointments/' + id; };
   var stamp = function (d) { return d ? fmt.date(d) : '—'; }; %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/patients"><%= t('patients.title') %></a><%- icon('chevron-right', 'flip-rtl') %><span dir="auto"><%= p.full_name %></span></div>
    <div class="row rec-head">
      <span class="avatar avatar-lg"><%= initials(p.full_name) %></span>
      <div style="min-width:0">
        <h1 dir="auto"><%= p.full_name %></h1>
        <div class="rec-meta">
          <% if (age !== null) { %><span><%= t('patients.years', { n: age }) %></span><% } %>
          <% if (p.gender) { %><span><%= t('patients.genders.' + p.gender) %></span><% } %>
          <% if (p.phone) { %><a class="link" href="tel:<%= p.phone.replace(/[^\d+]/g, '') %>" dir="ltr"><%- icon('phone', 'icon-sm') %><%= p.phone %></a><% } %>
          <% if (p.insurance_name) { %><span class="badge badge-info"><%- icon('shield-check', 'icon-sm') %><%= p.insurance_name %><% if (p.insurance_number) { %> · <span dir="ltr"><%= p.insurance_number %></span><% } %></span><% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="page-actions">
    <%- include('../../teamops/_email-patient', { part: 'button', mailPatientId: p.id, mailTo: p.email, mailReturn: '/app/patients/' + p.id }) %>
    <% if (wa) { %><a class="btn btn-secondary" href="https://wa.me/<%= wa %>" target="_blank" rel="noopener noreferrer"><%- icon('message-square', 'icon-sm') %><%= t('patients.whatsapp') %></a><% } %>
    <a class="btn btn-secondary" href="/app/patients/<%= p.id %>/summary?print=1" target="_blank" rel="noopener"><%- icon('printer', 'icon-sm') %><%= t('prints.print_file') %></a>
    <% if (can('patients.edit')) { %><a class="btn btn-secondary" href="/app/patients/<%= p.id %>/edit"><%- icon('pencil', 'icon-sm') %><%= t('common.edit') %></a><% } %>
    <% if (can('appointments.manage')) { %><a class="btn btn-primary" href="/app/appointments/new?patient=<%= p.id %>"><%- icon('calendar-plus', 'icon-sm') %><%= t('patients.book') %></a><% } %>
  </div>
</div>

<% var tabHref = function (k) { return '/app/patients/' + p.id + (k === 'overview' ? '' : '?tab=' + k); };
   var tabIcon = { overview: 'user-round', clinical: 'stethoscope', appointments: 'calendar-days', prescriptions: 'pill', orders: 'activity', documents: 'file-text', billing: 'receipt', timeline: 'history' }; %>
<nav class="tabs mb-4 pt-tabs" aria-label="<%= t('patients.workspace') %>">
  <% tabs.forEach(function (k) { %><a href="<%= tabHref(k) %>" class="<%= tab === k ? 'active' : '' %>"<% if (tab === k) { %> aria-current="page"<% } %>><%- icon(tabIcon[k], 'icon-sm') %><%= t('patients.tab.' + k) %></a><% }) %>
</nav>

<% if (p.allergies || p.chronic_conditions) { %>
<div class="grid <%= p.allergies && p.chronic_conditions ? 'grid-2' : '' %> mb-4">
  <% if (p.allergies) { %><div class="alert alert-error" role="note"><%- icon('triangle-alert') %><div class="grow"><div class="alert-title"><%= t('patients.allergies') %></div><div class="rec-pre"><%= p.allergies %></div></div></div><% } %>
  <% if (p.chronic_conditions) { %><div class="alert alert-warning" role="note"><%- icon('heart-pulse') %><div class="grow"><div class="alert-title"><%= t('patients.chronic') %></div><div class="rec-pre"><%= p.chronic_conditions %></div></div></div><% } %>
</div>
<% } %>

<% if (tab === 'overview') { %>
<div class="stats rec-kpis<%= canBilling ? "" : " cols-3" %>">
  <div class="stat"><div class="stat-label"><%= t('patients.visits') %><span class="stat-icon"><%- icon('calendar-check') %></span></div><div class="stat-value"><%= fmt.number(stats.visits) %></div><div class="stat-meta"><%= stats.cancelled ? t('patients.cancelled_n', { n: fmt.number(stats.cancelled) }) : t('patients.completed_visits') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('patients.no_shows') %><span class="stat-icon <%= stats.noShows ? 'danger' : 'info' %>"><%- icon('calendar-x') %></span></div><div class="stat-value"><%= fmt.number(stats.noShows) %></div><div class="stat-meta"><%= stats.visits + stats.noShows ? t('patients.no_show_rate', { pct: fmt.pct(stats.noShows * 100 / (stats.visits + stats.noShows), 0) }) : '—' %></div></div>
  <% if (canBilling) { %>
  <div class="stat"><div class="stat-label"><%= t('patients.total_paid') %><span class="stat-icon"><%- icon('receipt') %></span></div><div class="stat-value"><%= fmt.money(stats.totalPaid) %></div><div class="stat-meta"><%= t('patients.invoices_n', { n: fmt.number(stats.invoices) }) %></div></div>
  <% } %>
  <div class="stat"><div class="stat-label"><%= t('patients.last_visit') %><span class="stat-icon accent"><%- icon('history') %></span></div><div class="stat-value" style="font-size:18px"><%= stats.lastVisit ? fmt.date(stats.lastVisit) : '—' %></div><div class="stat-meta"><%= upcoming.length ? t('patients.next_on', { date: fmt.date(upcoming[0].appointment_date) }) : t('patients.no_upcoming') %></div></div>
</div>

<div class="grid grid-main mt-6">
  <div>
  <div class="panel flush">
    <div class="panel-head"><div><h2><%= t('patients.recent_activity') %></h2><p class="panel-sub"><%= canClinical ? t('patients.timeline_sub') : restrictedView ? t('privacy.timeline_restricted') : t('patients.timeline_sub_basic') %></p></div></div>
    <% if (!timeline.length) { %>
      <%- include(P + 'empty', { compact: true, emptyIcon: 'history', emptyTitle: t('patients.timeline_empty'), emptyText: t('patients.timeline_empty_text'), emptyAction: can('appointments.manage') ? '<a class="btn btn-primary btn-sm" href="/app/appointments/new?patient=' + p.id + '">' + t('patients.book') + '</a>' : '' }) %>
    <% } else { %>
    <%- include('_timeline', { items: timeline.slice(0, 5), visitHref: visitHref, dxTitle: dxTitle, canBilling: canBilling, stamp: stamp }) %>
    <% } %>
    <% if (timeline.length > 5) { %><div class="panel-foot"><a class="link small" href="<%= tabHref('timeline') %>"><%= t('patients.see_timeline', { n: fmt.number(timeline.length) }) %></a></div><% } %>
  </div>
  </div>
  <div class="stack">
    <% if (restrictedView) { %><%- include('../../clinicalplus/_restricted', { acc: acc, patientId: p.id, returnTo: '/app/patients/' + p.id }) %><% } %>
    <% if (acc.reason === 'emergency' && acc.grant) { %><div class="alert alert-warning" role="note"><%- icon('shield-alert') %><div class="grow"><div class="alert-title"><%= t('privacy.bg_active_title') %></div><div class="small"><%= t('privacy.bg_active_text', { when: fmt.date(acc.grant.expires_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) }) %></div></div></div><% } %>
    <% if (upcoming.length) { %>
    <div class="panel flush"><div class="panel-head"><h2><%= t('patients.upcoming') %></h2></div>
      <ul class="action-list"><% upcoming.slice(0, 4).forEach(function (a) { %><li><a href="<%= can('appointments.view') ? '/app/appointments/' + a.id : visitHref(a.id) %>"><span class="action-icon brand"><%- icon('calendar-days') %></span><div class="grow"><div class="strong"><%= fmt.date(a.appointment_date) %> · <span dir="ltr"><%= a.appointment_time %></span></div><div class="small muted"><%= [a.doctor_name, a.service_name].filter(Boolean).join(' · ') %></div></div><span class="badge badge-<%= statusTone[a.status] %>"><%= t('dashboard.statuses.' + a.status) %></span></a></li><% }) %></ul>
    </div>
    <% } %>
    <% if (!restrictedView && (typeof moduleOn !== 'function' || moduleOn('specialty_records'))) { %><%- include('../../specialty/_patient-panel') %><% } %>
    <% if (latestDiagnosis) { %><div class="panel"><div class="panel-body"><div class="small muted strong"><%= t('patients.latest_diagnosis') %></div><div class="mt-1"><%= latestDiagnosis %></div></div></div><% } %>
    <div class="panel"><div class="panel-head"><h2><%= t('patients.details') %></h2></div><div class="panel-body"><dl class="dl rec-dl-narrow">
      <dt><%= t('patients.dob') %></dt><dd><%= p.date_of_birth ? fmt.date(p.date_of_birth) : '—' %></dd>
      <dt><%= t('patients.national_id') %></dt><dd><span dir="ltr"><%= p.national_id || '—' %></span></dd>
      <dt><%= t('common.email') %></dt><dd><% if (p.email) { %><a class="link" href="mailto:<%= p.email %>"><%= p.email %></a><% } else { %>—<% } %></dd>
      <dt><%= t('patients.insurance') %></dt><dd><%= p.insurance_name || t('patients.no_insurance') %><% if (p.insurance_number) { %> · <span dir="ltr"><%= p.insurance_number %></span><% } %></dd>
      <dt><%= t('common.notes') %></dt><dd class="rec-pre"><%= p.notes || '—' %></dd>
      <dt><%= t('patients.registered') %></dt><dd><%= fmt.date(p.created_at) %></dd>
    </dl></div>
    <% if (can('audit.view')) { %><div class="panel-foot cp-opened">
      <div class="row between"><span class="small strong"><%- icon('eye', 'icon-sm') %> <%= t('privacy.last_opened') %></span><a class="link small" href="/app/settings/privacy/log?patient=<%= p.id %>"><%= t('privacy.full_log') %></a></div>
      <% if (!opened.length) { %><p class="tiny muted mt-1"><%= t('privacy.never_opened') %></p><% } else { %>
      <ul class="cp-opened-list"><% opened.forEach(function (o) { %><li><span class="small"><%= o.user_name || '—' %></span><span class="tiny muted"><%= t('privacy.what.' + o.what) %><% if (o.access !== 'full') { %> · <%= t('privacy.level.' + o.access) %><% } %> · <%= fmt.date(o.created_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span></li><% }) %></ul>
      <% } %>
    </div><% } %>
    <% if (can('patients.delete')) { %><div class="panel-foot"><form method="post" action="/app/patients/<%= p.id %>/delete" data-confirm="<%= t('patients.delete_confirm') %>" data-confirm-title="<%= t('patients.delete') %>" data-confirm-yes="<%= t('common.delete') %>" data-confirm-type="<%= p.full_name %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('patients.delete') %></button></form></div><% } %>
    </div>
  </div>
</div>
<% } %>

<% if (tab === 'timeline') { %>
<div class="row-sm wrap mb-4 pt-filter" data-pt-filter role="group" aria-label="<%= t('patients.filter') %>">
  <% ['all', 'visit', 'prescription', 'invoice', 'diagnosis'].forEach(function (k, i) { %><button class="chip<%= i === 0 ? ' is-on' : '' %>" type="button" data-kind="<%= k %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>"><%= t('patients.kind.' + k) %></button><% }) %>
</div>
  <div class="panel flush">
    <div class="panel-head"><div><h2><%= t('patients.timeline') %></h2><p class="panel-sub"><%= canClinical ? t('patients.timeline_sub') : restrictedView ? t('privacy.timeline_restricted') : t('patients.timeline_sub_basic') %></p></div></div>
    <% if (!timeline.length) { %>
      <%- include(P + 'empty', { compact: true, emptyIcon: 'history', emptyTitle: t('patients.timeline_empty'), emptyText: t('patients.timeline_empty_text'), emptyAction: can('appointments.manage') ? '<a class="btn btn-primary btn-sm" href="/app/appointments/new?patient=' + p.id + '">' + t('patients.book') + '</a>' : '' }) %>
    <% } else { %>
    <%- include('_timeline', { items: timeline, visitHref: visitHref, dxTitle: dxTitle, canBilling: canBilling, stamp: stamp }) %>
    <% } %>
  </div>
<% } %>

<% if (tab === 'clinical') { %>
<div class="grid grid-main">
  <div class="stack">
    <% if (restrictedView) { %><%- include('../../clinicalplus/_restricted', { acc: acc, patientId: p.id, returnTo: '/app/patients/' + p.id + '?tab=clinical' }) %>
    <% } else { var cv = timeline.filter(function (e) { return e.kind === 'visit' && (e.consultation || (e.codes && e.codes.length)); }); %>
    <div class="panel flush">
      <div class="panel-head"><div><h2><%= t('patients.clinical_visits') %></h2><p class="panel-sub"><%= t('patients.clinical_visits_sub') %></p></div></div>
      <% if (!cv.length) { %><%- include(P + 'empty', { compact: true, emptyIcon: 'stethoscope', emptyTitle: t('patients.no_clinical'), emptyText: '' }) %>
      <% } else { %><%- include('_timeline', { items: cv, visitHref: visitHref, dxTitle: dxTitle, canBilling: false, stamp: stamp }) %><% } %>
    </div>
    <% } %>
  </div>
  <div class="stack">
    <% if (!restrictedView && (typeof moduleOn !== 'function' || moduleOn('specialty_records'))) { %><%- include('../../specialty/_patient-panel') %><% } %>
    <% if (latestDiagnosis) { %><div class="panel"><div class="panel-body"><div class="small muted strong"><%= t('patients.latest_diagnosis') %></div><div class="mt-1"><%= latestDiagnosis %></div></div></div><% } %>
  </div>
</div>
<% } %>

<% if (tab === 'appointments') { %>
<div class="panel flush">
  <div class="panel-head"><h2><%= t('patients.tab.appointments') %></h2><% if (can('appointments.manage')) { %><a class="btn btn-secondary btn-sm" href="/app/appointments/new?patient=<%= p.id %>"><%- icon('calendar-plus', 'icon-sm') %><%= t('patients.book') %></a><% } %></div>
  <% if (!allAppointments.length) { %><%- include(P + 'empty', { compact: true, emptyIcon: 'calendar-days', emptyTitle: t('patients.timeline_empty'), emptyText: '' }) %>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('common.date') %></th><th><%= t('common.doctor') %></th><th><%= t('common.status') %></th><% if (canBilling) { %><th><%= t('appointments.payment') %></th><% } %><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
    <tbody><% allAppointments.forEach(function (a) { var href = can('appointments.view') ? '/app/appointments/' + a.id : visitHref(a.id); %>
      <tr<%= a.appointment_date >= clinicToday && ['pending', 'confirmed'].indexOf(a.status) !== -1 ? ' class="is-upcoming"' : '' %>>
        <td class="primary-cell nowrap"><a class="strong" href="<%= href %>"><%= a.appointment_date === clinicToday ? t('common.today') : fmt.date(a.appointment_date) %></a> <span class="small muted" dir="ltr"><%= a.appointment_time %></span></td>
        <td data-label="<%= t('common.doctor') %>"><%= a.doctor_name || '—' %><div class="small muted"><%= a.service_name || '' %></div></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-<%= statusTone[a.status] || 'neutral' %>"><%= t('dashboard.statuses.' + a.status) %></span><% if (a.parent_appointment_id) { %> <span class="badge badge-brand"><%= t('patients.follow_up') %></span><% } %></td>
        <% if (canBilling) { %><td data-label="<%= t('appointments.payment') %>"><%= t('appointments.payment_statuses.' + (a.payment_status || 'unpaid')) %></td><% } %>
        <td class="actions"><a class="btn btn-ghost btn-icon btn-sm" href="<%= href %>" aria-label="<%= t('common.open') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</div>
<% } %>

<% if (tab === 'prescriptions') { %>
<div class="panel flush">
  <div class="panel-head"><h2><%= t('patients.tab.prescriptions') %></h2></div>
  <% if (!prescriptions.length) { %><%- include(P + 'empty', { compact: true, emptyIcon: 'pill', emptyTitle: t('patients.no_prescriptions'), emptyText: '' }) %>
  <% } else { %>
  <ul class="action-list">
    <% prescriptions.forEach(function (rx) { var aid = rx.appointment_id || (rx.appt && rx.appt.id); %>
    <li><a href="/app/visits/<%= aid %>/prescriptions/<%= rx.id %>"><span class="action-icon brand"><%- icon('pill', 'icon-sm') %></span><span class="grow"><span class="strong"><%= stamp(rx.created_at) %></span><span class="small muted d-block"><%= (rx.items || []).map(function (i) { return i.medicationName || ''; }).filter(Boolean).join(' · ') %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li>
    <% }) %>
  </ul>
  <% } %>
</div>
<% } %>

<% if (tab === 'orders' && orderTab) { %><%- include('../../orders/_patient-tab', { ot: orderTab }) %><% } %>

<% if (tab === 'documents') { %>
<div class="grid grid-2">
  <% if (can('certificates.view')) { %>
  <div class="panel flush">
    <div class="panel-head"><h2><%= t('nav.certificates') %></h2><% if (can('certificates.issue')) { %><a class="btn btn-secondary btn-sm" href="/app/certificates/new?patient=<%= p.id %>"><%- icon('plus', 'icon-sm') %><%= t('search.actions.new_certificate') %></a><% } %></div>
    <% if (!certificates.length) { %><%- include(P + 'empty', { compact: true, emptyIcon: 'badge-check', emptyTitle: t('patients.no_certificates'), emptyText: '' }) %>
    <% } else { %><ul class="action-list"><% certificates.forEach(function (c) { %>
      <li><a href="/app/certificates/<%= c.id %>"><span class="action-icon"><%- icon('badge-check', 'icon-sm') %></span><span class="grow"><span class="strong"><%= t('certificates.types.' + c.doc_type) %></span> <span class="mono small" dir="ltr"><%= c.serial %></span><span class="small muted d-block"><%= stamp(c.issued_at) %><%= c.doctor_name ? ' · ' + (locale === 'en' && c.doctor_name_en ? c.doctor_name_en : c.doctor_name) : '' %></span></span><% if (c.revoked_at) { %><span class="badge badge-danger"><%= t('patients.revoked') %></span><% } %></a></li>
    <% }) %></ul><% } %>
  </div>
  <% } %>
  <% if (reportVisits.length) { %>
  <div class="panel flush">
    <div class="panel-head"><div><h2><%= t('patients.visit_reports') %></h2><p class="panel-sub"><%= t('patients.visit_reports_sub') %></p></div></div>
    <ul class="action-list"><% reportVisits.forEach(function (a) { %>
      <li><a href="/app/patient-docs/<%= a.id %>/report.pdf" target="_blank" rel="noopener"><span class="action-icon"><%- icon('file-text', 'icon-sm') %></span><span class="grow"><span class="strong"><%= fmt.date(a.appointment_date) %></span><span class="small muted d-block"><%= [a.doctor_name, a.service_name].filter(Boolean).join(' · ') %></span></span><%- icon('download', 'icon-sm muted') %></a></li>
    <% }) %></ul>
  </div>
  <% } %>
</div>
<% } %>

<% if (tab === 'billing') { %>
<div class="stats cols-3 mb-4 rec-kpis">
  <div class="stat"><div class="stat-label"><%= t('patients.total_paid') %></div><div class="stat-value"><%= fmt.money(invoices.reduce(function (s, i) { return s + Number(i.amount || 0); }, 0)) %></div><div class="stat-meta"><%= t('patients.invoices_n', { n: fmt.number(invoices.length) }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('patients.unpaid_visits') %></div><div class="stat-value<%= unpaid.length ? ' ox-attn' : '' %>"><%= fmt.number(unpaid.length) %></div><div class="stat-meta"><%= unpaid.length ? fmt.money(unpaid.reduce(function (s, a) { return s + Number(a.amount_due || 0); }, 0)) : '—' %></div></div>
  <div class="stat"><div class="stat-label"><%= t('patients.insurance') %></div><div class="stat-value" style="font-size:18px"><%= p.insurance_name || t('patients.no_insurance') %></div><div class="stat-meta" dir="ltr"><%= p.insurance_number || '' %></div></div>
</div>
<% if (unpaid.length) { %>
<div class="panel flush mb-4"><div class="panel-head"><h2><%= t('patients.unpaid_visits') %></h2></div>
  <ul class="action-list"><% unpaid.forEach(function (a) { %><li><a href="<%= can('billing.manage') ? '/app/cashier?visit=' + a.id : '/app/appointments/' + a.id %>"><span class="action-icon"><%- icon('banknote', 'icon-sm') %></span><span class="grow"><span class="strong"><%= fmt.date(a.appointment_date) %></span><span class="small muted d-block"><%= [a.doctor_name, a.service_name].filter(Boolean).join(' · ') %></span></span><span class="strong num"><%= fmt.money(a.amount_due) %></span></a></li><% }) %></ul>
</div>
<% } %>
<div class="panel flush"><div class="panel-head"><h2><%= t('billing.invoices') %></h2></div>
  <% if (!invoices.length) { %><%- include(P + 'empty', { compact: true, emptyIcon: 'receipt', emptyTitle: t('patients.no_invoices'), emptyText: '' }) %>
  <% } else { %><ul class="action-list"><% invoices.forEach(function (inv) { %>
    <li><a href="/app/billing/<%= inv.id %>"><span class="action-icon"><%- icon('receipt', 'icon-sm') %></span><span class="grow"><span class="strong"><%= t('billing.invoice_no', { n: inv.invoice_number }) %></span><span class="small muted d-block"><%= stamp(inv.created_at) %> · <%- include('../billing/_payment-lines', { pl: { parts: inv.parts || [{ method: inv.payment_method, amount: inv.amount }], insuranceName: inv.insurance_provider_name, mode: 'text' } }) %></span></span><span class="strong num"><%= fmt.money(inv.amount) %></span></a></li>
  <% }) %></ul><% } %>
</div>
<% } %>
<%- include('../../teamops/_email-patient', { part: 'dialog', mailPatientId: p.id, mailTo: p.email, mailReturn: '/app/patients/' + p.id }) %>
