<% var B = 'patient_export.bulk.';
   var size = function (n) { n = Number(n) || 0; return n >= 1073741824 ? fmt.number(Math.round(n / 107374182.4) / 10) + ' ' + t('media_lib.gb') : n >= 1048576 ? fmt.number(Math.round(n / 104857.6) / 10) + ' ' + t('media_lib.mb') : fmt.number(Math.max(1, Math.round(n / 1024))) + ' ' + t('media_lib.kb'); };
   var run = exports.find(function (x) { return x.state === 'running'; });
   var done = exports.filter(function (x) { return x.state !== 'running'; }); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/patients"><%= t('patients.title') %></a><%- icon('chevron-right', 'flip-rtl') %></div>
    <h1><%= t(B + 'title') %></h1>
    <p><%= t(B + 'lead') %></p>
  </div>
</div>
<div class="grid grid-main">
  <section class="panel">
    <div class="panel-body stack">
      <p class="small muted"><%- icon('clock', 'icon-sm') %> <%= t(B + 'how') %></p>
      <p class="small muted"><%- icon('shield-check', 'icon-sm') %> <%= t(B + 'privacy') %></p>
      <% if (run) { var pct = run.total ? Math.round((run.done || 0) * 100 / run.total) : 0; %>
      <div class="stack-sm" data-export-running data-status="/app/patients/export-all/status" role="status" aria-live="polite">
        <strong data-export-text data-text-running="<%= t(B + 'running', { done: '{done}', total: '{total}' }) %>"><%= run.total ? t(B + 'running', { done: fmt.number(run.done || 0), total: fmt.number(run.total) }) : t(B + 'preparing') %></strong>
        <span class="meter" aria-hidden="true"><span data-export-bar style="width:<%= pct %>%"></span></span>
      </div>
      <% } else { %>
      <form method="post" action="/app/patients/export-all" data-confirm="<%= t(B + 'confirm') %>" data-confirm-yes="<%= t(B + 'confirm_yes') %>" data-confirm-tone="primary">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit"><%- icon('package', 'icon-sm') %><%= t(B + 'start') %></button>
      </form>
      <% } %>
    </div>
  </section>
  <section class="panel flush">
    <div class="panel-head"><div><h2><%= t(B + 'ready_title') %></h2><p class="panel-sub"><%= t(B + 'expires') %></p></div></div>
    <% if (!done.length) { %><div class="panel-body"><p class="muted small"><%= t(B + 'none') %></p></div><% } else { %>
    <ul class="px-list">
      <% done.forEach(function (x) { %>
      <li class="px-item">
        <div class="px-meta">
          <strong><%= fmt.date(x.at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></strong>
          <span class="small muted">
            <% if (x.state === 'ready') { %><%= t(B + 'patients_n', { n: fmt.number(x.patients || 0) }) %> · <bdi><%= size(x.size) %></bdi><% if (x.skipped) { %> · <%= t(B + 'skipped_n', { n: fmt.number(x.skipped) }) %><% } %>
            <% } else { %><span class="badge badge-danger"><%= t(B + 'failed') %></span><% } %>
            <% if (x.by_name) { %> · <%= t(B + 'by', { name: x.by_name }) %><% } %>
          </span>
        </div>
        <div class="row-sm">
          <% if (x.state === 'ready') { %><a class="btn btn-secondary btn-sm" href="/app/patients/export-all/<%= x.name %>"><%- icon('download', 'icon-sm') %><%= t(B + 'download') %></a><% } %>
          <form method="post" action="/app/patients/export-all/<%= x.name %>/delete" data-confirm="<%= t(B + 'delete_confirm') %>" data-confirm-yes="<%= t(B + 'delete') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t(B + 'delete') %></button>
          </form>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>
</div>
<% if (imports) { var I = 'patient_export.import.'; var irun = imports.find(function (x) { return x.state === 'running'; }); %>
<section class="panel mt-6" id="import">
  <div class="panel-head"><div><h2><%- icon('upload', 'icon-sm') %> <%= t(I + 'title') %></h2><p class="panel-sub"><%= t(I + 'lead') %></p></div></div>
  <div class="panel-body stack">
    <% if (irun) { var ipct = irun.total ? Math.round((irun.done || 0) * 100 / irun.total) : 0; %>
    <div class="stack-sm" data-export-running data-status="/app/patients/import-status" role="status" aria-live="polite">
      <strong data-export-text data-text-running="<%= t(I + 'running', { done: '{done}', total: '{total}' }) %>"><%= t(I + 'running', { done: fmt.number(irun.done || 0), total: fmt.number(irun.total || 0) }) %></strong>
      <span class="meter" aria-hidden="true"><span data-export-bar style="width:<%= ipct %>%"></span></span>
    </div>
    <% } else { %>
    <form class="row-sm" style="flex-wrap:wrap" method="post" action="/app/patients/import" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input class="input" type="file" name="file" accept=".zip,application/zip" required style="max-width:420px">
      <button class="btn btn-secondary" type="submit"><%- icon('upload', 'icon-sm') %><%= t(I + 'check') %></button>
    </form>
    <p class="small muted"><%= t(I + 'hint', { mb: fmt.number(importMaxMb) }) %></p>
    <% } %>
  </div>
  <% var past = imports.filter(function (x) { return x.state !== 'running' && x.state !== 'ready'; }); var waiting = imports.filter(function (x) { return x.state === 'ready'; }); %>
  <% if (past.length || waiting.length) { %>
  <ul class="px-list">
    <% waiting.forEach(function (x) { %>
    <li class="px-item"><div class="px-meta"><strong><%= fmt.date(x.at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></strong><span class="small muted"><%= t(I + 'waiting', { n: fmt.number(x.patients) }) %></span></div>
      <a class="btn btn-secondary btn-sm" href="/app/patients/import/<%= x.token %>"><%= t(I + 'review') %></a></li>
    <% }) %>
    <% past.forEach(function (x) { var r = x.report || {}; %>
    <li class="px-item"><div class="px-meta">
      <strong><%= fmt.date(x.finished_at || x.at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
        <span class="badge <%= x.state === 'done' ? 'badge-success' : x.state === 'stopped' ? 'badge-warning' : 'badge-danger' %>"><%= t(I + 'state.' + x.state) %></span></strong>
      <% if (x.state !== 'failed') { %><span class="small muted"><%= t(I + 'report', { added: fmt.number(r.patients_new || 0), merged: fmt.number(r.patients_merged || 0), visits: fmt.number(r.appointment || 0), files: fmt.number((r.file || 0) + (r.paper_invoice || 0) + (r.paper_certificate || 0)) }) %><% if (r.future) { %> · <%= t(I + 'report_future', { n: fmt.number(r.future) }) %><% } %><% if (x.failed) { %> · <%= t(I + 'report_failed', { n: fmt.number(x.failed) }) %><% } %><% if (x.stop === 'STORAGE_FULL') { %> · <%= t(I + 'report_full') %><% } %></span><% } %>
    </div></li>
    <% }) %>
  </ul>
  <% } %>
</section>
<% } %>
