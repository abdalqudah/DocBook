<% var actions = [];
   if (kind === 'owner') {
     if (can('appointments.manage')) actions.push({ href: '/app/appointments/new', icon: 'calendar-plus', key: 'new_appointment' });
     if (can('frontdesk.use')) actions.push({ href: '/app/front-desk', icon: 'armchair', key: 'reception' });
     if (can('billing.manage')) actions.push({ href: '/app/cashier', icon: 'banknote', key: 'cash' });
     if (can('expenses.manage')) actions.push({ href: '/app/expenses?new=1', icon: 'receipt-text', key: 'expense' });
   } else if (kind === 'reception') {
     if (can('frontdesk.use')) actions.push({ href: '/app/front-desk', icon: 'armchair', key: 'reception' });
     if (can('appointments.manage')) actions.push({ href: '/app/appointments/new', icon: 'calendar-plus', key: 'new_appointment' });
     if (can('billing.manage')) actions.push({ href: '/app/cashier', icon: 'banknote', key: 'cash' });
     if (can('patients.create')) actions.push({ href: '/app/patients?new=1', icon: 'user-plus', key: 'new_patient' });
   } else {
     if (can('billing.manage')) actions.push({ href: '/app/cashier', icon: 'banknote', key: 'cash' });
     if (can('expenses.manage')) actions.push({ href: '/app/expenses?new=1', icon: 'receipt-text', key: 'expense' });
     if (can('billing.view')) actions.push({ href: '/app/billing', icon: 'receipt', key: 'invoices' });
     if (can('finance.view')) actions.push({ href: '/app/finance', icon: 'trending-up', key: 'pnl' }); else if (can('reports.view')) actions.push({ href: '/app/reports', icon: 'chart-pie', key: 'reports' });
   } %>
<div class="page-head ox-home-head" data-autorefresh="120">
  <div>
    <div class="breadcrumbs"><%= business.name %></div>
    <h1><%= greeting %></h1>
    <p><%= fmt.date(clinicToday, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %> · <span dir="ltr"><%= nowTime %></span></p>
  </div>
</div>

<% if (actions.length) { %>
<nav class="ox-actions" aria-label="<%= t('ownerx.home.quick') %>">
  <% actions.forEach(function (a, i) { %><a class="ox-action<%= i === 0 ? ' is-main' : '' %>" href="<%= a.href %>"><%- icon(a.icon) %><span><%= t('ownerx.home.act_' + a.key) %></span></a><% }) %>
</nav>
<% } %>

<% if (checklist) { %><%- include('_checklist') %><% } %>

<% if (kind === 'accounts') { %>
  <%- include('_accounts') %>
<% } else { %>
<div class="stats ox-stats">
  <a class="stat card-link" href="<%= can('appointments.view') ? '/app/appointments' : '#' %>"><div class="stat-label"><%= t('ownerx.home.appts_today') %></div><div class="stat-value"><%= fmt.number(counts.total) %></div><div class="stat-meta"><%= t('ownerx.home.to_come_done', { come: fmt.number(counts.toArrive), done: fmt.number(counts.done) }) %></div></a>
  <a class="stat card-link" href="<%= can('frontdesk.use') ? '/app/front-desk' : '#' %>"><div class="stat-label"><%= t('ownerx.home.waiting_now') %></div><div class="stat-value"><%= fmt.number(counts.waiting) %></div><div class="stat-meta"><%= t('ownerx.home.with_doctor_n', { n: fmt.number(counts.withDoctor) }) %></div></a>
  <% if (cash) { %>
  <a class="stat card-link" href="<%= can('billing.view') ? '/app/billing' : '#' %>"><div class="stat-label"><%= t('ownerx.home.collected_today') %></div><div class="stat-value"><%= fmt.money(cash.today.value) %></div><div class="stat-meta"><%= t('ownerx.home.yesterday_x', { amount: fmt.money(cash.yesterday.value) }) %></div></a>
  <% } else { %>
  <div class="stat"><div class="stat-label"><%= t('ownerx.home.done_today') %></div><div class="stat-value"><%= fmt.number(counts.done) %></div><div class="stat-meta"><%= counts.noShows ? t('ownerx.home.no_shows_n', { n: fmt.number(counts.noShows) }) : '—' %></div></div>
  <% } %>
  <% if (unpaid) { %>
  <a class="stat card-link" href="<%= can('billing.manage') ? '/app/cashier' : '/app/billing' %>"><div class="stat-label"><%= t('ownerx.home.unpaid') %></div><div class="stat-value<%= unpaid.count ? ' ox-attn' : '' %>"><%= fmt.number(unpaid.count) %></div><div class="stat-meta"><%= unpaid.count ? (unpaid.amount ? t('ownerx.home.unpaid_due', { amount: fmt.money(unpaid.amount) }) : t('ownerx.home.unpaid_last30')) : t('ownerx.home.unpaid_none') %></div></a>
  <% } else { %>
  <div class="stat"><div class="stat-label"><%= t('ownerx.home.still_to_arrive') %></div><div class="stat-value"><%= fmt.number(counts.toArrive) %></div><div class="stat-meta"><%= counts.cancelled ? t('ownerx.home.cancelled_n', { n: fmt.number(counts.cancelled) }) : '—' %></div></div>
  <% } %>
</div>

<div class="grid grid-main mt-6">
  <%- include('_schedule') %>
  <div class="stack">
    <% if (kind === 'owner' && typeof attention !== 'undefined') { var att = attention.filter(function (x) { return x.n > 0; }); %>
    <div class="panel flush">
      <div class="panel-head"><h2><%= t('ownerx.home.attention') %></h2></div>
      <% if (!att.length) { %><div class="ox-pad small muted row-sm"><%- icon('circle-check', 'icon-sm') %><%= t('ownerx.home.attention_none') %></div><% } else { %>
      <ul class="action-list"><% att.forEach(function (x) { %><li><a href="<%= x.href %>"><span class="action-icon"><%- icon(x.icon, 'icon-sm') %></span><span class="grow"><%= t('ownerx.home.att_' + x.key, { n: fmt.number(x.n) }) %></span><span class="badge <%= x.tone === 'danger' ? 'badge-danger' : 'badge-neutral' %>"><%= fmt.number(x.n) %></span></a></li><% }) %></ul>
      <% } %>
    </div>
    <% } else if (online) { %>
    <%- include('_online') %>
    <% } %>
    <% if (month) { %><%- include('_month') %><% } %>
  </div>
</div>

<% if (kind === 'owner' && typeof trends !== 'undefined' && (trends.apptChart || trends.byDoctor)) { %>
<details class="panel ox-trends mt-6">
  <summary class="panel-head"><div><h2><%= t('ownerx.home.trends') %></h2><p class="panel-sub"><%= t('ownerx.home.trends_sub') %></p></div><%- icon('chevron-down', 'icon-sm muted ox-chev') %></summary>
  <div class="panel-body stack-lg">
    <% if (trends.apptChart) { %><div><div class="row between wrap mb-2"><span class="strong small"><%= t('dashboard.chart_30') %></span><div class="legend"><span><i class="l1"></i><%= t('dashboard.legend_booked') %></span><span><i class="l2"></i><%= t('dashboard.legend_done') %></span></div></div><%- trends.apptChart %></div><% } %>
    <% if (trends.byDoctor) { %><div><div class="strong small mb-2"><%= t('dashboard.revenue_by_doctor') %> · <%= fmt.month(clinicToday.slice(0, 7)) %></div><div class="rec-hbars-stacked"><%- trends.byDoctor %></div></div><% } %>
  </div>
</details>
<% } %>
<% } %>
