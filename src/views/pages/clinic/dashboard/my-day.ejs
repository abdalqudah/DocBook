<% var P = '../../../partials/'; var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
   /* The doctor's day (round 8 doctor journey): the next patient with ONE big action, then today's patients in order
      with a clear state. Live: live.js refreshes the page when reception checks a patient in or sends them in. */
   var canStart = can('clinical.edit');
   var visitHref = function (id) { return can('clinical.view') ? '/app/visits/' + id : '/app/appointments/' + id; };
   var stateText = function (a) { return a.state === 'cancelled' || a.state === 'no_show' ? t('dashboard.statuses.' + a.state) : t('dflow.state.' + a.state); };
   var stateTone = function (a) { return a.state === 'with_me' || a.state === 'sent_in' ? 'brand' : a.state === 'cancelled' ? 'danger' : a.state === 'waiting' && a.waitedMin !== null && a.waitedMin >= 30 ? 'warning' : 'neutral'; };
   var startable = function (a) { return isToday && canStart && can('clinical.view') && ['booked', 'waiting', 'sent_in'].indexOf(a.state) !== -1; };
   var np = nextPatient; %>
<div class="page-head"<% if (autoRefresh) { %> data-autorefresh="90"<% } %>>
  <div>
    <div class="breadcrumbs"><%= L(doctor.full_name, doctor.full_name_en) %></div>
    <h1><%= isToday ? t('my_day.title') : fmt.date(date, { weekday: 'long', day: 'numeric', month: 'long' }) %></h1>
    <p><%= fmt.date(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %><% if (day.enabled && !offToday) { %> · <span dir="ltr"><%= day.shifts.map(function (s) { return s.start + '–' + s.end; }).join(' , ') %></span><% } %></p>
  </div>
  <div class="page-actions">
    <form class="rec-datenav" method="get" action="/app/my-day" data-autosubmit>
      <a class="btn btn-secondary btn-icon" href="/app/my-day?date=<%= prev %>" aria-label="<%= t('my_day.prev') %>" title="<%= t('my_day.prev') %>"><%- icon('chevron-left', 'icon-sm flip-rtl') %></a>
      <input class="input" type="date" name="date" value="<%= date %>" aria-label="<%= t('common.date') %>">
      <a class="btn btn-secondary btn-icon" href="/app/my-day?date=<%= next %>" aria-label="<%= t('my_day.next') %>" title="<%= t('my_day.next') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a>
      <% if (!isToday) { %><a class="btn btn-ghost" href="/app/my-day"><%= t('common.today') %></a><% } %>
      <noscript><button class="btn btn-secondary" type="submit"><%= t('common.apply') %></button></noscript>
    </form>
  </div>
</div>

<% if (offToday) { %><div class="alert alert-info mb-4"><%- icon('calendar-x') %><div class="grow"><div class="alert-title"><%= t('my_day.day_off') %></div><% if (offToday.reason) { %><div><%= offToday.reason %></div><% } %></div></div><% } else if (!day.enabled && !items.length) { %><div class="alert alert-info mb-4"><%- icon('calendar') %><div class="grow"><div class="alert-title"><%= t('my_day.not_working') %></div></div></div><% } %>

<%/* ---------------- next patient: the one obvious action ---------------- */%>
<% if (isToday) { %>
<section class="panel df-next" aria-labelledby="df-next-title">
  <div class="panel-body">
    <% if (np) { %>
    <div class="df-next-main">
      <div class="df-next-kicker" id="df-next-title"><%= np.state === 'with_me' ? t('my_day.with_me') : t('my_day.next_patient') %></div>
      <div class="df-next-name" dir="auto"><%= np.patient_name %></div>
      <div class="df-next-meta">
        <span dir="ltr" class="mono"><%= np.appointment_time %></span>
        <span><%= L(np.service_name, np.service_name_en) || t('my_day.visit') %></span>
        <span class="df-status df-st-<%= np.state %>"><i></i><%= stateText(np) %><% if (np.state === 'waiting' && np.waitedMin !== null) { %> · <%= t('my_day.minutes_n', { n: fmt.number(np.waitedMin) }) %><% } %></span>
      </div>
    </div>
    <div class="df-next-actions">
      <% if (np.state === 'with_me' || !startable(np)) { %>
      <a class="btn btn-primary btn-lg df-big" href="<%= visitHref(np.id) %>"><%- icon('stethoscope', 'icon-sm') %><%= np.state === 'with_me' ? t('dflow.continue_visit') : t('my_day.open_visit') %></a>
      <% } else { %>
      <form method="post" action="/app/visits/<%= np.id %>/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-lg df-big" type="submit"><%- icon('stethoscope', 'icon-sm') %><%= t('dflow.start_visit') %></button></form>
      <% } %>
      <% if (np.patient_id && can('patients.view')) { %><a class="btn btn-ghost" href="/app/patients/<%= np.patient_id %>"><%= t('my_day.patient_file') %></a><% } %>
    </div>
    <% } else { %>
    <div class="df-next-main"><div class="df-next-kicker"><%= t('my_day.next_patient') %></div><div class="df-next-empty"><%= counts.total ? t('dflow.all_done') : t('my_day.empty_today') %></div></div>
    <% } %>
  </div>
  <div class="df-counts">
    <span><strong><%= fmt.number(counts.total) %></strong> <%= t('my_day.total') %></span>
    <span><strong><%= fmt.number(counts.waiting) %></strong> <%= t('dflow.count_waiting') %></span>
    <span><strong><%= fmt.number(counts.remaining) %></strong> <%= t('my_day.remaining') %></span>
    <span><strong><%= fmt.number(counts.toPay) %></strong> <%= t('dflow.count_to_pay') %></span>
    <span><strong><%= fmt.number(counts.completed) %></strong> <%= t('dflow.count_finished') %></span>
    <% if (revenue) { %><span><strong><%= fmt.money(revenue.value) %></strong> <%= t('my_day.revenue') %></span><% } %>
  </div>
</section>
<% } %>

<div class="grid grid-main mt-6">
  <div class="stack">
    <div class="panel flush">
      <div class="panel-head"><h2><%= isToday ? t('dflow.today_patients') : t('my_day.timeline') %></h2><% if (can('appointments.view')) { %><a class="btn btn-ghost btn-sm" href="/app/appointments?date=<%= date %>"><%= t('dashboard.open_calendar') %><%- icon('chevron-right', 'icon-sm flip-rtl') %></a><% } %></div>
      <% if (!items.length) { %>
        <%- include(P + 'empty', { compact: true, emptyIcon: 'calendar-check', emptyTitle: t('my_day.empty'), emptyText: isToday ? t('my_day.empty_today') : t('my_day.empty_other') }) %>
      <% } else { %>
      <ol class="df-day">
        <% items.forEach(function (a) { %>
        <% if (a.state === 'blocked') { %>
        <li class="df-day-row is-block"><span class="df-day-time mono" dir="ltr"><%= a.appointment_time %></span><span class="small muted row-sm grow"><%- icon('lock', 'icon-sm') %><%= a.notes || t('my_day.blocked') %></span></li>
        <% } else { %>
        <li class="df-day-row st-<%= a.state %><%= np && np.id === a.id && isToday ? ' is-next' : '' %><%= a.past && ['booked', 'cancelled', 'no_show'].indexOf(a.state) !== -1 ? ' is-past' : '' %>">
          <span class="df-day-time mono" dir="ltr"><%= a.appointment_time %></span>
          <a class="df-day-main" href="<%= visitHref(a.id) %>">
            <span class="strong df-day-name" dir="auto"><%= a.patient_name %></span>
            <span class="small muted"><%= L(a.service_name, a.service_name_en) || t('my_day.visit') %><% if (a.appointment_type === 'online') { %> · <%= t('dashboard.online') %><% } %><% if (a.parent_appointment_id) { %> · <%= t('patients.follow_up') %><% } %></span>
          </a>
          <span class="df-day-state">
            <span class="badge badge-<%= stateTone(a) %> badge-dot"><%= stateText(a) %></span>
            <% if (a.state === 'waiting' && a.arrivedTime) { %><span class="tiny muted"><%= t('my_day.waiting_since', { time: a.arrivedTime }) %></span><% } %>
            <% if (a.state === 'to_pay' || a.state === 'paid') { %><span class="tiny muted mono" dir="ltr"><%= fmt.money(a.amount_due) %></span><% } %>
          </span>
          <span class="df-day-act">
            <% if (a.state === 'with_me') { %><a class="btn btn-secondary btn-sm" href="<%= visitHref(a.id) %>"><%= t('dflow.continue') %></a>
            <% } else if (startable(a) && (a.state === 'waiting' || a.state === 'sent_in')) { %><form method="post" action="/app/visits/<%= a.id %>/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" type="submit"><%= t('dflow.start') %></button></form>
            <% } else { %><a class="btn btn-ghost btn-sm btn-icon" href="<%= visitHref(a.id) %>" aria-label="<%= t('my_day.open_visit') %>" title="<%= t('my_day.open_visit') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a><% } %>
          </span>
        </li>
        <% } %>
        <% }) %>
      </ol>
      <% } %>
    </div>
  </div>

  <div class="stack">
    <div class="panel flush"><div class="panel-head"><h2><%= t('my_day.coming_days') %></h2></div>
      <ul class="rec-week">
        <% week.forEach(function (w) { %><li><a href="/app/my-day?date=<%= w.date %>"><span class="small"><%= fmt.date(w.date, { weekday: 'short' }) %></span><span class="strong"><%= fmt.date(w.date, { day: 'numeric' }) %></span><span class="badge badge-neutral"><%= fmt.number(w.n) %></span></a></li><% }) %>
      </ul>
    </div>

    <div class="panel"><div class="panel-head"><h2><%= t('my_day.days_off') %></h2></div><div class="panel-body">
      <% if (!daysOff.length) { %><p class="small muted"><%= t('my_day.no_days_off') %></p><% } else { %>
      <ul class="checklist"><% daysOff.forEach(function (o) { %><li><%- icon('calendar-x', 'icon-sm') %><span class="grow"><strong><%= fmt.date(o.off_date, { weekday: 'long', day: 'numeric', month: 'long' }) %></strong><% if (o.reason) { %> · <%= o.reason %><% } %></span></li><% }) %></ul>
      <% } %>
    </div></div>
  </div>
</div>
