<%
  /* One invoice: the paper exactly as it prints (clinic letterhead, lines, payment parts, stamp, footer note) and,
     on screen, the summary and the void action. ?print=1 renders the paper alone (layouts/print); ?paper= picks
     A4 / A5 / 80 mm (default: Settings → Invoice template). */
  var printing = query.print === '1';
  var original = Number(inv.amount) + Number(inv.discount_amount);
  var paperHref = function (p, extra) { return '/app/billing/' + inv.id + '?paper=' + p + (extra || ''); };
%>
<% if (!printing) { %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/billing"><%= t('billing.title') %></a><%- icon('chevron-right', 'flip-rtl') %><bdi class="mono" dir="ltr">#<%= number %></bdi></div>
    <h1><%= t('billing.invoice_no', { n: number }) %></h1>
    <p><span dir="auto"><%= inv.patient_name %></span> · <%= fmt.date(issued.date) %></p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="<%= paperHref(paper, '&print=1') %>"><%- icon('file-text', 'icon-sm') %><%= t('billing.print_view') %></a>
    <a class="btn btn-primary" href="<%= paperHref(paper, '&print=1&autoprint=1') %>"><%- icon('printer', 'icon-sm') %><%= t('common.print') %></a>
  </div>
</div>

<div class="grid grid-main">
  <div class="stack">
    <div class="ivd-bar no-print">
      <span class="small muted"><%= t('invoicex.print_as') %></span>
      <div class="segmented" role="group" aria-label="<%= t('invoicex.print_as') %>">
        <% ['a4', 'a5', 'receipt80'].forEach(function (p) { %><a href="<%= paperHref(p) %>" class="<%= paper === p ? 'active' : '' %>"<%- paper === p ? ' aria-current="true"' : '' %>><%= t('invoicex.paper.' + p) %></a><% }) %>
      </div>
    </div>
    <%- include('_document', { doc: doc }) %>
  </div>

  <div class="stack">
    <div class="panel"><div class="panel-head"><h2><%= t('billing.summary') %></h2></div><div class="panel-body"><dl class="dl rec-dl-narrow">
      <dt><%= t('billing.original_price') %></dt><dd><%= fmt.money(original) %></dd>
      <% if (Number(inv.discount_amount) > 0) { %>
      <dt><%= t('billing.discount') %></dt><dd><%= fmt.money(inv.discount_amount) %> <span class="muted small">(<%= fmt.number(inv.discount_percent) %>%)</span></dd>
      <% if (inv.discount_reason) { %><dt class="muted"></dt><dd class="small muted" dir="auto"><%= inv.discount_reason %></dd><% } %>
      <% } %>
      <dt><%= t('billing.net_paid') %></dt><dd class="strong"><%= fmt.money(inv.amount) %></dd>
      <dt><%= t('invoicex.paid_by') %></dt><dd><%- include('_payment-lines', { pl: { parts: doc.parts, insuranceName: inv.insurance_provider_name, mode: 'rows' } }) %></dd>
    </dl></div>
    <% if (inv.appointment_id && (can('appointments.view') || can('clinical.view'))) { %><div class="panel-foot"><a class="btn btn-ghost btn-sm" href="<%= can('clinical.view') ? '/app/visits/' : '/app/appointments/' %><%= inv.appointment_id %>"><%- icon('calendar-days', 'icon-sm') %><%= t('billing.open_visit') %></a></div><% } %>
    </div>
    <% if (can('billing.manage')) { %>
    <div class="panel"><div class="panel-body stack-sm">
      <div class="strong"><%= t('billing.void') %></div>
      <p class="small muted"><%= t('billing.void_help') %></p>
      <form method="post" action="/app/billing/<%= inv.id %>/void" data-confirm="<%= t('billing.void_confirm', { n: inv.invoice_number }) %>" data-confirm-title="<%= t('billing.void') %>" data-confirm-yes="<%= t('billing.void_yes') %>" data-confirm-type="<%= inv.invoice_number %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="confirm_name" value="">
        <button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('circle-x', 'icon-sm') %><%= t('billing.void') %></button>
      </form>
    </div></div>
    <% } %>
  </div>
</div>
<% } else { %>
<%- include('_document', { doc: doc }) %>
<% } %>
