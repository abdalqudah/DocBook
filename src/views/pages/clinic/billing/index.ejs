<% var P = '../../../partials/'; var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
   var invPrefix = (typeof invoiceTpl !== 'undefined' && invoiceTpl && invoiceTpl.prefix) || ''; %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><%= t('nav.group_clinic') %></div>
    <h1><%= t('billing.title') %></h1>
    <p><%= t('billing.lead') %></p>
  </div>
  <div class="page-actions">
    <% if (tab === 'invoices') { %><%- include(P + 'export-menu', { href: '/app/billing/export' }) %><% } %>
    <% if (can('billing.manage')) { %><a class="btn btn-primary" href="/app/cashier"><%- icon('banknote', 'icon-sm') %><%= t('nav.cashier') %></a><% } %>
  </div>
</div>

<nav class="tabs mb-4" aria-label="<%= t('billing.title') %>">
  <a href="/app/billing" class="<%= tab === 'invoices' ? 'active' : '' %>"<%- tab === 'invoices' ? ' aria-current="page"' : '' %>><%- icon('receipt', 'icon-sm') %><%= t('billing.invoices') %></a>
  <a href="/app/billing?tab=unpaid" class="<%= tab === 'unpaid' ? 'active' : '' %>"<%- tab === 'unpaid' ? ' aria-current="page"' : '' %>><%- icon('clock', 'icon-sm') %><%= t('billing.unpaid_tab') %><% if (unpaidCount) { %><span class="count"><%= fmt.number(unpaidCount) %></span><% } %></a>
</nav>

<% if (tab === 'unpaid') { %>
  <div class="panel flush">
    <div class="panel-head"><div><h2><%= t('billing.unpaid_title') %></h2><p class="panel-sub"><%= t('billing.unpaid_lead') %></p></div><% if (rows.length) { %><div class="text-end"><div class="small muted"><%= t('billing.expected_due') %></div><div class="strong"><%= fmt.money(due) %></div></div><% } %></div>
    <% if (!rows.length) { %>
      <%- include(P + 'empty', { emptyIcon: 'circle-check', emptyTitle: t('billing.unpaid_empty'), emptyText: t('billing.unpaid_empty_text') }) %>
    <% } else { %>
    <div class="table-wrap"><table class="table responsive">
      <thead><tr><th><%= t('common.date') %></th><th><%= t('common.patient') %></th><th><%= t('common.doctor') %></th><th><%= t('common.status') %></th><th class="num"><%= t('billing.amount_due') %></th><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody><% rows.forEach(function (a) { var old = a.appointment_date < clinicToday; %>
        <tr>
          <td data-label="<%= t('common.date') %>" class="nowrap"><%= a.appointment_date === clinicToday ? t('common.today') : fmt.date(a.appointment_date) %> · <span dir="ltr"><%= a.appointment_time %></span><% if (old) { %> <span class="badge badge-warning"><%= t('billing.overdue') %></span><% } %></td>
          <td class="primary-cell"><% if (a.patient_id && can('patients.view')) { %><a class="strong" href="/app/patients/<%= a.patient_id %>" dir="auto"><%= a.patient_name %></a><% } else { %><span class="strong" dir="auto"><%= a.patient_name %></span><% } %><div class="small muted"><span dir="ltr"><%= a.patient_phone || '' %></span></div></td>
          <td data-label="<%= t('common.doctor') %>"><span class="row-sm"><span class="swatch" style="<%= a.doctor_color ? 'background:' + a.doctor_color : '' %>"></span><%= a.doctor_name || '—' %></span><div class="small muted"><%= a.service_name || '' %></div></td>
          <td data-label="<%= t('common.status') %>"><span class="badge badge-<%= a.status === 'completed' ? 'success' : 'info' %>"><%= a.status === 'completed' ? t('dashboard.statuses.completed') : t('dashboard.checked_in') %></span></td>
          <td data-label="<%= t('billing.amount_due') %>" class="num strong"><%= fmt.amount(a.amount_due) %></td>
          <td class="actions"><% if (can('billing.manage')) { %><a class="btn btn-secondary btn-sm" href="/app/cashier?visit=<%= a.id %>"><%- icon('banknote', 'icon-sm') %><%= t('billing.checkout') %></a><% } else if (can('appointments.view')) { %><a class="btn btn-ghost btn-sm" href="/app/appointments/<%= a.id %>"><%= t('billing.open_visit') %><%- icon('chevron-right', 'icon-sm flip-rtl') %></a><% } %></td>
        </tr>
      <% }) %></tbody>
    </table></div>
    <% if (rows.length >= 300) { %><div class="table-foot"><%= t('billing.unpaid_limit') %></div><% } %>
    <% } %>
  </div>
<% } else { %>
  <div class="stats cols-3 mb-4 rec-kpis">
    <div class="stat hero"><div class="stat-label"><%= t('billing.collected') %><span class="stat-icon"><%- icon('banknote') %></span></div><div class="stat-value"><%= fmt.money(totals.amount) %></div><div class="stat-meta"><%= filtered ? t('billing.for_filters') : t('billing.all_time') %></div></div>
    <div class="stat"><div class="stat-label"><%= t('billing.count') %><span class="stat-icon"><%- icon('receipt') %></span></div><div class="stat-value"><%= fmt.number(totals.count) %></div><div class="stat-meta"><%= totals.count ? t('billing.avg_ticket', { v: fmt.money(totals.amount / totals.count) }) : '—' %></div></div>
    <div class="stat"><div class="stat-label"><%= t('billing.discounts') %><span class="stat-icon warning"><%- icon('percent') %></span></div><div class="stat-value"><%= fmt.money(totals.discount) %></div><div class="stat-meta"><%= t('billing.discounted_n', { n: fmt.number(totals.discounted) }) %></div></div>
  </div>

  <% if (byMethod && byMethod.rows.length) { %>
  <div class="panel flush mb-4">
    <div class="panel-head"><div><h2><%= t('invoicex.by_method') %></h2><p class="panel-sub"><%= t('invoicex.by_method_hint') %></p></div></div>
    <dl class="ivx-methods">
      <% byMethod.rows.forEach(function (m) { %><div><dt><%= t('invoicex.m.' + m.method) %></dt><dd class="num"><%= fmt.money(m.amount) %> <div class="ivx-sub"><%= t('invoicex.n_invoices', { n: fmt.number(m.invoices) }) %></div></dd></div><% }) %>
    </dl>
  </div>
  <% } %>

  <div class="panel flush">
    <form class="table-toolbar" method="get" data-autosubmit role="search">
      <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('billing.search') %>" aria-label="<%= t('common.search') %>"></div>
      <% if (!ctx.ownDoctorId) { %><select class="select" name="doctor" aria-label="<%= t('common.doctor') %>"><option value="all"><%= t('common.all_doctors') %></option><% doctors.forEach(function (d) { %><option value="<%= d.id %>"<%= String(query.doctor) === String(d.id) ? ' selected' : '' %>><%= L(d.full_name, d.full_name_en) %></option><% }) %></select><% } %>
      <select class="select" name="method" aria-label="<%= t('billing.method') %>"><option value="all"><%= t('billing.all_methods') %></option><% methods.forEach(function (m) { %><option value="<%= m %>"<%= query.method === m ? ' selected' : '' %>><%= t('invoicex.m.' + m) %></option><% }) %></select>
      <% if (insurance.length) { %><select class="select" name="insurance" aria-label="<%= t('billing.insurance') %>"><option value="all"><%= t('billing.all_insurance') %></option><option value="none"<%= query.insurance === 'none' ? ' selected' : '' %>><%= t('billing.no_insurance') %></option><% insurance.forEach(function (i) { %><option value="<%= i.id %>"<%= String(query.insurance) === String(i.id) ? ' selected' : '' %>><%= i.name %></option><% }) %></select><% } %>
      <input class="input" type="date" name="from" value="<%= query.from || '' %>" aria-label="<%= t('common.from') %>" title="<%= t('common.from') %>">
      <input class="input" type="date" name="to" value="<%= query.to || '' %>" aria-label="<%= t('common.to') %>" title="<%= t('common.to') %>">
      <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="/app/billing"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
    </form>
    <% if (!rows.length) { %>
      <% if (filtered) { %>
        <%- include(P + 'empty', { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: '', emptyAction: '<a class="btn btn-secondary btn-sm" href="/app/billing">' + t('table.clear_filters') + '</a>' }) %>
      <% } else { %>
        <%- include(P + 'empty', { emptyIcon: 'receipt', emptyTitle: t('billing.empty_title'), emptyText: t('billing.empty_text'), emptyAction: can('frontdesk.use') ? '<a class="btn btn-primary btn-sm" href="/app/front-desk">' + t('billing.front_desk') + '</a>' : '' }) %>
      <% } %>
    <% } else { %>
    <div class="table-wrap"><table class="table responsive">
      <thead><tr><th><%= t('billing.number') %></th><th><%= t('common.date') %></th><th><%= t('common.patient') %></th><th><%= t('common.doctor') %> / <%= t('common.service') %></th><th><%= t('billing.method') %></th><th class="num"><%= t('billing.discount') %></th><th class="num"><%= t('billing.net_paid') %> (<%= currency %>)</th><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody><% rows.forEach(function (r) { var lt = localTime(r.created_at) || {}; %>
        <tr>
          <td class="primary-cell ivx-no"><a class="strong mono" href="/app/billing/<%= r.id %>" dir="ltr">#<%= invPrefix %><%= r.invoice_number %></a><span class="mobile-only small muted"> · <%= r.patient_name %></span></td>
          <td data-label="<%= t('common.date') %>" class="nowrap"><%= fmt.date(lt.date) %> <span class="small muted" dir="ltr"><%= lt.time %></span></td>
          <td data-label="<%= t('common.patient') %>"><% if (r.patient_id && can('patients.view')) { %><a href="/app/patients/<%= r.patient_id %>" dir="auto"><%= r.patient_name %></a><% } else { %><span dir="auto"><%= r.patient_name %></span><% } %></td>
          <td data-label="<%= t('common.doctor') %>"><div><%= r.doctor_name || '—' %></div><div class="small muted"><%= r.service_name || '' %></div></td>
          <td data-label="<%= t('billing.method') %>"><%- include('_payment-lines', { pl: { parts: r.parts, insuranceName: r.insurance_provider_name, mode: 'chips' } }) %><% if (r.insurance_provider_name && !r.parts.some(function (p) { return p.method === 'insurance'; })) { %><div class="small muted mt-1"><%= r.insurance_provider_name %></div><% } %></td>
          <td data-label="<%= t('billing.discount') %>" class="num"><% if (Number(r.discount_amount) > 0) { %><span class="small"><%= fmt.amount(r.discount_amount) %></span> <span class="badge badge-warning"><%= fmt.number(r.discount_percent) %>%</span><% } else { %><span class="muted">—</span><% } %></td>
          <td data-label="<%= t('billing.net_paid') %>" class="num strong"><%= fmt.amount(r.amount) %></td>
          <td class="actions"><a class="btn btn-ghost btn-icon btn-sm" href="/app/billing/<%= r.id %>?print=1&autoprint=1" aria-label="<%= t('common.print') %>" title="<%= t('common.print') %>"><%- icon('printer', 'icon-sm') %></a><a class="btn btn-ghost btn-icon btn-sm" href="/app/billing/<%= r.id %>" aria-label="<%= t('common.open') %>" title="<%= t('common.open') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a></td>
        </tr>
      <% }) %></tbody>
      <tfoot><tr><td colspan="5"><%= t('table.totals') %></td><td class="num"><%= fmt.amount(totals.discount) %></td><td class="num"><%= fmt.amount(totals.amount) %></td><td></td></tr></tfoot>
    </table></div>
    <%- include(P + 'pagination', { meta: meta }) %>
    <% } %>
  </div>
<% } %>
