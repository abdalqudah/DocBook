<%# Clinic → Branches: the main branch (the clinic itself) and the other branches, within the package. %>
<% var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
   var addBtn = '<button class="btn btn-primary" type="button" data-open-dialog="branch-dialog" data-reset-form data-action="/app/clinic/branches" data-dialog-title="' + t('branches.add') + '">' + icon('plus', 'icon-sm') + t('branches.add') + '</button>'; %>
<div class="page-head">
  <div><div class="breadcrumbs"><%= t('navx.sec_clinic') %></div><h1><%= t('branches.title') %></h1><p><%= t('branches.lead') %></p></div>
  <div class="page-actions"><% if (room && branchesOn) { %><%- addBtn %><% } %></div>
</div>
<% if (!branchesOn) { %>
<div class="alert alert-info mb-4" data-branches-off><%- icon('info', 'icon-sm') %><div class="grow">
  <div class="strong"><%= t('branches.off_title') %></div>
  <div class="small"><%= t('branches.off_text') %></div>
</div><a class="btn btn-primary btn-sm" href="/workspaces/new"><%- icon('plus', 'icon-sm') %><%= t('branches.off_add_clinic') %></a></div>
<% } else if (!room) { %>
<div class="alert alert-info mb-4"><%- icon('info', 'icon-sm') %><div class="grow">
  <div class="strong"><%= allowed <= 1 ? t('branches.locked_title') : t('branches.full_title', { n: allowed }) %></div>
  <div class="small"><%= allowed <= 1 ? t('branches.locked_text') : t('branches.full_text') %></div>
</div><% if (subsOn) { %><a class="btn btn-secondary btn-sm" href="/app/settings/subscription"><%= t('branches.see_packages') %></a><% } %></div>
<% } else if (allowed !== null) { %>
<p class="small muted mb-4"><%- icon('building-2', 'icon-sm') %> <%= t('branches.usage', { used: active, n: allowed }) %></p>
<% } %>
<section class="panel flush">
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('branches.branch') %></th><th><%= t('branches.address') %></th><th><%= t('branches.phone') %></th><th class="num"><%= t('branches.doctors') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
    <tbody>
      <tr>
        <td class="primary-cell"><div class="strong"><%= L(clinic.name, clinic.name_en) %></div><div class="tiny muted"><%= t('branches.main') %><% if (clinic.branch_short) { %> · <span class="badge badge-info"><%= clinic.branch_short %></span><% } %></div>
          <form class="row-sm mt-2" method="post" action="/app/clinic/branches/main-short" data-main-short><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="short_name" value="<%= clinic.branch_short || '' %>" maxlength="40" placeholder="<%= t('branches.main_short') %>" aria-label="<%= t('branches.main_short') %>" style="max-width:180px"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('check', 'icon-sm') %></button></form></td>
        <td data-label="<%= t('branches.address') %>"><%= [clinic.city, clinic.address].filter(Boolean).join(' · ') || '—' %></td>
        <td data-label="<%= t('branches.phone') %>"><bdi><%= clinic.phone || '—' %></bdi></td>
        <td class="num" data-label="<%= t('branches.doctors') %>"><%= doctorsIn.main || 0 %></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-success badge-dot"><%= t('common.active') %></span></td>
        <td class="actions"><a class="btn btn-ghost btn-icon btn-sm" href="/app/settings/clinic" aria-label="<%= t('common.edit') %>" title="<%= t('branches.main_edit') %>"><%- icon('pencil', 'icon-sm') %></a></td>
      </tr>
      <% rows.forEach(function (b) { %>
      <tr<%= b.is_active ? '' : ' class="muted"' %>>
        <td class="primary-cell"><div class="strong"><%= L(b.name, b.name_en) %><% if (b.short_name) { %> <span class="badge badge-info"><%= b.short_name %></span><% } %></div><% if (b.map_url) { %><a class="tiny link" href="<%= b.map_url %>" target="_blank" rel="noopener"><%= t('branches.map') %></a><% } %></td>
        <td data-label="<%= t('branches.address') %>"><%= [b.city, b.address].filter(Boolean).join(' · ') || '—' %></td>
        <td data-label="<%= t('branches.phone') %>"><bdi><%= b.phone || '—' %></bdi></td>
        <td class="num" data-label="<%= t('branches.doctors') %>"><%= doctorsIn[b.id] || 0 %></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= b.is_active ? 'badge-success' : 'badge-neutral' %>"><%= b.is_active ? t('common.active') : t('branches.inactive') %></span></td>
        <td class="actions"><div class="row-sm" style="justify-content:flex-end">
          <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" data-open-dialog="branch-dialog" data-action="/app/clinic/branches/<%= b.id %>" data-dialog-title="<%= t('branches.edit') %>" data-fill="<%= JSON.stringify({ name: b.name, name_en: b.name_en, short_name: b.short_name, city: b.city, address: b.address, phone: b.phone, whatsapp: b.whatsapp, map_url: b.map_url, sort_order: b.sort_order }) %>"><%- icon('pencil', 'icon-sm') %></button>
          <% if (b.is_active) { %>
          <form method="post" action="/app/clinic/branches/<%= b.id %>/off" data-confirm="<%= t('branches.off_confirm') %>" data-confirm-title="<%= L(b.name, b.name_en) %>" data-confirm-yes="<%= t('branches.turn_off') %>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%= t('branches.turn_off') %></button></form>
          <% } else { %>
          <form method="post" action="/app/clinic/branches/<%= b.id %>/on" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"<%= room ? '' : ' disabled title="' + t('branches.locked_title') + '"' %>><%= t('branches.turn_on') %></button></form>
          <% } %>
          <%- include('../../partials/delete-form', { action: '/app/clinic/branches/' + b.id + '/delete', confirmText: t('branches.delete_confirm') }) %>
        </div></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% if (!rows.length) { %><div class="panel-body"><p class="small muted"><%= room ? t('branches.empty_text') : t('branches.empty_locked') %></p></div><% } %>
</section>
<p class="help mt-4"><%= t('branches.how') %></p>
<% if (others.length) { %>
<section class="panel mt-6">
  <div class="panel-head"><div><h2><%= t('branches.others_title') %></h2><div class="panel-sub"><%= t('branches.others_sub') %></div></div></div>
  <div class="table-wrap"><table class="table responsive">
    <tbody>
    <% others.forEach(function (c) { %>
      <tr>
        <td class="primary-cell"><div class="strong"><%= L(c.name, c.name_en) %></div><div class="tiny muted"><%= t('branches.others_holds', { p: c.patients, a: c.appointments, d: c.doctors }) %></div></td>
        <td class="actions">
          <% if (room) { %>
          <form method="post" action="/app/clinic/branches/from-clinic" class="row wrap" data-confirm="<%= t(c.empty ? 'branches.merge_confirm_empty' : 'branches.merge_confirm', { name: c.name }) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="clinic_id" value="<%= c.id %>">
            <% if (c.empty) { %><label class="check small"><input type="checkbox" name="remove" value="1" checked> <%= t('branches.merge_remove') %></label><% } %>
            <button class="btn btn-primary btn-sm" type="submit"><%- icon('building-2', 'icon-sm') %><%= t('branches.merge') %></button>
          </form>
          <% if (!c.empty) { %><div class="tiny muted mt-1"><%= t('branches.merge_keeps') %></div><% } %>
          <% } else { %><span class="tiny muted"><%= t('branches.full_title', { n: allowed }) %></span><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</section>
<% } %>
<dialog class="dialog wide" id="branch-dialog" data-new-dialog aria-labelledby="branch-title"<% if (typeof openDialog !== 'undefined' && openDialog) { %> data-open-on-load<% } %>>
  <form method="post" action="<%= typeof formAction !== 'undefined' && formAction ? formAction : '/app/clinic/branches' %>" novalidate>
    <div class="dialog-head"><h2 id="branch-title" data-dialog-title-target><%= t('branches.add') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('../../partials/form-error') %>
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'name', label: t('branches.name_ar'), required: true, attrs: 'dir="auto" maxlength="120"' }) %>
        <%- include('../../partials/field', { name: 'name_en', label: t('branches.name_en'), attrs: 'dir="ltr" maxlength="120"' }) %>
        <%- include('../../partials/field', { name: 'short_name', label: t('branches.short_name'), help: t('branches.short_name_help'), attrs: 'dir="auto" maxlength="40"' }) %>
        <%- include('../../partials/field', { name: 'city', label: t('branches.city'), attrs: 'dir="auto" maxlength="120"' }) %>
        <%- include('../../partials/field', { name: 'address', label: t('branches.address'), attrs: 'dir="auto" maxlength="255"' }) %>
        <%- include('../../partials/field', { name: 'phone', label: t('branches.phone'), type: 'tel', attrs: 'dir="ltr" maxlength="40"' }) %>
        <%- include('../../partials/field', { name: 'whatsapp', label: t('branches.whatsapp'), type: 'tel', attrs: 'dir="ltr" maxlength="40"' }) %>
        <%- include('../../partials/field', { name: 'map_url', label: t('branches.map_url'), type: 'url', attrs: 'dir="ltr" maxlength="500" placeholder="https://maps.google.com/…"' }) %>
        <%- include('../../partials/field', { name: 'sort_order', label: t('doctors.sort_order'), value: 0, attrs: 'inputmode="numeric" data-default="0"' }) %>
      </div></div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
