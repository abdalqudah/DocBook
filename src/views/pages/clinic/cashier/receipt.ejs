<%
  /* The paper of an invoice printed from the cash screen (layout: cashscreen, light theme, prints on its own with
     ?autoprint=1): the 80 mm till receipt, or A4 / A5 with ?paper=. Same document as the invoice page
     (pages/clinic/billing/_document: clinic letterhead, lines, payment parts, stamp, footer note).
     Locals: rec (cashier.service receipt), issued, paper. */
  var i = rec.inv;
  var doc = { inv: i, parts: rec.parts, lines: rec.lines, subtotal: rec.subtotal, insuranceAmount: rec.insuranceAmount, patientAmount: rec.patientAmount,
    issued: issued, paper: paper, patient: typeof rec.patient !== 'undefined' ? rec.patient : null, stampOn: typeof rec.stampOn !== 'undefined' ? rec.stampOn : undefined };
%>
<% if (typeof recs === 'undefined') { /* the batch page (receipt-batch.ejs) has its own toolbar */ %>
<div class="ivd-bar no-print">
  <button class="btn btn-primary btn-sm" type="button" data-print><%- icon('printer', 'icon-sm') %><%= t('common.print') %></button>
  <div class="segmented" role="group" aria-label="<%= t('invoicex.print_as') %>">
    <% ['receipt80', 'a5', 'a4'].forEach(function (p) { %><a href="/app/cashier/receipt/<%= i.id %><%= p === 'receipt80' ? '' : '?paper=' + p %>" class="<%= paper === p ? 'active' : '' %>"<%- paper === p ? ' aria-current="true"' : '' %>><%= t('invoicex.paper.' + p) %></a><% }) %>
  </div>
</div>
<% } %>
<%- include('../billing/_document', { doc: doc }) %>
