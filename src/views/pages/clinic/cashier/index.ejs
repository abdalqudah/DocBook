<%
  var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
  var money = function (v) { return fmt.amount(v); };
  var dot = function (color) { return '<span class="cs-dot" style="' + (color ? 'background:' + escapeHtml(color) : '') + '" aria-hidden="true"></span>'; };
  var visitHref = function (id) { return '/app/cashier?visit=' + id + (searchTerm ? '&q=' + encodeURIComponent(searchTerm) : ''); };
  var waitText = function (a) { return a.waited === null || a.waited === undefined ? '' : a.waited >= 60 ? t('cashier.waited_h', { h: Math.floor(a.waited / 60), m: a.waited % 60 }) : t('cashier.waited_m', { n: a.waited }); };
  var visitItem = function (a, showDate) {
    var sel = bill && bill.a.id === a.id;
    return '<li><a class="cs-visit' + (sel ? ' is-selected' : '') + '" href="' + visitHref(a.id) + '"' + (sel ? ' aria-current="true"' : '') + '>'
      + '<span class="cs-visit-main"><span class="cs-visit-name"><bdi>' + escapeHtml(a.patient_name) + '</bdi></span>'
      + '<span class="cs-visit-sub">' + (a.doctor_id ? dot(a.doctor_color) + escapeHtml(L(a.doctor_name, a.doctor_name_en)) : escapeHtml(t('cashier.no_doctor')))
      + (a.service_name ? ' · ' + escapeHtml(L(a.service_name, a.service_name_en)) : '') + '</span></span>'
      + '<span class="cs-visit-side"><span class="cs-visit-amount num">' + escapeHtml(money(a.amount_due)) + '</span>'
      + '<span class="cs-visit-meta">' + (showDate ? escapeHtml(fmt.date(a.appointment_date)) : escapeHtml(t('cashier.stage.' + a.stage)) + (a.waited !== null && a.waited !== undefined && a.stage !== 'done' ? ' · <span class="' + (a.waited >= 30 ? 'cs-late' : '') + '">' + escapeHtml(waitText(a)) + '</span>' : '')) + '</span></span>'
      + '</a></li>';
  };
  var otherMethods = methods.filter(function (m) { return m !== 'cash' && totals.byMethod[m] > 0; });
%>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><%= t('nav.group_clinic') %></div>
    <h1><%= t('cashier.title') %></h1>
    <p><%= fmt.date(clinicToday, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/app/cashier/screen?fs=1" data-cx-open-screen><%- icon('maximize', 'icon-sm') %><%= t('cashx.open_screen') %></a>
    <a class="btn btn-secondary" href="/app/cashier/closings"><%- icon('banknote', 'icon-sm') %><%= t('cashier.close_drawer_link') %></a>
  </div>
</div>

<section class="cs-strip" aria-label="<%= t('cashier.today_totals') %>">
  <div class="cs-strip-cell">
    <div class="cs-strip-label"><%= t('cashier.collected_today') %></div>
    <div class="cs-strip-value num"><%= money(totals.total) %> <span class="cs-cur"><%= currency %></span></div>
    <div class="cs-strip-meta"><%= t('cashier.receipts_n', { n: fmt.number(totals.count) }) %></div>
  </div>
  <div class="cs-strip-cell">
    <div class="cs-strip-label"><%= t('cashier.by_method') %></div>
    <dl class="cs-methods">
      <div><dt><%= label('payment_methods', 'cash') %></dt><dd class="num"><%= money(totals.byMethod.cash) %></dd></div>
      <% (otherMethods.length ? otherMethods : ['card']).forEach(function (m) { %><div><dt><%= label('payment_methods', m) %></dt><dd class="num"><%= money(totals.byMethod[m]) %></dd></div><% }) %>
    </dl>
  </div>
  <% if (period) { %>
  <a class="cs-strip-cell cs-strip-link" href="/app/cashier/closings">
    <div class="cs-strip-label"><%= t('cashier.in_drawer') %></div>
    <div class="cs-strip-value num"><%= money(period.expected) %> <span class="cs-cur"><%= currency %></span></div>
    <div class="cs-strip-meta"><% var ps = localTime(period.start); %><%= period.sinceClosing ? t('cashier.since_closing', { time: ps.time, date: fmt.date(ps.date) }) : t('cashier.since_today') %> · <%= t('cashier.cash_receipts_n', { n: fmt.number(period.count) }) %></div>
  </a>
  <% } %>
</section>

<% if (typeof done !== 'undefined' && done) { %>
<dialog class="dialog cx-dialog cx-done-dialog" id="cx-done-dialog" data-open-on-load data-cx-done>
  <div class="dialog-inner"><%- include('_done', { done: done }) %></div>
</dialog>
<% } %>

<div class="cs-layout<%= bill ? ' has-bill' : '' %>">
  <aside class="cs-side" aria-label="<%= t('cashier.queue_title') %>">
    <form class="cs-search" method="get" action="/app/cashier" role="search">
      <% if (visitId) { %><input type="hidden" name="visit" value="<%= visitId %>"><% } %>
      <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= searchTerm %>" placeholder="<%= t('cashier.search_ph') %>" aria-label="<%= t('cashier.search_ph') %>" data-cs-search autocomplete="off"></div>
      <span class="kbd cs-kbd" aria-hidden="true">/</span>
    </form>

    <% if (searchTerm) { %>
    <section class="cs-block cs-block-results">
      <div class="cs-block-head"><h2><%= t('cashier.search_results') %></h2><a class="btn btn-ghost btn-sm" href="<%= visitId ? '/app/cashier?visit=' + visitId : '/app/cashier' %>"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a></div>
      <% if (searchTerm.length < 2) { %><p class="cs-empty-line"><%= t('cashier.search_short') %></p>
      <% } else if (!results.length) { %><p class="cs-empty-line"><%= t('cashier.search_none', { days: 30 }) %></p>
      <% } else { %><ul class="cs-list"><% results.forEach(function (a) { %><%- visitItem(a, true) %><% }) %></ul><% } %>
    </section>
    <% } %>

    <section class="cs-block">
      <div class="cs-block-head"><h2><%= t('cashier.queue_title') %></h2><span class="badge badge-neutral"><%= fmt.number(queue.length) %></span></div>
      <% if (!queue.length) { %><p class="cs-empty-line"><%= t('cashier.queue_empty') %></p>
      <% } else { %><ul class="cs-list"><% queue.forEach(function (a) { %><%- visitItem(a, false) %><% }) %></ul><% } %>
    </section>

    <section class="cs-block cs-block-receipts">
      <div class="cs-block-head"><h2><%= t('cashier.recent_receipts') %></h2><% if (can('billing.view')) { %><a class="link small" href="/app/billing"><%= t('cashier.all_invoices') %></a><% } %></div>
      <% if (!receipts.length) { %><p class="cs-empty-line"><%= t('cashier.receipts_empty') %></p>
      <% } else { %>
      <ul class="cs-receipts">
        <% receipts.forEach(function (r) { var lt = localTime(r.created_at) || {}; %>
        <li>
          <a class="cs-receipt" href="/app/billing/<%= r.id %>">
            <span class="mono">#<%= r.invoice_number %></span>
            <span class="grow truncate"><bdi><%= r.patient_name %></bdi></span>
            <span class="num strong"><%= money(r.amount) %></span>
          </a>
          <span class="cs-receipt-meta"><span dir="ltr"><%= lt.time %></span> · <%= label('payment_methods', r.payment_method) %></span>
          <a class="btn btn-ghost btn-icon btn-sm" href="/app/billing/<%= r.id %>?print=1&autoprint=1" title="<%= t('cashier.reprint') %>" aria-label="<%= t('cashier.reprint') %> #<%= r.invoice_number %>"><%- icon('printer', 'icon-sm') %></a>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </section>
  </aside>

  <main class="cs-main">
    <% if (!bill) { %>
    <div class="cs-placeholder">
      <span class="cs-placeholder-icon"><%- icon('receipt-text') %></span>
      <h2><%= t('cashier.pick_title') %></h2>
      <p class="muted"><%= t('cashier.pick_text') %></p>
      <% if (queue.length) { %><a class="btn btn-secondary" href="<%= visitHref(queue[0].id) %>"><%= t('cashier.open_first', { name: queue[0].patient_name }) %></a><% } %>
    </div>
    <% } else { %>
    <div class="cx-inline-panel"><%- include('_panel', panel) %></div>
    <% } %>
  </main>
</div>
