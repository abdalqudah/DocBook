<%
  /* Cash screen header: today's collections (cash / card split). Locals: scr. Re-rendered by /app/cashier/screen/board. */
  var _tt = scr.totals; var _other = 0;
  Object.keys(_tt.byMethod).forEach(function (m) { if (m !== 'cash' && m !== 'card') _other += Number(_tt.byMethod[m]) || 0; });
%>
<dl class="cx-totals" aria-label="<%= t('cashx.collected_today') %>">
  <div class="cx-total-main"><dt><%= t('cashx.collected_today') %></dt><dd><span class="num"><%= fmt.amount(_tt.total) %></span> <span class="cx-cur"><%= currency %></span></dd></div>
  <div><dt><span class="cx-mdot" aria-hidden="true"></span><%= t('cashx.method.cash') %></dt><dd class="num"><%= fmt.amount(_tt.byMethod.cash) %></dd></div>
  <div><dt><span class="cx-mdot is-card" aria-hidden="true"></span><%= t('cashx.method.card') %></dt><dd class="num"><%= fmt.amount(_tt.byMethod.card) %></dd></div>
  <% if (_other > 0) { %><div><dt><%= t('cashx.other_methods') %></dt><dd class="num"><%= fmt.amount(_other) %></dd></div><% } %>
  <div><dt><%= t('cashx.receipts') %></dt><dd class="num"><%= fmt.number(_tt.count) %></dd></div>
</dl>
