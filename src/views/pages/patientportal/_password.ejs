<% var _n = typeof pwName !== 'undefined' ? pwName : 'password'; var _l = typeof pwLabel !== 'undefined' ? pwLabel : t('pportal.password'); var _ac = typeof pwAuto !== 'undefined' ? pwAuto : 'current-password'; %>
<div class="field">
  <div class="row between"><label class="label" for="pp-<%= _n %>"><%= _l %><span class="req">*</span></label><% if (typeof pwForgot !== 'undefined' && pwForgot) { %><a class="link small" href="<%= pwForgot %>"><%= t('pportal.forgot') %></a><% } %></div>
  <div class="pp-pw">
    <input class="input" id="pp-<%= _n %>" name="<%= _n %>" type="password"<%= typeof pwOptional !== 'undefined' && pwOptional ? '' : ' required' %> autocomplete="<%= _ac %>" dir="ltr"<%- _ac === 'new-password' ? ' minlength="8"' : '' %>>
    <button class="btn btn-ghost btn-icon btn-sm pp-pw-eye" type="button" data-pw-eye aria-label="<%= t('pportal.show_password') %>" aria-pressed="false" data-label-show="<%= t('pportal.show_password') %>" data-label-hide="<%= t('pportal.hide_password') %>"><span data-eye-on><%- icon('eye', 'icon-sm') %></span><span data-eye-off hidden><%- icon('eye-off', 'icon-sm') %></span></button>
  </div>
</div>
