<% var S = 'surgeries.'; var qs = function (o) { var p = Object.assign({ when: f.when, doctor: f.doctor || '', hospital: f.hospital || '' }, o); return '?' + Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + '=' + encodeURIComponent(p[k]); }).join('&'); };
   var end = function (s) { if (!s.duration_minutes) return ''; var a = String(s.surgery_time).split(':'); var x = Number(a[0]) * 60 + Number(a[1]) + Number(s.duration_minutes); return ('0' + (Math.floor(x / 60) % 24)).slice(-2) + ':' + ('0' + (x % 60)).slice(-2); };
   var tone = { scheduled: 'badge-info', done: 'badge-success', cancelled: 'badge-neutral' }; %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><%= t('navx.sec_patients') %></div>
    <h1><%= t(S + 'title') %></h1>
    <p><%= t(S + 'lead') %></p>
  </div>
  <div class="page-actions">
    <% if (canAdd) { %><a class="btn btn-primary" href="/app/appointments?surgery=1<%= ctx.ownDoctorId ? '&doctor=' + ctx.ownDoctorId : '' %>"><%- icon('scissors', 'icon-sm') %><%= t(S + 'add') %></a><% } %>
  </div>
</div>
<div class="panel flush">
  <div class="panel-body">
    <form class="row-sm" style="flex-wrap:wrap" method="get" data-autosubmit role="search">
      <div class="segmented">
        <% ['upcoming', 'past', 'all'].forEach(function (w) { %><a href="<%= qs({ when: w }) %>" class="<%= f.when === w ? 'active' : '' %>"><%= t(S + 'when.' + w) %></a><% }) %>
      </div>
      <input type="hidden" name="when" value="<%= f.when %>">
      <% if (doctors.length > 1) { %><select class="select" name="doctor" aria-label="<%= t('common.doctor') %>" style="max-width:220px"><option value=""><%= t('common.all_doctors') %></option><% doctors.forEach(function (d) { %><option value="<%= d.id %>"<%= f.doctor === d.id ? ' selected' : '' %>><%= L(d.full_name, d.full_name_en) %></option><% }) %></select><% } %>
      <% if (hospitals.length) { %><select class="select" name="hospital" aria-label="<%= t(S + 'hospital') %>" style="max-width:220px"><option value=""><%= t(S + 'all_hospitals') %></option><% hospitals.forEach(function (h) { %><option value="<%= h.id %>"<%= f.hospital === h.id ? ' selected' : '' %>><%= h.name %></option><% }) %></select><% } %>
      <noscript><button class="btn btn-secondary" type="submit"><%= t('common.filter') %></button></noscript>
    </form>
  </div>
  <% if (!days.length) { %>
  <div class="empty"><%- icon('scissors') %><h3><%= t(S + 'empty_title') %></h3><p><%= t(S + 'empty_' + f.when) %></p><% if (canAdd) { %><a class="btn btn-secondary" href="/app/appointments?surgery=1"><%= t(S + 'add') %></a><% } %></div>
  <% } else { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th><%= t(S + 'col_time') %></th><th><%= t('common.patient') %></th><th><%= t(S + 'procedure') %></th><th><%= t(S + 'hospital') %></th><th><%= t('common.doctor') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
      <% days.forEach(function (d) { %>
      <tbody>
        <tr class="table-group"><th colspan="7"><%= fmt.date(d.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %> <span class="muted small">· <%= t(S + 'n', { n: fmt.number(d.rows.length) }) %></span></th></tr>
        <% d.rows.forEach(function (s) { %>
        <tr data-href="/app/surgeries/<%= s.id %>">
          <td data-label="<%= t(S + 'col_time') %>" class="nowrap"><bdi dir="ltr" class="strong"><%= s.surgery_time %><%= end(s) ? '–' + end(s) : '' %></bdi></td>
          <td class="primary-cell"><a class="strong" href="/app/surgeries/<%= s.id %>" dir="auto"><%= s.patient_name %></a><% if (s.patient_phone) { %><div class="small muted"><bdi dir="ltr"><%= s.patient_phone %></bdi></div><% } %></td>
          <td data-label="<%= t(S + 'procedure') %>"><%= s.procedure_name %></td>
          <td data-label="<%= t(S + 'hospital') %>"><%= s.hospital_name || '—' %><% if (s.sent_at) { %><div class="tiny muted sx-sent"><%- icon(s.sent_channel === 'whatsapp' ? 'message-circle' : 'mail', 'icon-sm') %><%= t(S + 'sent_short', { date: fmt.date(s.sent_at, { day: 'numeric', month: 'short' }) }) %></div><% } %></td>
          <td data-label="<%= t('common.doctor') %>"><%= s.doctor_id ? L(s.doctor_name, s.doctor_name_en) : '—' %></td>
          <td data-label="<%= t('common.status') %>"><span class="badge <%= tone[s.status] %>"><%= t(S + 'status.' + s.status) %></span></td>
          <td class="actions"><a class="btn btn-ghost btn-icon btn-sm" href="/app/surgeries/<%= s.id %>" aria-label="<%= t('common.open') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a></td>
        </tr>
        <% }) %>
      </tbody>
      <% }) %>
    </table>
  </div>
  <% } %>
</div>
