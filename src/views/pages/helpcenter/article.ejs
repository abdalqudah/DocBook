<%# /help/<slug> — one help article and others on the same topic. %>
<section class="section"><div class="container" style="max-width:820px" data-help-article>
  <div class="breadcrumbs small mb-2"><a class="link" href="/help"><%= t('helpc.title') %></a> · <%= t('helpc.cat_' + a.category) %></div>
  <h1><%= title %></h1>
  <article class="doc-body mt-4"><%- html %></article>
  <% if (related.length) { %><div class="panel mt-6"><div class="panel-head"><div><h2><%= t('helpc.related') %></h2></div></div><ul class="panel-body stack-sm" style="list-style:none;margin:0"><% related.forEach(function (r) { %><li><a class="link" href="/help/<%= r.slug %>"><%= r.title %></a></li><% }) %></ul></div><% } %>
  <p class="small muted mt-6"><%= t('helpc.still') %> <a class="link" href="/signup"><%= t('helpc.start') %></a></p>
</div></section>
