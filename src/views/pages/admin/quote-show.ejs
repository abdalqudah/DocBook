<%# Admin → Quotations → one: the document, its state and link, send by e-mail / WhatsApp, the conversation and reply, the sends. %>
<% var money = function (v) { return fmt.money(v, q.currency); }; var d = function (v) { return v ? fmt.date(v instanceof Date ? v.toISOString().slice(0, 10) : String(v).slice(0, 10)) : ''; };
   var dt = function (v) { try { return new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'ar-EG-u-nu-latn', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(v)); } catch (e) { return ''; } };
   var closed = ['accepted', 'declined'].indexOf(q.status) >= 0; %>
<div class="page-head">
  <div><div class="breadcrumbs"><a href="/admin/quotes"><%= t('sales.quotes') %></a></div>
    <h1 dir="ltr" style="text-align:start"><%= q.number %></h1>
    <p><span class="badge badge-dot <%= state === 'accepted' ? 'badge-success' : state === 'negotiating' ? 'badge-warning' : 'badge-info' %>" data-quote-state="<%= state %>"><%= t('sales.state_' + state) %></span>
      <%= q.customer_name %><%= q.customer_company ? ' · ' + q.customer_company : '' %> · <span class="strong"><%= money(q.total) %></span><% if (q.revision > 1) { %> · <%= t('sales.revision_n', { n: q.revision }) %><% } %>
      <% if (q.view_count) { %> · <%- icon('eye', 'icon-sm') %> <%= t('sales.viewed_n', { n: q.view_count }) %><% } %></p></div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="<%= doc.link %>" target="_blank" rel="noopener"><%- icon('external-link', 'icon-sm') %><%= t('sales.open_link') %></a>
    <% if (!closed) { %><a class="btn btn-ghost" href="/admin/quotes/<%= q.id %>/edit"><%- icon('pencil', 'icon-sm') %><%= q.status === 'draft' ? t('common.edit') : t('sales.revise') %></a><% } %>
    <form method="post" action="/admin/quotes/<%= q.id %>/duplicate" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost" type="submit"><%- icon('copy', 'icon-sm') %><%= t('sales.duplicate') %></button></form>
  </div>
</div>

<div class="grid grid-main" style="align-items:start">
  <div class="stack">
    <section class="panel"><div class="panel-head"><div><h2><%= t('sales.lines') %></h2><div class="panel-sub"><%= t('sales.issue_date') %>: <%= d(q.issue_date) %> · <%= t('sales.valid_until') %>: <%= d(q.valid_until) %></div></div></div>
      <div class="table-wrap"><table class="table">
        <thead><tr><th><%= t('sales.item') %></th><th class="num"><%= t('sales.qty') %></th><th class="num"><%= t('sales.price') %></th><th class="num"><%= t('sales.amount') %></th></tr></thead>
        <tbody><% q.items.forEach(function (it) { %><tr><td style="white-space:pre-wrap"><%= it.description %></td><td class="num"><%= Number(it.quantity) %></td><td class="num"><%= money(it.unit_price) %></td><td class="num"><%= money(it.amount) %></td></tr><% }) %></tbody>
        <tfoot>
          <tr><td colspan="3" class="num"><%= t('sales.subtotal') %></td><td class="num"><%= money(q.subtotal) %></td></tr>
          <% if (Number(q.discount)) { %><tr><td colspan="3" class="num"><%= t('sales.discount') %></td><td class="num">− <%= money(q.discount) %></td></tr><% } %>
          <tr><td colspan="3" class="num"><%= t('sales.tax') %> (<%= Number(q.tax_rate) %>%)</td><td class="num"><%= money(q.tax) %></td></tr>
          <tr><td colspan="3" class="num strong"><%= t('sales.total') %></td><td class="num strong"><%= money(q.total) %></td></tr>
        </tfoot></table></div></section>

    <% if (q.status === 'accepted') { %>
    <section class="panel"><div class="panel-body row-sm wrap" style="align-items:center">
      <div class="grow"><div class="strong"><%- icon('circle-check', 'icon-sm') %> <%= t('sales.accepted_by', { name: q.response_name }) %><% if (q.signer_title) { %> · <%= q.signer_title %><% } %></div><div class="small muted"><%= dt(q.responded_at) %><% if (q.response_ip) { %> · <bdi dir="ltr"><%= q.response_ip %></bdi><% } %></div></div>
      <img src="/quote/<%= q.token %>/signature.png" alt="<%= t('sales.signature') %>" style="max-height:80px;max-width:240px"></div></section>
    <% } else if (q.status === 'declined') { %>
    <div class="alert alert-info"><%- icon('info', 'icon-sm') %><div class="grow"><%= t('sales.declined_by', { name: q.response_name || q.customer_name }) %><% if (q.decline_reason) { %> · <%= t('sales.reason_' + q.decline_reason) %><% } %><% if (q.response_note) { %><div class="small"><%= q.response_note %></div><% } %></div></div>
    <% } %>

    <section class="panel" id="conversation"><div class="panel-head"><div><h2><%= t('sales.conversation') %></h2></div></div>
      <div class="panel-body stack-sm">
        <% if (!events.length) { %><p class="small muted"><%= t('sales.no_events') %></p><% } %>
        <% events.forEach(function (e) { %><div class="small" data-quote-event="<%= e.type %>"><span class="badge"><%= t('sales.ev_' + e.type) %></span> <span class="muted"><%= e.by === 'team' ? (e.user_name || t('sales.team')) : (e.name || q.customer_name) %> · <%= dt(e.created_at) %></span>
          <% if (e.amount !== null && e.amount !== undefined && e.type !== 'accepted') { %> · <span class="strong"><%= money(e.amount) %></span><% } %>
          <% if (e.message) { %><div style="white-space:pre-wrap"><%= e.message %></div><% } %></div><% }) %>
        <% if (!closed && q.status !== 'draft') { %>
        <form method="post" action="/admin/quotes/<%= q.id %>/reply" class="stack-sm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea class="textarea" name="message" rows="3" required placeholder="<%= t('sales.reply_ph') %>"></textarea>
          <div><button class="btn btn-primary btn-sm" type="submit"><%- icon('send', 'icon-sm') %><%= t('sales.reply') %></button></div>
        </form><% } %>
      </div></section>

    <section class="panel"><div class="panel-head"><div><h2><%= t('sales.sends') %></h2></div></div>
      <div class="panel-body"><% if (!sends.length) { %><p class="small muted"><%= t('sales.no_sends') %></p><% } else { %>
        <ul class="stack-sm" style="list-style:none;padding:0;margin:0" data-sends><% sends.forEach(function (s) { %>
          <li class="small"><%- icon(s.channel === 'email' ? 'mail' : 'message-circle', 'icon-sm') %> <bdi dir="ltr"><%= s.recipient %></bdi> · <span class="badge <%= s.status === 'failed' ? 'badge-danger' : 'badge-success' %>"><%= t('sales.send_' + s.status) %></span> <span class="muted"><%= dt(s.created_at) %><%= s.user_name ? ' · ' + s.user_name : '' %></span><% if (s.error) { %><div class="tiny muted"><%= s.error %></div><% } %></li>
        <% }) %></ul><% } %></div></section>
  </div>

  <div class="stack">
    <section class="panel"><div class="panel-head"><div><h2><%= t('sales.customer_link') %></h2></div></div>
      <div class="panel-body stack-sm"><input class="input" dir="ltr" readonly value="<%= doc.link %>">
        <% if (q.status === 'draft') { %><form method="post" action="/admin/quotes/<%= q.id %>/mark-sent"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%= t('sales.mark_sent') %></button></form><% } %></div></section>

    <%- include('../../partials/doc-send', { doc: doc, action: '/admin/quotes/' + q.id }) %>

    <% if (q.status === 'draft') { %>
    <form method="post" action="/admin/quotes/<%= q.id %>/delete" data-confirm="<%= t('sales.delete_confirm') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('common.delete') %></button></form>
    <% } %>
  </div>
</div>
<script src="/js/sales.js?v=<%= assetV %>" defer></script>
