<div class="page-head"><div><h1><%= t('admin.nav_clinics') %></h1><p><%= t('admin.clinics_sub') %></p></div></div>
<section class="panel flush">
  <form class="table-toolbar" method="get" action="/admin/clinics" data-autosubmit>
    <div class="input-group"><%- icon('search') %><input class="input" type="search" name="q" value="<%= q %>" placeholder="<%= t('admin.search_clinics') %>" aria-label="<%= t('admin.search_clinics') %>"></div>
    <select class="select" name="status" aria-label="<%= t('admin.col_status') %>">
      <option value=""><%= t('common.all') %></option>
      <option value="active"<%= status === 'active' ? ' selected' : '' %>><%= t('admin.status_active') %></option>
      <option value="suspended"<%= status === 'suspended' ? ' selected' : '' %>><%= t('admin.status_suspended') %></option>
    </select>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.search') %></button></noscript>
  </form>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', { emptyIcon: 'hospital', emptyTitle: t('admin.no_clinics') }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th><%= t('admin.col_clinic') %></th><th><%= t('admin.col_address') %></th><th class="num"><%= t('admin.col_staff') %></th><th class="num"><%= t('admin.col_doctors') %></th><th class="num"><%= t('admin.col_appts') %></th><th><%= t('admin.col_status') %></th><th><%= t('admin.col_created') %></th><th><%= t('admin.col_storage') %></th><th><%= t('admin.col_backup') %></th><th class="actions"></th></tr></thead>
      <tbody>
        <% rows.forEach(function (b) { %>
        <tr data-href="/admin/clinics/<%= b.id %>">
          <td class="primary-cell"><div class="person"><span class="avatar"><%= initials(b.name) %></span><div><a class="person-name" href="/admin/clinics/<%= b.id %>"><%= b.name %></a><div class="person-sub"><%= [b.name_en, b.city].filter(Boolean).join(' · ') || b.currency %></div></div></div></td>
          <td data-label="<%= t('admin.col_address') %>"><a class="link mono" href="/<%= b.slug %>" target="_blank" rel="noopener" dir="ltr">/<%= b.slug %></a></td>
          <td class="num" data-label="<%= t('admin.col_staff') %>"><%= fmt.number(Number(b.staff)) %></td>
          <td class="num" data-label="<%= t('admin.col_doctors') %>"><%= fmt.number(Number(b.doctors)) %></td>
          <td class="num" data-label="<%= t('admin.col_appts') %>"><%= fmt.number(Number(b.appts)) %></td>
          <td data-label="<%= t('admin.col_status') %>"><span class="badge <%= b.status === 'active' ? 'badge-success' : 'badge-danger' %> badge-dot"><%= t('admin.status_' + b.status) %></span></td>
          <td data-label="<%= t('admin.col_created') %>" class="nowrap"><%= fmt.date(b.created_at) %></td>
          <td data-label="<%= t('admin.col_storage') %>" class="nowrap"><% var _sz = function (n) { if (n === null) return t('admin.storage_unl'); return n >= 1073741824 ? fmt.number(Math.round(n / 107374182.4) / 10) + ' ' + t('media_lib.gb') : n >= 1048576 ? fmt.number(Math.round(n / 104857.6) / 10) + ' ' + t('media_lib.mb') : fmt.number(Math.round(n / 1024)) + ' ' + t('media_lib.kb'); }; var _p = b.storage.quota ? Math.round(b.storage.bytes * 100 / b.storage.quota) : 0; %><a class="link" href="/admin/clinics/<%= b.id %>#storage"><bdi class="num small"><%= _sz(b.storage.bytes) %> / <%= _sz(b.storage.quota) %></bdi></a><% if (b.storage.quota) { %><span class="meter<%= _p >= 100 ? ' full' : _p >= 80 ? ' warn' : '' %>" style="margin-top:4px;min-width:90px" aria-hidden="true"><span style="width:<%= Math.min(100, _p) %>%"></span></span><% } %></td>
          <td data-label="<%= t('admin.col_backup') %>" class="nowrap"><% if (b.lastBackup) { %><span class="badge <%= Date.now() - new Date(b.lastBackup).getTime() < 36 * 3600000 ? 'badge-success' : 'badge-warning' %> badge-dot"><%= fmt.date(b.lastBackup, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span><% } else { %><span class="badge badge-neutral"><%= t('admin.backup.never') %></span><% } %></td>
          <td class="actions">
            <form method="post" action="/admin/clinics/<%= b.id %>/status" data-confirm="<%= t(b.status === 'active' ? 'admin.suspend_confirm' : 'admin.activate_confirm', { name: b.name }) %>" data-confirm-yes="<%= t(b.status === 'active' ? 'admin.suspend' : 'admin.activate') %>"<% if (b.status !== 'active') { %> data-confirm-tone="primary"<% } %>>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= b.status === 'active' ? 'suspended' : 'active' %>">
              <button class="btn btn-sm <%= b.status === 'active' ? 'btn-danger-ghost' : 'btn-secondary' %>" type="submit"><%- icon(b.status === 'active' ? 'lock' : 'refresh-cw', 'icon-sm') %><%= t(b.status === 'active' ? 'admin.suspend' : 'admin.activate') %></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/pagination', { meta: meta }) %>
  <% } %>
</section>
<section class="panel mt-6" id="restore-file">
  <div class="panel-head"><div><h2><%- icon('archive-restore', 'icon-sm') %> <%= t('admin.backup.from_file') %></h2><p class="panel-sub"><%= t('admin.backup.from_file_sub') %></p></div></div>
  <form class="panel-body row-sm wrap" method="post" action="/admin/clinics/restore" enctype="multipart/form-data" data-confirm="<%= t('admin.backup.confirm_file') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input class="input" type="file" name="file" accept=".dbk" required aria-label="<%= t('admin.backup.file') %>">
    <input class="input" type="password" name="password" required autocomplete="current-password" placeholder="<%= t('admin.backup.your_password') %>" aria-label="<%= t('admin.backup.your_password') %>" style="max-width:240px">
    <button class="btn btn-danger" type="submit"><%= t('admin.backup.restore_now') %></button>
  </form>
</section>
