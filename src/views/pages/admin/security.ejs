<%# Admin → Settings → Two-step sign-in: set up the authenticator app, recovery codes, turn it off. %>
<div class="page-head"><div><h1><%= t('tfa.admin_title') %></h1><p><%= t('tfa.admin_lead') %></p></div></div>
<% if (codes) { %>
<section class="panel mb-4" data-tfa-codes><div class="panel-head"><div><h2><%- icon('key-round', 'icon-sm') %> <%= t('tfa.codes_title') %></h2><div class="panel-sub"><%= t('tfa.codes_lead') %></div></div></div>
  <div class="panel-body"><div class="grid grid-2" dir="ltr" style="font-family:monospace;font-size:1.05rem"><% codes.forEach(function (c) { %><div><%= c %></div><% }) %></div></div></section>
<% } %>
<% if (on) { %>
<section class="panel"><div class="panel-body stack-sm">
  <div class="row-sm"><span class="badge badge-success badge-dot"><%= t('tfa.on') %></span><span class="small muted"><%= t('tfa.codes_left', { n: left }) %></span></div>
  <form method="post" action="/admin/security/disable" class="row-sm wrap" data-tfa-disable>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input class="input" name="code" inputmode="numeric" dir="ltr" placeholder="<%= t('tfa.code') %>" required style="max-width:200px">
    <button class="btn btn-danger btn-sm" type="submit"><%= t('tfa.turn_off') %></button>
  </form>
  <% if (errors.code) { %><span class="field-error"><%= errors.code %></span><% } %>
</div></section>
<% } else if (setup) { %>
<section class="panel"><div class="panel-body stack">
  <ol class="small" style="margin:0;padding-inline-start:18px"><li><%= t('tfa.step1') %></li><li><%= t('tfa.step2') %></li><li><%= t('tfa.step3') %></li></ol>
  <div style="max-width:220px;background:var(--surface);padding:8px;border-radius:var(--radius)" data-tfa-qr><%- setup.qr %></div>
  <div class="small"><%= t('tfa.manual') %> <code dir="ltr" data-tfa-secret><%= setup.secret %></code></div>
  <form method="post" action="/admin/security/enable" class="row-sm wrap">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input class="input<%= errors.code ? ' is-invalid' : '' %>" name="code" inputmode="numeric" autocomplete="one-time-code" dir="ltr" placeholder="123456" required style="max-width:200px">
    <button class="btn btn-primary" type="submit"><%= t('tfa.turn_on') %></button>
  </form>
  <% if (errors.code) { %><span class="field-error"><%= errors.code %></span><% } %>
</div></section>
<% } else { %>
<section class="panel"><div class="panel-body stack-sm">
  <span class="badge badge-neutral badge-dot"><%= t('tfa.off') %></span>
  <form method="post" action="/admin/security/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit"><%- icon('shield-check', 'icon-sm') %><%= t('tfa.set_up') %></button></form>
</div></section>
<% } %>
