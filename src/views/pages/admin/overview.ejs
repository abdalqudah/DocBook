<div class="page-head">
  <div><h1><%= t('admin.nav_overview') %></h1><p><%= t('admin.overview_sub') %></p></div>
  <div class="page-actions"><a class="btn btn-secondary" href="/admin/site"><%- icon('layout-template', 'icon-sm') %><%= t('admin.nav_site') %></a></div>
</div>
<% if (typeof appUrlWarning !== 'undefined' && appUrlWarning) { %><div class="alert alert-warning mb-4" role="alert"><%- icon('triangle-alert') %><div class="grow small"><div class="alert-title"><%= t('attendance.app_url_title') %></div><div><%= t('attendance.app_url_text', { current: appUrlWarning.current || '—', suggested: appUrlWarning.suggested }) %></div></div></div><% } %>
<div class="stats">
  <div class="stat hero"><div class="stat-label"><%= t('admin.stat_clinics') %><span class="stat-icon"><%- icon('hospital') %></span></div><div class="stat-value"><%= fmt.number(stats.clinics) %></div><div class="stat-meta"><%= t('admin.stat_clinics_meta', { active: fmt.number(stats.active), suspended: fmt.number(stats.suspended) }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_users') %><span class="stat-icon info"><%- icon('users') %></span></div><div class="stat-value"><%= fmt.number(stats.users) %></div><div class="stat-meta"><%= t('admin.stat_users_meta', { n: fmt.number(stats.activeUsers) }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_appts') %><span class="stat-icon"><%- icon('calendar-check') %></span></div><div class="stat-value"><%= fmt.number(stats.appts) %></div><div class="stat-meta"><%= t('admin.stat_appts_meta') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_online') %><span class="stat-icon accent"><%- icon('globe') %></span></div><div class="stat-value"><%= fmt.number(stats.online) %></div><div class="stat-meta"><%= t('admin.stat_online_meta', { pct: fmt.pct(stats.appts ? stats.online / stats.appts * 100 : 0) }) %></div></div>
</div>
<% if (typeof dbPending !== 'undefined' && dbPending.length) { %><div class="alert alert-warning mt-4"><%- icon('database') %><div class="grow"><%= t('admin.db_pending', { n: dbPending.length }) %></div><a class="btn btn-secondary btn-sm" href="/admin/updates"><%= t('admin.db_open') %></a></div><% } %>
<div class="stats mt-4">
  <div class="stat"><div class="stat-label"><%= t('admin.stat_backups') %><span class="stat-icon <%= stats.backedUp < stats.backupTotal ? 'warning' : 'success' %>"><%- icon('database') %></span></div><div class="stat-value"><%= fmt.number(stats.backedUp) %> / <%= fmt.number(stats.backupTotal) %></div><div class="stat-meta"><%= t('admin.stat_backups_meta') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_sent') %><span class="stat-icon"><%- icon('send') %></span></div><div class="stat-value"><%= fmt.number(stats.sent) %></div><div class="stat-meta"><%= t('admin.stat_appts_meta') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_screens') %><span class="stat-icon info"><%- icon('monitor') %></span></div><div class="stat-value"><%= fmt.number(stats.screens) %></div><div class="stat-meta"><%= t('admin.stat_screens_meta') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_centres') %><span class="stat-icon"><%- icon('pill-bottle') %></span></div><div class="stat-value"><%= fmt.number(stats.centreSends) %></div><div class="stat-meta"><%= t('admin.stat_centres_meta', { n: fmt.number(stats.centreClinics) }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_mailboxes') %><span class="stat-icon info"><%- icon('mail') %></span></div><div class="stat-value"><%= fmt.number(stats.mailboxes) %></div><div class="stat-meta"><%= t('admin.stat_mailboxes_meta') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_moves') %><span class="stat-icon"><%- icon('package') %></span></div><div class="stat-value"><%= fmt.number(stats.moves) %></div><div class="stat-meta"><%= t('admin.stat_appts_meta') %></div></div>
  <% var _sz = function (n) { if (n === null) return t('admin.storage_unl'); return n >= 1073741824 ? fmt.number(Math.round(n / 107374182.4) / 10) + ' ' + t('media_lib.gb') : n >= 1048576 ? fmt.number(Math.round(n / 104857.6) / 10) + ' ' + t('media_lib.mb') : fmt.number(Math.round(n / 1024)) + ' ' + t('media_lib.kb'); }; %><div class="stat"><div class="stat-label"><%= t('admin.stat_storage') %><span class="stat-icon <%= stats.nearFull ? 'warning' : 'success' %>"><%- icon('database') %></span></div><div class="stat-value"><%= _sz(stats.storageBytes) %></div><div class="stat-meta"><%= stats.nearFull ? t('admin.stat_storage_near', { n: fmt.number(stats.nearFull) }) : t('admin.stat_storage_ok') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.stat_chats') %><span class="stat-icon accent"><%- icon('message-circle') %></span></div><div class="stat-value"><%= fmt.number(stats.chats) %></div><div class="stat-meta"><%= t('admin.stat_appts_meta') %></div></div>
</div>
<div class="grid grid-main mt-6">
  <section class="panel flush">
    <div class="panel-head"><h2><%= t('admin.recent_clinics') %></h2><a class="btn btn-ghost btn-sm" href="/admin/clinics"><%= t('common.view_all') %><%- icon('arrow-right', 'icon-sm flip-rtl') %></a></div>
    <div class="panel-body">
      <% if (!recentClinics.length) { %><%- include('../../partials/empty', { emptyIcon: 'hospital', emptyTitle: t('admin.no_clinics'), compact: true }) %><% } else { %>
      <ul class="action-list">
        <% recentClinics.forEach(function (b) { %>
        <li><a href="/admin/clinics/<%= b.id %>"><span class="action-icon brand"><%- icon('hospital', 'icon-sm') %></span><span class="grow"><span class="strong"><%= b.name %></span><span class="muted small" dir="ltr" style="display:block;text-align:start">/<%= b.slug %></span></span><span class="badge <%= b.status === 'active' ? 'badge-success' : 'badge-danger' %> badge-dot"><%= t('admin.status_' + b.status) %></span><span class="muted small nowrap hide-xs-admin"><%= fmt.date(b.created_at) %></span></a></li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </section>
  <section class="panel flush">
    <div class="panel-head"><h2><%= t('admin.recent_activity') %></h2></div>
    <div class="panel-body">
      <% if (!activity.length) { %><%- include('../../partials/empty', { emptyIcon: 'history', emptyTitle: t('admin.no_activity'), compact: true }) %><% } else { %>
      <ul class="feed">
        <% activity.forEach(function (a) { var nv = {}; try { nv = typeof a.new_values === 'string' ? JSON.parse(a.new_values || '{}') : (a.new_values || {}); } catch (e) {} %>
        <li><span class="dot"></span><div class="grow"><div class="what"><%= t('admin.act.' + a.action) !== 'admin.act.' + a.action ? t('admin.act.' + a.action) : a.action %><% if (nv && (nv.name || nv.email || nv.action)) { %> <span class="muted">· <%= nv.name || nv.email || nv.action %></span><% } %></div><div class="when"><%= a.user_name || '—' %> · <%= fmt.date(a.created_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></div></div></li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </section>
</div>
