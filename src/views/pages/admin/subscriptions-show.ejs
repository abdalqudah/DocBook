<%
  var L = function (ar, en) { return locale === 'en' && en ? en : ar; };
  var badge = function (s) { return s === 'expired' ? 'badge-danger' : s === 'past_due' ? 'badge-warning' : s === 'active' ? 'badge-success' : 'badge-neutral'; };
  var lim = function (v) { return v === null || v === undefined ? t('subscriptions.unlimited') : fmt.number(v); };
  var openInv = invoices.filter(function (i) { return i.status === 'open' || i.status === 'reported'; });
  var planOpts = [{ value: '', label: t('subscriptions_admin.no_plan') }].concat(plans.map(function (p) { return { value: p.id, label: L(p.name, p.name_en) + (p.is_active ? '' : ' (' + t('common.inactive') + ')') }; }));
  var cycleOpts = ['monthly', 'yearly'].map(function (c) { return { value: c, label: t('subscriptions.cycle.' + c) }; });
  var csrf = '<input type="hidden" name="_csrf" value="' + csrfToken + '">';
%>
<div class="page-head">
  <div><div class="breadcrumbs"><a href="/admin/subscriptions"><%= t('subscriptions_admin.subs_title') %></a></div><h1><%= b.name %></h1><p><%= [b.name_en, b.city, b.email].filter(Boolean).join(' · ') %></p></div>
  <div class="page-actions"><a class="btn btn-ghost" href="/admin/clinics/<%= b.id %>"><%- icon('hospital', 'icon-sm') %><%= t('subscriptions_admin.clinic_page') %></a></div>
</div>
<%- include('plans-tabs') %>

<% if (!sub) { %>
<section class="panel"><div class="panel-body"><%- include('../../partials/empty', { emptyIcon: 'receipt', emptyTitle: t('subscriptions_admin.no_sub'), emptyText: t('subscriptions_admin.no_sub_text') }) %></div></section>
<% } else { %>
<div class="grid grid-main">
  <div class="stack-lg">
    <section class="panel">
      <div class="panel-head"><div><h2><%= t('subscriptions.current_title') %></h2></div><span class="badge badge-dot <%= badge(sub.status) %>"><%= t('subscriptions.status.' + sub.status) %></span></div>
      <div class="panel-body stack">
        <% if (readOnly) { %><div class="alert alert-danger small"><%- icon('lock', 'icon-sm') %><div class="grow"><%= t('subscriptions_admin.readonly_now') %></div></div><% } %>
        <dl class="dl">
          <dt><%= t('subscriptions.plan') %></dt><dd><%= plan ? L(plan.name, plan.name_en) : (sub.status === 'comped' ? t('subscriptions.comped_plan') : t('subscriptions.trial_plan')) %> · <%= t('subscriptions.cycle.' + sub.billing_cycle) %> · <%= t('subscriptions.branches_n', { n: sub.branches || 1 }) %></dd>
          <% if (sub.trial_ends_at) { %><dt><%= t('subscriptions.trial_ends') %></dt><dd><%= fmt.date(sub.trial_ends_at) %></dd><% } %>
          <% if (sub.current_period_end) { %><dt><%= t('subscriptions.current_period') %></dt><dd><%= fmt.date(sub.current_period_start) %> – <%= fmt.date(sub.current_period_end) %></dd><% } %>
          <% if (sub.grace_ends_at) { %><dt><%= t('subscriptions.grace_ends') %></dt><dd><%= fmt.date(sub.grace_ends_at) %></dd><% } %>
          <% if (sub.cancelled_at) { %><dt><%= t('subscriptions_admin.cancelled_at') %></dt><dd><%= fmt.date(sub.cancelled_at) %></dd><% } %>
          <% if (sub.note) { %><dt><%= t('common.notes') %></dt><dd dir="auto"><%= sub.note %></dd><% } %>
          <dt><%= t('subscriptions_admin.owners') %></dt><dd><%= owners.map(function (o) { return o.name + ' <' + o.email + '>'; }).join('، ') || '—' %></dd>
        </dl>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head"><div><h2><%= t('subscriptions.usage_title') %></h2></div></div>
      <div class="panel-body">
        <dl class="dl">
          <dt><%= t('subscriptions.usage.doctors') %></dt><dd class="num"><%= fmt.number(usage.doctors) %> / <%= lim(limits.doctors) %></dd>
          <dt><%= t('subscriptions.usage.staff') %></dt><dd class="num"><%= fmt.number(usage.staff) %> / <%= lim(limits.staff) %></dd>
          <dt><%= t('subscriptions.usage.appointments') %></dt><dd class="num"><%= fmt.number(usage.appointments) %> / <%= lim(limits.appointments) %></dd>
        </dl>
      </div>
    </section>

    <section class="panel flush">
      <div class="panel-head"><div><h2><%= t('subscriptions.invoices_title') %></h2></div></div>
      <% if (!invoices.length) { %>
        <%- include('../../partials/empty', { compact: true, emptyIcon: 'receipt-text', emptyTitle: t('subscriptions.no_invoices') }) %>
      <% } else { %>
      <div class="table-wrap">
        <table class="table responsive">
          <thead><tr><th><%= t('subscriptions.invoice') %></th><th><%= t('subscriptions.period') %></th><th class="num"><%= t('common.amount') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
          <tbody>
            <% invoices.forEach(function (i) { %>
            <tr>
              <td class="primary-cell"><bdi class="mono small"><%= i.number %></bdi><div class="tiny muted"><%= L(i.plan_name, i.plan_name_en) || '—' %> · <%= t('subscriptions.cycle.' + i.billing_cycle) %><% if ((i.branches || 1) > 1) { %> · <%= t('subscriptions.branches_n', { n: i.branches }) %><% } %></div></td>
              <td data-label="<%= t('subscriptions.period') %>" class="small"><%= i.period_start ? fmt.date(i.period_start) + ' – ' + fmt.date(i.period_end) : '—' %></td>
              <td data-label="<%= t('common.amount') %>" class="num"><%= fmt.money(i.amount, i.currency) %></td>
              <td data-label="<%= t('common.status') %>">
                <span class="badge badge-dot <%= i.status === 'paid' ? 'badge-success' : i.status === 'reported' ? 'badge-warning' : 'badge-neutral' %>"><%= t('subscriptions.inv_status.' + i.status) %></span>
                <% if (i.method) { %><div class="tiny muted"><%= t('subscriptions.methods.' + i.method) %><% if (i.reference) { %> · <bdi class="mono"><%= i.reference %></bdi><% } %></div><% } %>
                <% if (i.notice_note) { %><div class="tiny muted" dir="auto"><%= i.notice_note %></div><% } %>
              </td>
              <td class="actions"><% if (i.status === 'open' || i.status === 'reported') { %><div class="row-sm">
                <button class="btn btn-secondary btn-sm" type="button" data-open-dialog="dlg-payment" data-fill='<%= JSON.stringify({ invoice_id: String(i.id), amount: String(i.amount), billing_cycle: i.billing_cycle, plan_id: String(i.plan_id || ""), method: i.method || "bank_transfer", reference: i.reference || "", period_start: "", period_end: "" }) %>'><%- icon('check', 'icon-sm') %><%= t('subscriptions_admin.confirm_payment') %></button>
                <form method="post" action="/admin/subscriptions/<%= b.id %>/invoices/<%= i.id %>/void" data-confirm="<%= t('subscriptions_admin.void_confirm', { number: i.number }) %>" data-confirm-yes="<%= t('subscriptions_admin.void') %>"><%- csrf %><button class="btn btn-danger-ghost btn-sm" type="submit"><%= t('subscriptions_admin.void') %></button></form>
              </div><% } %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </div>

  <aside class="stack-lg">
    <section class="panel">
      <div class="panel-head"><div><h2><%= t('subscriptions_admin.actions') %></h2></div></div>
      <div class="panel-body">
        <div class="sub-actions">
          <button class="btn btn-primary" type="button" data-open-dialog="dlg-payment" data-reset-form><%- icon('banknote', 'icon-sm') %><%= t('subscriptions_admin.record_payment') %></button>
          <button class="btn btn-secondary" type="button" data-open-dialog="dlg-trial"><%- icon('hourglass', 'icon-sm') %><%= t('subscriptions_admin.extend_trial') %></button>
          <button class="btn btn-secondary" type="button" data-open-dialog="dlg-plan"><%- icon('wallet', 'icon-sm') %><%= t('subscriptions_admin.change_plan') %></button>
          <% if (sub.status !== 'comped') { %><button class="btn btn-secondary" type="button" data-open-dialog="dlg-comp"><%- icon('badge-check', 'icon-sm') %><%= t('subscriptions_admin.comp') %></button><% } %>
          <% if (sub.status !== 'cancelled') { %>
          <form method="post" action="/admin/subscriptions/<%= b.id %>/cancel" data-confirm="<%= t('subscriptions_admin.cancel_confirm', { name: b.name }) %>" data-confirm-yes="<%= t('subscriptions_admin.cancel') %>"><%- csrf %><button class="btn btn-danger-ghost" type="submit"><%- icon('circle-x', 'icon-sm') %><%= t('subscriptions_admin.cancel') %></button></form>
          <% } %>
        </div>
      </div>
    </section>
  </aside>
</div>

<dialog class="dialog" id="dlg-payment">
  <form method="post" action="/admin/subscriptions/<%= b.id %>/payment" data-confirm="<%= t('subscriptions_admin.payment_confirm') %>" data-confirm-yes="<%= t('subscriptions_admin.record_payment') %>" data-confirm-tone="primary">
    <%- csrf %>
    <div class="dialog-head"><h2><%= t('subscriptions_admin.record_payment') %></h2><button class="btn btn-ghost btn-icon" type="button" data-close-dialog aria-label="<%= t('common.cancel') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <div class="field"><label class="label" for="f-invoice_id"><%= t('subscriptions.invoice') %></label>
        <select class="select" id="f-invoice_id" name="invoice_id" data-sub-invoice-pick>
          <option value="" data-plan="<%= sub.plan_id || '' %>" data-cycle="<%= sub.billing_cycle %>" data-branches="<%= sub.branches || 1 %>"><%= t('subscriptions_admin.new_invoice') %></option>
          <% openInv.forEach(function (i) { %><option value="<%= i.id %>" data-amount="<%= i.amount %>" data-cycle="<%= i.billing_cycle %>" data-plan="<%= i.plan_id || '' %>" data-branches="<%= i.branches || 1 %>"><%= i.number %> · <%= fmt.money(i.amount, i.currency) %> · <%= t('subscriptions.inv_status.' + i.status) %></option><% }) %>
        </select>
      </div>
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'plan_id', label: t('subscriptions.plan'), type: 'select', value: sub.plan_id || '', options: planOpts }) %>
        <%- include('../../partials/field', { name: 'billing_cycle', label: t('subscriptions.billing_cycle'), type: 'select', value: sub.billing_cycle, options: cycleOpts }) %>
        <%- include('../../partials/field', { name: 'branches', label: t('subscriptions.branches'), type: 'number', value: sub.branches || 1, attrs: 'min="1" max="50" step="1" inputmode="numeric"' }) %>
        <%- include('../../partials/field', { name: 'amount', label: t('common.amount'), type: 'number', value: plan ? priceFor(plan, sub.branches || 1, sub.billing_cycle) : '', required: true, attrs: 'min="0" step="0.001" inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'method', label: t('subscriptions.method'), type: 'select', value: 'bank_transfer', options: methods.map(function (m) { return { value: m, label: t('subscriptions.methods.' + m) }; }) }) %>
        <%- include('../../partials/field', { name: 'reference', label: t('subscriptions.reference'), attrs: 'maxlength="120" dir="auto"' }) %>
        <div></div>
        <%- include('../../partials/field', { name: 'period_start', label: t('subscriptions_admin.period_start'), type: 'date', help: t('subscriptions_admin.period_auto', { date: fmt.date(nextStart) }) }) %>
        <%- include('../../partials/field', { name: 'period_end', label: t('subscriptions_admin.period_end'), type: 'date', help: t('subscriptions_admin.period_end_help') }) %>
      </div>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('subscriptions_admin.record_payment') %></button></div>
  </form>
</dialog>

<dialog class="dialog" id="dlg-trial">
  <form method="post" action="/admin/subscriptions/<%= b.id %>/extend-trial" data-confirm="<%= t('subscriptions_admin.extend_confirm') %>" data-confirm-yes="<%= t('subscriptions_admin.extend_trial') %>" data-confirm-tone="primary">
    <%- csrf %>
    <div class="dialog-head"><h2><%= t('subscriptions_admin.extend_trial') %></h2><button class="btn btn-ghost btn-icon" type="button" data-close-dialog aria-label="<%= t('common.cancel') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <%- include('../../partials/field', { name: 'days', label: t('subscriptions_admin.extend_days'), type: 'number', value: 14, suffix: t('subscriptions_admin.days'), required: true, help: t('subscriptions_admin.extend_help'), attrs: 'min="1" max="365" step="1" inputmode="numeric"' }) %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('subscriptions_admin.extend_trial') %></button></div>
  </form>
</dialog>

<dialog class="dialog" id="dlg-plan">
  <form method="post" action="/admin/subscriptions/<%= b.id %>/plan" data-confirm="<%= t('subscriptions_admin.plan_confirm') %>" data-confirm-yes="<%= t('common.save') %>" data-confirm-tone="primary">
    <%- csrf %>
    <div class="dialog-head"><h2><%= t('subscriptions_admin.change_plan') %></h2><button class="btn btn-ghost btn-icon" type="button" data-close-dialog aria-label="<%= t('common.cancel') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'plan_id', id: 'p-plan_id', label: t('subscriptions.plan'), type: 'select', value: sub.plan_id || '', options: planOpts }) %>
        <%- include('../../partials/field', { name: 'billing_cycle', id: 'p-billing_cycle', label: t('subscriptions.billing_cycle'), type: 'select', value: sub.billing_cycle, options: cycleOpts }) %>
        <%- include('../../partials/field', { name: 'branches', id: 'p-branches', label: t('subscriptions.branches'), type: 'number', value: sub.branches || 1, attrs: 'min="1" max="50" step="1" inputmode="numeric"' }) %>
      </div>
      <p class="tiny muted"><%= t('subscriptions_admin.plan_help') %></p>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>

<dialog class="dialog" id="dlg-comp">
  <form method="post" action="/admin/subscriptions/<%= b.id %>/comp" data-confirm="<%= t('subscriptions_admin.comp_confirm', { name: b.name }) %>" data-confirm-yes="<%= t('subscriptions_admin.comp') %>" data-confirm-tone="primary">
    <%- csrf %>
    <div class="dialog-head"><h2><%= t('subscriptions_admin.comp') %></h2><button class="btn btn-ghost btn-icon" type="button" data-close-dialog aria-label="<%= t('common.cancel') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <p class="small muted"><%= t('subscriptions_admin.comp_help') %></p>
      <%- include('../../partials/field', { name: 'note', label: t('common.notes'), type: 'textarea', placeholder: t('subscriptions_admin.comp_note_ph') }) %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('subscriptions_admin.comp') %></button></div>
  </form>
</dialog>
<% } %>
