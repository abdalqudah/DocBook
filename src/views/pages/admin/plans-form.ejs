<%
  var p = plan || {};
  var o = old || null;
  var errs = errors || {};
  var val = function (k, d) { if (o) return o[k] !== undefined ? o[k] : ''; return p[k] !== undefined && p[k] !== null ? p[k] : (d === undefined ? '' : d); };
  var on = function (k, d) { if (o) return o[k] === '1'; return p[k] !== undefined ? Boolean(p[k]) : d; };
  var feat = function (f) { if (o) return o['f_' + f] === '1'; return Boolean(p.features && p.features[f]); };
  // Entitlements (registry: src/modules/subscriptions/entitlements.js) — limits and lists besides the yes/no features.
  var has = function (k) { return p.features && Object.prototype.hasOwnProperty.call(p.features, k); };
  var num = function (k) { if (o) return o['n_' + k] || ''; var v = has(k) ? p.features[k] : null; return v === null || v === undefined ? '' : v; };
  var listAll = function (k) { if (o) return o['l_' + k + '_all'] === '1'; return !has(k) || p.features[k] === '*'; };
  var listHas = function (k, x) { if (o) return [].concat(o['l_' + k] || []).indexOf(x) !== -1; return has(k) && Array.isArray(p.features[k]) && p.features[k].indexOf(x) !== -1; };
  var action = plan ? '/admin/plans/' + plan.id : '/admin/plans/new';
%>
<div class="page-head">
  <div><div class="breadcrumbs"><a href="/admin/plans"><%= t('subscriptions_admin.plans_title') %></a></div><h1><%= plan ? t('subscriptions_admin.edit_plan') : t('subscriptions_admin.new_plan') %></h1></div>
</div>
<%- include('../../partials/form-error') %>
<form method="post" action="<%= action %>" class="stack-lg sub-admin-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel">
    <div class="panel-head"><div><h2><%= t('subscriptions_admin.sec_plan') %></h2></div></div>
    <div class="panel-body stack">
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'name', label: t('subscriptions_admin.name_ar'), value: val('name'), required: true, attrs: 'maxlength="120" dir="auto"', errors: errs }) %>
        <%- include('../../partials/field', { name: 'name_en', label: t('subscriptions_admin.name_en'), value: val('name_en'), attrs: 'maxlength="120" dir="ltr"', errors: errs }) %>
        <%- include('../../partials/field', { name: 'description', label: t('subscriptions_admin.desc_ar'), type: 'textarea', value: val('description'), errors: errs }) %>
        <%- include('../../partials/field', { name: 'description_en', label: t('subscriptions_admin.desc_en'), type: 'textarea', value: val('description_en'), errors: errs }) %>
      </div>
    </div>
  </section>
  <section class="panel">
    <div class="panel-head"><div><h2><%= t('subscriptions_admin.sec_price') %></h2></div></div>
    <div class="panel-body">
      <div class="form-grid cols-3">
        <%- include('../../partials/field', { name: 'price_monthly', label: t('subscriptions_admin.price_monthly'), type: 'number', value: val('price_monthly', 0), attrs: 'min="0" step="0.001" inputmode="decimal"', errors: errs }) %>
        <%- include('../../partials/field', { name: 'price_yearly', label: t('subscriptions_admin.price_yearly'), type: 'number', value: val('price_yearly', 0), attrs: 'min="0" step="0.001" inputmode="decimal"', errors: errs }) %>
        <%- include('../../partials/field', { name: 'currency', label: t('subscriptions_admin.currency'), value: val('currency', 'JOD'), attrs: 'maxlength="3" dir="ltr" style="text-transform:uppercase"', errors: errs }) %>
      </div>
      <% var bpv = function (k, n) { if (o) return o[n === 'extra' ? 'bp_extra_' + k : 'bp_' + k + '_' + n] || ''; var t2 = n === 'extra' ? branchPrices.extra : branchPrices.tiers[n]; return t2 && t2[k] !== null && t2[k] !== undefined ? t2[k] : ''; }; %>
      <div class="bp-table mt-4">
        <h3 class="ent-group"><%= t('subscriptions_admin.bp_title') %></h3>
        <p class="help"><%= t('subscriptions_admin.bp_help') %></p>
        <div class="table-wrap"><table class="table responsive">
          <thead><tr><th><%= t('subscriptions_admin.bp_branches') %></th><th><%= t('subscriptions_admin.price_monthly') %></th><th><%= t('subscriptions_admin.price_yearly') %></th></tr></thead>
          <tbody>
            <tr><td class="primary-cell strong"><%= t('subscriptions_admin.bp_one') %></td><td data-label="<%= t('subscriptions_admin.price_monthly') %>" class="muted small"><%= t('subscriptions_admin.bp_base') %></td><td data-label="<%= t('subscriptions_admin.price_yearly') %>" class="muted small"><%= t('subscriptions_admin.bp_base') %></td></tr>
            <% bpRows.forEach(function (n) { %>
            <tr><td class="primary-cell strong"><%= t('subscriptions_admin.bp_n', { n: n }) %></td>
              <td data-label="<%= t('subscriptions_admin.price_monthly') %>"><input class="input" type="number" min="0" step="0.001" inputmode="decimal" dir="ltr" name="bp_m_<%= n %>" value="<%= bpv('m', n) %>" placeholder="<%= t('subscriptions_admin.bp_auto') %>" aria-label="<%= t('subscriptions_admin.bp_n', { n: n }) %> · <%= t('subscriptions_admin.price_monthly') %>"></td>
              <td data-label="<%= t('subscriptions_admin.price_yearly') %>"><input class="input" type="number" min="0" step="0.001" inputmode="decimal" dir="ltr" name="bp_y_<%= n %>" value="<%= bpv('y', n) %>" placeholder="<%= t('subscriptions_admin.bp_auto') %>" aria-label="<%= t('subscriptions_admin.bp_n', { n: n }) %> · <%= t('subscriptions_admin.price_yearly') %>"></td></tr>
            <% }) %>
            <tr><td class="primary-cell strong"><%= t('subscriptions_admin.bp_extra') %></td>
              <td data-label="<%= t('subscriptions_admin.price_monthly') %>"><input class="input" type="number" min="0" step="0.001" inputmode="decimal" dir="ltr" name="bp_extra_m" value="<%= bpv('m', 'extra') %>" aria-label="<%= t('subscriptions_admin.bp_extra') %> · <%= t('subscriptions_admin.price_monthly') %>"></td>
              <td data-label="<%= t('subscriptions_admin.price_yearly') %>"><input class="input" type="number" min="0" step="0.001" inputmode="decimal" dir="ltr" name="bp_extra_y" value="<%= bpv('y', 'extra') %>" aria-label="<%= t('subscriptions_admin.bp_extra') %> · <%= t('subscriptions_admin.price_yearly') %>"></td></tr>
          </tbody>
        </table></div>
        <p class="help"><%= t('subscriptions_admin.bp_limit_help') %></p>
      </div>
    </div>
  </section>
  <section class="panel">
    <div class="panel-head"><div><h2><%= t('subscriptions_admin.sec_limits') %></h2><div class="panel-sub"><%= t('subscriptions_admin.limits_help') %></div></div></div>
    <div class="panel-body">
      <div class="form-grid cols-3">
        <%- include('../../partials/field', { name: 'max_doctors', label: t('subscriptions_admin.max_doctors'), type: 'number', value: val('max_doctors'), placeholder: '∞', attrs: 'min="0" step="1" inputmode="numeric"', errors: errs }) %>
        <%- include('../../partials/field', { name: 'max_staff', label: t('subscriptions_admin.max_staff'), type: 'number', value: val('max_staff'), placeholder: '∞', attrs: 'min="0" step="1" inputmode="numeric"', errors: errs }) %>
        <%- include('../../partials/field', { name: 'max_appointments_month', label: t('subscriptions_admin.max_appointments'), type: 'number', value: val('max_appointments_month'), placeholder: '∞', attrs: 'min="0" step="1" inputmode="numeric"', errors: errs }) %>
      </div>
    </div>
  </section>
  <section class="panel">
    <div class="panel-head"><div><h2><%= t('subscriptions_admin.sec_features') %></h2><div class="panel-sub"><%= t('subscriptions_admin.features_help') %></div></div></div>
    <div class="panel-body">
      <% entGroups.forEach(function (g) { var items = entitlements.filter(function (e) { return e.group === g; }); %>
      <h3 class="ent-group"><%= t('subscriptions_admin.ent_group.' + g) %></h3>
      <div class="sub-feature-grid">
        <% items.filter(function (e) { return e.type === 'bool'; }).forEach(function (e) { %>
        <label class="check"><input type="checkbox" name="f_<%= e.key %>" value="1"<%= feat(e.key) ? ' checked' : '' %>><span><span class="strong small"><%= t('subscriptions.ent.' + e.key.replace(/\./g, '_')) %></span> <span class="tiny muted mono" dir="ltr"><%= e.key %></span></span></label>
        <% }) %>
      </div>
      <% items.filter(function (e) { return e.type === 'int'; }).forEach(function (e) { %>
      <div class="field ent-limit"><label for="n_<%= e.key %>"><%= t('subscriptions.ent.' + e.key.replace(/\./g, '_')) %> <span class="tiny muted mono" dir="ltr"><%= e.key %></span></label>
        <input class="input" type="number" min="0" step="1" id="n_<%= e.key %>" name="n_<%= e.key %>" value="<%= num(e.key) %>" placeholder="<%= t('subscriptions_admin.unlimited') %>" dir="ltr"></div>
      <% }) %>
      <% items.filter(function (e) { return e.type === 'list'; }).forEach(function (e) { %>
      <fieldset class="ent-list"><legend class="small strong"><%= t('subscriptions.ent.' + e.key.replace(/\./g, '_')) %> <span class="tiny muted mono" dir="ltr"><%= e.key %></span></legend>
        <label class="check"><input type="checkbox" name="l_<%= e.key %>_all" value="1" data-ent-all<%= listAll(e.key) ? ' checked' : '' %>><span class="small strong"><%= t('subscriptions_admin.all_options') %></span></label>
        <div class="sub-feature-grid"><% e.options.forEach(function (x) { %><label class="check"><input type="checkbox" name="l_<%= e.key %>" value="<%= x %>"<%= listHas(e.key, x) ? ' checked' : '' %>><span class="small"><%= t('website.template.' + x) %></span></label><% }) %></div>
      </fieldset>
      <% }) %>
      <% }) %>
    </div>
  </section>
  <section class="panel">
    <div class="panel-head"><div><h2><%= t('subscriptions_admin.sec_visibility') %></h2></div></div>
    <div class="panel-body stack">
      <label class="check"><input type="checkbox" name="is_active" value="1"<%= on('is_active', true) ? ' checked' : '' %>><span><span class="strong small"><%= t('subscriptions_admin.is_active') %></span> <span class="tiny muted"><%= t('subscriptions_admin.is_active_help') %></span></span></label>
      <label class="check"><input type="checkbox" name="is_public" value="1"<%= on('is_public', true) ? ' checked' : '' %>><span><span class="strong small"><%= t('subscriptions_admin.is_public') %></span> <span class="tiny muted"><%= t('subscriptions_admin.is_public_help') %></span></span></label>
      <label class="check"><input type="checkbox" name="is_featured" value="1"<%= on('is_featured', false) ? ' checked' : '' %>><span><span class="strong small"><%= t('subscriptions_admin.is_featured') %></span> <span class="tiny muted"><%= t('subscriptions_admin.is_featured_help') %></span></span></label>
      <div class="form-grid cols-3"><%- include('../../partials/field', { name: 'sort_order', label: t('subscriptions_admin.sort_order'), type: 'number', value: val('sort_order', 0), attrs: 'step="1"', errors: errs }) %></div>
    </div>
  </section>
  <div class="row-sm"><button class="btn btn-primary" type="submit"><%= t('common.save') %></button><a class="btn btn-ghost" href="/admin/plans"><%= t('common.cancel') %></a></div>
</form>
