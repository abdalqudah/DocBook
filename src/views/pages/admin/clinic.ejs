<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/admin/clinics"><%= t('admin.nav_clinics') %></a><%- icon('chevron-right', 'flip-rtl') %></div>
    <h1 class="row-sm"><%= b.name %> <span class="badge <%= b.status === 'active' ? 'badge-success' : 'badge-danger' %> badge-dot"><%= t('admin.status_' + b.status) %></span></h1>
    <% if (b.name_en) { %><p><%= b.name_en %></p><% } %>
  </div>
  <div class="page-actions">
    <% if (b.status === 'active' && b.slug) { %><a class="btn btn-secondary" href="/<%= b.slug %>" target="_blank" rel="noopener"><%- icon('external-link', 'icon-sm') %><%= t('admin.open_page') %></a><% } %>
    <form method="post" action="/admin/clinics/<%= b.id %>/status" data-confirm="<%= t(b.status === 'active' ? 'admin.suspend_confirm' : 'admin.activate_confirm', { name: b.name }) %>" data-confirm-yes="<%= t(b.status === 'active' ? 'admin.suspend' : 'admin.activate') %>"<% if (b.status !== 'active') { %> data-confirm-tone="primary"<% } %>>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="detail"><input type="hidden" name="status" value="<%= b.status === 'active' ? 'suspended' : 'active' %>">
      <button class="btn <%= b.status === 'active' ? 'btn-danger' : 'btn-primary' %>" type="submit"><%- icon(b.status === 'active' ? 'lock' : 'refresh-cw', 'icon-sm') %><%= t(b.status === 'active' ? 'admin.suspend' : 'admin.activate') %></button>
    </form>
  </div>
</div>
<div class="stats">
  <div class="stat"><div class="stat-label"><%= t('admin.col_doctors') %><span class="stat-icon"><%- icon('stethoscope') %></span></div><div class="stat-value"><%= fmt.number(counts.doctors) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.patients') %><span class="stat-icon info"><%- icon('users') %></span></div><div class="stat-value"><%= fmt.number(counts.patients) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.appointments_total') %><span class="stat-icon"><%- icon('calendar-check') %></span></div><div class="stat-value"><%= fmt.number(counts.appts) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('admin.online_total') %><span class="stat-icon accent"><%- icon('globe') %></span></div><div class="stat-value"><%= fmt.number(counts.online) %></div></div>
</div>
<div class="grid grid-main mt-6">
  <section class="panel flush">
    <div class="panel-head"><h2><%= t('admin.members') %></h2><span class="badge"><%= members.length %></span></div>
    <div class="table-wrap">
      <table class="table responsive">
        <thead><tr><th><%= t('admin.col_user') %></th><th><%= t('admin.col_status') %></th><th><%= t('admin.col_last_login') %></th></tr></thead>
        <tbody>
          <% members.forEach(function (m) { %>
          <tr>
            <td class="primary-cell"><div class="person"><span class="avatar"><%= initials(m.name) %></span><div><div class="person-name"><%= m.name %></div><div class="person-sub" dir="ltr" style="text-align:start"><%= m.email %></div></div></div></td>
            <td data-label="<%= t('admin.col_status') %>"><span class="badge badge-brand"><%= roleName(m) %></span><% if (m.status !== 'active') { %> <span class="badge badge-neutral"><%= t('admin.status_disabled') %></span><% } %></td>
            <td data-label="<%= t('admin.col_last_login') %>" class="nowrap"><%= m.last_login_at ? fmt.date(m.last_login_at) : t('admin.never') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <section class="panel">
    <div class="panel-head"><h2><%= t('admin.clinic_info') %></h2></div>
    <div class="panel-body">
      <dl class="dl">
        <dt><%= t('admin.col_address') %></dt><dd dir="ltr" style="text-align:start" class="mono">/<%= b.slug || '—' %></dd>
        <% if (b.specialty) { %><dt><%= t('admin.specialty') %></dt><dd><%= b.specialty %></dd><% } %>
        <dt><%= t('common.currency') %></dt><dd><%= b.currency %> · <span dir="ltr"><%= b.timezone %></span></dd>
        <% if (b.city) { %><dt><%= t('portal.address') %></dt><dd><%= [b.city, b.address].filter(Boolean).join(' · ') %></dd><% } %>
        <% if (b.phone) { %><dt><%= t('common.phone') %></dt><dd dir="ltr" style="text-align:start"><%= b.phone %></dd><% } %>
        <% if (b.email) { %><dt><%= t('common.email') %></dt><dd dir="ltr" style="text-align:start"><%= b.email %></dd><% } %>
        <dt><%= t('admin.booking') %></dt><dd><span class="badge <%= b.booking_enabled ? 'badge-success' : 'badge-neutral' %>"><%= t(b.booking_enabled ? 'admin.booking_on' : 'admin.booking_off') %></span></dd>
        <dt><%= t('admin.onboarding') %></dt><dd><%= t(b.onboarding_completed_at ? 'admin.onboarding_done' : 'admin.onboarding_pending') %></dd>
        <dt><%= t('admin.col_created') %></dt><dd><%= fmt.date(b.created_at) %></dd>
      </dl>
    </div>
  </section>
</div>
<% var _groups = { patients_care: ['online_booking', 'online_consultations', 'certificates', 'specialty_records', 'reviews', 'ai_assistant', 'patient_sharing', 'centres'], money: ['billing', 'doctor_payroll', 'staff_salaries', 'finance'], operations: ['queue_screens', 'staff_chat', 'staff_mail', 'supplies', 'marketplace', 'attendance', 'reports'] };
   var _mk = {}; modules.list.forEach(function (m) { _mk[m.key] = m; }); %>
<div class="grid grid-main mt-6">
  <form class="panel" id="modules" method="post" action="/admin/clinics/<%= b.id %>/modules" data-confirm="<%= t('admin.modules_confirm', { name: b.name }) %>" data-confirm-yes="<%= t('common.save') %>" data-confirm-tone="primary">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel-head"><div><h2><%- icon('layout-grid', 'icon-sm') %> <%= t('admin.modules_title') %></h2><p class="panel-sub"><%= t('admin.modules_sub') %></p></div></div>
    <div class="panel-body stack">
      <% Object.keys(_groups).forEach(function (g) { %>
      <div>
        <div class="small strong muted mb-2"><%= t('modules_cfg.group_' + g) %></div>
        <div class="adm-mods">
        <% _groups[g].forEach(function (k) { var m = _mk[k]; if (!m) return; %>
          <label class="check adm-mod<%= m.inPlan ? '' : ' is-locked' %>" title="<%= t('modules_cfg.d.' + k) %>">
            <input type="checkbox" name="<%= k %>" value="1"<%= m.toggled ? ' checked' : '' %><%= m.inPlan ? '' : ' disabled' %>>
            <span><%- icon(m.icon, 'icon-sm') %> <%= t('modules_cfg.m.' + k) %><% if (!m.inPlan) { %> <span class="badge badge-neutral"><%= t('modules_cfg.not_in_plan') %></span><% } %></span>
          </label>
        <% }) %>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="panel-foot"><button class="btn btn-secondary" type="submit"><%= t('common.save') %></button></div>
  </form>
  <section class="panel">
    <div class="panel-head"><div><h2><%- icon('activity', 'icon-sm') %> <%= t('admin.usage_title') %></h2><p class="panel-sub"><%= t('admin.usage_sub') %></p></div></div>
    <div class="panel-body">
      <dl class="dl">
        <dt><%= t('admin.stat_sent') %></dt><dd><%= fmt.number(usage.sent) %></dd>
        <dt><%= t('admin.stat_chats') %></dt><dd><%= fmt.number(usage.chats) %></dd>
        <dt><%= t('admin.usage_centres') %></dt><dd><%= t('admin.usage_centres_val', { n: fmt.number(usage.centres), sent: fmt.number(usage.centreSends) }) %></dd>
        <dt><%= t('admin.usage_texts') %></dt><dd><%= usage.ownTexts ? t('admin.usage_texts_yes', { n: fmt.number(usage.ownTexts) }) : t('admin.usage_texts_no') %></dd>
        <dt><%= t('admin.usage_screens') %></dt>
        <dd><% if (!usage.screens.length) { %><span class="muted"><%= t('admin.usage_no_screens') %></span><% } else { usage.screens.forEach(function (s) { var on = s.is_active && s.last_seen_at && Date.now() - new Date(s.last_seen_at).getTime() < 60000; %><div class="row-sm"><span><%= s.name %></span><span class="badge <%= on ? 'badge-success' : 'badge-neutral' %> badge-dot"><%= on ? t('attendance.screen_online') : (s.is_active ? (s.last_seen_at ? fmt.date(s.last_seen_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : t('attendance.screen_never')) : t('attendance.screen_off')) %></span></div><% }) } %></dd>
        <dt><%= t('admin.backup.title') %></dt><dd><% if (backups.length) { %><%= fmt.date(backups[0].at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %><% } else { %><span class="muted"><%= t('admin.backup.never') %></span><% } %></dd>
      </dl>
    </div>
  </section>
</div>
<% var _sz = function (n) { if (n === null) return t('admin.storage_unl'); return n >= 1073741824 ? fmt.number(Math.round(n / 107374182.4) / 10) + ' ' + t('media_lib.gb') : n >= 1048576 ? fmt.number(Math.round(n / 104857.6) / 10) + ' ' + t('media_lib.mb') : fmt.number(Math.max(n ? 1 : 0, Math.round(n / 1024))) + ' ' + t('media_lib.kb'); };
   var _mbs = function (mb) { return mb === null ? t('admin.storage_unl') : _sz(mb * 1048576); };
   var _pct = storage.quota ? Math.min(100, Math.round(storage.bytes * 100 / storage.quota)) : 0; %>
<form class="panel mt-6" id="storage" method="post" action="/admin/clinics/<%= b.id %>/storage" data-confirm="<%= t('admin.storage_confirm', { name: b.name }) %>" data-confirm-yes="<%= t('common.save') %>" data-confirm-tone="primary">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="panel-head"><div><h2><%- icon('database', 'icon-sm') %> <%= t('admin.storage_title') %></h2><p class="panel-sub"><%= t('admin.storage_sub') %></p></div>
    <span class="badge <%= storage.source === 'clinic' ? 'badge-brand' : 'badge-neutral' %>"><%= t('admin.storage_source_' + storage.source) %></span></div>
  <div class="panel-body stack">
    <div class="stack-sm">
      <div class="row-sm" style="justify-content:space-between;flex-wrap:wrap">
        <strong class="num"><%= storage.quota === null ? t('admin.storage_used_unl', { used: _sz(storage.bytes) }) : t('admin.storage_used', { used: _sz(storage.bytes), total: _sz(storage.quota) }) %></strong>
        <span class="small muted"><%= t('admin.storage_files', { n: fmt.number(storage.files) }) %></span>
      </div>
      <% if (storage.quota !== null) { %><span class="meter<%= _pct >= 100 ? ' full' : _pct >= 80 ? ' warn' : '' %>" aria-hidden="true"><span style="width:<%= _pct %>%"></span></span><% } %>
      <span class="small muted"><%= storage.hasPlan ? t('admin.storage_plan', { size: _mbs(storage.planMb) }) : t('admin.storage_default', { size: _mbs(storage.planMb) }) %></span>
    </div>
    <div class="field">
      <label for="media_quota_mb"><%= t('admin.storage_own') %></label>
      <input class="input" type="number" min="1" max="1000000" step="1" id="media_quota_mb" name="media_quota_mb" value="<%= storage.ownMb === null ? '' : storage.ownMb %>" placeholder="<%= _mbs(storage.planMb) %>" dir="ltr" inputmode="numeric" style="max-width:220px">
      <p class="help"><%= t('admin.storage_own_help') %></p>
    </div>
  </div>
  <div class="panel-foot row-sm">
    <button class="btn btn-secondary" type="submit"><%= t('common.save') %></button>
    <% if (storage.ownMb !== null) { %><button class="btn btn-ghost" type="submit" name="follow_plan" value="1"><%= t('admin.storage_follow') %></button><% } %>
  </div>
</form>
<section class="panel flush mt-6" id="backups">
  <div class="panel-head"><div><h2><%- icon('database', 'icon-sm') %> <%= t('admin.backup.title') %></h2><p class="panel-sub"><%= t('admin.backup.sub') %></p></div>
    <form method="post" action="/admin/clinics/<%= b.id %>/backups"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" type="submit"><%- icon('plus', 'icon-sm') %><%= t('admin.backup.create') %></button></form></div>
  <% if (!backups.length) { %><div class="panel-body"><p class="small muted"><%= t('admin.backup.none') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('admin.backup.when') %></th><th><%= t('admin.backup.kind') %></th><th class="num"><%= t('admin.backup.size') %></th><th class="actions"></th></tr></thead>
    <tbody><% backups.forEach(function (k) { %><tr>
      <td class="primary-cell"><%= fmt.date(k.at, { dateStyle: 'medium', timeStyle: 'short' }) %></td>
      <td data-label="<%= t('admin.backup.kind') %>"><span class="badge <%= k.auto ? 'badge-neutral' : 'badge-brand' %>"><%= t(k.auto ? 'admin.backup.auto' : 'admin.backup.manual') %></span></td>
      <td class="num" data-label="<%= t('admin.backup.size') %>"><%= fmt.number(Math.max(1, Math.round(k.size / 1024))) %> KB</td>
      <td class="actions nowrap">
        <a class="btn btn-ghost btn-sm" href="/admin/clinics/<%= b.id %>/backups/<%= k.name %>"><%- icon('download', 'icon-sm') %><%= t('admin.backup.download') %></a>
        <details class="dropdown"><summary class="btn btn-ghost btn-sm"><%- icon('archive-restore', 'icon-sm') %><%= t('admin.backup.restore') %></summary>
          <form class="menu stack-sm" method="post" action="/admin/clinics/<%= b.id %>/backups/<%= k.name %>/restore" style="min-width:300px;padding:12px" data-confirm="<%= t('admin.backup.confirm', { name: b.name }) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <p class="small"><%= t('admin.backup.restore_help') %></p>
            <input class="input" type="password" name="password" required autocomplete="current-password" placeholder="<%= t('admin.backup.your_password') %>" aria-label="<%= t('admin.backup.your_password') %>">
            <button class="btn btn-danger btn-sm" type="submit"><%= t('admin.backup.restore_now') %></button>
          </form></details>
      </td></tr><% }) %></tbody>
  </table></div>
  <% } %>
</section>
