<%# Admin → E-mail log: every e-mail the platform sent or tried to send (signup, invoices, quotations, resets…). %>
<% var dt = function (v) { try { return new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'ar-EG-u-nu-latn', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(v)); } catch (e) { return ''; } }; %>
<div class="page-head"><div><h1><%= t('sales.email_log') %></h1><p><%= t('sales.email_log_lead') %></p></div></div>
<form method="get" class="row-sm wrap mb-4">
  <input class="input" name="q" dir="ltr" value="<%= f.q %>" placeholder="<%= t('sales.search_email') %>" style="max-width:280px">
  <select class="select" name="status" style="max-width:180px"><option value=""><%= t('crm.all') %></option><% ['sent', 'failed', 'not_sent'].forEach(function (s) { %><option value="<%= s %>"<%= f.status === s ? ' selected' : '' %>><%= t('sales.mail_' + s) %></option><% }) %></select>
  <button class="btn btn-secondary" type="submit"><%- icon('search', 'icon-sm') %></button>
</form>
<section class="panel flush">
  <% if (!rows.length) { %><div class="panel-body"><p class="muted"><%= t('sales.no_emails') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table responsive" data-email-log>
    <thead><tr><th><%= t('sales.when') %></th><th><%= t('sales.to') %></th><th><%= t('crm.subject') %></th><th><%= t('sales.mail_kind') %></th><th><%= t('common.status') %></th></tr></thead>
    <tbody><% rows.forEach(function (m) { %><tr>
      <td class="primary-cell"><%= dt(m.created_at) %></td>
      <td data-label="<%= t('sales.to') %>"><bdi dir="ltr"><%= m.to_addr %></bdi></td>
      <td data-label="<%= t('crm.subject') %>"><%= m.subject || '' %></td>
      <td data-label="<%= t('sales.mail_kind') %>"><span class="badge"><%= m.kind %></span> <span class="tiny muted"><%= m.via %></span></td>
      <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= m.status === 'sent' ? 'badge-success' : m.status === 'failed' ? 'badge-danger' : 'badge-neutral' %>"><%= t('sales.mail_' + m.status) %></span><% if (m.error) { %><div class="tiny muted"><%= m.error %></div><% } %></td>
    </tr><% }) %></tbody></table></div><% } %>
</section>
