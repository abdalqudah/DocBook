<%# System update: version card, install form (zip + password),
    backups with restore, update history. %>
<% var when = function (iso) { return iso ? fmt.date(new Date(iso), { dateStyle: 'medium', timeStyle: 'short' }) : '—'; }; %>
<div class="page-head"><div><h1><%= t('updater.title') %></h1><p><%= t('updater.lead') %></p></div></div>

<% if (updated || restored) { %>
<div class="alert alert-success mb-4"><%- icon('rocket') %><div class="grow"><div class="alert-title"><%= updated ? t('updater.update_started', { v: updated }) : t('updater.restore_started', { v: restored }) %></div><div class="small"><%= t('updater.restart_note') %></div></div><a class="btn btn-secondary btn-sm" href="/admin/updates"><%= t('updater.refresh') %></a></div>
<% } %>
<% if (typeof fromSource !== 'undefined' && fromSource && dist) { %>
<div class="alert alert-info mb-4"><%- icon('info', 'icon-sm') %><div class="grow"><div class="alert-title"><%= t('updater.from_source_title') %></div><div><%= t('updater.from_source_text') %></div></div></div>
<% } %>
<% if (!dist) { %>
<div class="alert alert-info mb-4"><%- icon('info', 'icon-sm') %><div class="grow"><div class="alert-title"><%= t('updater.source_title') %></div><div><%= t('updater.source_text') %></div></div></div>
<% } %>

<div class="grid grid-3" style="align-items:start">
  <section class="panel">
    <div class="panel-head"><h2><%= t('updater.current_version') %></h2></div>
    <div class="panel-body">
      <div class="num" dir="ltr" style="font-size:30px;font-weight:800;text-align:start">v<%= current.version || '—' %></div>
      <dl class="dl mt-4">
        <dt>Node.js</dt><dd class="mono" dir="ltr"><%= current.node %></dd>
        <dt><%= t('updater.database') %></dt><dd class="mono small" dir="ltr"><%= dbVersion %></dd>
        <dt><%= t('updater.db_state') %></dt><dd><% if (pendingDb.length) { %><span class="badge badge-warning badge-dot"><%= t('updater.db_pending', { n: pendingDb.length }) %></span><% } else { %><span class="badge badge-success badge-dot"><%= t('updater.db_ok') %></span><% } %> <span class="tiny muted"><%= t('updater.db_count', { n: appliedDb }) %></span></dd>
      </dl>
      <p class="tiny muted mt-2"><%= t('updater.db_auto') %></p>
      <form method="post" action="/admin/updates/database" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" type="submit"><%- icon('database', 'icon-sm') %><%= t('updater.db_run') %></button></form>
    </div>
  </section>

  <form method="post" action="/admin/updates/install" enctype="multipart/form-data" class="panel span-2" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel-head"><div><h2><%= t('updater.install_title') %></h2><div class="panel-sub"><%= t('updater.install_sub') %></div></div></div>
    <div class="panel-body stack">
      <div class="field"><label class="label" for="upd-file"><%= t('updater.package') %><span class="req">*</span></label>
        <input class="input" id="upd-file" type="file" name="file" accept=".zip,application/zip" required<%= dist ? '' : ' disabled' %>>
        <% if (errors.file) { %><span class="field-error"><%= errors.file %></span><% } else { %><span class="help"><%= t('updater.package_help', { mb: maxMb }) %></span><% } %></div>
      <div class="field"><label class="label" for="upd-pass"><%= t('updater.confirm_password') %><span class="req">*</span></label>
        <input class="input" id="upd-pass" type="password" name="password" required autocomplete="current-password"<%= dist ? '' : ' disabled' %>>
        <% if (errors.password) { %><span class="field-error"><%= t('updater.wrong_password') %></span><% } %></div>
      <ul class="small muted" style="margin:0;padding-inline-start:18px;display:grid;gap:4px">
        <li><%= t('updater.step_backup') %></li>
        <li><%= t('updater.step_keep') %></li>
        <li><%= t('updater.step_migrate') %></li>
        <li><%= t('updater.step_restart') %></li>
      </ul>
    </div>
    <div class="panel-foot"><button class="btn btn-primary" type="submit"<%= dist ? '' : ' disabled' %>><%- icon('upload', 'icon-sm') %><%= t('updater.install') %></button></div>
  </form>
</div>

<div class="grid grid-2 mt-6" style="align-items:start">
  <section class="panel flush">
    <div class="panel-head"><div><h2><%= t('updater.backups_title') %></h2><div class="panel-sub"><%= t('updater.backups_sub') %></div></div></div>
    <% if (errors.backup) { %><div class="panel-body"><span class="field-error"><%= errors.backup %></span></div><% } %>
    <% if (!backups.length) { %><div class="empty"><p><%= t('updater.no_backups') %></p></div><% } else { %>
    <div class="table-wrap"><table class="table"><tbody>
      <% backups.forEach(function (b) { %>
      <tr><td><strong class="num" dir="ltr">v<%= b.version %></strong><div class="muted tiny"><%= when(b.createdAt) %><%= b.replacedBy ? ' · ' + t('updater.replaced_by', { v: b.replacedBy }) : '' %></div></td>
        <td class="actions"><button class="btn btn-secondary btn-sm" type="button" data-open-dialog="restore-dialog" data-fill="<%= JSON.stringify({ backup: b.id }) %>"<%= dist ? '' : ' disabled' %>><%- icon('history', 'icon-sm') %><%= t('updater.restore') %></button></td></tr>
      <% }) %>
    </tbody></table></div><% } %>
  </section>
  <section class="panel flush">
    <div class="panel-head"><h2><%= t('updater.history_title') %></h2></div>
    <% if (!log.length) { %><div class="empty"><p><%= t('updater.no_history') %></p></div><% } else { %>
    <ul class="feed"><% log.forEach(function (l) { %>
      <li><span class="dot" style="<%= l.ok ? '' : 'background:var(--danger)' %>"></span><div class="grow"><div class="what"><strong><%= t('updater.log_' + l.action) %></strong> <span dir="ltr">v<%= l.from %> → v<%= l.to %></span><% if (!l.ok) { %> · <span class="field-error"><%= l.error %></span><% } %></div><div class="when"><%= when(l.at) %> · <%= l.by || '—' %><%= l.sha256 ? ' · sha256 ' + l.sha256.slice(0, 12) : '' %></div></div></li>
    <% }) %></ul><% } %>
  </section>
</div>

<dialog class="dialog" id="restore-dialog"<%= typeof openRestore !== 'undefined' && openRestore ? ' data-open-on-load' : '' %>>
  <form method="post" action="/admin/updates/restore" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="backup" value="<%= typeof openRestore !== 'undefined' && openRestore ? openRestore : '' %>">
    <div class="dialog-head"><div><h2><%= t('updater.restore_title') %></h2><p class="muted small mt-1"><%= t('updater.restore_sub') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x') %></button></div>
    <div class="dialog-body"><div class="field"><label class="label" for="rs-pass"><%= t('updater.confirm_password') %></label><input class="input" id="rs-pass" type="password" name="password" required autocomplete="current-password">
      <% if (errors.password && typeof openRestore !== 'undefined' && openRestore) { %><span class="field-error"><%= t('updater.wrong_password') %></span><% } %></div></div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-danger" type="submit"><%= t('updater.restore') %></button></div>
  </form>
</dialog>
