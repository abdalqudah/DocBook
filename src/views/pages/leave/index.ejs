    <div class="dialog-head"><div><h2 id="settings-dialog-title"><%= t('leave.allowance_title') %></h2><p class="muted small mt-1"><%= t('leave.allowance_help') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
