      <div class="form-grid">
        <%- include('../../partials/field', { id: 'st-annual', name: 'annual_days', label: t('leave.annual_per_year'), type: 'number', required: true, value: settings.annualDays, attrs: 'min="0" max="365" step="0.5"', errors: od === 'settings-dialog' ? errors : {}, old: od === 'settings-dialog' ? old : {} }) %>
        <%- include('../../partials/field', { id: 'st-sick', name: 'sick_days', label: t('leave.sick_per_year'), type: 'number', required: true, value: settings.sickDays, attrs: 'min="0" max="365" step="0.5"', errors: od === 'settings-dialog' ? errors : {}, old: od === 'settings-dialog' ? old : {} }) %>
