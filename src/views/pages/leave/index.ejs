    <div class="dialog-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (od === 'allowance-dialog') { %><%- include('../../partials/form-error') %><% } %>
      <div class="form-grid">
        <%- include('../../partials/field', { id: 'al-annual', name: 'annual_days', label: t('leave.annual_per_year'), type: 'number', placeholder: String(settings.annualDays), attrs: 'min="0" max="365" step="0.5"', errors: od === 'allowance-dialog' ? errors : {}, old: od === 'allowance-dialog' ? old : {} }) %>
        <%- include('../../partials/field', { id: 'al-sick', name: 'sick_days', label: t('leave.sick_per_year'), type: 'number', placeholder: String(settings.sickDays), attrs: 'min="0" max="365" step="0.5"', errors: od === 'allowance-dialog' ? errors : {}, old: od === 'allowance-dialog' ? old : {} }) %>
