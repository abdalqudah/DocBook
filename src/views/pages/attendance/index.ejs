<%
  var canView = can('attendance.view'); var canManage = can('attendance.manage');
  var isPrint = query.print === '1';
  var qs = function (over) { var o = Object.assign({ view: view, date: typeof date !== 'undefined' ? date : '', month: month, role: roleId || '', user: userId || '' }, over || {}); if (o.view !== 'today') delete o.date; if (o.view === 'today') delete o.month; return '?' + Object.keys(o).filter(function (k) { return o[k] !== '' && o[k] !== null && o[k] !== undefined; }).map(function (k) { return k + '=' + encodeURIComponent(o[k]); }).join('&'); };
%>
<div class="page-head">
  <div>
    <h1><%= t('attendance.title') %></h1>
    <p><%= view === 'me' ? t('attendance.lead') : (view === 'today' ? fmt.date(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : t('attendance.report_lead', { month: fmt.month(month) })) %></p>
  </div>
  <div class="page-actions no-print">
    <% if (view !== 'me') { %>
      <%- include('../../partials/export-menu', { href: '/app/attendance/export' }) %>
      <a class="btn btn-ghost" href="<%= qs({}) %>&print=1"><%- icon('printer', 'icon-sm') %><%= t('common.print') %></a>
    <% } %>
    <% if (canManage) { %>
      <a class="btn btn-ghost" href="/app/attendance/settings"><%- icon('calendar-clock', 'icon-sm') %><%= t('attendance.hours_title') %></a>
      <a class="btn btn-secondary" href="/app/attendance/screens"><%- icon('qr-code', 'icon-sm') %><%= t('attendance.screens_title') %></a>
    <% } %>
  </div>
</div>

<% if (!isPrint) { %>
<%- include('_clock') %>
<% if (canView) { %>
<nav class="tabs mb-4" aria-label="<%= t('attendance.title') %>">
  <a href="/app/attendance?view=today" class="<%= view === 'today' ? 'active' : '' %>"<%- view === 'today' ? ' aria-current="page"' : '' %>><%= t('attendance.tab_today') %></a>
  <a href="/app/attendance?view=month&month=<%= month %>" class="<%= view === 'month' ? 'active' : '' %>"<%- view === 'month' ? ' aria-current="page"' : '' %>><%= t('attendance.tab_month') %></a>
  <a href="/app/attendance?view=me&month=<%= month %>" class="<%= view === 'me' ? 'active' : '' %>"<%- view === 'me' ? ' aria-current="page"' : '' %>><%= t('attendance.tab_me') %></a>
</nav>
<% } %>
<% } %>

<% if (view === 'me') { %>
  <form method="get" class="row-sm mb-4 no-print" data-autosubmit>
    <input type="hidden" name="view" value="me">
    <label class="sr-only" for="att-month"><%= t('common.month') %></label>
    <select class="select att-select" id="att-month" name="month"><% months.forEach(function (m) { %><option value="<%= m %>"<%= m === month ? ' selected' : '' %>><%= fmt.month(m) %></option><% }) %></select>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.apply') %></button></noscript>
  </form>
  <%- include('_timesheet', { sheet: sheet }) %>
<% } else { %>
  <form method="get" class="att-toolbar mb-4 no-print" data-autosubmit>
    <input type="hidden" name="view" value="<%= view %>">
    <% if (view === 'today') { %>
      <div class="row-sm">
        <a class="btn btn-ghost btn-icon btn-sm" href="<%= qs({ date: prevDate }) %>" aria-label="<%= t('attendance.prev_day') %>"><%- icon('chevron-left', 'icon-sm flip-rtl') %></a>
        <input class="input" type="date" name="date" value="<%= date %>" max="<%= clinicToday %>" aria-label="<%= t('common.date') %>">
        <% if (nextDate) { %><a class="btn btn-ghost btn-icon btn-sm" href="<%= qs({ date: nextDate }) %>" aria-label="<%= t('attendance.next_day') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a><% } %>
        <% if (date !== clinicToday) { %><a class="btn btn-ghost btn-sm" href="<%= qs({ date: clinicToday }) %>"><%= t('common.today') %></a><% } %>
      </div>
    <% } else { %>
      <select class="select" name="month" aria-label="<%= t('common.month') %>"><% months.forEach(function (m) { %><option value="<%= m %>"<%= m === month ? ' selected' : '' %>><%= fmt.month(m) %></option><% }) %></select>
    <% } %>
    <select class="select" name="role" aria-label="<%= t('attendance.role') %>"><option value=""><%= t('attendance.all_roles') %></option><% roles.forEach(function (r) { %><option value="<%= r.role_id %>"<%= roleId === r.role_id ? ' selected' : '' %>><%= r.label %></option><% }) %></select>
    <% if (view === 'today') { %><select class="select" name="user" aria-label="<%= t('attendance.person') %>"><option value=""><%= t('attendance.all_people') %></option><% staffOptions.forEach(function (s) { %><option value="<%= s.user_id %>"<%= userId === s.user_id ? ' selected' : '' %>><%= s.name %></option><% }) %></select><% } %>
    <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="<%= qs({ role: '', user: '' }) %>"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
    <noscript><button class="btn btn-secondary btn-sm" type="submit"><%= t('common.apply') %></button></noscript>
    <% if (canManage) { %><button class="btn btn-ghost btn-sm att-toolbar-end" type="button" data-open-dialog="add-dialog" data-fill="<%= json({ user_id: '', work_date: view === 'today' ? date : clinicToday, clock_in: '', clock_out: '', reason: '' }) %>"><%- icon('plus', 'icon-sm') %><%= t('attendance.add_shift') %></button><% } %>
  </form>
  <% if (isPrint) { %><h2 class="mb-4"><%= view === 'today' ? fmt.date(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : fmt.month(month) %></h2><% } %>

  <% if (view === 'today') { var s = board.summary; %>
    <div class="stats att-stats mb-4">
      <div class="stat"><div class="stat-label"><%= t('attendance.st_present') %></div><div class="stat-value"><%= fmt.number(s.present) %></div><div class="stat-meta"><%= t('attendance.in_now_n', { n: fmt.number(s.in_now) }) %></div></div>
      <div class="stat"><div class="stat-label"><%= t('attendance.st_late') %></div><div class="stat-value<%= s.late ? ' att-warn' : '' %>"><%= fmt.number(s.late) %></div><div class="stat-meta"><%= t('attendance.grace_meta', { n: fmt.number(board.settings.grace) }) %></div></div>
      <div class="stat"><div class="stat-label"><%= t('attendance.st_absent') %></div><div class="stat-value<%= s.absent ? ' att-danger' : '' %>"><%= fmt.number(s.absent) %></div><div class="stat-meta"><%= s.not_yet ? t('attendance.not_yet_n', { n: fmt.number(s.not_yet) }) : '—' %></div></div>
      <div class="stat"><div class="stat-label"><%= t('attendance.hours_worked') %></div><div class="stat-value" dir="ltr"><%= hm(s.minutes) %></div><div class="stat-meta"><%= s.off ? t('attendance.off_n', { n: fmt.number(s.off) }) : '—' %></div></div>
    </div>
    <% if (!board.hasAnyPlan) { %><div class="alert alert-info mb-4 no-print"><%- icon('info') %><div class="grow"><%= t('attendance.no_plan_note') %><% if (canManage) { %> <a href="/app/attendance/settings"><%= t('attendance.set_hours') %></a><% } %></div></div><% } %>
    <div class="panel flush mb-4">
      <% if (!board.rows.length) { %>
        <%- include('../../partials/empty', { emptyIcon: 'users', emptyTitle: t('attendance.empty_team_title'), emptyText: t('attendance.empty_team_text'), compact: true }) %>
      <% } else { %>
      <div class="table-wrap"><table class="table responsive att-board">
        <thead><tr><th><%= t('attendance.person') %></th><th><%= t('common.status') %></th><th><%= t('attendance.planned') %></th><th><%= t('attendance.times') %></th><th class="num"><%= t('attendance.hours') %></th><th class="actions no-print"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
        <tbody>
        <% board.rows.forEach(function (p) { %>
          <tr>
            <td class="primary-cell"><a class="att-person" href="/app/attendance/staff/<%= p.user_id %>?month=<%= date.slice(0, 7) %>"><span class="avatar att-avatar"><%= initials(p.name) %></span><span><span class="strong"><%= p.name %></span><span class="small muted att-role"><%= roleLabel(p) %></span></span></a></td>
            <td data-label="<%= t('common.status') %>"><%- include('_status', { st: p, isIn: p.isIn }) %></td>
            <td data-label="<%= t('attendance.planned') %>" class="muted"><% if (p.plan && p.plan !== 'off') { %><bdi dir="ltr"><%= p.plan.start %>–<%= p.plan.end %></bdi><% } else if (p.plan === 'off') { %><%= t('attendance.st_off') %><% } else { %>—<% } %></td>
            <td data-label="<%= t('attendance.times') %>"><% if (p.shifts.length) { %><%- include('_shifts', { shifts: p.shifts, personName: p.name }) %><% } else { %><span class="muted">—</span><% } %></td>
            <td class="num strong" data-label="<%= t('attendance.hours') %>" dir="ltr"><%= p.worked ? hm(p.worked) : '—' %></td>
            <td class="actions no-print"><% if (canManage) { %><button class="btn btn-ghost btn-sm" type="button" data-open-dialog="add-dialog" data-fill="<%= json({ user_id: p.user_id, work_date: date, clock_in: p.plan && p.plan !== 'off' ? p.plan.start : '', clock_out: '', reason: '' }) %>"><%- icon('plus', 'icon-sm') %><%= t('attendance.add_shift') %></button><% } %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  <% } else { var r = report; %>
    <div class="stats att-stats mb-4">
      <div class="stat"><div class="stat-label"><%= t('attendance.people_present') %></div><div class="stat-value"><%= fmt.number(r.totals.people) %></div><div class="stat-meta"><%= fmt.month(month) %></div></div>
      <div class="stat"><div class="stat-label"><%= t('attendance.hours_worked') %></div><div class="stat-value" dir="ltr"><%= hm(r.totals.worked) %></div><div class="stat-meta"><%= r.totals.overtime ? t('attendance.overtime_meta', { h: hm(r.totals.overtime) }) : '—' %></div></div>
      <div class="stat"><div class="stat-label"><%= t('attendance.late_days') %></div><div class="stat-value<%= r.totals.late ? ' att-warn' : '' %>"><%= fmt.number(r.totals.late) %></div><div class="stat-meta">&nbsp;</div></div>
      <div class="stat"><div class="stat-label"><%= t('attendance.absent_days') %></div><div class="stat-value<%= r.totals.absent ? ' att-danger' : '' %>"><%= fmt.number(r.totals.absent) %></div><div class="stat-meta">&nbsp;</div></div>
    </div>
    <div class="panel flush mb-4">
      <% if (!r.rows.length) { %>
        <%- include('../../partials/empty', { emptyIcon: 'users', emptyTitle: t('attendance.empty_team_title'), emptyText: t('attendance.empty_team_text'), compact: true }) %>
      <% } else { %>
      <div class="table-wrap"><table class="table responsive">
        <thead><tr><th><%= t('attendance.person') %></th><th class="num"><%= t('attendance.days_present') %></th><th class="num"><%= t('attendance.hours_worked') %></th><th class="num"><%= t('attendance.late_days') %></th><th class="num"><%= t('attendance.absent_days') %></th><th class="num"><%= t('attendance.overtime') %></th><th class="num"><%= t('attendance.missing_out') %></th><th class="actions no-print"></th></tr></thead>
        <tbody>
        <% r.rows.forEach(function (p) { %>
          <tr>
            <td class="primary-cell"><a class="att-person" href="/app/attendance/staff/<%= p.user_id %>?month=<%= month %>"><span class="avatar att-avatar"><%= initials(p.name) %></span><span><span class="strong"><%= p.name %></span><span class="small muted att-role"><%= roleLabel(p) %></span></span></a></td>
            <td class="num" data-label="<%= t('attendance.days_present') %>"><%= fmt.number(p.present) %></td>
            <td class="num strong" data-label="<%= t('attendance.hours_worked') %>" dir="ltr"><%= p.worked ? hm(p.worked) : '—' %></td>
            <td class="num" data-label="<%= t('attendance.late_days') %>"><% if (p.late) { %><span class="att-warn"><%= fmt.number(p.late) %></span> <span class="tiny muted"><%= t('attendance.min_n', { n: fmt.number(p.lateMinutes) }) %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td class="num" data-label="<%= t('attendance.absent_days') %>"><% if (p.absent) { %><span class="att-danger"><%= fmt.number(p.absent) %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td class="num" data-label="<%= t('attendance.overtime') %>" dir="ltr"><%= p.overtime ? hm(p.overtime) : '—' %></td>
            <td class="num" data-label="<%= t('attendance.missing_out') %>"><% if (p.missingOut) { %><span class="att-tag warn"><%= fmt.number(p.missingOut) %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td class="actions no-print"><a class="btn btn-ghost btn-sm" href="/app/attendance/staff/<%= p.user_id %>?month=<%= month %>"><%= t('attendance.open_timesheet') %></a></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  <% } %>
<% } %>
<%- include('_manual') %>
