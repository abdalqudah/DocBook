<% var o = typeof old !== 'undefined' && old ? old : {}; var errs = typeof errors !== 'undefined' && errors ? errors : {}; %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/attendance"><%= t('attendance.title') %></a></div>
    <h1><%= t('attendance.screens_title') %></h1>
    <p><%= t('attendance.screens_lead') %></p>
  </div>
  <div class="page-actions"><a class="btn btn-ghost" href="/app/attendance/kiosk" target="_blank" rel="noopener"><%- icon('monitor', 'icon-sm') %><%= t('attendance.preview_here') %></a></div>
</div>
<% if (reach.via === 'lan') { %><div class="alert alert-info mb-4"><%- icon('info') %><div><%= t('attendance.reach_lan_help') %> <bdi dir="ltr" class="mono strong"><%= reach.base %></bdi></div></div><% } %>
<% if (reach.via === 'local') { %><div class="alert alert-warning mb-4"><%- icon('triangle-alert') %><div><%= t('attendance.reach_local') %></div></div><% } %>

<div class="grid grid-main">
  <div class="stack">
    <section class="panel">
      <div class="panel-head"><h2><%= t('attendance.screens') %></h2><span class="badge badge-neutral"><%= fmt.number(list.length) %></span></div>
      <% if (!list.length) { %>
        <%- include('../../partials/empty', { emptyIcon: 'monitor', emptyTitle: t('attendance.screens_empty_title'), emptyText: t('attendance.screens_empty_text'), compact: true }) %>
      <% } else { %>
      <ul class="att-screens">
      <% list.forEach(function (k) { %>
        <li class="att-screen">
          <div class="row between wrap">
            <div class="row-sm">
              <span class="att-screen-icon" aria-hidden="true"><%- icon('monitor', 'icon-sm') %></span>
              <div>
                <div class="strong"><%= k.name %></div>
                <div class="small muted">
                  <% if (!k.is_active) { %><span class="badge badge-neutral"><%= t('attendance.screen_off') %></span>
                  <% } else if (k.online) { %><span class="badge badge-success badge-dot"><%= t('attendance.screen_online') %></span>
                  <% } else if (k.last_seen_at) { %><%= t('attendance.screen_last_seen', { when: fmt.date(k.last_seen_at, { dateStyle: 'medium', timeStyle: 'short' }) }) %>
                  <% } else { %><%= t('attendance.screen_never') %><% } %>
                </div>
              </div>
            </div>
            <% if (k.is_active && k.url) { %><a class="btn btn-secondary btn-sm" href="/app/attendance/screens/<%= k.id %>/open" target="_blank" rel="noopener"><%- icon('external-link', 'icon-sm') %><%= t('attendance.open_screen') %></a><% } %>
          </div>
          <% if (k.is_active && k.url) { %>
          <div class="row-sm mt-2 att-link-row">
            <input class="input grow" id="screen-url-<%= k.id %>" value="<%= k.url %>" readonly dir="ltr" aria-label="<%= t('attendance.screen_link') %>">
            <button class="btn btn-ghost btn-sm" type="button" data-copy="screen-url-<%= k.id %>"><%- icon('copy', 'icon-sm') %><%= t('common.copy') %></button>
          </div>
          <% } %>
          <details class="att-more mt-2">
            <summary class="small"><%= t('attendance.screen_manage') %></summary>
            <form method="post" action="/app/attendance/screens/<%= k.id %>" class="row-sm wrap mt-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="input att-name-input" name="name" value="<%= k.name %>" maxlength="120" aria-label="<%= t('attendance.screen_name') %>">
              <label class="check"><input type="checkbox" name="is_active" value="1"<%= k.is_active ? ' checked' : '' %>><span><%= t('attendance.screen_active') %></span></label>
              <button class="btn btn-secondary btn-sm" type="submit"><%= t('common.save') %></button>
            </form>
            <div class="row-sm mt-2">
              <form class="inline" method="post" action="/app/attendance/screens/<%= k.id %>/regenerate" data-confirm="<%= t('attendance.screen_regenerate_confirm') %>" data-confirm-yes="<%= t('attendance.screen_regenerate') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('refresh-cw', 'icon-sm') %><%= t('attendance.screen_regenerate') %></button></form>
              <form class="inline" method="post" action="/app/attendance/screens/<%= k.id %>/delete" data-confirm="<%= t('attendance.screen_delete_confirm', { name: k.name }) %>" data-confirm-title="<%= t('common.confirm_delete_title') %>" data-confirm-yes="<%= t('common.delete') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('common.delete') %></button></form>
            </div>
          </details>
        </li>
      <% }) %>
      </ul>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head"><h2><%= t('attendance.setup_how') %></h2></div>
      <div class="panel-body">
        <ol class="att-steps">
          <li><%= t('attendance.how_1') %></li>
          <li><%= t('attendance.how_2') %></li>
          <li><%= t('attendance.how_3') %></li>
          <li><%= t('attendance.how_4') %></li>
        </ol>
        <p class="small muted mt-4 row-sm"><%- icon('lock', 'icon-sm') %><span><%= t('attendance.kiosk_security') %></span></p>
      </div>
    </section>
  </div>

  <div class="stack">
    <form class="panel" method="post" action="/app/attendance/screens" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="panel-head"><div><h2><%= t('attendance.screen_add') %></h2><div class="panel-sub"><%= t('attendance.screen_add_sub') %></div></div></div>
      <div class="panel-body">
        <% if (o.name !== undefined && typeof formError !== 'undefined' && formError && !errs.name) { %><%- include('../../partials/form-error') %><% } %>
        <%- include('../../partials/field', { name: 'name', label: t('attendance.screen_name'), required: true, placeholder: t('attendance.screen_name_ph'), attrs: 'maxlength="120"', value: '' }) %>
      </div>
      <div class="panel-foot"><button class="btn btn-primary" type="submit"><%- icon('plus', 'icon-sm') %><%= t('attendance.screen_add') %></button></div>
    </form>

    <form class="panel" method="post" action="/app/attendance/settings">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="section" value="rules">
      <div class="panel-head"><h2><%= t('attendance.policy') %></h2></div>
      <div class="panel-body stack">
        <div>
          <label class="check"><input type="checkbox" name="qr_only" value="1"<%= settings.qrOnly ? ' checked' : '' %>><span><%= t('attendance.qr_only') %></span></label>
          <p class="help mt-1"><%= t('attendance.qr_only_help') %></p>
        </div>
        <div>
          <label class="check"><input type="checkbox" name="same_network" value="1"<%= settings.sameNetwork ? ' checked' : '' %>><span><%= t('attendance.same_network') %></span></label>
          <p class="help mt-1"><%= t('attendance.same_network_help') %></p>
        </div>
      </div>
      <div class="panel-foot"><button class="btn btn-secondary" type="submit"><%= t('common.save') %></button></div>
    </form>
  </div>
</div>
