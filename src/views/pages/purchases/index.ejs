<% var canManage = can('purchases.manage'); var m = metrics; var dec = ['JOD','KWD','BHD','OMR','TND','LYD','IQD'].indexOf(currency) >= 0 ? 3 : 2; %>
<div class="page-head">
  <div><div class="breadcrumbs"><%= t('nav.group_operations') %></div><h1><%= t('purchases.title') %></h1><p><%= t('purchases.lead') %></p></div>
  <div class="page-actions">
    <%- include('../../partials/period') %>
    <% if (tab === 'invoices') { %><%- include('../../partials/export-menu', { href: '/app/purchases/export' }) %><% } %>
    <% if (canManage) { %><button class="btn btn-primary" type="button" data-open-dialog="purchase-dialog" data-reset-form data-action="/app/purchases" data-dialog-title="<%= t('purchases.add') %>"><%- icon('plus', 'icon-sm') %><%= t('purchases.add') %></button><% } %>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="stat-label"><%= t('purchases.committed') %><span class="stat-icon"><%- icon('package') %></span></div><div class="stat-value"><%= fmt.money(m.totalInventoryCommitment) %></div><div class="stat-meta"><%= t('purchases.committed_help') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('purchases.paid_total') %><span class="stat-icon info"><%- icon('banknote') %></span></div><div class="stat-value"><%= fmt.money(m.totalInventoryPurchased) %></div><div class="stat-meta"><%= t('purchases.paid_help') %></div></div>
  <div class="stat hero"><div class="stat-label"><%= t('purchases.payables') %><span class="stat-icon"><%- icon('clock') %></span></div><div class="stat-value"><%= fmt.money(m.totalInventoryDue) %></div><div class="stat-meta"><%= t('purchases.payables_help') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('purchases.cogs') %><span class="stat-icon accent"><%- icon('layers') %></span></div><div class="stat-value"><%= fmt.money(m.totalCogs) %></div><div class="stat-meta"><%= t('purchases.cogs_help') %></div></div>
</div>

<div class="panel mt-4"><div class="panel-body row wrap" style="gap:10px">
  <span class="badge badge-brand"><%= t('purchases.flow_purchases') %></span><%- icon('arrow-right', 'icon-sm muted flip-rtl') %>
  <span class="badge"><%= t('purchases.flow_cogs', { amount: fmt.money(m.totalCogs) }) %></span><%- icon('arrow-right', 'icon-sm muted flip-rtl') %>
  <span class="badge"><%= t('purchases.flow_revenue', { amount: fmt.money(m.totalRevenue) }) %></span><%- icon('arrow-right', 'icon-sm muted flip-rtl') %>
  <span class="badge badge-success"><%= t('purchases.flow_gross', { amount: fmt.money(m.grossProfit), pct: fmt.pct(m.grossMarginPercent) }) %></span>
  <span class="small muted grow" style="min-width:220px"><%= t('purchases.flow_help') %></span>
</div></div>

<nav class="tabs mt-6 mb-4" aria-label="<%= t('nav.purchases') %>">
  <a href="/app/purchases" class="<%= tab === 'invoices' ? 'active' : '' %>"><%- icon('receipt', 'icon-sm') %><%= t('purchases.tab_invoices') %></a>
  <a href="/app/purchases?tab=suppliers" class="<%= tab === 'suppliers' ? 'active' : '' %>"><%- icon('building-2', 'icon-sm') %><%= t('purchases.tab_suppliers') %></a>
  <a href="/app/purchases?tab=items" class="<%= tab === 'items' ? 'active' : '' %>"><%- icon('boxes', 'icon-sm') %><%= t('purchases.tab_items') %></a>
</nav>

<% if (tab === 'invoices') { %>
<div class="panel flush">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('purchases.search') %>" aria-label="<%= t('common.search') %>"></div>
    <select class="select" name="status" aria-label="<%= t('common.status') %>"><option value="all"><%= t('purchases.all_statuses') %></option><% statuses.forEach(function (s) { %><option value="<%= s %>"<%= query.status === s ? ' selected' : '' %>><%= label('purchases.statuses', s) %></option><% }) %></select>
    <input class="input" type="date" name="from" value="<%= query.from || '' %>" aria-label="<%= t('common.from') %>"><input class="input" type="date" name="to" value="<%= query.to || '' %>" aria-label="<%= t('common.to') %>">
    <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="/app/purchases"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
  </form>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', filtered ? { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: '' } : { emptyIcon: 'package', emptyTitle: t('purchases.empty_title'), emptyText: t('purchases.empty_text'), emptyAction: canManage ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="purchase-dialog" data-reset-form>' + t('purchases.add') + '</button>' : '' }) %>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('common.date') %></th><th><%= t('purchases.item') %></th><th><%= t('purchases.supplier') %></th><th class="num"><%= t('purchases.qty_x_cost') %></th><th class="num"><%= t('purchases.total_landed') %></th><th class="num"><%= t('purchases.remaining') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
    <tbody><% rows.forEach(function (r) { var landed = Number(r.total_cost) + Number(r.shipping_cost); var rem = Math.max(0, landed - Number(r.paid_amount)); %>
      <tr>
        <td class="nowrap" data-label="<%= t('common.date') %>"><%= fmt.date(r.date) %></td>
        <td class="primary-cell"><div class="strong"><%= r.item_name %></div><div class="small muted"><%= [r.sku ? 'SKU ' + r.sku : null, r.category, r.invoice_ref ? '#' + r.invoice_ref : null].filter(Boolean).join(' · ') %></div></td>
        <td data-label="<%= t('purchases.supplier') %>"><%= r.supplier_name %><div class="small muted" dir="ltr" style="text-align:start"><%= r.supplier_phone || '' %></div></td>
        <td class="num" data-label="<%= t('purchases.qty_x_cost') %>"><%= fmt.number(r.quantity) %> × <%= fmt.amount(r.unit_cost) %></td>
        <td class="num strong" data-label="<%= t('purchases.total_landed') %>"><%= fmt.amount(landed) %><% if (Number(r.shipping_cost)) { %><div class="tiny muted"><%= t('purchases.incl_shipping', { amount: fmt.amount(r.shipping_cost) }) %></div><% } %></td>
        <td class="num <%= rem > 0 ? 'warn-text strong' : 'muted' %>" data-label="<%= t('purchases.remaining') %>"><%= fmt.amount(rem) %></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= r.payment_status === 'paid' ? 'badge-success' : r.payment_status === 'partial' ? 'badge-warning' : 'badge-danger' %>"><%= label('purchases.statuses', r.payment_status) %></span></td>
        <td class="actions">
          <% if (canManage) { %>
            <% if (rem > 0) { %><button class="btn btn-secondary btn-sm" type="button" data-open-dialog="pay-dialog" data-action="/app/purchases/<%= r.id %>/pay" data-fill="<%= json({ amount: Math.round(rem * 1000) / 1000 }) %>" data-dialog-title="<%= t('purchases.pay_supplier_for', { item: r.item_name }) %>"><%= t('purchases.pay') %></button><% } %>
            <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" data-open-dialog="purchase-dialog" data-action="/app/purchases/<%= r.id %>" data-dialog-title="<%= t('purchases.edit') %>" data-fill="<%= json({ date: r.date, supplier_name: r.supplier_name, supplier_phone: r.supplier_phone, item_name: r.item_name, sku: r.sku, category: r.category, unit_cost: r.unit_cost, quantity: r.quantity, shipping_cost: r.shipping_cost, paid_amount: r.paid_amount, invoice_ref: r.invoice_ref, notes: r.notes }) %>"><%- icon('pencil', 'icon-sm') %></button>
            <%- include('../../partials/delete-form', { action: '/app/purchases/' + r.id + '/delete' }) %>
          <% } %>
        </td>
      </tr>
    <% }) %></tbody>
    <tfoot><tr><td colspan="4"><%= t('table.totals') %></td><td class="num"><%= fmt.amount(totals.total_cost + totals.shipping_cost) %></td><td class="num"><%= fmt.amount(Math.max(0, totals.total_cost + totals.shipping_cost - totals.paid_amount)) %></td><td colspan="2"></td></tr></tfoot>
  </table></div>
  <%- include('../../partials/pagination', { meta: meta }) %>
  <% } %>
</div>
<% } else if (tab === 'suppliers') { %>
<div class="panel flush">
  <% if (!suppliers.length) { %><%- include('../../partials/empty', { emptyIcon: 'building-2', emptyTitle: t('purchases.no_suppliers'), emptyText: t('purchases.no_suppliers_text') }) %><% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('purchases.supplier') %></th><th class="num"><%= t('purchases.invoices') %></th><th class="num"><%= t('purchases.committed') %></th><th class="num"><%= t('purchases.paid') %></th><th class="num"><%= t('purchases.payable') %></th><th><%= t('purchases.last_purchase') %></th></tr></thead>
    <tbody><% suppliers.forEach(function (s) { %><tr>
      <td class="primary-cell"><a class="strong" href="/app/purchases?q=<%= encodeURIComponent(s.supplier_name) %>"><%= s.supplier_name %></a><div class="small muted" dir="ltr" style="text-align:start"><%= s.phone || '' %></div></td>
      <td class="num" data-label="<%= t('purchases.invoices') %>"><%= s.invoices %></td>
      <td class="num" data-label="<%= t('purchases.committed') %>"><%= fmt.amount(s.committed) %></td>
      <td class="num" data-label="<%= t('purchases.paid') %>"><%= fmt.amount(s.paid) %></td>
      <td class="num strong <%= s.due > 0 ? 'warn-text' : '' %>" data-label="<%= t('purchases.payable') %>"><%= fmt.amount(s.due) %></td>
      <td data-label="<%= t('purchases.last_purchase') %>"><%= fmt.date(s.last_date) %></td>
    </tr><% }) %></tbody>
  </table></div><% } %>
</div>
<% } else { %>
<div class="panel flush">
  <% if (!items.length) { %><%- include('../../partials/empty', { emptyIcon: 'boxes', emptyTitle: t('purchases.no_items'), emptyText: t('purchases.no_items_text') }) %><% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('purchases.item') %></th><th class="num"><%= t('purchases.purchased_qty') %></th><th class="num"><%= t('purchases.avg_unit_cost') %></th><th class="num"><%= t('purchases.sold_qty') %></th><th class="num"><%= t('purchases.on_hand') %></th><th><%= t('purchases.last_purchase') %></th></tr></thead>
    <tbody><% items.forEach(function (i) { %><tr>
      <td class="primary-cell"><div class="strong"><%= i.item_name %></div><div class="small muted"><%= [i.sku ? 'SKU ' + i.sku : null, i.category].filter(Boolean).join(' · ') %></div></td>
      <td class="num" data-label="<%= t('purchases.purchased_qty') %>"><%= fmt.number(i.qty) %></td>
      <td class="num" data-label="<%= t('purchases.avg_unit_cost') %>"><%= fmt.amount(i.avgUnitCost) %></td>
      <td class="num" data-label="<%= t('purchases.sold_qty') %>"><%= fmt.number(i.sold) %></td>
      <td class="num strong <%= i.onHand <= 0 ? 'neg' : '' %>" data-label="<%= t('purchases.on_hand') %>"><%= fmt.number(i.onHand) %></td>
      <td data-label="<%= t('purchases.last_purchase') %>"><%= fmt.date(i.last_date) %></td>
    </tr><% }) %></tbody>
  </table></div>
  <div class="panel-body small muted"><%= t('purchases.items_note') %></div><% } %>
</div>
<% } %>

<% if (canManage) { %>
<dialog class="dialog wide" id="purchase-dialog" data-new-dialog aria-labelledby="purchase-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'purchase-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="<%= typeof formAction !== 'undefined' && formAction ? formAction : '/app/purchases' %>" data-calc="purchase" data-decimals="<%= dec %>" novalidate>
    <div class="dialog-head"><h2 id="purchase-title" data-dialog-title-target><%= t('purchases.add') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../../partials/form-error') %>
      <div class="form-grid cols-3">
        <%- include('../../partials/field', { name: 'item_name', label: t('purchases.item'), required: true, cls: 'span-2' }) %>
        <%- include('../../partials/field', { name: 'sku', label: 'SKU' }) %>
        <div class="field span-2"><label class="label" for="f-supplier_name"><%= t('purchases.supplier') %><span class="req">*</span></label><input class="input<%= errors.supplier_name ? ' is-invalid' : '' %>" id="f-supplier_name" name="supplier_name" list="supplier-list" value="<%= old.supplier_name || '' %>" required><datalist id="supplier-list"><% supplierNames.forEach(function (s) { %><option value="<%= s %>"><% }) %></datalist><% if (errors.supplier_name) { %><span class="field-error"><%= errors.supplier_name %></span><% } %></div>
        <%- include('../../partials/field', { name: 'supplier_phone', label: t('purchases.supplier_phone'), type: 'tel' }) %>
        <%- include('../../partials/field', { name: 'category', label: t('common.category') }) %>
        <%- include('../../partials/field', { name: 'date', label: t('common.date'), type: 'date', required: true, value: today, attrs: 'data-default="' + today + '"' }) %>
        <%- include('../../partials/field', { name: 'invoice_ref', label: t('purchases.invoice_ref') }) %>
        <%- include('../../partials/field', { name: 'unit_cost', label: t('purchases.unit_cost'), required: true, suffix: currency, attrs: 'inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'quantity', label: t('purchases.quantity'), required: true, attrs: 'inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'shipping_cost', label: t('purchases.shipping'), value: 0, suffix: currency, attrs: 'inputmode="decimal" data-default="0"' }) %>
        <%- include('../../partials/field', { name: 'paid_amount', label: t('purchases.paid'), value: 0, suffix: currency, attrs: 'inputmode="decimal" data-default="0"' }) %>
      </div>
      <div class="kpis">
        <div class="kpi"><div class="kpi-label"><%= t('purchases.total_cost') %></div><div class="kpi-value"><span data-out="total">0</span></div></div>
        <div class="kpi"><div class="kpi-label"><%= t('purchases.total_landed') %></div><div class="kpi-value"><span data-out="payable">0</span></div></div>
        <div class="kpi"><div class="kpi-label"><%= t('purchases.remaining') %></div><div class="kpi-value warn-text"><span data-out="remaining">0</span></div></div>
        <div class="kpi"><div class="kpi-label"><%= t('common.currency') %></div><div class="kpi-value"><%= currency %></div></div>
      </div>
      <%- include('../../partials/field', { name: 'notes', label: t('common.notes'), type: 'textarea' }) %>
      <p class="help"><%= t('purchases.status_auto') %></p>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
<dialog class="dialog" id="pay-dialog" aria-labelledby="pay-title">
  <form method="post" action="/app/purchases" novalidate>
    <div class="dialog-head"><h2 id="pay-title" data-dialog-title-target><%= t('purchases.pay') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_return" value="<%= fullPath %>">
      <%- include('../../partials/field', { name: 'amount', label: t('purchases.payment_amount'), required: true, suffix: currency, attrs: 'inputmode="decimal"' }) %><p class="help"><%= t('purchases.payment_help') %></p></div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('purchases.record_payment') %></button></div>
  </form>
</dialog>
<% } %>
