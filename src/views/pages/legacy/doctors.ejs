<% var B = '/app/import/legacy-clinica'; %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/patients"><%= t('patients.title') %></a><%- icon('chevron-right', 'flip-rtl') %><a href="<%= B %>"><%= t('legacy.title') %></a><%- icon('chevron-right', 'flip-rtl') %></div>
    <h1><%= t('legacy.doc_title') %></h1>
    <p><%= t('legacy.doc_lead') %></p>
  </div>
</div>
<% if (!list.length) { %>
<section class="panel"><div class="empty"><span class="empty-icon"><%- icon('stethoscope') %></span><p><%= t('legacy.doc_empty') %></p></div></section>
<% } else { %>
<form method="post" action="<%= B %>/doctors" class="panel" data-legacy-doctors>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('legacy.doc_col_name') %></th><th class="num"><%= t('legacy.doc_col_count') %></th><th><%= t('legacy.doc_col_here') %></th></tr></thead>
    <tbody>
    <% list.forEach(function (x, i) { var v = x.action === 'doctor' && x.doctorId ? 'd:' + x.doctorId : x.action; %>
      <tr>
        <td data-label="<%= t('legacy.doc_col_name') %>"><% if (x.key) { %><strong dir="auto"><%= x.name %></strong><% } else { %><em class="muted"><%= t('legacy.doc_none_name') %></em><% } %>
          <% if (!x.chosen && x.auto) { %><div class="tiny muted"><%= t('legacy.doc_auto') %></div><% } else if (!x.chosen && x.key) { %><div class="tiny text-danger"><%= t('legacy.doc_not_found') %></div><% } %></td>
        <td data-label="<%= t('legacy.doc_col_count') %>" class="num"><%= fmt.number(x.count) %></td>
        <td data-label="<%= t('legacy.doc_col_here') %>">
          <input type="hidden" name="key" value="<%= x.key %>"><input type="hidden" name="action" value="<%= x.action %>" data-act><input type="hidden" name="doctor_id" value="<%= x.doctorId || '' %>" data-doc>
          <select class="select" data-pick aria-label="<%= x.name || t('legacy.doc_none_name') %>">
            <option value="none"<%= v === 'none' ? ' selected' : '' %>><%= t(x.key ? 'legacy.doc_opt_none' : 'legacy.doc_opt_leave') %></option>
            <% if (x.key) { %><option value="create"<%= v === 'create' ? ' selected' : '' %>><%= t('legacy.doc_opt_create', { name: x.name }) %></option><% } %>
            <optgroup label="<%= t('legacy.doc_opt_existing') %>">
              <% doctors.forEach(function (d) { %><option value="d:<%= d.id %>"<%= v === 'd:' + d.id ? ' selected' : '' %>><%= d.full_name %><%= d.is_active ? '' : ' (' + t('legacy.doc_inactive') + ')' %></option><% }) %>
            </optgroup>
          </select>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <div class="panel-body row-sm" style="justify-content:space-between;flex-wrap:wrap">
    <p class="small muted" style="margin:0"><%= t('legacy.doc_note') %></p>
    <button class="btn btn-primary" type="submit"><%- icon('check', 'icon-sm') %><%= t('legacy.doc_save') %></button>
  </div>
</form>
<% } %>
