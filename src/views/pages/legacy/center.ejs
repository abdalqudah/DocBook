<% var B = '/app/import/legacy-clinica'; %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/patients"><%= t('patients.title') %></a><%- icon('chevron-right', 'flip-rtl') %></div>
    <h1><%= t('legacy.title') %></h1>
    <p><%= t('legacy.lead') %></p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="<%= B %>/recovery"><%- icon('archive-restore', 'icon-sm') %><%= t('legacy.recovery') %></a>
    <% if (current) { %>
    <a class="btn btn-primary" href="<%= B %>/jobs/<%= current.id %>"><%- icon('arrow-right', 'icon-sm flip-rtl') %><%= t('legacy.continue') %></a>
    <% } else { %>
    <form method="post" action="<%= B %>/jobs"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit"><%- icon('cloud-upload', 'icon-sm') %><%= t('legacy.start_new') %></button></form>
    <% } %>
  </div>
</div>

<div class="alert alert-info mb-4" role="note"><%- icon('shield-check') %><div class="grow small"><%= t('legacy.privacy') %></div></div>

<% if (promotion.total) { var _pp = Math.round(promotion.done * 100 / promotion.total); %>
<section class="panel mb-4" data-promote data-status-url="<%= B %>/promote/status" data-live="<%= promotion.running ? '1' : '' %>">
  <div class="panel-head"><div><h2><%- icon('clipboard-list', 'icon-sm') %> <%= t('legacy.promote_title') %></h2><p class="panel-sub"><%= t('legacy.promote_sub') %></p></div>
    <div class="row-sm" style="flex-wrap:wrap">
      <a class="btn btn-secondary btn-sm" href="<%= B %>/doctors"><%- icon('stethoscope', 'icon-sm') %><%= t('legacy.doc_title') %></a>
      <form method="post" action="<%= B %>/promote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-sm" type="submit"<%= promotion.running ? ' disabled' : '' %>><%- icon('refresh-cw', 'icon-sm') %><%= t(promotion.done < promotion.total - promotion.unlinked ? 'legacy.promote_run' : 'legacy.promote_again') %></button></form>
    </div></div>
  <div class="panel-body stack-sm">
    <div class="row-sm" style="justify-content:space-between;flex-wrap:wrap"><strong data-text data-tpl="<%= t('legacy.promote_progress', { done: '{done}', total: '{total}' }) %>"><%= t('legacy.promote_progress', { done: fmt.number(promotion.done), total: fmt.number(promotion.total) }) %></strong><span class="num strong" data-pct><%= _pp %>%</span></div>
    <span class="meter" aria-hidden="true"><span data-bar style="width:<%= _pp %>%"></span></span>
    <div class="summary-strip">
      <span class="chip"><%- icon('calendar-days', 'icon-sm') %> <%= t('legacy.promote_visits') %> <strong data-visits><%= fmt.number(promotion.visits) %></strong></span>
      <span class="chip<%= promotion.noDoctor ? ' lg-warn' : '' %>"><%- icon('stethoscope', 'icon-sm') %> <%= t('legacy.promote_no_doctor') %> <strong><%= fmt.number(promotion.noDoctor) %></strong></span>
      <% if (promotion.unlinked) { %><span class="chip lg-warn"><%= t('legacy.promote_unlinked', { n: fmt.number(promotion.unlinked) }) %></span><% } %>
    </div>
    <% if (promotion.running) { %><p class="small muted"><%- icon('hourglass', 'icon-sm') %> <%= t('legacy.promote_running') %></p><% } %>
    <% if (promotion.noDoctor) { %><p class="small"><a class="link" href="<%= B %>/doctors"><%= t('legacy.promote_pick_doctors') %></a></p><% } %>
  </div>
</section>
<% } %>
<% if (legacyCount) { %><p class="small muted mb-4"><%- icon('users', 'icon-sm') %> <a class="link" href="<%= B %>/recovery"><%= t('legacy.legacy_count', { n: fmt.number(legacyCount) }) %></a></p><% } %>

<section class="panel">
  <div class="panel-head"><div><h2><%= t('legacy.history') %></h2></div></div>
  <% if (!history.length) { %>
  <div class="empty compact"><span class="empty-icon"><%- icon('archive-restore') %></span><p><%= t('legacy.no_history') %></p></div>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('legacy.col.job') %></th><th><%= t('legacy.col.status') %></th><th><%= t('legacy.col.started') %></th><th><%= t('legacy.col.completed') %></th><th class="num"><%= t('legacy.col.patients') %></th><th class="num"><%= t('legacy.col.treatments') %></th><th class="num"><%= t('legacy.col.files') %></th></tr></thead>
    <tbody>
    <% history.forEach(function (j) { %>
      <tr>
        <td data-label="<%= t('legacy.col.job') %>"><a class="link strong" href="<%= B %>/jobs/<%= j.id %>">#<%= j.id %></a></td>
        <td data-label="<%= t('legacy.col.status') %>"><%- include('_status', { st: j.status }) %></td>
        <td data-label="<%= t('legacy.col.started') %>"><%= j.started_at ? fmt.date(j.started_at) : fmt.date(j.created_at) %></td>
        <td data-label="<%= t('legacy.col.completed') %>"><%= j.completed_at ? fmt.date(j.completed_at) : '—' %></td>
        <td class="num" data-label="<%= t('legacy.col.patients') %>"><%= fmt.number(j.src_patients || 0) %></td>
        <td class="num" data-label="<%= t('legacy.col.treatments') %>"><%= fmt.number(j.src_treatments || 0) %></td>
        <td class="num" data-label="<%= t('legacy.col.files') %>"><%= fmt.number(j.src_attachments || 0) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>

<% if (isOwner() && legacyCount) { var rm = remote; var rmRun = rm && rm.status === 'processing'; %>
<section class="panel mt-6" id="remote" data-remote<% if (rmRun) { %> data-live data-status-url="<%= B %>/remote/status"<% } %>>
  <div class="panel-head"><div><h2><%- icon('download', 'icon-sm') %> <%= t('legacy.remote_title') %></h2><p class="panel-sub"><%= t('legacy.remote_sub') %></p></div><% if (rm) { %><%- include('_status', { st: rm.status }) %><% } %></div>
  <div class="panel-body stack">
    <% if (rm) { %>
    <div class="summary-strip">
      <span class="chip"><%= t('legacy.col.patients') %> <strong data-rm="patients"><%= fmt.number(rm.patients.done) %> / <%= fmt.number(rm.patients.total) %></strong></span>
      <span class="chip"><%= t('legacy.remote_found') %> <strong data-rm="found"><%= fmt.number(rm.found) %></strong></span>
      <span class="chip"><%= t('legacy.remote_downloaded') %> <strong data-rm="downloaded"><%= fmt.number(rm.downloaded) %></strong></span>
      <span class="chip"><%= t('legacy.remote_skipped') %> <strong data-rm="skipped"><%= fmt.number(rm.skipped) %></strong></span>
      <span class="chip"><%= t('legacy.remote_failed') %> <strong data-rm="failed"><%= fmt.number(rm.failed) %></strong></span>
    </div>
    <% if (!rmRun && rm.waitingFor && rm.status === 'waiting') { %><p class="small text-danger"><%- icon('circle-alert', 'icon-sm') %> <%= t('legacy.remote_wait.' + (['NEEDS_SIGN_IN', 'LOGIN_FAILED', 'STORAGE_FULL', 'STOPPED'].indexOf(rm.waitingFor) >= 0 ? rm.waitingFor : 'STOPPED')) %></p><% } %>
    <% if (rm.errors && rm.errors.length) { %><details><summary class="small"><%= t('legacy.remote_errors', { n: fmt.number(rm.failed) }) %></summary><ul class="small"><% rm.errors.forEach(function (e) { %><li dir="auto"><bdi><%= e.legacy_patient_id %></bdi> · <%= e.error_code %><%= e.file ? ' · ' + decodeURIComponent(String(e.file).split('/').pop()) : '' %></li><% }) %></ul></details><% } %>
    <% } %>
    <% if (rmRun) { %>
    <form method="post" action="<%= B %>/remote/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary" type="submit"><%- icon('x', 'icon-sm') %><%= t('legacy.remote_stop') %></button></form>
    <% } else { %>
    <% if (!remoteSignIn) { %>
    <form class="row-sm" style="flex-wrap:wrap;align-items:flex-end" method="post" action="<%= B %>/remote/prepare">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field grow"><span class="label"><%= t('legacy.remote_address') %></span><input class="input" name="base_url" dir="ltr" required value="https://dentalbh.clinicame.net"></label>
      <button class="btn btn-primary" type="submit"><%- icon('key-round', 'icon-sm') %><%= t('legacy.remote_connect') %></button>
    </form>
    <% } else { %>
    <form class="stack-sm" method="post" action="<%= B %>/remote/start" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="base_url" value="<%= remoteSignIn.base %>">
      <p class="small" style="margin:0"><%= t('legacy.remote_signin_at') %> <bdi dir="ltr" class="strong"><%= remoteSignIn.base %></bdi></p>
      <div class="grid grid-3">
        <label class="field"><span class="label"><%= t('legacy.remote_user') %></span><input class="input" name="username" dir="ltr" required autocomplete="off"></label>
        <label class="field"><span class="label"><%= t('legacy.remote_pass') %></span><input class="input" name="password" type="password" dir="ltr" required autocomplete="new-password"></label>
        <% if (remoteSignIn.question) { %><label class="field"><span class="label"><%= t('legacy.remote_question') %> <bdi dir="ltr" class="strong" data-remote-question><%= remoteSignIn.question %></bdi></span><input class="input" name="captcha" dir="ltr" required autocomplete="off" inputmode="numeric"><span class="hint"><%= t('legacy.remote_question_hint') %></span></label><% } %>
      </div>
      <p class="small muted" style="margin:0"><%- icon('lock', 'icon-sm') %> <%= t('legacy.remote_privacy') %></p>
      <div><button class="btn btn-primary" type="submit"><%- icon('download', 'icon-sm') %><%= t(rm && rm.status === 'waiting' ? 'legacy.remote_resume' : 'legacy.remote_start') %></button></div>
    </form>
    <% } %>
    <% } %>
  </div>
</section>
<% } %>

<% if (isOwner() && (purge.patients || purge.visits || purge.plan || purge.files || purge.running)) { %>
<section class="panel mt-6" data-legacy-purge>
  <div class="panel-head"><div><h2><%- icon('trash-2', 'icon-sm') %> <%= t('legacy.purge_title') %></h2><p class="panel-sub"><%= t('legacy.purge_sub') %></p></div></div>
  <div class="panel-body stack">
    <div class="summary-strip">
      <span class="chip"><%= t('legacy.col.patients') %> <strong><%= fmt.number(purge.patients) %></strong></span>
      <span class="chip"><%= t('legacy.promote_visits') %> <strong><%= fmt.number(purge.visits) %></strong></span>
      <span class="chip"><%= t('legacy.col.treatments') %> <strong><%= fmt.number(purge.plan) %></strong></span>
      <span class="chip"><%= t('legacy.col.files') %> <strong><%= fmt.number(purge.files) %></strong></span>
      <span class="chip"><%= t('legacy.purge_doctors') %> <strong><%= fmt.number(purge.doctors) %></strong></span>
    </div>
    <% if (purge.running) { %><p class="small"><%- icon('hourglass', 'icon-sm') %> <%= t('legacy.purge_running') %></p><% } else { %>
    <form class="row-sm" style="flex-wrap:wrap" method="post" action="<%= B %>/purge" data-confirm="<%= t('legacy.purge_confirm') %>" data-confirm-tone="danger">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input class="input" name="confirm" required autocomplete="off" placeholder="<%= t('legacy.purge_placeholder') %>" aria-label="<%= t('legacy.purge_placeholder') %>" style="max-width:240px">
      <button class="btn btn-danger" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('legacy.purge_button') %></button>
    </form>
    <% } %>
  </div>
</section>
<% } %>
