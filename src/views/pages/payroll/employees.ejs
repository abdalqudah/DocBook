<% var canManage = can('payroll.manage'); %>
<div class="page-head">
  <div><div class="breadcrumbs"><%= t('nav.group_finance') %></div><h1><%= t('payroll.employees') %></h1><p><%= t('payroll.employees_lead') %></p></div>
  <div class="page-actions">
    <%- include('../../partials/export-menu', { href: '/app/payroll/employees/export' }) %>
    <% if (canManage) { %><a class="btn btn-primary" href="/app/payroll/employees/new"><%- icon('user-plus', 'icon-sm') %><%= t('payroll.add_employee') %></a><% } %>
  </div>
</div>
<%- include('tabs', { tab: 'employees' }) %>
<div class="panel flush">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('payroll.search') %>" aria-label="<%= t('common.search') %>"></div>
    <div class="pill-filter" role="group">
      <% ['all'].concat(statuses).forEach(function (s) { var active = (query.status || 'all') === s; %><a class="<%= active ? 'active' : '' %>" href="?status=<%= s %><%= query.q ? '&q=' + encodeURIComponent(query.q) : '' %>"><%= s === 'all' ? t('common.all') : label('payroll.statuses', s) %></a><% }) %>
    </div>
  </form>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', filtered ? { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: '' } : { emptyIcon: 'users', emptyTitle: t('payroll.empty_title'), emptyText: t('payroll.empty_text'), emptyAction: canManage ? '<a class="btn btn-primary btn-sm" href="/app/payroll/employees/new">' + t('payroll.add_employee') + '</a>' : '' }) %>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('payroll.employee') %></th><th><%= t('common.phone') %></th><th class="num"><%= t('payroll.monthly_net') %></th><th><%= t('payroll.commission_scheme') %></th><th class="num"><%= t('payroll.commission_this_month') %></th><th><%= t('common.status') %></th></tr></thead>
    <tbody><% rows.forEach(function (r) { var net = Number(r.base_salary) + Number(r.bonus) - Number(r.deductions); %>
      <tr data-href="/app/payroll/employees/<%= r.id %>">
        <td class="primary-cell"><a class="person" href="/app/payroll/employees/<%= r.id %>"><span class="avatar"><%= initials(r.name) %></span><span><span class="person-name"><%= r.name %></span><span class="person-sub" style="display:block"><%= r.role || '—' %></span></span></a></td>
        <td data-label="<%= t('common.phone') %>" dir="ltr" style="text-align:start"><%= r.phone || '—' %></td>
        <td class="num strong" data-label="<%= t('payroll.monthly_net') %>"><%= fmt.amount(net) %></td>
        <td data-label="<%= t('payroll.commission_scheme') %>"><%= r.commission_type === 'percentage' ? fmt.number(r.commission_rate) + '%' : fmt.money(r.commission_rate) + ' / ' + t('payroll.per_order') %></td>
        <td class="num" data-label="<%= t('payroll.commission_this_month') %>"><%= fmt.amount(commission[r.id] || 0) %></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= r.status === 'active' ? 'badge-success' : r.status === 'on_leave' ? 'badge-info' : 'badge-neutral' %>"><%= label('payroll.statuses', r.status) %></span></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <%- include('../../partials/pagination', { meta: meta }) %>
  <% } %>
</div>
