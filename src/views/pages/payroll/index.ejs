<% var canManage = can('payroll.manage'); var unpaid = rows.filter(function (r) { return !r.paid && r.status !== 'inactive'; }); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs no-print"><%= t('nav.group_finance') %></div>
    <h1><%= t('payroll.title') %> — <%= fmt.month(month) %></h1>
    <p class="no-print"><%= t('payroll.lead') %></p>
  </div>
  <div class="page-actions no-print">
    <form class="period-picker" method="get" data-autosubmit><%- icon('calendar', 'muted') %><input class="input" type="month" name="month" value="<%= month %>" aria-label="<%= t('common.month') %>"></form>
    <%- include('../../partials/export-menu', { href: '/app/payroll/export' }) %>
    <a class="btn btn-secondary" href="?month=<%= month %>&print=1"><%- icon('printer', 'icon-sm') %><%= t('common.print') %></a>
    <% if (canManage) { %><a class="btn btn-primary" href="/app/payroll/employees/new"><%- icon('user-plus', 'icon-sm') %><%= t('payroll.add_employee') %></a><% } %>
  </div>
</div>
<%- include('tabs', { tab: 'run' }) %>

<div class="stats">
  <div class="stat hero"><div class="stat-label"><%= t('payroll.total_net') %><span class="stat-icon"><%- icon('wallet') %></span></div><div class="stat-value"><%= fmt.money(totals.net) %></div><div class="stat-meta"><%= t('payroll.employees_n', { n: rows.length }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('payroll.salaries') %><span class="stat-icon"><%- icon('banknote') %></span></div><div class="stat-value"><%= fmt.money(totals.base + totals.bonus - totals.deductions) %></div><div class="stat-meta"><%= t('payroll.bonus') %> <%= fmt.money(totals.bonus) %> · <%= t('payroll.deductions') %> <%= fmt.money(totals.deductions) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('payroll.commissions') %><span class="stat-icon accent"><%- icon('percent') %></span></div><div class="stat-value"><%= fmt.money(totals.commission) %></div><div class="stat-meta"><%= t('payroll.commissions_note') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('payroll.outstanding') %><span class="stat-icon <%= totals.unpaid > 0 ? 'warning' : '' %>"><%- icon('clock') %></span></div><div class="stat-value <%= totals.unpaid > 0 ? 'warn-text' : 'pos' %>"><%= fmt.money(totals.unpaid) %></div><div class="stat-meta"><%= t('payroll.paid_so_far', { amount: fmt.money(totals.paid) }) %></div></div>
</div>

<div class="panel flush mt-6">
  <div class="panel-head">
    <div><h2><%= t('payroll.register') %></h2><div class="panel-sub"><%= t('payroll.register_sub') %></div></div>
    <% if (canManage && unpaid.length) { %>
      <form class="no-print" method="post" action="/app/payroll/pay" data-confirm="<%= t('payroll.pay_all_confirm', { n: unpaid.length, month: fmt.month(month) }) %>" data-confirm-title="<%= t('payroll.pay_all') %>" data-confirm-yes="<%= t('payroll.pay_all') %>" data-confirm-tone="primary">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= month %>">
        <button class="btn btn-primary btn-sm" type="submit"><%- icon('check', 'icon-sm') %><%= t('payroll.pay_all') %> (<%= unpaid.length %>)</button>
      </form>
    <% } %>
  </div>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', { emptyIcon: 'users', emptyTitle: t('payroll.empty_title'), emptyText: t('payroll.empty_text'), emptyAction: canManage ? '<a class="btn btn-primary btn-sm" href="/app/payroll/employees/new">' + t('payroll.add_employee') + '</a>' : '' }) %>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('payroll.employee') %></th><th class="num"><%= t('payroll.base_salary') %></th><th class="num"><%= t('payroll.bonus') %></th><th class="num"><%= t('payroll.deductions') %></th><th class="num"><%= t('payroll.commission') %></th><th class="num"><%= t('payroll.net_pay') %></th><th><%= t('common.status') %></th><th class="actions no-print"></th></tr></thead>
    <tbody><% rows.forEach(function (r) { %>
      <tr>
        <td class="primary-cell"><a class="person" href="/app/payroll/employees/<%= r.id %>"><span class="avatar"><%= initials(r.name) %></span><span><span class="person-name"><%= r.name %></span><span class="person-sub" style="display:block"><%= r.role || '' %><% if (r.status === 'on_leave') { %> · <%= label('payroll.statuses', r.status) %><% } %></span></span></a></td>
        <td class="num" data-label="<%= t('payroll.base_salary') %>"><%= fmt.amount(r.baseSalary) %></td>
        <td class="num" data-label="<%= t('payroll.bonus') %>"><%= r.bonus ? '+' + fmt.amount(r.bonus) : '—' %></td>
        <td class="num" data-label="<%= t('payroll.deductions') %>"><%= r.deductions ? '−' + fmt.amount(r.deductions) : '—' %></td>
        <td class="num" data-label="<%= t('payroll.commission') %>"><%= fmt.amount(r.commission) %><div class="tiny muted"><%= t('payroll.orders_n', { n: r.orders }) %></div></td>
        <td class="num strong" data-label="<%= t('payroll.net_pay') %>"><%= fmt.amount(r.net) %></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= r.paid ? 'badge-success' : 'badge-warning' %>"><%= r.paid ? t('payroll.paid') : t('payroll.unpaid') %></span></td>
        <td class="actions no-print">
          <a class="btn btn-ghost btn-icon btn-sm" href="/app/payroll/employees/<%= r.id %>/payslip/<%= month %>?print=1" title="<%= t('payroll.payslip') %>" aria-label="<%= t('payroll.payslip') %>"><%- icon('printer', 'icon-sm') %></a>
          <% if (canManage) { %>
            <% if (!r.paid) { %>
              <form method="post" action="/app/payroll/pay" style="display:inline" data-confirm="<%= t('payroll.pay_one_confirm', { name: r.name, amount: fmt.money(r.salary), month: fmt.month(month) }) %>" data-confirm-title="<%= t('payroll.mark_paid') %>" data-confirm-yes="<%= t('payroll.mark_paid') %>" data-confirm-tone="primary"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="employee_id" value="<%= r.id %>"><button class="btn btn-secondary btn-sm" type="submit"><%= t('payroll.mark_paid') %></button></form>
            <% } else { %>
              <form method="post" action="/app/payroll/unpay" style="display:inline" data-confirm="<%= t('payroll.unpay_confirm', { name: r.name }) %>" data-confirm-title="<%= t('payroll.undo_paid') %>" data-confirm-yes="<%= t('payroll.undo_paid') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="employee_id" value="<%= r.id %>"><button class="btn btn-ghost btn-sm" type="submit"><%= t('payroll.undo_paid') %></button></form>
            <% } %>
          <% } %>
        </td>
      </tr>
    <% }) %></tbody>
    <tfoot><tr><td><%= t('table.totals') %></td><td class="num"><%= fmt.amount(totals.base) %></td><td class="num"><%= fmt.amount(totals.bonus) %></td><td class="num"><%= fmt.amount(totals.deductions) %></td><td class="num"><%= fmt.amount(totals.commission) %></td><td class="num"><%= fmt.amount(totals.net) %></td><td></td><td class="no-print"></td></tr></tfoot>
  </table></div>
  <% } %>
</div>
<div class="alert alert-info mt-4 no-print"><%- icon('info') %><div class="grow small"><%= t('payroll.rule_note') %></div></div>
