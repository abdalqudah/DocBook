<%/* Patient file → "Tests & files": lab / imaging orders, referral letters and the uploaded files (data: ot). */%>
<% var LL = function (ar, en) { return locale === 'en' && en ? en : ar; };
   var tone = { ordered: 'badge-warning', done: 'badge-success', cancelled: 'badge-neutral' };
   var canUpload = can('clinical.edit') || can('prescriptions.create') || can('patients.edit');
   var kb = function (n) { return n >= 1048576 ? (Math.round(n / 104857.6) / 10) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB'; }; %>
<div class="grid grid-2">
  <div class="panel flush">
    <div class="panel-head"><h2><%- icon('activity', 'icon-sm') %> <%= t('orders.tab_orders') %></h2><span class="badge"><%= fmt.number(ot.orders.length) %></span></div>
    <% if (!ot.orders.length) { %><div class="flush-empty small muted"><%= t('orders.no_orders') %></div><% } else { %>
    <ul class="action-list"><% ot.orders.forEach(function (o) { %>
      <li><a href="/app/orders/<%= o.id %>"><span class="action-icon"><%- icon(o.kind === 'lab' ? 'activity' : 'scan-line', 'icon-sm') %></span><span class="grow" style="min-width:0"><span class="strong"><%= t('orders.kind.' + o.kind) %></span> <span class="badge badge-dot <%= tone[o.status] %>"><%= t('orders.status.' + o.status) %></span><span class="small muted d-block ord-items"><%= o.items.map(function (i) { return LL(i.name, i.name_en); }).join('، ') %></span><span class="tiny muted d-block"><%= fmt.date(o.created_at) %><%= o.doctor_name ? ' · ' + LL(o.doctor_name, o.doctor_name_en) : '' %></span></span></a></li>
    <% }) %></ul><% } %>
  </div>
  <div class="panel flush">
    <div class="panel-head"><h2><%- icon('send', 'icon-sm') %> <%= t('orders.tab_referrals') %></h2><span class="badge"><%= fmt.number(ot.referrals.length) %></span></div>
    <% if (!ot.referrals.length) { %><div class="flush-empty small muted"><%= t('orders.no_referrals') %></div><% } else { %>
    <ul class="action-list"><% ot.referrals.forEach(function (r) { %>
      <li><a href="/app/referrals/<%= r.id %>"><span class="action-icon"><%- icon('send', 'icon-sm') %></span><span class="grow" style="min-width:0"><span class="strong"><%= t('orders.referral_to', { specialty: r.specialty }) %></span><span class="small muted d-block ord-items"><%= [r.to_doctor, r.to_facility].filter(Boolean).join(' · ') || r.reason %></span><span class="tiny muted d-block"><%= fmt.date(r.created_at) %><%= r.doctor_name ? ' · ' + LL(r.doctor_name, r.doctor_name_en) : '' %></span></span></a></li>
    <% }) %></ul><% } %>
  </div>
</div>
<div class="panel flush mt-4" id="files">
  <div class="panel-head"><div><h2><%- icon('paperclip', 'icon-sm') %> <%= t('orders.tab_files') %></h2><p class="panel-sub"><%= t('orders.files_sub') %></p></div><span class="badge"><%= fmt.number(ot.files.length) %></span></div>
  <% if (!ot.files.length) { %><div class="flush-empty small muted"><%= t('orders.no_files') %></div><% } else { %>
  <ul class="action-list"><% ot.files.forEach(function (f) { %>
    <li class="row"><a class="grow row" href="/app/patients/<%= patient.id %>/files/<%= f.id %>" target="_blank" rel="noopener"><span class="ord-file-thumb"><%- icon(f.mime === 'application/pdf' ? 'file-text' : 'image', 'icon-sm') %></span><span class="grow" style="min-width:0"><span class="strong"><%= f.title || f.name %></span> <span class="badge"><%= t('orders.cat.' + f.category) %></span><span class="tiny muted d-block"><bdi><%= f.name %></bdi> · <span dir="ltr"><%= kb(f.size) %></span> · <%= fmt.date(f.created_at) %><%= f.added_by ? ' · ' + f.added_by : '' %><% if (f.order_id) { %> · <%= t('orders.number') %> #<%= f.order_id %><% } %></span></span></a>
      <a class="btn btn-ghost btn-icon btn-sm" href="/app/patients/<%= patient.id %>/files/<%= f.id %>?download=1" aria-label="<%= t('orders.download') %>" title="<%= t('orders.download') %>"><%- icon('download', 'icon-sm') %></a>
      <% if (can('clinical.edit') || can('patients.edit')) { %><%- include('../../partials/delete-form', { action: '/app/patients/' + patient.id + '/files/' + f.id + '/delete', confirmText: t('orders.file_delete_confirm', { name: f.name }) }) %><% } %></li>
  <% }) %></ul><% } %>
  <% if (canUpload) { %><div class="ord-upload"><%- include('_upload', { pid: patient.id, back: '/app/patients/' + patient.id + '?tab=orders#files', orders: ot.orders.filter(function (o) { return o.status !== 'cancelled'; }) }) %></div><% } %>
</div>
