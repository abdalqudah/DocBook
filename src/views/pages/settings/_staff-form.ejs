<%# Add-a-login fields (Settings → Staff & logins and the setup wizard). Needs: assignable, doctors, emailEnabled; optional prefill %>
<% var pf = (typeof prefill !== 'undefined' && prefill) || {}; var o = Object.assign({}, pf, old || {}); var freeDocs = doctors.filter(function (d) { return !d.linkedTo && d.is_active; }); var defRole = o.role_id || (assignable.find(function (r) { return r.key === 'receptionist'; }) || assignable[0] || {}).id; %>
<div class="form-grid">
  <%- include('../../partials/field', { name: 'name', label: t('auth.full_name'), required: true, value: o.name, autocomplete: 'off', attrs: 'data-staff-name' }) %>
  <%- include('../../partials/field', { name: 'email', label: t('common.email'), type: 'email', required: true, value: o.email, help: t('team.email_help'), attrs: 'dir="ltr" inputmode="email" autocomplete="off"' }) %>
  <div class="field">
    <label class="label" for="f-role_id"><%= t('team.role') %><span class="req">*</span></label>
    <select class="select<%= errors.role_id ? ' is-invalid' : '' %>" id="f-role_id" name="role_id" required data-role-select>
      <% assignable.forEach(function (r) { %><option value="<%= r.id %>" data-key="<%= r.key %>"<%= String(r.id) === String(defRole) ? ' selected' : '' %>><%= roleName(r) %></option><% }) %>
    </select>
    <% if (errors.role_id) { %><span class="field-error"><%= errors.role_id %></span><% } else { %><span class="help" data-role-help><%= t('team.role_help') %></span><% } %>
  </div>
  <div class="field" data-doctor-field>
    <label class="label" for="f-doctor_id"><%= t('team.doctor_profile') %><span class="req" data-doctor-req hidden>*</span></label>
    <select class="select<%= errors.doctor_id ? ' is-invalid' : '' %>" id="f-doctor_id" name="doctor_id">
      <option value=""><%= t('team.no_doctor') %></option>
      <% freeDocs.forEach(function (d) { %><option value="<%= d.id %>" data-name="<%= d.full_name %>"<%= String(d.id) === String(o.doctor_id) ? ' selected' : '' %>><%= d.full_name %><%= d.specialization ? ' — ' + d.specialization : '' %></option><% }) %>
    </select>
    <% if (errors.doctor_id) { %><span class="field-error"><%= errors.doctor_id %></span><% } else { %><span class="help"><%= freeDocs.length ? t('team.doctor_help') : doctors.length ? t('team.no_free_doctors') : t('team.no_doctors') %> <% if (can('doctors.manage')) { %><a class="link" href="/app/doctors/new"><%= t('team.add_doctor_profile') %></a><% } %></span><% } %>
  </div>
  <%- include('../../partials/field', { name: 'phone', label: t('common.phone'), type: 'tel', value: o.phone, attrs: 'dir="ltr" inputmode="tel"' }) %>
  <%- include('../../partials/field', { name: 'job_title', label: t('team.job_title'), value: o.job_title, placeholder: t('team.job_title_ph') }) %>
  <%- include('../../partials/field', { name: 'room', label: t('team.room'), value: o.room, help: t('team.room_help'), attrs: 'maxlength="20" inputmode="numeric" dir="ltr"' }) %>
  <% if (typeof branchOpts !== 'undefined' && branchOpts) { %><%- include('../../partials/field', { name: 'work_branch', type: 'select', label: t('branches.member_branch'), value: o.work_branch !== undefined ? o.work_branch : (typeof workBranch !== 'undefined' ? workBranch : ''), options: [{ value: '', label: t('branches.all') }].concat(branchOpts), help: t('branches.member_branch_help') }) %><% } %>
  <div class="field">
    <label class="label" for="f-locale"><%= t('team.account_language') %></label>
    <select class="select" id="f-locale" name="locale"><option value="ar"<%= (o.locale || locale) === 'ar' ? ' selected' : '' %>>العربية</option><option value="en"<%= (o.locale || locale) === 'en' ? ' selected' : '' %>>English</option></select>
  </div>
</div>
<div class="field">
  <span class="label"><%= t('team.method') %></span>
  <div class="choice-grid set-method">
    <label class="choice"><input type="radio" name="mode" value="password"<%= (o.mode || 'password') === 'password' ? ' checked' : '' %>><span class="box"><span class="row-sm"><%- icon('key-round', 'icon-sm') %><span class="name"><%= t('team.method_password') %></span></span><span class="meta"><%= t('team.method_password_text') %></span></span></label>
    <label class="choice"><input type="radio" name="mode" value="invite"<%= o.mode === 'invite' ? ' checked' : '' %>><span class="box"><span class="row-sm"><%- icon('mail', 'icon-sm') %><span class="name"><%= t('team.method_invite') %></span></span><span class="meta"><%= emailEnabled ? t('team.method_invite_text') : t('team.method_invite_noemail') %></span></span></label>
  </div>
</div>
