<%
  var system = roles.filter(function (r) { return r.is_system; });
  var custom = roles.filter(function (r) { return !r.is_system; });
  var all = system.concat(custom);
  var hasP = function (r, p) { return r.key === 'owner' || r.permissions.indexOf(p) >= 0; };
%>
<%- include('_head', { heading: t('settings.nav_roles'), lead: t('settings.roles_lead'), actions: '<button class="btn btn-primary" type="button" data-open-dialog="role-dialog" data-reset-form data-action="/app/settings/roles" data-dialog-title="' + escapeHtml(t('settings.role_new')) + '">' + icon('plus', 'icon-sm') + escapeHtml(t('settings.role_new')) + '</button>' }) %>
<div class="settings-layout">
  <%- include('_nav') %>
  <div class="stack-lg">
    <% if (typeof openDialog === 'undefined' || openDialog !== 'role-dialog') { %><%- include('../../partials/form-error') %><% } %>
    <section>
      <h2 class="set-group-title"><%= t('settings.system_roles') %></h2>
      <div class="set-role-cards">
        <% system.forEach(function (r) { %>
        <div class="set-role-card">
          <div class="row between"><span class="strong"><%= t('roles.' + r.key) %></span><span class="badge badge-neutral"><%= t('settings.n_members', { n: r.members }) %></span></div>
          <p class="small muted"><%= t('role_desc.' + r.key) %></p>
          <div class="tiny muted"><%- icon('lock', 'icon-sm') %> <%= r.key === 'owner' ? t('settings.role_all') : t('settings.n_permissions', { n: r.permissions.length }) %></div>
        </div>
        <% }) %>
      </div>
    </section>

    <section class="panel flush">
      <div class="panel-head"><div><h2><%= t('settings.custom_roles') %></h2><div class="panel-sub"><%= t('settings.custom_roles_sub') %></div></div></div>
      <% if (!custom.length) { %>
        <%- include('../../partials/empty', { emptyIcon: 'shield-check', emptyTitle: t('settings.custom_empty_title'), emptyText: t('settings.custom_empty_text'), compact: true, emptyAction: '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="role-dialog" data-reset-form data-action="/app/settings/roles" data-dialog-title="' + escapeHtml(t('settings.role_new')) + '">' + escapeHtml(t('settings.role_new')) + '</button>' }) %>
      <% } else { %>
      <div class="table-wrap"><table class="table responsive">
        <thead><tr><th><%= t('settings.role') %></th><th><%= t('settings.permissions') %></th><th><%= t('settings.members') %></th><th class="actions"></th></tr></thead>
        <tbody><% custom.forEach(function (r) { %><tr id="role-<%= r.id %>">
          <td class="primary-cell"><div class="strong"><%= r.name %></div><div class="small muted"><%= r.description || '' %></div></td>
          <td data-label="<%= t('settings.permissions') %>"><%= t('settings.n_permissions', { n: r.permissions.length }) %></td>
          <td data-label="<%= t('settings.members') %>"><%= fmt.number(r.members) %></td>
          <td class="actions nowrap">
            <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" title="<%= t('common.edit') %>" data-open-dialog="role-dialog" data-action="/app/settings/roles/<%= r.id %>" data-dialog-title="<%= t('settings.role_edit') %>" data-fill="<%= json({ name: r.name, description: r.description || '', permissions: r.permissions }) %>"><%- icon('pencil', 'icon-sm') %></button>
            <% if (!r.members) { %><%- include('../../partials/delete-form', { action: '/app/settings/roles/' + r.id + '/delete', confirmText: t('settings.role_delete_confirm', { name: r.name }) }) %><% } else { %><span class="btn btn-ghost btn-icon btn-sm" title="<%= t('errors.ROLE_IN_USE') %>" aria-disabled="true" style="opacity:.4"><%- icon('trash-2', 'icon-sm') %></span><% } %>
          </td></tr><% }) %></tbody>
      </table></div>
      <% } %>
    </section>

    <section class="panel flush">
      <div class="panel-head"><div><h2><%= t('settings.matrix') %></h2><div class="panel-sub"><%= t('settings.matrix_sub') %></div></div></div>
      <div class="table-wrap set-matrix-wrap"><table class="table matrix set-matrix">
        <thead><tr><th><%= t('settings.permission') %></th><% all.forEach(function (r) { %><th><span class="set-matrix-role"><%= roleName(r) %></span></th><% }) %></tr></thead>
        <tbody>
        <% groups.forEach(function (g) { %>
          <tr class="set-matrix-group"><td colspan="<%= all.length + 1 %>"><%= t('perm_groups.' + g.key) %></td></tr>
          <% g.perms.forEach(function (p) { %>
          <tr><td><%= t('perms.' + p) %></td><% all.forEach(function (r) { var y = hasP(r, p); %><td class="<%= y ? 'yes' : 'no' %>" aria-label="<%= y ? t('common.yes') : t('common.no') %>"><%- y ? icon('check', 'icon-sm') : '·' %></td><% }) %></tr>
          <% }) %>
        <% }) %>
        </tbody>
      </table></div>
    </section>
  </div>
</div>

<dialog class="dialog wide" id="role-dialog" aria-labelledby="role-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'role-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="<%= typeof formAction !== 'undefined' && formAction ? formAction : '/app/settings/roles' %>" novalidate>
    <div class="dialog-head"><h2 id="role-title" data-dialog-title-target><%= t('settings.role_new') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (typeof openDialog !== 'undefined' && openDialog === 'role-dialog') { %><%- include('../../partials/form-error') %><% } %>
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'name', label: t('settings.role_name'), required: true, placeholder: t('settings.role_name_ph') }) %>
        <%- include('../../partials/field', { name: 'description', label: t('common.description') }) %>
      </div>
      <% if (errors.permissions) { %><div class="field-error"><%= errors.permissions %></div><% } %>
      <div class="set-perm-groups">
        <% var chosen = [].concat(old.permissions || []); groups.forEach(function (g) { %>
        <fieldset class="perm-group" data-perm-group>
          <legend class="row between w-full"><span class="strong small"><%= t('perm_groups.' + g.key) %></span><button class="btn btn-ghost btn-sm" type="button" data-perm-all><%= t('settings.select_all') %></button></legend>
          <div class="stack-sm mt-2"><% g.perms.forEach(function (p) { %><label class="check"><input type="checkbox" name="permissions" value="<%= p %>"<%= chosen.indexOf(p) >= 0 ? ' checked' : '' %>><span><%= t('perms.' + p) %></span></label><% }) %></div>
        </fieldset>
        <% }) %>
      </div>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
