<% var color = (old && old.color) || b.color || ''; %>
<%- include('_head', { heading: t('settings.nav_appearance'), lead: can('settings.manage') ? t('settings.appearance_lead') : t('settings.appearance_lead_personal') }) %>
<div class="settings-layout<%= typeof workspace !== 'undefined' && workspace ? ' is-bare' : '' %>">
  <%- include('_nav') %>
  <div class="stack-lg">
    <section class="panel">
      <div class="panel-head"><div><h2><%= t('settings.display_title') %></h2><div class="panel-sub"><%= t('settings.display_sub') %></div></div></div>
      <div class="panel-body"><%- include('_prefs') %></div>
    </section>

    <% if (can('settings.manage')) { %>
    <section class="panel">
      <div class="panel-head"><div><h2><%= t('settings.brand_title') %></h2><div class="panel-sub"><%= t('settings.brand_sub') %></div></div></div>
      <div class="panel-body">
        <form method="post" action="/app/settings/appearance" class="stack" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- include('../../partials/form-error') %>
          <div class="set-brand-grid">
            <div class="stack">
              <div class="field">
                <label class="label" for="f-color"><%= t('settings.brand_color') %></label>
                <div class="row-sm">
                  <input class="color-input" type="color" id="f-color-picker" value="<%= color || brand.colors.light.primary %>" data-color-picker aria-label="<%= t('settings.brand_color') %>">
                  <input class="input mono<%= errors.color ? ' is-invalid' : '' %>" id="f-color" name="color" value="<%= color %>" placeholder="<%= t('settings.brand_default') %>" maxlength="7" dir="ltr" style="max-width:160px" data-color-text>
                </div>
                <% if (errors.color) { %><span class="field-error"><%= errors.color %></span><% } else { %><span class="help"><%= t('settings.brand_color_help') %></span><% } %>
              </div>
              <div class="field">
                <label class="label" for="f-calendar_color_mode"><%= t('settings.cal_mode') %></label>
                <select class="select" id="f-calendar_color_mode" name="calendar_color_mode">
                  <option value="status"<%= b.calendar_color_mode !== 'doctor' ? ' selected' : '' %>><%= t('settings.cal_mode_status') %></option>
                  <option value="doctor"<%= b.calendar_color_mode === 'doctor' ? ' selected' : '' %>><%= t('settings.cal_mode_doctor') %></option>
                </select>
                <span class="help"><%= t('settings.cal_mode_help') %></span>
              </div>
            </div>
            <div class="set-brand-preview" data-brand-preview<% if (color) { %> style="--pv: <%= color %>"<% } %>>
              <div class="tiny muted strong mb-2"><%= t('settings.preview') %></div>
              <div class="set-pv-bar"><span class="set-pv-dot"></span><span class="strong small truncate"><%= b.name %></span></div>
              <div class="set-pv-body">
                <span class="set-pv-btn"><%= t('settings.pv_book') %></span>
                <span class="set-pv-chip"><%= t('settings.pv_slot') %></span>
                <span class="set-pv-link"><%= t('settings.pv_link') %></span>
              </div>
            </div>
          </div>
          <div class="form-actions">
            <% if (b.color) { %><button class="btn btn-ghost" type="submit" name="reset_color" value="1"><%- icon('refresh-cw', 'icon-sm') %><%= t('settings.brand_reset') %></button><% } %>
            <button class="btn btn-primary" type="submit"><%= t('common.save_changes') %></button>
          </div>
        </form>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head"><div><h2><%= t('settings.logo_title') %></h2><div class="panel-sub"><%= t('settings.logo_sub') %></div></div></div>
      <div class="panel-body">
        <div class="row wrap" style="align-items:flex-start;gap:20px">
          <div class="logo-preview set-logo-lg" data-logo-preview><% if (b.logo_mime) { %><img src="/app/logo/<%= b.id %>?v=<%= b.logo_version %>" alt="<%= t('settings.logo_title') %>"><% } else { %><%- icon('image') %><% } %></div>
          <div class="stack grow" style="min-width:240px">
            <form method="post" action="/app/settings/appearance/logo" enctype="multipart/form-data" class="stack-sm" data-logo-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="input" type="file" name="logo" accept="image/png,image/jpeg,image/webp" required data-logo-input data-max="15728640" data-too-big="<%= t('settings.logo_too_big') %>">
              <span class="help"><%= t('settings.logo_help') %></span>
              <div class="row-sm"><button class="btn btn-primary btn-sm" type="submit"><%- icon('upload', 'icon-sm') %><%= t('settings.logo_upload') %></button></div>
            </form>
            <% if (b.logo_mime) { %>
            <form method="post" action="/app/settings/appearance/logo/delete" data-confirm="<%= t('settings.logo_remove_confirm') %>" data-confirm-yes="<%= t('settings.logo_remove') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('settings.logo_remove') %></button>
            </form>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <section class="panel" id="square-logo">
      <div class="panel-head"><div><h2><%= t('settings.square_logo_title') %></h2><div class="panel-sub"><%= t('settings.square_logo_sub') %></div></div></div>
      <div class="panel-body">
        <div class="row wrap" style="align-items:flex-start;gap:20px">
          <div class="logo-preview set-logo-lg"><% if (b.logo_square_mime) { %><img src="/app/logo-square/<%= b.id %>?v=<%= b.logo_square_version %>" alt="<%= t('settings.square_logo_title') %>"><% } else { %><%- icon('square', '') %><% } %></div>
          <div class="stack grow" style="min-width:240px">
            <form method="post" action="/app/settings/appearance/logo-square" enctype="multipart/form-data" class="stack-sm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="input" type="file" name="logo_square" accept="image/png,image/jpeg,image/webp" required>
              <span class="help"><%= t('settings.square_logo_help') %></span>
              <div class="row-sm"><button class="btn btn-primary btn-sm" type="submit"><%- icon('upload', 'icon-sm') %><%= t('settings.logo_upload') %></button></div>
            </form>
            <% if (b.logo_square_mime) { %>
            <form method="post" action="/app/settings/appearance/logo-square/delete" data-confirm="<%= t('settings.square_logo_remove_confirm') %>" data-confirm-yes="<%= t('settings.logo_remove') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('settings.logo_remove') %></button>
            </form>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <section class="panel" id="favicon">
      <div class="panel-head"><div><h2><%= t('settings.favicon_title') %></h2><div class="panel-sub"><%= t('settings.favicon_sub') %></div></div></div>
      <div class="panel-body">
        <% var fm = b.favicon_mode || 'platform'; %>
        <form method="post" action="/app/settings/appearance/favicon" enctype="multipart/form-data" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="set-fav-choices">
            <label class="choice"><input type="radio" name="favicon_mode" value="platform"<%= fm === 'platform' ? ' checked' : '' %>><span class="box row-sm"><span class="set-fav"><img src="<%= brand.favicon || '/favicon.svg' %>" alt=""></span><span><span class="name"><%= t('settings.favicon_platform') %></span><span class="meta"><%= t('settings.favicon_platform_text', { name: brandName }) %></span></span></span></label>
            <label class="choice"><input type="radio" name="favicon_mode" value="logo"<%= fm === 'logo' ? ' checked' : '' %><%= b.logo_mime ? '' : ' disabled' %>><span class="box row-sm"><span class="set-fav"><% if (b.logo_mime) { %><img src="/app/logo/<%= b.id %>?v=<%= b.logo_version %>" alt=""><% } else { %><%- icon('image', 'icon-sm') %><% } %></span><span><span class="name"><%= t('settings.favicon_logo') %></span><span class="meta"><%= b.logo_mime ? t('settings.favicon_logo_text') : t('settings.favicon_logo_none') %></span></span></span></label>
            <label class="choice"><input type="radio" name="favicon_mode" value="custom"<%= fm === 'custom' ? ' checked' : '' %><%= b.favicon_mime ? '' : ' disabled' %>><span class="box row-sm"><span class="set-fav"><% if (b.favicon_mime) { %><img src="/app/favicon?v=c<%= b.favicon_version %>&amp;show=1" alt=""><% } else { %><%- icon('upload', 'icon-sm') %><% } %></span><span><span class="name"><%= t('settings.favicon_custom') %></span><span class="meta"><%= b.favicon_mime ? t('settings.favicon_custom_text') : t('settings.favicon_custom_none') %></span></span></span></label>
          </div>
          <div class="field">
            <label class="label" for="f-favicon"><%= t('settings.favicon_upload') %></label>
            <input class="input" type="file" id="f-favicon" name="favicon" accept="image/png,image/x-icon,image/vnd.microsoft.icon,image/webp,image/jpeg">
            <span class="help"><%= t('settings.favicon_help') %></span>
          </div>
          <div class="form-actions">
            <% if (b.favicon_mime) { %><button class="btn btn-ghost" type="submit" name="remove" value="1"><%- icon('trash-2', 'icon-sm') %><%= t('settings.favicon_remove') %></button><% } %>
            <button class="btn btn-primary" type="submit"><%= t('common.save_changes') %></button>
          </div>
        </form>
      </div>
    </section>
    <% } %>
  </div>
</div>
