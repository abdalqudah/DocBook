<%- include('_top') %>
<form id="step-form" class="panel" method="post" action="/app/onboarding/region" novalidate>
  <div class="panel-body stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../../partials/form-error') %>
    <div class="form-grid">
      <%- include('../../partials/field', { name: 'timezone', label: t('auth.timezone'), type: 'select', required: true, value: b.timezone, options: zoneOptions, help: t('settings.f_tz_help') }) %>
      <%- include('../../partials/field', { name: 'currency', label: t('common.currency'), type: 'select', required: true, value: b.currency, options: currencyOptions, help: t('settings.f_currency_help') }) %>
      <%- include('../../partials/field', { name: 'country', label: t('settings.f_country'), type: 'select', placeholder: t('onboarding.country_auto'), value: b.country, options: countryOptions }) %>
    </div>
    <div class="alert alert-info small"><%- icon('clock') %><div class="grow"><%= t('onboarding.region_note') %></div></div>
  </div>
</form>
<%- include('_foot', { formId: 'step-form' }) %>
