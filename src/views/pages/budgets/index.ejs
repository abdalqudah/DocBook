<%
  var canManage = can('budgets.manage');
  var catName = function (k) { return customName[k] || label('categories', k); };
  var src = { marketing: 'budgets.src_marketing', delivery: 'budgets.src_delivery', inventory_purchase: 'budgets.src_inventory', payroll: 'budgets.src_payroll' };
%>
<div class="page-head">
  <div><div class="breadcrumbs"><%= t('nav.group_finance') %></div><h1><%= t('budgets.title') %></h1><p><%= t('budgets.lead') %></p></div>
  <div class="page-actions">
    <form class="period-picker" method="get" data-autosubmit><%- icon('calendar', 'muted') %><input class="input" type="month" name="month" value="<%= month %>" aria-label="<%= t('common.month') %>"></form>
    <% if (canManage) { %><button class="btn btn-primary" type="button" data-open-dialog="budget-dialog" data-reset-form data-action="/app/budgets" data-dialog-title="<%= t('budgets.add') %>"><%- icon('plus', 'icon-sm') %><%= t('budgets.add') %></button><% } %>
  </div>
</div>
<div class="stats">
  <div class="stat hero"><div class="stat-label"><%= t('budgets.used_total', { month: fmt.month(month) }) %><span class="stat-icon"><%- icon('piggy-bank') %></span></div><div class="stat-value"><%= fmt.pct(totals.limit ? totals.spent / totals.limit * 100 : 0, 0) %></div><div class="stat-meta"><%= fmt.money(totals.spent) %> / <%= fmt.money(totals.limit) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('budgets.exceeded') %><span class="stat-icon danger"><%- icon('circle-x') %></span></div><div class="stat-value <%= counts.exceeded ? 'neg' : '' %>"><%= counts.exceeded %></div></div>
  <div class="stat"><div class="stat-label"><%= t('budgets.warning') %><span class="stat-icon warning"><%- icon('triangle-alert') %></span></div><div class="stat-value <%= counts.warning ? 'warn-text' : '' %>"><%= counts.warning %></div></div>
  <div class="stat"><div class="stat-label"><%= t('budgets.safe') %><span class="stat-icon"><%- icon('circle-check') %></span></div><div class="stat-value"><%= counts.safe %></div></div>
</div>

<div class="grid grid-main mt-6">
  <div class="panel flush">
    <div class="panel-head"><div><h2><%= t('budgets.lines', { month: fmt.month(month) }) %></h2><div class="panel-sub"><%= t('budgets.lines_sub') %></div></div></div>
    <% if (!lines.length) { %>
      <%- include('../../partials/empty', { emptyIcon: 'piggy-bank', emptyTitle: t('budgets.empty_title'), emptyText: t('budgets.empty_text'), emptyAction: canManage ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="budget-dialog" data-reset-form>' + t('budgets.add') + '</button>' : '' }) %>
    <% } else { %>
    <ul class="action-list">
      <% lines.sort(function (a, b) { return b.usagePercent - a.usagePercent; }).forEach(function (l) { var b = byId[l.id]; var tone = l.isExceeded ? 'danger' : l.isWarning ? 'warning' : 'success'; %>
      <li><div style="display:block">
        <div class="row between wrap">
          <div class="row"><span class="action-icon <%= tone %>"><%- icon(l.isExceeded ? 'circle-x' : l.isWarning ? 'triangle-alert' : 'circle-check') %></span><div><div class="strong"><%= catName(l.category) %></div><div class="small muted"><%= src[l.category] ? t(src[l.category]) : t('budgets.src_expenses') %> · <%= b.periodMonth ? fmt.month(b.periodMonth) : t('budgets.every_month') %> · <%= t('budgets.alert_at', { pct: fmt.number(l.thresholdPercent) }) %></div></div></div>
          <div class="row-sm">
            <span class="badge <%= 'badge-' + tone %>"><%= l.isExceeded ? t('budgets.status_exceeded') : l.isWarning ? t('budgets.status_warning') : t('budgets.status_safe') %></span>
            <% if (canManage) { %>
              <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" data-open-dialog="budget-dialog" data-action="/app/budgets/<%= l.id %>" data-dialog-title="<%= t('budgets.edit') %>" data-fill="<%= json({ category: b.category, monthly_budget: b.monthlyBudget, alert_threshold_percent: b.alertThresholdPercent, period_month: b.periodMonth }) %>"><%- icon('pencil', 'icon-sm') %></button>
              <%- include('../../partials/delete-form', { action: '/app/budgets/' + l.id + '/delete' }) %>
            <% } %>
          </div>
        </div>
        <div class="meter mt-3 <%= l.isExceeded ? 'full' : l.isWarning ? 'warn' : '' %>" role="progressbar" aria-valuenow="<%= Math.round(l.usagePercent) %>" aria-valuemin="0" aria-valuemax="100"><span style="width:<%= Math.min(100, l.usagePercent).toFixed(1) %>%"></span></div>
        <div class="row between small mt-2"><span><strong class="num"><%= fmt.money(l.actualSpent) %></strong> <span class="muted">/ <%= fmt.money(l.monthlyLimit) %></span></span><span class="<%= l.isExceeded ? 'neg strong' : 'muted' %>"><%= l.isExceeded ? t('budgets.over_by', { amount: fmt.money(l.actualSpent - l.monthlyLimit) }) : t('budgets.remaining', { amount: fmt.money(l.remaining) }) %> · <%= fmt.pct(l.usagePercent, 0) %></span></div>
      </div></li>
      <% }) %>
    </ul>
    <% } %>
  </div>
  <div class="stack">
    <div class="panel">
      <div class="panel-head"><h2><%= t('budgets.alert_history') %></h2><a class="btn btn-ghost btn-sm" href="/app/notifications"><%= t('common.view_all') %></a></div>
      <% if (!history.length) { %><div class="panel-body small muted"><%= t('budgets.no_alerts') %></div><% } else { %>
      <ul class="feed"><% history.slice(0, 8).forEach(function (n) { %><li><span class="dot" style="background:var(--<%= n.severity === 'danger' ? 'danger' : 'warning' %>)"></span><div><div class="what"><%= n.title %></div><div class="when"><%= n.body %> · <%= fmt.date(n.created_at) %></div></div></li><% }) %></ul><% } %>
    </div>
    <div class="alert alert-info"><%- icon('info') %><div class="grow small"><%= t('budgets.how') %></div></div>
  </div>
</div>

<% if (canManage) { %>
<dialog class="dialog" id="budget-dialog" data-new-dialog aria-labelledby="budget-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'budget-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="<%= typeof formAction !== 'undefined' && formAction ? formAction : '/app/budgets' %>" novalidate>
    <div class="dialog-head"><h2 id="budget-title" data-dialog-title-target><%= t('budgets.add') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_return" value="<%= fullPath %>">
      <%- include('../../partials/form-error') %>
      <%- include('../../partials/field', { name: 'category', label: t('budgets.category'), type: 'select', required: true, options: keys.map(function (k) { return { value: k, label: catName(k) + (src[k] ? ' — ' + t(src[k]) : '') }; }) }) %>
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'monthly_budget', label: t('budgets.monthly_cap'), required: true, suffix: currency, attrs: 'inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'alert_threshold_percent', label: t('budgets.threshold'), value: 80, suffix: '%', attrs: 'inputmode="decimal" data-default="80"' }) %>
      </div>
      <%- include('../../partials/field', { name: 'period_month', label: t('budgets.period'), type: 'month', help: t('budgets.period_help') }) %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
<% } %>
