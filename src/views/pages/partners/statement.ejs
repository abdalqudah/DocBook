<div class="page-head">
  <div>
    <div class="breadcrumbs no-print"><a href="/app/partners/distribution"><%= t('partners.distribution') %></a></div>
    <h1><%= t('partners.statement_title') %> — <%= fmt.month(dist.period) %></h1>
    <p><%= t('partners.statement_meta', { date: fmt.date(dist.created_at), user: dist.created_by_name || '—' }) %></p>
  </div>
  <div class="page-actions no-print"><a class="btn btn-secondary" href="?print=1"><%- icon('printer', 'icon-sm') %><%= t('reports.print_pdf') %></a></div>
</div>
<div class="kpis mb-4">
  <div class="kpi"><div class="kpi-label"><%= t('kpi.revenue') %></div><div class="kpi-value"><%= fmt.money(dist.revenue) %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('kpi.gross_profit') %></div><div class="kpi-value"><%= fmt.money(dist.gross_profit) %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('kpi.net_profit') %></div><div class="kpi-value"><%= fmt.money(dist.net_profit) %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('common.status') %></div><div class="kpi-value" style="font-size:15px"><%= t('partners.dist_' + dist.status) %></div></div>
</div>
<div class="panel flush">
  <table class="table">
    <thead><tr><th><%= t('partners.partner') %></th><th class="num"><%= t('partners.equity') %></th><th class="num"><%= t('partners.allocated') %></th><th class="num"><%= t('partners.withdrawn') %></th><th class="num"><%= t('partners.net_payable') %></th><th class="num"><%= t('partners.paid_out') %></th></tr></thead>
    <tbody><% dist.lines.forEach(function (l) { %><tr><td class="strong"><%= l.partner_name %></td><td class="num"><%= fmt.pct(l.equity_percent, 2) %></td><td class="num"><%= fmt.amount(l.allocated_profit) %></td><td class="num"><%= fmt.amount(l.withdrawn) %></td><td class="num strong"><%= fmt.amount(l.net_payable) %></td><td class="num"><%= Number(l.paid_out) ? fmt.amount(l.paid_out) : '—' %></td></tr><% }) %></tbody>
  </table>
</div>
<% if (dist.note) { %><p class="mt-4 text-2"><strong><%= t('common.notes') %>:</strong> <%= dist.note %></p><% } %>
<p class="small muted mt-4"><%= t('partners.formula_alloc') %> · <%= t('partners.formula_payable') %></p>
<div class="grid grid-3 mt-8"><% dist.lines.forEach(function (l) { %><div class="small" style="border-top:1px solid var(--border-strong);padding-top:8px"><%= t('partners.signature') %>: <%= l.partner_name %></div><% }) %></div>
