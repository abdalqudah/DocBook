<% var p = partner || {}; var available = Math.max(0, 100 - othersEquity); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/partners"><%= t('nav.partners') %></a><%- icon('chevron-right', 'flip-rtl') %><%= partner ? partner.name : t('partners.add') %></div>
    <h1><%= partner ? t('partners.edit') : t('partners.add') %></h1>
  </div>
</div>
<div class="panel" style="max-width:820px">
  <form method="post" action="<%= partner ? '/app/partners/' + partner.id + '/edit' : '/app/partners/new' %>" novalidate>
    <div class="panel-body stack-lg">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../../partials/form-error') %>
      <div class="form-section stack">
        <h3><%= t('partners.section_profile') %></h3>
        <div class="form-grid">
          <%- include('../../partials/field', { name: 'name', label: t('common.name'), required: true, value: p.name, cls: 'full' }) %>
          <%- include('../../partials/field', { name: 'phone', label: t('common.phone'), type: 'tel', value: p.phone }) %>
          <%- include('../../partials/field', { name: 'email', label: t('common.email'), type: 'email', value: p.email }) %>
          <%- include('../../partials/field', { name: 'join_date', label: t('partners.join_date'), type: 'date', value: fmt.dateInput(p.join_date) || today }) %>
        </div>
      </div>
      <div class="form-section stack">
        <h3><%= t('partners.section_capital') %></h3>
        <div class="form-grid">
          <%- include('../../partials/field', { name: 'initial_investment', label: t('partners.initial'), required: true, value: p.initial_investment || 0, suffix: currency, attrs: 'inputmode="decimal"', help: partner ? t('partners.initial_help_edit') : t('partners.initial_help') }) %>
          <%- include('../../partials/field', { name: 'current_equity_percent', label: t('partners.equity'), required: true, value: p.current_equity_percent !== undefined ? p.current_equity_percent : available, suffix: '%', attrs: 'inputmode="decimal"', help: t('partners.equity_help', { available: fmt.number(available, 2) }) }) %>
        </div>
      </div>
      <%- include('../../partials/field', { name: 'notes', label: t('common.notes'), type: 'textarea', value: p.notes }) %>
    </div>
    <div class="panel-foot"><a class="btn btn-ghost" href="<%= partner ? '/app/partners/' + partner.id : '/app/partners' %>"><%= t('common.cancel') %></a><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</div>
