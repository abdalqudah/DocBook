<% var p = partner; var canManage = can('partners.manage'); var invested = Number(p.initial_investment) + Number(p.additional_contributions); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/partners"><%= t('nav.partners') %></a><%- icon('chevron-right', 'flip-rtl') %><%= p.name %></div>
    <div class="row"><span class="avatar avatar-lg"><%= initials(p.name) %></span><div><h1><%= p.name %></h1><p><%= [t('partners.equity_short', { pct: fmt.number(p.current_equity_percent, 2) }), p.join_date ? t('partners.since', { date: fmt.date(p.join_date) }) : null].filter(Boolean).join(' · ') %></p></div></div>
  </div>
  <div class="page-actions">
    <% if (showProfit) { %><%- include('../../partials/period') %><% } %>
    <% if (canManage) { %>
      <button class="btn btn-secondary" type="button" data-open-dialog="tx-dialog" data-reset-form data-fill="<%= json({ type: 'contribution' }) %>"><%- icon('circle-plus', 'icon-sm') %><%= t('partners.record_movement') %></button>
      <a class="btn btn-secondary" href="/app/partners/<%= p.id %>/edit"><%- icon('pencil', 'icon-sm') %><%= t('common.edit') %></a>
    <% } %>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="stat-label"><%= t('partners.total_invested') %><span class="stat-icon"><%- icon('landmark') %></span></div><div class="stat-value"><%= fmt.money(invested) %></div><div class="stat-meta"><%= t('partners.initial') %> <%= fmt.money(p.initial_investment) %> · <%= t('partners.additional') %> <%= fmt.money(p.additional_contributions) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('partners.withdrawn') %><span class="stat-icon info"><%- icon('banknote') %></span></div><div class="stat-value"><%= fmt.money(p.total_withdrawn) %></div></div>
  <% if (showProfit) { %>
  <div class="stat"><div class="stat-label"><%= t('partners.allocated_period', { period: month ? fmt.month(month) : t('common.all_time') }) %><span class="stat-icon <%= (alloc.allocatedProfit || 0) < 0 ? 'danger' : '' %>"><%- icon('chart-pie') %></span></div><div class="stat-value <%= (alloc.allocatedProfit || 0) < 0 ? 'neg' : 'pos' %>"><%= fmt.money(alloc.allocatedProfit || 0) %></div></div>
  <div class="stat hero"><div class="stat-label"><%= t('partners.net_payable') %><span class="stat-icon"><%- icon('hand-coins') %></span></div><div class="stat-value"><%= fmt.money(allocAll.netPayable || 0) %></div><div class="stat-meta"><%= t('partners.net_payable_help') %></div></div>
  <% } %>
</div>

<div class="grid grid-main mt-6">
  <div class="panel flush">
    <div class="panel-head"><div><h2><%= t('partners.ledger') %></h2><div class="panel-sub"><%= t('partners.ledger_sub') %></div></div></div>
    <% if (!txs.length) { %>
      <%- include('../../partials/empty', { compact: true, emptyIcon: 'history', emptyTitle: t('partners.no_movements'), emptyText: t('partners.no_movements_text') }) %>
    <% } else { %>
    <div class="table-wrap"><table class="table responsive">
      <thead><tr><th><%= t('common.date') %></th><th><%= t('partners.movement') %></th><th><%= t('common.reference') %></th><th class="num"><%= t('common.amount') %></th><th class="actions"></th></tr></thead>
      <tbody><% txs.forEach(function (x) { %>
        <tr>
          <td data-label="<%= t('common.date') %>"><%= fmt.date(x.date) %></td>
          <td class="primary-cell"><span class="badge <%= x.type === 'withdrawal' ? 'badge-warning' : 'badge-success' %>"><%= t('partners.tx_' + x.type) %></span><% if (x.note) { %><div class="small muted mt-1"><%= x.note %></div><% } %></td>
          <td data-label="<%= t('common.reference') %>" class="small"><%= x.reference || '—' %><div class="muted tiny"><%= x.created_by_name || '' %></div></td>
          <td data-label="<%= t('common.amount') %>" class="num strong <%= x.type === 'withdrawal' ? 'neg' : 'pos' %>"><%= x.type === 'withdrawal' ? '−' : '+' %><%= fmt.amount(x.amount) %></td>
          <td class="actions"><% if (canManage && x.type !== 'opening' && !x.distribution_id) { %><%- include('../../partials/delete-form', { action: '/app/partners/' + p.id + '/transactions/' + x.id + '/delete', confirmText: t('partners.delete_tx_confirm') }) %><% } %></td>
        </tr>
      <% }) %></tbody>
    </table></div>
    <% } %>
  </div>
  <div class="stack">
    <% if (showProfit) { %><div class="panel"><div class="panel-head"><div><h2><%= t('partners.monthly_share') %></h2><div class="panel-sub"><%= t('dashboard.last_12') %></div></div></div><div class="panel-body"><% if (hasSeries) { %><%- chart %><% } else { %><p class="muted small"><%= t('dashboard.no_trend_text') %></p><% } %></div></div><% } %>
    <div class="panel"><div class="panel-head"><h2><%= t('partners.section_profile') %></h2></div><div class="panel-body">
      <dl class="dl">
        <dt><%= t('common.phone') %></dt><dd dir="ltr" style="text-align:start"><%= p.phone || '—' %></dd>
        <dt><%= t('common.email') %></dt><dd><%= p.email || '—' %></dd>
        <dt><%= t('partners.join_date') %></dt><dd><%= fmt.date(p.join_date) %></dd>
        <dt><%= t('common.notes') %></dt><dd><%= p.notes || '—' %></dd>
      </dl>
    </div>
    <% if (canManage) { %><div class="panel-foot"><form method="post" action="/app/partners/<%= p.id %>/delete" data-confirm="<%= t('partners.delete_confirm', { name: p.name }) %>" data-confirm-title="<%= t('partners.delete') %>" data-confirm-yes="<%= t('common.delete') %>" data-confirm-type="<%= p.name %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('partners.delete') %></button></form></div><% } %>
    </div>
  </div>
</div>

<% if (canManage) { %>
<dialog class="dialog" id="tx-dialog" aria-labelledby="tx-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'tx-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="/app/partners/<%= p.id %>/transactions" novalidate>
    <div class="dialog-head"><h2 id="tx-title"><%= t('partners.record_movement') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../../partials/form-error') %>
      <div class="segmented" role="radiogroup">
        <label><input type="radio" name="type" value="contribution"<%= (old.type || 'contribution') === 'contribution' ? ' checked' : '' %>><span><%= t('partners.tx_contribution') %></span></label>
        <label><input type="radio" name="type" value="withdrawal"<%= old.type === 'withdrawal' ? ' checked' : '' %>><span><%= t('partners.tx_withdrawal') %></span></label>
      </div>
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'amount', label: t('common.amount'), required: true, suffix: currency, attrs: 'inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'date', label: t('common.date'), type: 'date', required: true, value: today, attrs: 'data-default="' + today + '"' }) %>
        <%- include('../../partials/field', { name: 'reference', label: t('common.reference'), cls: 'full' }) %>
        <%- include('../../partials/field', { name: 'note', label: t('common.notes'), cls: 'full' }) %>
      </div>
      <label class="check small"><input type="checkbox" name="allow_overdraw" value="1"><span><%= t('partners.allow_overdraw') %></span></label>
      <p class="help"><%= t('partners.tx_help') %></p>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
<% } %>
