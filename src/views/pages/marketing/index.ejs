<% var canManage = can('marketing.manage'); var sb = { active: 'badge-success', paused: 'badge-warning', completed: 'badge-neutral' }; %>
<div class="page-head">
  <div><div class="breadcrumbs"><%= t('nav.group_growth') %></div><h1><%= t('marketing.title') %></h1><p><%= t('marketing.lead') %></p></div>
  <div class="page-actions">
    <%- include('../../partials/period') %>
    <%- include('../../partials/export-menu', { href: '/app/marketing/export' }) %>
    <% if (canManage) { %><button class="btn btn-primary" type="button" data-open-dialog="campaign-dialog" data-reset-form data-action="/app/marketing" data-dialog-title="<%= t('marketing.add') %>"><%- icon('plus', 'icon-sm') %><%= t('marketing.add') %></button><% } %>
  </div>
</div>
<div class="stats">
  <div class="stat hero"><div class="stat-label">ROAS<span class="stat-icon"><%- icon('target') %></span></div><div class="stat-value"><%= tot.cost ? fmt.number(totalM.roas, 2) + '×' : '—' %></div><div class="stat-meta"><%= t('marketing.roas_help') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('marketing.spend') %><span class="stat-icon warning"><%- icon('megaphone') %></span></div><div class="stat-value"><%= fmt.money(tot.cost) %></div><div class="stat-meta"><%= t('marketing.campaigns_n', { n: rows.length }) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('marketing.revenue') %><span class="stat-icon"><%- icon('trending-up') %></span></div><div class="stat-value"><%= fmt.money(tot.revenueGenerated) %></div><div class="stat-meta"><%= t('marketing.profit') %> <strong class="<%= totalM.netProfit < 0 ? 'neg' : 'pos' %>"><%= fmt.money(totalM.netProfit) %></strong></div></div>
  <div class="stat"><div class="stat-label">ROI<span class="stat-icon accent"><%- icon('percent') %></span></div><div class="stat-value <%= totalM.roi < 0 ? 'neg' : '' %>"><%= tot.cost ? fmt.pct(totalM.roi, 0) : '—' %></div><div class="stat-meta"><%= t('marketing.roi_help') %></div></div>
</div>
<div class="kpis mt-4">
  <div class="kpi"><div class="kpi-label">CTR</div><div class="kpi-value"><%= tot.impressions ? fmt.pct(totalM.ctr, 2) : '—' %></div></div>
  <div class="kpi"><div class="kpi-label">CPC</div><div class="kpi-value"><%= tot.clicks ? fmt.money(totalM.cpc) : '—' %></div></div>
  <div class="kpi"><div class="kpi-label">CPA</div><div class="kpi-value"><%= tot.conversions ? fmt.money(totalM.cpa) : '—' %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('marketing.conversions') %></div><div class="kpi-value"><%= fmt.number(tot.conversions) %></div></div>
</div>
<div class="grid grid-main mt-4">
  <div class="panel"><div class="panel-head"><div><h2><%= t('marketing.spend_vs_revenue') %></h2><div class="panel-sub"><%= t('dashboard.last_12') %></div></div><div class="legend"><span><i class="l2"></i><%= t('marketing.spend') %></span><span><i class="l1"></i><%= t('marketing.revenue') %></span></div></div><div class="panel-body"><% if (hasTrend) { %><%- trend %><% } else { %><%- include('../../partials/empty', { compact: true, emptyIcon: 'chart-pie', emptyTitle: t('marketing.no_trend'), emptyText: '' }) %><% } %></div></div>
  <div class="panel"><div class="panel-head"><div><h2><%= t('marketing.platform_compare') %></h2><div class="panel-sub"><%= t('marketing.platform_compare_sub') %></div></div></div><div class="panel-body">
    <% if (!platforms.length) { %><p class="small muted"><%= t('marketing.no_platforms') %></p><% } else { %>
      <% if (best && best.cost > 0) { %><div class="alert alert-success mb-4"><%- icon('award') %><div class="grow small"><strong><%= t('marketing.best_channel') %>:</strong> <%= label('platforms', best.platform) %> — <%= fmt.number(best.m.roas, 2) %>× ROAS</div></div><% } %>
      <%- platformChart %>
    <% } %>
  </div></div>
</div>

<div class="panel flush mt-4">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <% if (query.month) { %><input type="hidden" name="month" value="<%= query.month %>"><% } %>
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('marketing.search') %>" aria-label="<%= t('common.search') %>"></div>
    <select class="select" name="platform" aria-label="<%= t('marketing.platform') %>"><option value="all"><%= t('marketing.all_platforms') %></option><% platformList.forEach(function (p) { %><option value="<%= p %>"<%= query.platform === p ? ' selected' : '' %>><%= label('platforms', p) %></option><% }) %></select>
    <select class="select" name="status" aria-label="<%= t('common.status') %>"><option value="all"><%= t('marketing.all_statuses') %></option><% statuses.forEach(function (s) { %><option value="<%= s %>"<%= query.status === s ? ' selected' : '' %>><%= label('marketing.statuses', s) %></option><% }) %></select>
    <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="/app/marketing"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
  </form>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', filtered || month ? { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: '' } : { emptyIcon: 'megaphone', emptyTitle: t('marketing.empty_title'), emptyText: t('marketing.empty_text'), emptyAction: canManage ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="campaign-dialog" data-reset-form>' + t('marketing.add') + '</button>' : '' }) %>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('marketing.campaign') %></th><th class="num"><%= t('marketing.spend') %></th><th class="num"><%= t('marketing.revenue') %></th><th class="num">ROAS</th><th class="num">ROI</th><th class="num">CTR</th><th class="num">CPC</th><th class="num">CPA</th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
    <tbody><% rows.forEach(function (c) { %>
      <tr>
        <td class="primary-cell"><div class="strong"><%= c.campaignName %></div><div class="small muted"><%= label('platforms', c.platform) %> · <%= fmt.date(c.startDate) %><%= c.endDate ? ' → ' + fmt.date(c.endDate) : '' %></div></td>
        <td class="num" data-label="<%= t('marketing.spend') %>"><%= fmt.amount(c.cost) %></td>
        <td class="num" data-label="<%= t('marketing.revenue') %>"><%= fmt.amount(c.revenueGenerated) %></td>
        <td class="num strong <%= c.m.roas >= 1 ? 'pos' : 'neg' %>" data-label="ROAS"><%= c.cost ? fmt.number(c.m.roas, 2) + '×' : '—' %></td>
        <td class="num" data-label="ROI"><%= c.cost ? fmt.pct(c.m.roi, 0) : '—' %></td>
        <td class="num" data-label="CTR"><%= c.impressions ? fmt.pct(c.m.ctr, 2) : '—' %></td>
        <td class="num" data-label="CPC"><%= c.clicks ? fmt.amount(c.m.cpc) : '—' %></td>
        <td class="num" data-label="CPA"><%= c.conversions ? fmt.amount(c.m.cpa) : '—' %></td>
        <td data-label="<%= t('common.status') %>"><span class="badge badge-dot <%= sb[c.status] %>"><%= label('marketing.statuses', c.status) %></span></td>
        <td class="actions"><% if (canManage) { %>
          <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="<%= t('common.edit') %>" data-open-dialog="campaign-dialog" data-action="/app/marketing/<%= c.id %>" data-dialog-title="<%= t('marketing.edit') %>" data-fill="<%= json({ campaign_name: c.campaignName, platform: c.platform, start_date: c.startDate, end_date: c.endDate, cost: c.cost, impressions: c.impressions, clicks: c.clicks, conversions: c.conversions, revenue_generated: c.revenueGenerated, status: c.status, target_product: c.targetProduct, notes: c.notes }) %>"><%- icon('pencil', 'icon-sm') %></button>
          <%- include('../../partials/delete-form', { action: '/app/marketing/' + c.id + '/delete' }) %>
        <% } %></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</div>

<% if (canManage) { %>
<dialog class="dialog wide" id="campaign-dialog" data-new-dialog aria-labelledby="campaign-title"<% if (typeof openDialog !== 'undefined' && openDialog === 'campaign-dialog') { %> data-open-on-load<% } %>>
  <form method="post" action="<%= typeof formAction !== 'undefined' && formAction ? formAction : '/app/marketing' %>" data-calc="campaign" novalidate>
    <div class="dialog-head"><h2 id="campaign-title" data-dialog-title-target><%= t('marketing.add') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div>
    <div class="dialog-body stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_return" value="<%= fullPath %>">
      <%- include('../../partials/form-error') %>
      <div class="form-grid cols-3">
        <%- include('../../partials/field', { name: 'campaign_name', label: t('marketing.campaign'), required: true, cls: 'span-2' }) %>
        <%- include('../../partials/field', { name: 'platform', label: t('marketing.platform'), type: 'select', value: 'facebook', options: platformList.map(function (p) { return { value: p, label: label('platforms', p) }; }) }) %>
        <%- include('../../partials/field', { name: 'start_date', label: t('marketing.start'), type: 'date', required: true, value: today, attrs: 'data-default="' + today + '"' }) %>
        <%- include('../../partials/field', { name: 'end_date', label: t('marketing.end'), type: 'date' }) %>
        <%- include('../../partials/field', { name: 'status', label: t('common.status'), type: 'select', value: 'active', options: statuses.map(function (s) { return { value: s, label: label('marketing.statuses', s) }; }) }) %>
        <%- include('../../partials/field', { name: 'cost', label: t('marketing.spend'), required: true, suffix: currency, attrs: 'inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'revenue_generated', label: t('marketing.revenue'), suffix: currency, attrs: 'inputmode="decimal"' }) %>
        <%- include('../../partials/field', { name: 'target_product', label: t('marketing.target_product') }) %>
        <%- include('../../partials/field', { name: 'impressions', label: t('marketing.impressions'), attrs: 'inputmode="numeric"' }) %>
        <%- include('../../partials/field', { name: 'clicks', label: t('marketing.clicks'), attrs: 'inputmode="numeric"' }) %>
        <%- include('../../partials/field', { name: 'conversions', label: t('marketing.conversions'), attrs: 'inputmode="numeric"' }) %>
      </div>
      <div class="kpis"><div class="kpi"><div class="kpi-label">ROAS</div><div class="kpi-value" data-out="roas">—</div></div><div class="kpi"><div class="kpi-label">CTR</div><div class="kpi-value" data-out="ctr">—</div></div><div class="kpi"><div class="kpi-label">CPC</div><div class="kpi-value" data-out="cpc">—</div></div><div class="kpi"><div class="kpi-label">CPA</div><div class="kpi-value" data-out="cpa">—</div></div></div>
      <%- include('../../partials/field', { name: 'notes', label: t('common.notes'), type: 'textarea' }) %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
<% } %>
