<%
  var FILTERS = ['all', 'paid', 'attention', 'failed', 'refunded'];
  var badge = function (s) { return s === 'failed' || s === 'refunded' ? 'badge-danger' : 'badge-neutral'; };
%>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><% if (can('billing.view')) { %><a href="/app/billing"><%= t('payments.list.billing') %></a><%- icon('chevron-right', 'flip-rtl') %><% } %><%= t('payments.list.title') %></div>
    <h1><%= t('payments.list.title') %></h1>
    <p><%= t('payments.list.lead') %></p>
  </div>
  <% if (can('settings.manage')) { %><div class="page-actions"><a class="btn btn-secondary" href="/app/settings/payments"><%- icon('settings', 'icon-sm') %><%= t('payments.list.settings') %></a></div><% } %>
</div>

<nav class="tabs mb-4" aria-label="<%= t('payments.list.title') %>">
  <% FILTERS.forEach(function (f) { %><a href="/app/payments<%= f === 'all' ? '' : '?status=' + f %>" class="<%= status === f ? 'active' : '' %>"<%- status === f ? ' aria-current="page"' : '' %>><%= t('payments.list.filters.' + f) %></a><% }) %>
</nav>

<div class="panel flush">
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', { emptyIcon: 'wallet', emptyTitle: status === 'all' ? t('payments.list.empty_title') : t('table.no_matches'), emptyText: status === 'all' ? (gw.provider === 'none' ? t('payments.list.empty_off') : t('payments.list.empty_text')) : '', emptyAction: status === 'all' && gw.provider === 'none' && can('settings.manage') ? '<a class="btn btn-secondary btn-sm" href="/app/settings/payments">' + escapeHtml(t('payments.list.settings')) + '</a>' : '' }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th><%= t('common.date') %></th><th><%= t('common.patient') %></th><th><%= t('payments.list.provider') %></th><th><%= t('common.status') %></th><th class="num"><%= t('common.amount') %></th><th class="actions"><span class="sr-only"><%= t('common.actions') %></span></th></tr></thead>
      <tbody>
        <% rows.forEach(function (p) { %>
        <tr>
          <td data-label="<%= t('common.date') %>" class="nowrap"><%= fmt.date(p.created_at, { dateStyle: 'medium', timeStyle: 'short' }) %></td>
          <td class="primary-cell"><a class="strong" href="/app/payments/<%= p.id %>"><%= p.patient_name %></a><div class="tiny muted"><%= t('payments.list.consult_on', { date: fmt.date(p.appointment_date), time: p.appointment_time }) %></div></td>
          <td data-label="<%= t('payments.list.provider') %>"><%= t('payments.providers.' + p.provider) %><% if (p.brand === 'mada') { %> <span class="tiny muted">· mada</span><% } %><% if (p.mode === 'test') { %> <span class="tiny muted">· <%= t('payments.modes.test') %></span><% } %></td>
          <td data-label="<%= t('common.status') %>"><span class="row-sm wrap"><span class="badge badge-dot <%= badge(p.status) %>"><%= t('payments.statuses.' + p.status) %></span><% if (p.note && p.note !== 'settling' && p.status !== 'refunded') { %><span class="badge badge-warning"><%= t('payments.notes.' + p.note) %></span><% } %></span></td>
          <td data-label="<%= t('common.amount') %>" class="num strong"><%= fmt.money(p.amount, p.currency) %></td>
          <td class="actions"><a class="btn btn-ghost btn-icon btn-sm" href="/app/payments/<%= p.id %>" aria-label="<%= t('common.open') %>"><%- icon('chevron-right', 'icon-sm flip-rtl') %></a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/pagination', { meta: { page: page, pages: pages, total: total, perPage: 50 } }) %>
  <% } %>
</div>
