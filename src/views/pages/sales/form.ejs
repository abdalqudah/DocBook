<%
  var o = order || {};
  var items = (old.items ? (Array.isArray(old.items) ? old.items : Object.values(old.items)) : (o.items || [])) ;
  if (!items.length) items = [{ itemName: '', sku: '', quantity: 1, unitPrice: '', unitCost: '' }];
  var v = function (k, dflt) { return old[k] !== undefined ? old[k] : (o[k] !== undefined && o[k] !== null ? o[k] : dflt); };
  var pf = prefill || {};
  var repsJson = {}; reps.forEach(function (r) { repsJson[r.id] = { type: r.commission_type, rate: Number(r.commission_rate), regions: r.region_commission_rates || {} }; });
  var custJson = {}; custs.forEach(function (c) { custJson[c.id] = { name: c.name, phone: c.phone || '', email: c.email || '', region: c.region || '' }; });
  var dec = ['JOD','KWD','BHD','OMR','TND','LYD','IQD'].indexOf(currency) >= 0 ? 3 : 2;
%>
<div class="page-head">
  <div><div class="breadcrumbs"><a href="/app/sales"><%= t('nav.sales') %></a><%- icon('chevron-right', 'flip-rtl') %><%= order ? order.order_number : t('sales.new') %></div><h1><%= order ? t('sales.edit') : t('sales.new') %></h1></div>
</div>
<form method="post" action="<%= order ? '/app/sales/' + order.id + '/edit' : '/app/sales/new' %>" data-order-form data-decimals="<%= dec %>" data-reps="<%= json(repsJson) %>" data-customers="<%= json(custJson) %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../partials/form-error') %>
  <div class="grid grid-main">
    <div class="stack">
      <div class="panel">
        <div class="panel-head"><h2><%= t('sales.section_customer') %></h2><% if (can('customers.manage')) { %><span class="small muted"><%= t('sales.customer_hint') %></span><% } %></div>
        <div class="panel-body form-grid">
          <%- include('../../partials/field', { name: 'customer_id', label: t('sales.existing_customer'), type: 'select', placeholder: t('sales.new_customer_option'), value: v('customer_id', pf.id || ''), options: custs.map(function (c) { return { value: c.id, label: c.name + (c.phone ? ' · ' + c.phone : '') }; }), cls: 'full' }) %>
          <%- include('../../partials/field', { name: 'customer_name', label: t('sales.customer'), required: true, value: v('customer_name', pf.name || '') }) %>
          <%- include('../../partials/field', { name: 'customer_phone', label: t('common.phone'), type: 'tel', value: v('customer_phone', pf.phone || '') }) %>
          <%- include('../../partials/field', { name: 'customer_email', label: t('common.email'), type: 'email', value: v('customer_email', pf.email || ''), cls: 'full' }) %>
          <% if (!order) { %><label class="check full"><input type="checkbox" name="save_customer" value="1" checked><span><%= t('sales.save_customer') %></span></label><% } %>
        </div>
      </div>
      <div class="panel">
        <div class="panel-head"><h2><%= t('sales.section_items') %></h2><button class="btn btn-secondary btn-sm" type="button" data-add-line><%- icon('plus', 'icon-sm') %><%= t('sales.add_line') %></button></div>
        <div class="panel-body">
          <div class="line line-head mb-2"><span><%= t('sales.item') %></span><span>SKU</span><span><%= t('sales.qty') %></span><span><%= t('sales.unit_price') %></span><span><%= t('sales.unit_cost') %></span><span></span></div>
          <div class="lines" data-lines>
            <% items.forEach(function (it) { %>
            <div class="line" data-line>
              <input class="input" data-name="itemName" value="<%= it.itemName || '' %>" placeholder="<%= t('sales.item') %>" aria-label="<%= t('sales.item') %>">
              <input class="input" data-name="sku" value="<%= it.sku || '' %>" placeholder="SKU" aria-label="SKU">
              <input class="input" data-name="quantity" value="<%= it.quantity !== undefined ? it.quantity : 1 %>" inputmode="decimal" aria-label="<%= t('sales.qty') %>">
              <input class="input" data-name="unitPrice" value="<%= it.unitPrice !== undefined ? it.unitPrice : '' %>" inputmode="decimal" placeholder="0" aria-label="<%= t('sales.unit_price') %>">
              <input class="input" data-name="unitCost" value="<%= it.unitCost !== undefined ? it.unitCost : '' %>" inputmode="decimal" placeholder="0" aria-label="<%= t('sales.unit_cost') %>" title="<%= t('sales.unit_cost_help') %>">
              <button class="btn btn-ghost btn-icon btn-sm" type="button" data-remove-line aria-label="<%= t('common.delete') %>"><%- icon('trash-2', 'icon-sm') %></button>
            </div>
            <% }) %>
          </div>
          <template data-line-template><div class="line" data-line><input class="input" data-name="itemName" placeholder="<%= t('sales.item') %>" aria-label="<%= t('sales.item') %>"><input class="input" data-name="sku" placeholder="SKU" aria-label="SKU"><input class="input" data-name="quantity" value="1" inputmode="decimal" aria-label="<%= t('sales.qty') %>"><input class="input" data-name="unitPrice" inputmode="decimal" placeholder="0" aria-label="<%= t('sales.unit_price') %>"><input class="input" data-name="unitCost" inputmode="decimal" placeholder="0" aria-label="<%= t('sales.unit_cost') %>"><button class="btn btn-ghost btn-icon btn-sm" type="button" data-remove-line aria-label="<%= t('common.delete') %>"><%- icon('trash-2', 'icon-sm') %></button></div></template>
          <p class="help mt-3"><%= t('sales.unit_cost_help') %></p>
        </div>
      </div>
      <div class="panel">
        <div class="panel-head"><h2><%= t('sales.section_delivery') %></h2></div>
        <div class="panel-body form-grid">
          <div class="field"><label class="label" for="f-delivery_courier"><%= t('sales.courier') %></label><input class="input" id="f-delivery_courier" name="delivery_courier" list="courier-list" value="<%= v('delivery_courier', '') %>"><datalist id="courier-list"><% couriers.forEach(function (c) { %><option value="<%= c %>"><% }) %></datalist></div>
          <%- include('../../partials/field', { name: 'delivery_cost', label: t('sales.delivery_cost'), value: v('delivery_cost', 0), suffix: currency, attrs: 'inputmode="decimal"', help: t('sales.delivery_cost_help') }) %>
          <% if (!order) { %><label class="check full"><input type="checkbox" name="create_shipment" value="1"<%= old.create_shipment ? ' checked' : '' %>><span><%= t('sales.create_shipment') %></span></label><% } %>
        </div>
      </div>
      <%- include('../../partials/field', { name: 'notes', label: t('common.notes'), type: 'textarea', value: v('notes', '') }) %>
    </div>
    <div class="stack">
      <div class="panel">
        <div class="panel-head"><h2><%= t('sales.section_order') %></h2></div>
        <div class="panel-body stack">
          <%- include('../../partials/field', { name: 'date', label: t('common.date'), type: 'date', required: true, value: fmt.dateInput(v('date', today)) }) %>
          <%- include('../../partials/field', { name: 'order_number', label: t('sales.order_number'), value: v('order_number', ''), placeholder: t('sales.auto_number', { next: business.invoice_prefix + business.invoice_next_number }) }) %>
          <%- include('../../partials/field', { name: 'payment_status', label: t('sales.payment_status'), type: 'select', value: v('payment_status', 'paid'), options: statuses.map(function (s) { return { value: s, label: label('sales.payment_statuses', s) }; }) }) %>
          <%- include('../../partials/field', { name: 'channel', label: t('sales.channel'), type: 'select', value: v('channel', 'manual'), options: channels.map(function (s) { return { value: s, label: label('sales.channels', s) }; }) }) %>
          <%- include('../../partials/field', { name: 'employee_id', label: t('sales.rep'), type: 'select', placeholder: t('sales.no_rep'), value: v('employee_id', ''), options: reps.map(function (r) { return { value: r.id, label: r.name }; }) }) %>
        </div>
      </div>
      <div class="panel">
        <div class="panel-body stack">
          <div class="form-grid">
            <%- include('../../partials/field', { name: 'discount', label: t('sales.discount'), value: v('discount', 0), suffix: currency, attrs: 'inputmode="decimal"' }) %>
            <%- include('../../partials/field', { name: 'delivery_fee', label: t('sales.delivery_fee'), value: v('delivery_fee', order ? 0 : Number(business.default_delivery_fee)), suffix: currency, attrs: 'inputmode="decimal"' }) %>
          </div>
          <div class="totals-box" style="max-width:none">
            <span class="muted"><%= t('sales.subtotal') %></span><span class="num" data-out="subtotal">0</span>
            <span class="muted">− <%= t('sales.discount') %></span><span class="num" data-out="discount">0</span>
            <span class="muted">+ <%= t('sales.delivery_fee') %></span><span class="num" data-out="fee">0</span>
            <span class="grand"><%= t('sales.total') %> (<%= currency %>)</span><span class="grand num" data-out="total">0</span>
            <span class="muted small"><%= t('kpi.cogs') %></span><span class="num small" data-out="cogs">0</span>
            <span class="muted small"><%= t('sales.gross_margin') %></span><span class="num small pos" data-out="gross">0</span>
            <span class="muted small"><%= t('sales.commission') %></span><span class="num small" data-out="commission">0</span>
          </div>
          <p class="help"><%= t('sales.totals_server') %></p>
        </div>
        <div class="panel-foot"><a class="btn btn-ghost" href="<%= order ? '/app/sales/' + order.id : '/app/sales' %>"><%= t('common.cancel') %></a><button class="btn btn-primary" type="submit"><%= order ? t('common.save_changes') : t('sales.create') %></button></div>
      </div>
    </div>
  </div>
</form>
