<% var canManage = can('customers.manage'); %>
<div class="page-head">
  <div><div class="breadcrumbs"><%= t('nav.group_operations') %></div><h1><%= t('customers.title') %></h1><p><%= t('customers.lead') %></p></div>
  <div class="page-actions">
    <%- include('../../partials/export-menu', { href: '/app/customers/export' }) %>
    <% if (canManage) { %><button class="btn btn-primary" type="button" data-open-dialog="customer-dialog" data-reset-form data-action="/app/customers" data-dialog-title="<%= t('customers.add') %>"><%- icon('user-plus', 'icon-sm') %><%= t('customers.add') %></button><% } %>
  </div>
</div>
<div class="stats">
  <div class="stat"><div class="stat-label"><%= t('customers.total') %><span class="stat-icon"><%- icon('users') %></span></div><div class="stat-value"><%= fmt.number(summary.customers) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('customers.buyers') %><span class="stat-icon info"><%- icon('shopping-cart') %></span></div><div class="stat-value"><%= fmt.number(summary.buyers) %></div><div class="stat-meta"><%= t('customers.buyers_help') %></div></div>
  <div class="stat"><div class="stat-label"><%= t('customers.repeat') %><span class="stat-icon accent"><%- icon('refresh-cw') %></span></div><div class="stat-value"><%= fmt.pct(summary.buyers ? summary.repeat / summary.buyers * 100 : 0, 0) %></div><div class="stat-meta"><%= t('customers.repeat_help', { n: summary.repeat }) %></div></div>
  <div class="stat hero"><div class="stat-label"><%= t('customers.ltv') %><span class="stat-icon"><%- icon('badge-dollar-sign') %></span></div><div class="stat-value"><%= fmt.money(summary.ltv) %></div><div class="stat-meta"><%= t('customers.ltv_help') %></div></div>
</div>
<div class="panel flush mt-6">
  <form class="table-toolbar" method="get" data-autosubmit role="search">
    <div class="input-group"><%- icon('search', 'icon-sm') %><input class="input" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('customers.search') %>" aria-label="<%= t('common.search') %>"></div>
    <% if (regions.length) { %><select class="select" name="region" aria-label="<%= t('customers.region') %>"><option value="all"><%= t('customers.all_regions') %></option><% regions.forEach(function (r) { %><option<%= query.region === r ? ' selected' : '' %>><%= r %></option><% }) %></select><% } %>
    <% if (groups.length) { %><select class="select" name="group" aria-label="<%= t('customers.group') %>"><option value="all"><%= t('customers.all_groups') %></option><% groups.forEach(function (g) { %><option<%= query.group === g ? ' selected' : '' %>><%= g %></option><% }) %></select><% } %>
    <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="/app/customers"><%- icon('x', 'icon-sm') %><%= t('common.clear') %></a><% } %>
  </form>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', filtered ? { emptyIcon: 'filter', emptyTitle: t('table.no_matches'), emptyText: '' } : { emptyIcon: 'users', emptyTitle: t('customers.empty_title'), emptyText: t('customers.empty_text'), emptyAction: canManage ? '<button class="btn btn-primary btn-sm" type="button" data-open-dialog="customer-dialog" data-reset-form>' + t('customers.add') + '</button>' : '' }) %>
  <% } else { %>
  <div class="table-wrap"><table class="table responsive">
    <thead><tr><th><%= t('customers.customer') %></th><th><%= t('customers.location') %></th><th><%= t('customers.group') %></th><th class="num"><%= t('customers.orders') %></th><th class="num"><%= t('customers.spent') %></th><th><%= t('customers.last_order') %></th></tr></thead>
    <tbody><% rows.forEach(function (r) { var s = stats[r.id] || { orders: 0, spent: 0 }; %>
      <tr data-href="/app/customers/<%= r.id %>">
        <td class="primary-cell"><a class="person" href="/app/customers/<%= r.id %>"><span class="avatar"><%= initials(r.name) %></span><span><span class="person-name"><%= r.name %></span><span class="person-sub" style="display:block" dir="ltr"><%= r.phone || r.email || '' %></span></span></a></td>
        <td data-label="<%= t('customers.location') %>"><%= [r.city, r.region].filter(Boolean).join(' · ') || '—' %></td>
        <td data-label="<%= t('customers.group') %>"><%= r.group_name ? r.group_name : '—' %></td>
        <td class="num" data-label="<%= t('customers.orders') %>"><%= s.orders %></td>
        <td class="num strong" data-label="<%= t('customers.spent') %>"><%= fmt.amount(s.spent) %></td>
        <td data-label="<%= t('customers.last_order') %>"><%= s.lastOrder ? fmt.date(s.lastOrder) : '—' %></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <%- include('../../partials/pagination', { meta: meta }) %>
  <% } %>
</div>
<% if (canManage) { %><%- include('dialog', { c: {} }) %><% } %>
