<% var c = customer; var canManage = can('customers.manage'); %>
<div class="page-head">
  <div>
    <div class="breadcrumbs"><a href="/app/customers"><%= t('nav.customers') %></a><%- icon('chevron-right', 'flip-rtl') %><%= c.name %></div>
    <div class="row"><span class="avatar avatar-lg"><%= initials(c.name) %></span><div><h1><%= c.name %></h1><p><%= [c.group_name, c.category, c.city].filter(Boolean).join(' · ') || t('customers.customer') %></p></div></div>
  </div>
  <div class="page-actions">
    <% if (can('sales.manage')) { %><a class="btn btn-primary" href="/app/sales/new?customer=<%= c.id %>"><%- icon('plus', 'icon-sm') %><%= t('sales.new') %></a><% } %>
    <% if (canManage) { %><button class="btn btn-secondary" type="button" data-open-dialog="customer-dialog" data-action="/app/customers/<%= c.id %>" data-dialog-title="<%= t('customers.edit') %>" data-fill="<%= json({ name: c.name, phone: c.phone, email: c.email, city: c.city, region: c.region, address: c.address, group_name: c.group_name, category: c.category, notes: c.notes }) %>"><%- icon('pencil', 'icon-sm') %><%= t('common.edit') %></button><% } %>
  </div>
</div>
<div class="stats cols-3">
  <div class="stat hero"><div class="stat-label"><%= t('customers.spent') %></div><div class="stat-value"><%= fmt.money(spent) %></div></div>
  <div class="stat"><div class="stat-label"><%= t('customers.orders') %></div><div class="stat-value"><%= orders.length %></div></div>
  <div class="stat"><div class="stat-label"><%= t('customers.avg_order') %></div><div class="stat-value"><%= fmt.money(avg) %></div></div>
</div>
<div class="grid grid-main mt-6">
  <div class="panel flush">
    <div class="panel-head"><h2><%= t('customers.order_history') %></h2></div>
    <% if (!orders.length) { %><%- include('../../partials/empty', { compact: true, emptyIcon: 'shopping-cart', emptyTitle: t('customers.no_orders'), emptyText: '' }) %><% } else { %>
    <div class="table-wrap"><table class="table responsive"><thead><tr><th><%= t('sales.order') %></th><th><%= t('common.date') %></th><th class="num"><%= t('sales.total') %></th><th><%= t('sales.payment_status') %></th></tr></thead>
      <tbody><% orders.forEach(function (o) { %><tr<% if (canSales) { %> data-href="/app/sales/<%= o.id %>"<% } %>><td class="primary-cell strong"><%= o.order_number %></td><td data-label="<%= t('common.date') %>"><%= fmt.date(o.date) %></td><td class="num strong" data-label="<%= t('sales.total') %>"><%= fmt.amount(o.total_amount) %></td><td data-label="<%= t('sales.payment_status') %>"><span class="badge"><%= label('sales.payment_statuses', o.payment_status) %></span></td></tr><% }) %></tbody></table></div>
    <% } %>
  </div>
  <div class="panel">
    <div class="panel-head"><h2><%= t('customers.contact') %></h2></div>
    <div class="panel-body"><dl class="dl">
      <dt><%= t('common.phone') %></dt><dd dir="ltr" style="text-align:start"><%= c.phone || '—' %></dd>
      <dt><%= t('common.email') %></dt><dd><%= c.email || '—' %></dd>
      <dt><%= t('customers.address') %></dt><dd><%= [c.address, c.city].filter(Boolean).join(', ') || '—' %></dd>
      <dt><%= t('customers.region') %></dt><dd><%= c.region || '—' %></dd>
      <dt><%= t('common.notes') %></dt><dd><%= c.notes || '—' %></dd>
      <dt><%= t('common.created_at') %></dt><dd><%= fmt.date(c.created_at) %></dd>
    </dl></div>
    <% if (canManage) { %><div class="panel-foot"><form method="post" action="/app/customers/<%= c.id %>/delete" data-confirm="<%= t('customers.delete_confirm') %>" data-confirm-title="<%= t('customers.delete') %>" data-confirm-yes="<%= t('common.delete') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-ghost btn-sm" type="submit"><%- icon('trash-2', 'icon-sm') %><%= t('customers.delete') %></button></form></div><% } %>
  </div>
</div>
<% if (canManage) { %><%- include('dialog') %><% } %>
