<%# The closing band of the platform's own pages (/switch, /clinic-management-system): try it, or book a demo. %>
<section class="section lp-cta">
  <div class="container">
    <div class="cta-band">
      <div class="lp-cta-glow" aria-hidden="true"></div>
      <div class="lp-cta-copy"><h2><%= title %></h2><p><%= text %></p></div>
      <div class="lp-cta-actions">
        <a class="btn btn-primary btn-lg" href="/signup"><%= M.switch.cta_trial %><%- icon('arrow-right', 'flip-rtl') %></a>
        <a class="btn btn-lg lp-btn-ghost-inverse" href="/demo"><%= M.switch.cta_demo %></a>
      </div>
    </div>
  </div>
</section>
