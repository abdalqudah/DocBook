<div class="row-sm mb-2"><span class="badge badge-warning"><%- icon('key-round', 'icon-sm') %><%= t('auth.newpw_badge') %></span></div>
<h1><%= t('auth.newpw_title') %></h1>
<p class="lead"><%= t('auth.newpw_lead', { name: currentUser.name }) %></p>
<form class="stack mt-6" method="post" action="/password/new" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../partials/form-error') %>
  <div class="field"><span class="label"><%= t('common.email') %></span><input class="input" value="<%= currentUser.email %>" readonly dir="ltr" autocomplete="username"></div>
  <div class="field">
    <label class="label" for="f-password"><%= t('auth.new_password') %><span class="req">*</span></label>
    <input class="input<%= errors.password ? ' is-invalid' : '' %>" id="f-password" name="password" type="password" required minlength="8" autocomplete="new-password" autofocus>
    <div class="pw-meter" data-pw-meter="f-password"><span></span></div>
    <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } else { %><span class="help"><%= t('auth.password_help') %></span><% } %>
  </div>
  <%- include('../../partials/field', { name: 'password_confirm', label: t('auth.confirm_password'), type: 'password', required: true, autocomplete: 'new-password' }) %>
  <button class="btn btn-primary btn-lg btn-block" type="submit"><%= t('auth.newpw_submit') %></button>
</form>
<form method="post" action="/logout" class="mt-4 text-center"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('log-out', 'icon-sm') %><%= t('auth.logout') %></button></form>
