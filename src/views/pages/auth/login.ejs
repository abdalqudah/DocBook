<h1><%= t('auth.login_title') %></h1>
<p class="lead"><%= t('auth.login_lead') %></p>
<form class="stack mt-6" method="post" action="/login" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../partials/form-error') %>
  <%- include('../../partials/field', { name: 'email', label: t('common.email'), type: 'email', required: true, autocomplete: 'username', attrs: 'autofocus inputmode="email" dir="ltr"' }) %>
  <div class="field">
    <div class="row between"><label class="label" for="f-password"><%= t('auth.password') %></label><a class="link small" href="/forgot"><%= t('auth.forgot_link') %></a></div>
    <input class="input<%= errors.password ? ' is-invalid' : '' %>" id="f-password" name="password" type="password" required autocomplete="current-password">
    <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
  </div>
  <button class="btn btn-primary btn-lg btn-block" type="submit"><%= t('auth.login') %></button>
</form>
<%- include('../../partials/google-button') %>
<div class="alert alert-info mt-6"><%- icon('info') %><div class="grow small"><div class="alert-title"><%= t('auth.staff_hint_title') %></div><%= t('auth.staff_hint_text') %></div></div>
<p class="mt-6 small muted text-center"><%= t('auth.no_account') %> <a class="link" href="/signup"><%= t('auth.signup_link') %></a></p>
<p class="mt-2 small muted text-center"><%= t('vendors.login_hint') %> <a class="link" href="/vendors"><%= t('vendors.login_hint_link') %></a></p>
