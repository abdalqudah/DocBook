<h1><%= t('workspaces.new_title') %></h1>
<p class="lead"><%= t('workspaces.new_lead') %></p>
<form class="stack mt-6" method="post" action="/workspaces/new" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../partials/form-error') %>
  <%- include('../../partials/field', { name: 'clinic_name', label: t('auth.business_name'), required: true, placeholder: t('auth.business_name_ph') }) %>
  <div class="form-grid">
    <%- include('../../partials/field', { name: 'specialty', label: t('auth.industry'), type: 'select', placeholder: t('common.select'), options: specialtyOptions }) %>
    <%- include('../../partials/field', { name: 'city', label: t('auth.city') }) %>
    <%- include('../../partials/field', { name: 'currency', label: t('common.currency'), type: 'select', required: true, value: 'JOD', options: currencyOptions }) %>
    <%- include('../../partials/field', { name: 'timezone', label: t('auth.timezone'), type: 'select', required: true, value: 'Asia/Amman', options: zoneOptions }) %>
  </div>
  <button class="btn btn-primary btn-lg btn-block" type="submit"><%= t('workspaces.create') %></button>
  <% if (currentUser) { %><a class="btn btn-ghost btn-block" href="/app"><%= t('common.cancel') %></a><% } %>
</form>
