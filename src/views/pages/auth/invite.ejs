<h1><%= t('auth.invite_title') %></h1>
<% if (!inv) { %>
  <div class="alert alert-error mt-6"><%- icon('circle-alert') %><div class="grow"><%= t('auth.invite_invalid') %></div></div>
<% } else { %>
  <p class="lead"><%= t('auth.invite_lead', { business: inv.business_name }) %></p>
  <form class="stack mt-6" method="post" action="/invite/<%= token %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../../partials/form-error') %>
    <div class="field"><span class="label"><%= t('common.email') %></span><input class="input" value="<%= inv.email %>" readonly></div>
    <% if (!currentUser) { %>
      <%- include('../../partials/field', { name: 'name', label: t('auth.full_name'), required: true, autocomplete: 'name' }) %>
      <%- include('../../partials/field', { name: 'password', label: t('auth.password'), type: 'password', required: true, autocomplete: 'new-password', help: t('auth.password_help') }) %>
    <% } %>
    <button class="btn btn-primary btn-lg btn-block" type="submit"><%= t('auth.invite_accept') %></button>
  </form>
<% } %>
