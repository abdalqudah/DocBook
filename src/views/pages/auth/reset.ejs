<h1><%= t('auth.reset_title') %></h1>
<% if (!valid) { %>
  <div class="alert alert-error mt-6"><%- icon('circle-alert') %><div class="grow"><%= t('errors.RESET_INVALID') %></div></div>
  <a class="btn btn-secondary btn-block mt-4" href="/forgot"><%= t('auth.request_new_link') %></a>
<% } else { %>
  <p class="lead"><%= t('auth.reset_lead') %></p>
  <form class="stack mt-6" method="post" action="/reset/<%= token %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../../partials/form-error') %>
    <div class="field">
      <label class="label" for="f-password"><%= t('auth.new_password') %></label>
      <input class="input<%= errors.password ? ' is-invalid' : '' %>" id="f-password" name="password" type="password" required minlength="8" autocomplete="new-password">
      <div class="pw-meter" data-pw-meter="f-password"><span></span></div>
      <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
    </div>
    <%- include('../../partials/field', { name: 'password_confirm', label: t('auth.confirm_password'), type: 'password', required: true, autocomplete: 'new-password' }) %>
    <button class="btn btn-primary btn-lg btn-block" type="submit"><%= t('auth.set_password') %></button>
  </form>
<% } %>
