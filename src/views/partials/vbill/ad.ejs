<%# A rep's paid ad shown to the clinic (sponsored). Local: ad. Click goes through /app/marketplace/ad/:id (counted). %>
<% var _a = ad; var _L = function (ar, en) { return locale === 'en' && en ? en : ar; }; %>
<a class="vb-ad" href="/app/marketplace/ad/<%= _a.id %>" rel="sponsored">
  <% if (_a.image_mime) { %><img src="/vendors/ad-image/<%= _a.id %>" alt="" loading="lazy"><% } else { %><span class="vb-ad-ico"><%- icon('megaphone') %></span><% } %>
  <span class="grow" style="min-width:0">
    <span class="vb-ad-tag"><%= t('vbill.sponsored') %> · <%= _L(_a.vendor_name, _a.vendor_name_en) %></span>
    <span class="vb-ad-title"><%= _L(_a.title, _a.title_en) %></span>
    <% var _b = _L(_a.body, _a.body_en); if (_b) { %><span class="vb-ad-body"><%= _b %></span><% } %>
  </span>
  <%- icon('chevron-right', 'icon-sm muted flip-rtl') %>
</a>
