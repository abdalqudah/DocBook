<% var d = s.data || {}; %>
<section class="section alt lp-steps <%= secCls(s) %>" id="<%= s.anchor %>"><%- include('bg', { s: s }) %>
  <div class="container"><%- include('slot-open', { s: s }) %>
    <%- include('head', { s: s, center: true }) %>
    <ol class="lp-step-list">
      <% (d.items || []).forEach(function (st, i) { %>
      <li class="lp-step">
        <span class="lp-step-n num"><%= i + 1 %></span>
        <h3><%= L(st.title) %></h3>
        <% if (L(st.text)) { %><p><%= L(st.text) %></p><% } %>
      </li>
      <% }) %>
    </ol>
  <%- include('slot-close', { s: s }) %></div>
</section>
