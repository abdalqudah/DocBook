<div class="mock mock-records">
  <div class="mock-card">
    <div class="mock-head">
      <span class="mock-av c3 lg"><%- icon('user-round') %></span>
      <span class="grow"><strong><%= t('site.mock.patient_file') %></strong><span class="mock-sub"><i class="sk w40 inline"></i></span></span>
      <span class="mock-pill info"><%= t('site.mock.visit') %></span>
    </div>
    <div class="mock-body">
      <div class="mock-label"><%= t('site.mock.vitals') %></div>
      <div class="mock-vitals">
        <span><small><%= t('site.mock.bp') %></small><b class="num" dir="ltr">120/80</b></span>
        <span><small><%= t('site.mock.pulse') %></small><b class="num" dir="ltr">72</b></span>
        <span><small><%= t('site.mock.temp') %></small><b class="num" dir="ltr">37.0°</b></span>
      </div>
      <div class="mock-label"><%= t('site.mock.diagnosis') %></div>
      <div class="mock-lines"><i class="sk w90"></i><i class="sk w70"></i></div>
      <div class="mock-rx">
        <div class="mock-rx-head"><%- icon('pill', 'icon-sm') %><strong><%= t('site.mock.prescription') %></strong><span class="mock-btn ghost sm"><%- icon('printer', 'icon-sm') %><%= t('site.mock.print') %></span></div>
        <div class="mock-rx-line"><span class="mock-dot"></span><i class="sk w60"></i><i class="sk w20"></i></div>
        <div class="mock-rx-line"><span class="mock-dot"></span><i class="sk w50"></i><i class="sk w25"></i></div>
      </div>
    </div>
  </div>
</div>
