<% var d = s.data || {}; %>
<section class="section alt lp-faq <%= secCls(s) %>" id="<%= s.anchor %>"><%- include('bg', { s: s }) %>
  <div class="container lp-faq-grid"><%- include('slot-open', { s: s }) %>
    <div><%- include('head', { s: s }) %></div>
    <div class="faq">
      <% (d.items || []).forEach(function (f) { %>
        <details><summary><span><%= L(f.q) %></span><%- icon('chevron-down', 'icon-sm') %></summary><p><%= L(f.a) %></p></details>
      <% }) %>
    </div>
  <%- include('slot-close', { s: s }) %></div>
</section>
