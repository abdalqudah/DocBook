<%
  // Thumb-reach bar on phones: the role's daily pages (see BOTTOM_ORDER in src/routes/nav.js) + the full menu.
  var _bn = navGroups.bottom ? navGroups.bottom() : [];
  var _bnHere = navGroups.locate ? navGroups.locate(fullPath).item : null;
%>
<% if (_bn.length) { %>
<nav class="bottom-nav" aria-label="<%= t('nav.quick') %>">
  <% _bn.forEach(function (i) { var active = _bnHere === i, n = i.badge && navBadges ? Number(navBadges[i.badge]) || 0 : 0; %>
    <a href="<%= i.href %>" class="<%= active ? 'active' : '' %>"<% if (active) { %> aria-current="page"<% } %>><span class="bottom-nav-icon"><%- icon(i.icon) %><% if (n) { %><span class="bottom-nav-dot" role="img" aria-label="<%= t('navx.pending', { count: n }) %>"></span><% } %></span><span><%= t('nav.short.' + i.key) %></span></a>
  <% }) %>
  <a href="#" data-nav-toggle aria-controls="sidebar"><%- icon('menu') %><span><%= t('nav.more') %></span></a>
</nav>
<% } %>
