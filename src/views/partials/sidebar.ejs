<%
  // One line per workspace (src/routes/nav.js); the workspace's pages are the tabs above the page content.
  var _here = navGroups.locate ? navGroups.locate(fullPath) : { item: null, group: null };
  var _activeGroup = _here.group ? _here.group.group : null;
  var _fmtCount = function (n) { return n > 99 ? '99+' : n; };
  var _line = function (g) {
    var on = g.group === _activeGroup, n = navGroups.sectionCount(g, navBadges);
    return '<a href="' + g.home.href + '" class="' + (on ? 'active' : '') + '"' + (on ? ' aria-current="page"' : '') + ' data-nav-ws="' + g.group + '">'
      + icon(g.icon) + '<span class="truncate">' + escapeFn(t(g.label)) + '</span>'
      + (n ? '<span class="nav-count" aria-label="' + escapeFn(t('navx.pending', { count: n })) + '">' + _fmtCount(n) + '</span>' : '') + '</a>';
  };
  var _main = navGroups.filter(function (g) { return g.inSidebar && !g.foot; });
  var _foot = navGroups.filter(function (g) { return g.inSidebar && g.foot; });
%>
<%# White label: the clinic's own logo and name at the top (switching clinics lives in the user menu). %>
<% var _clinicName = locale === 'en' && business.name_en ? business.name_en : business.name; %>
<div class="sidebar-brand clinic-brand"><a class="row-sm" href="/app"><span class="ws-mark"><% if (business.logo_mime) { %><img src="/app/logo/<%= business.id %>?v=<%= business.logo_version %>" alt=""><% } else { %><%= initials(_clinicName) %><% } %></span><span class="clinic-brand-name truncate"><%= _clinicName %></span></a></div>
<nav class="nav nav-workspaces" aria-label="<%= t('nav.main') %>">
  <div class="nav-flat nav-main">
    <% _main.forEach(function (g) { %><%- _line(g) %><% }) %>
  </div>
  <% if (_foot.length) { %>
  <div class="nav-flat nav-foot-links">
    <% _foot.forEach(function (g) { %><%- _line(g) %><% }) %>
  </div>
  <% } %>
</nav>
<div class="sidebar-foot">
  <div class="sys-status small muted" data-sys-status data-off="<%= t('navx.sys_offline') %>" data-on="<%= t('navx.sys_online') %>"><i class="sys-dot" aria-hidden="true"></i><span data-sys-text><%= t('navx.sys_online') %></span><span class="sys-ver" dir="ltr">v<%= appVersion %></span></div>
</div>
