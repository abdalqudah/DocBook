<%
  var _here = navGroups.locate ? navGroups.locate(fullPath) : { item: null, group: null };
  // A page without its own line (support tickets) lights up the line it's reached from.
  var _activeKey = _here.item ? (_here.item.parent || _here.item.key) : null;
  var _count = function (i) { return i.badge && navBadges ? Number(navBadges[i.badge]) || 0 : 0; };
  var _fmtCount = function (n) { return n > 99 ? '99+' : n; };
  var _link = function (item, cls) {
    var on = item.key === _activeKey, n = _count(item);
    return '<a href="' + item.href + '" class="' + (cls || '') + (on ? ' active' : '') + '"' + (on ? ' aria-current="page"' : '') + '>'
      + (cls === 'nav-sub' ? '' : icon(item.icon)) + '<span class="truncate">' + escapeFn(t('nav.' + item.key)) + '</span>'
      + (n ? '<span class="nav-count" aria-label="' + escapeFn(t('navx.pending', { count: n })) + '">' + _fmtCount(n) + '</span>' : '') + '</a>';
  };
  var _shown = function (g) { return g.items.filter(function (i) { return i.sidebar !== false; }); };
  var _daily = navGroups.filter(function (g) { return g.group === 'daily'; });
  var _groups = navGroups.filter(function (g) { return !g.flat && _shown(g).length; });
  var _foot = navGroups.filter(function (g) { return g.flat && g.group !== 'daily'; });
%>
<div class="sidebar-brand"><a class="row-sm" href="/app" aria-label="<%= brandName %>"><%- include('logo') %></a></div>
<details class="dropdown ws-switch">
  <summary>
    <span class="ws-mark"><% if (business.logo_mime) { %><img src="/app/logo/<%= business.id %>?v=<%= business.logo_version %>" alt=""><% } else { %><%= initials(business.name) %><% } %></span>
    <span class="grow"><span class="ws-name truncate"><%= business.name %></span><span class="ws-meta"><%= roleName(membership) %> · <%= business.currency %></span></span>
    <%- icon('chevrons-up-down', 'icon-sm muted') %>
  </summary>
  <div class="menu">
    <div class="menu-label"><%= t('nav.workspaces') %></div>
    <% workspaces.forEach(function (w) { %>
      <form method="post" action="/workspaces/switch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="business_id" value="<%= w.id %>">
        <button type="submit" class="<%= w.id === business.id ? 'is-current' : '' %>"><span class="ws-mark" style="width:22px;height:22px;font-size:10px;border-radius:6px"><%= initials(w.name) %></span><span class="grow truncate"><%= w.name %></span><% if (w.id === business.id) { %><%- icon('check', 'icon-sm') %><% } %></button>
      </form>
    <% }) %>
    <div class="sep"></div>
    <a href="/workspaces/new"><%- icon('plus', 'icon-sm') %><%= t('nav.new_workspace') %></a>
  </div>
</details>
<nav class="nav nav-sections" aria-label="<%= t('nav.main') %>" data-nav-sections data-nav-user="<%= currentUser ? currentUser.id : '' %>-<%= business.id %>">
  <% _daily.forEach(function (g) { %>
  <div class="nav-flat nav-daily">
    <% _shown(g).forEach(function (item) { %><%- _link(item) %><% }) %>
  </div>
  <% }) %>
  <% if (_groups.length) { %>
  <div class="nav-groups">
    <% _groups.forEach(function (g) { var items = _shown(g); %>
      <% if (items.length === 1) { %><%- _link(items[0]) %>
      <% } else { var mine = _here.group && _here.group.group === g.group, total = navGroups.sectionCount(g, navBadges); %>
      <details class="nav-sec<%= mine ? ' has-active' : '' %>" data-nav-sec="<%= g.group %>"<% if (mine) { %> open<% } %>>
        <summary class="nav-sec-head"><%- icon(g.icon) %><span class="truncate"><%= t(g.label) %></span><% if (total) { %><span class="nav-dot" role="img" aria-label="<%= t('navx.pending', { count: total }) %>"></span><% } %><%- icon('chevron-down', 'icon-sm nav-chev') %></summary>
        <div class="nav-sec-items">
          <% items.forEach(function (item) { %><%- _link(item, 'nav-sub') %><% }) %>
        </div>
      </details>
      <% } %>
    <% }) %>
  </div>
  <% } %>
  <% _foot.forEach(function (g) { %>
  <div class="nav-flat nav-foot-links">
    <% _shown(g).forEach(function (item) { %><%- _link(item) %><% }) %>
  </div>
  <% }) %>
</nav>
<div class="sidebar-foot">
  <div class="row-sm small muted"><%- icon('shield-check', 'icon-sm') %><span class="truncate"><%= tagline %></span></div>
</div>
