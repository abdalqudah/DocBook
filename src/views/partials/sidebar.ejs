<%
  var p = fullPath.split('?')[0];
  var isActive = function (item) { return item.exact ? p === item.href : (p === item.href || p.indexOf(item.href + '/') === 0); };
%>
<div class="sidebar-brand"><a class="row-sm" href="/app" aria-label="<%= brandName %>"><%- include('logo') %></a></div>
<details class="dropdown ws-switch">
  <summary>
    <span class="ws-mark"><% if (business.logo_mime) { %><img src="/app/logo/<%= business.id %>?v=<%= business.logo_version %>" alt=""><% } else { %><%= initials(business.name) %><% } %></span>
    <span class="grow"><span class="ws-name truncate"><%= business.name %></span><span class="ws-meta"><%= roleName(membership) %> · <%= business.currency %></span></span>
    <%- icon('chevrons-up-down', 'icon-sm muted') %>
  </summary>
  <div class="menu">
    <div class="menu-label"><%= t('nav.workspaces') %></div>
    <% workspaces.forEach(function (w) { %>
      <form method="post" action="/workspaces/switch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="business_id" value="<%= w.id %>">
        <button type="submit" class="<%= w.id === business.id ? 'is-current' : '' %>"><span class="ws-mark" style="width:22px;height:22px;font-size:10px;border-radius:6px"><%= initials(w.name) %></span><span class="grow truncate"><%= w.name %></span><% if (w.id === business.id) { %><%- icon('check', 'icon-sm') %><% } %></button>
      </form>
    <% }) %>
    <div class="sep"></div>
    <a href="/workspaces/new"><%- icon('plus', 'icon-sm') %><%= t('nav.new_workspace') %></a>
  </div>
</details>
<nav class="nav" aria-label="<%= t('nav.main') %>">
  <% navGroups.forEach(function (g) { %>
  <div class="nav-group">
    <div class="nav-title"><%= t('nav.group_' + g.group) %></div>
    <% g.items.forEach(function (item) { var count = item.badge && navBadges ? navBadges[item.badge] : 0; %>
      <a href="<%= item.href %>" class="<%= isActive(item) ? 'active' : '' %>"<% if (isActive(item)) { %> aria-current="page"<% } %>><%- icon(item.icon) %><span class="truncate"><%= t('nav.' + item.key) %></span><% if (count) { %><span class="nav-count<%= item.badge === 'pendingDeliveries' ? ' warn' : '' %>"><%= count > 99 ? '99+' : count %></span><% } %></a>
    <% }) %>
  </div>
  <% }) %>
</nav>
<div class="sidebar-foot">
  <div class="row-sm small muted"><%- icon('shield-check', 'icon-sm') %><span class="truncate"><%= tagline %></span></div>
</div>
