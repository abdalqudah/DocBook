<% if (flash && flash.length) { %><div class="toasts" role="status" aria-live="polite">
<% flash.forEach(function (f) { %><div class="toast <%= f.type %>" data-toast><%- icon(f.type === 'success' ? 'circle-check' : f.type === 'error' ? 'circle-alert' : f.type === 'warning' ? 'triangle-alert' : 'info') %><div class="grow"><%= f.message %></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-dismiss aria-label="<%= t('common.close') %>"><%- icon('x', 'icon-sm') %></button></div><% }) %>
</div><% } %>
