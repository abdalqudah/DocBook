<header class="topbar">
  <button class="btn btn-ghost btn-icon mobile-only" type="button" data-nav-toggle aria-label="<%= t('nav.menu') %>"><%- icon('menu') %></button>
  <%# Desktop: fold the sidebar to icons; the clinic's logo then moves here, into the top bar. %>
  <button class="btn btn-ghost btn-icon desktop-only sb-toggle" type="button" data-sb-toggle aria-label="<%= t('nav.toggle_sidebar') %>" title="<%= t('nav.toggle_sidebar') %>"><%- icon(dir === 'rtl' ? 'panel-right' : 'panel-left', 'icon-sm') %></button>
  <% var _tbName = locale === 'en' && business.name_en ? business.name_en : business.name; %>
  <a class="topbar-brand" href="/app" title="<%= _tbName %>"><% if (business.logo_mime) { %><img<%- typeof logoDarkSrc !== 'undefined' && logoDarkSrc ? ' class="logo-light"' : '' %> src="/app/logo/<%= business.id %>?v=<%= business.logo_version %>" alt="<%= _tbName %>"><% if (typeof logoDarkSrc !== 'undefined' && logoDarkSrc) { %><img class="logo-dark" src="<%= logoDarkSrc %>" alt=""><% } %><% } else { %><span class="ws-mark"><%= initials(_tbName) %></span><span class="topbar-brand-name truncate"><%= _tbName %></span><% } %></a>
  <button class="search-trigger" type="button" data-cmdk-open aria-label="<%= t('search.open') %>"><%- icon('search', 'icon-sm') %><span class="label-text"><%= t('search.placeholder') %></span><span class="kbd">Ctrl K</span></button>
  <% var _create = navActions.filter(function (a) { return a.create; }); %>
  <% if (_create.length) { %>
  <details class="dropdown new-menu desktop-only">
    <summary class="btn btn-primary btn-sm" aria-label="<%= t('nav.new_menu') %>"><%- icon('plus', 'icon-sm') %><span><%= t('nav.new') %></span></summary>
    <div class="menu">
      <div class="menu-label"><%= t('nav.new_menu') %></div>
      <% _create.forEach(function (a) { %><a href="<%= a.href %>"><%- icon(a.icon, 'icon-sm') %><%= t('search.actions.' + a.key) %></a><% }) %>
    </div>
  </details>
  <% } %>
  <div class="topbar-actions">
    <a class="btn btn-ghost btn-sm tb-wide" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>" title="<%= t('common.language') %>" data-lang-switch="<%= locale === 'ar' ? 'en' : 'ar' %>"><%- icon('languages') %><span><%= locale === 'ar' ? 'EN' : 'ع' %></span></a>
    <button class="btn btn-ghost btn-icon tb-wide" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button>
    <% if (can('billing.manage')) { %><a class="btn btn-ghost btn-icon tb-wide" href="/app/cashier/screen" title="<%= t('cashpos.title') %>" aria-label="<%= t('cashpos.title') %>"><%- icon('banknote') %></a><% } %>
    <% if (typeof moduleOn === 'undefined' || moduleOn('staff_mail')) { %><a class="btn btn-ghost btn-icon tb-wide" href="/app/mail" aria-label="<%= t('mailbox.title') %>" title="<%= t('mailbox.title') %>"><%- icon('mail') %></a><% } %><% if (typeof moduleOn === 'undefined' || moduleOn('staff_chat')) { %><% var _uc = typeof unreadChat !== 'undefined' ? unreadChat : 0; %><a class="btn btn-ghost btn-icon chat-link" href="/app/chat" data-chat-badge aria-label="<%= t('chat.title') %><%= _uc ? ' (' + _uc + ')' : '' %>" title="<%= t('chat.title') %>"><%- icon('message-circle') %><% if (_uc) { %><span class="bell-count"><%= _uc > 9 ? '9+' : _uc %></span><% } %></a><% } %>
    <% var _att = typeof myAttendance !== 'undefined' ? myAttendance : null; %>
    <% if (_att && (typeof moduleOn === 'undefined' || moduleOn('attendance'))) { %>
    <details class="dropdown att-dd">
      <summary class="btn btn-ghost btn-icon att-btn<%= _att.open ? ' is-in' : '' %>" aria-label="<%= t('attendance.tb_title') %>: <%= _att.open ? t('attendance.tb_in', { time: _att.since }) : t('attendance.tb_out') %>" title="<%= _att.open ? t('attendance.tb_in', { time: _att.since }) : t('attendance.tb_out') %>"><%- icon('clock') %><span class="att-dot" aria-hidden="true"></span></summary>
      <div class="menu att-menu">
        <div class="att-state"><span class="att-pill<%= _att.open ? ' is-in' : '' %>"><%= _att.open ? t('attendance.tb_in', { time: _att.since }) : t('attendance.tb_out') %></span></div>
        <% if (_att.qrOnly) { %><p class="small muted att-note"><%= t('attendance.tb_qr_only') %></p>
        <% } else { %>
        <form method="post" action="/app/attendance/clock">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expect" value="<%= _att.open ? 'out' : 'in' %>"><input type="hidden" name="_return" value="<%= path && path.indexOf('/app') === 0 ? path : '/app' %>">
          <button class="btn <%= _att.open ? 'btn-secondary' : 'btn-primary' %> att-go" type="submit"><%- icon(_att.open ? 'log-out' : 'log-in', 'icon-sm') %><%= _att.open ? t('attendance.tb_clock_out') : t('attendance.tb_clock_in') %></button>
        </form>
        <% } %>
        <a href="/app/attendance?view=me"><%- icon('calendar-days', 'icon-sm') %><%= t('attendance.tb_mine') %></a>
      </div>
    </details>
    <% } %>
    <details class="dropdown notif-dd" data-notif>
      <summary class="btn btn-ghost btn-icon bell" data-notif-bell aria-label="<%= t('notifications.title') %><%= unreadNotifications ? ' (' + unreadNotifications + ')' : '' %>" title="<%= t('notifications.title') %>"><%- icon('bell') %><% if (unreadNotifications) { %><span class="bell-count"><%= unreadNotifications > 9 ? '9+' : unreadNotifications %></span><% } %></summary>
      <div class="menu notif-menu" data-notif-panel>
        <div class="notif-head"><strong><%= t('notifications.title') %></strong></div>
        <div class="notif-body" data-notif-body><div class="notif-empty small muted"><%= t('common.loading') %></div></div>
        <a class="notif-all" href="/app/notifications"><%= t('notifications.view_all') %></a>
      </div>
    </details>
    <details class="dropdown">
      <summary class="user-chip"><span class="avatar"><% if (typeof myPhoto !== 'undefined' && myPhoto) { %><img src="<%= myPhoto %>" alt=""><% } else { %><%= initials(currentUser.name) %><% } %></span><span class="user-name small strong"><%= currentUser.name %></span><% if (typeof branchSwitch !== 'undefined' && branchSwitch && branchSwitch.current) { var _bo = branchSwitch.options.find(function (o) { return o.value === String(branchSwitch.current); }); if (_bo) { %><span class="badge badge-info truncate" style="max-width:160px" data-branch-now title="<%= _bo.label %>"><%- icon('map-pin', 'icon-sm') %><%= _bo.label %></span><% } } %><%- icon('chevron-down', 'icon-sm muted user-chev') %></summary>
      <div class="menu">
        <div class="menu-label truncate"><%= currentUser.email %></div>
        <%# Phones: the top-bar buttons that do not fit (language, theme, cash screen, mail) live here. %>
        <div class="tb-narrow">
          <a href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>" data-lang-switch="<%= locale === 'ar' ? 'en' : 'ar' %>"><%- icon('languages', 'icon-sm') %><%= locale === 'ar' ? 'English' : 'العربية' %></a>
          <button type="button" data-theme-toggle><%- icon('moon', 'icon-sm theme-moon') %><%- icon('sun', 'icon-sm theme-sun hidden') %><%= t('common.toggle_theme') %></button>
          <% if (can('billing.manage')) { %><a href="/app/cashier/screen"><%- icon('banknote', 'icon-sm') %><%= t('cashpos.title') %></a><% } %>
          <% if (typeof moduleOn === 'undefined' || moduleOn('staff_mail')) { %><a href="/app/mail"><%- icon('mail', 'icon-sm') %><%= t('mailbox.title') %></a><% } %>
          <div class="sep"></div>
        </div>
        <% if (!(typeof moduleOn === 'function') || moduleOn('attendance')) { %><a href="/app/attendance"><%- icon('clock', 'icon-sm') %><%= t('navx.clock') %></a><% } %>
        <div class="sep"></div>
        <% if (typeof workspaces !== 'undefined' && workspaces.length > 1) { %>
        <div class="menu-label"><%= t('nav.workspaces') %></div>
        <% workspaces.forEach(function (w) { %>
          <form method="post" action="/workspaces/switch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="business_id" value="<%= w.id %>"><button type="submit"<%- w.id === business.id ? ' aria-current="true"' : '' %>><%- icon(w.id === business.id ? 'check' : 'building-2', 'icon-sm') %><span class="truncate"><%= w.name %></span></button></form>
        <% }) %>
        <% } %>
        <% if (typeof branchSwitch !== 'undefined' && branchSwitch) { %>
        <div class="sep"></div>
        <div class="menu-label"><%= t('branches.work_in') %></div>
        <% [{ value: '', label: t('branches.all') }].concat(branchSwitch.options).forEach(function (o) { var on = String(branchSwitch.current || '') === o.value; %>
          <form method="post" action="/workspaces/branch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= o.value %>"><input type="hidden" name="return_to" value="<%= path %>"><button type="submit"<%- on ? ' aria-current="true"' : '' %> data-branch-switch><%- icon(on ? 'check' : 'map-pin', 'icon-sm') %><span class="truncate"><%= o.label %></span></button></form>
        <% }) %>
        <div class="sep"></div>
        <% } %>
        <a href="/workspaces/new"><%- icon('plus', 'icon-sm') %><%= t('nav.new_workspace') %></a>
        <div class="sep"></div>
        <div class="menu-label"><%= t('nav.personal') %></div>
        <a href="/app/settings/account"><%- icon('user', 'icon-sm') %><%= t('settings.account') %></a>
        <% if (typeof myDoctorId !== 'undefined' && myDoctorId) { %><a href="/app/my-profile"><%- icon('stethoscope', 'icon-sm') %><%= t('myprofile.menu') %></a><% } %>
        <a href="/app/settings/security"><%- icon('shield-check', 'icon-sm') %><%= t('settings.security') %></a>
        <% if (currentUser.is_platform_admin) { %><a href="<%= edition.single ? '/app/settings' : '/admin' %>"><%- icon('settings', 'icon-sm') %><%= t('maintenance.system_settings') %></a><% } %>
        <a href="/app/settings/appearance"><%- icon('palette', 'icon-sm') %><%= t('settings.appearance') %></a>
        <a href="/app/settings/notifications"><%- icon('bell', 'icon-sm') %><%= t('nav.my_notifications') %></a>
        <a href="/app/help"><%- icon('circle-help', 'icon-sm') %><%= t('nav.support') %></a>
        <div class="sep"></div>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%- icon('log-out', 'icon-sm') %><%= t('auth.logout') %></button></form>
      </div>
    </details>
  </div>
</header>
