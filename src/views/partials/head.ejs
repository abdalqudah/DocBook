<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= brandName %></title>
<meta name="description" content="<%= tagline %>">
<meta name="color-scheme" content="light dark">
<% if (typeof faviconHref !== 'undefined' && faviconHref) { %><link rel="icon" href="<%= faviconHref %>"><% } else { %><link rel="icon" href="<%= brand.favicon || '/favicon.svg' %>"><% } %>
<link rel="stylesheet" href="/theme.css?v=<%= assetV %>">
<link rel="stylesheet" href="/css/app.css?v=<%= assetV %>">
<% (typeof pageStyles !== 'undefined' ? pageStyles : []).forEach(function (h) { %><link rel="stylesheet" href="<%= h %>?v=<%= assetV %>"><% }) %>
<% if (typeof themeHref !== 'undefined' && themeHref) { /* a clinic screen opened by its secret link (waiting room, door): the clinic's colours */ %><link rel="stylesheet" href="<%= themeHref %>"><% } else if (typeof publicShare !== 'undefined' && publicShare && typeof business !== 'undefined' && business && business.slug) { /* a document shared with a patient: the clinic's public colours */ %><link rel="stylesheet" href="/<%= business.slug %>/theme.css"><% } else if (typeof business !== 'undefined' && business && business.color) { %><link rel="stylesheet" href="/app/theme/<%= business.id %>.css?c=<%= encodeURIComponent(business.color) %>"><% } else if (typeof authClinic !== 'undefined' && authClinic && authClinic.color) { /* one clinic / centre: its sign-in page in its colours */ %><link rel="stylesheet" href="/<%= authClinic.slug %>/theme.css"><% } %>
<meta name="csrf-token" content="<%= csrfToken %>">
