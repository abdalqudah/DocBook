<%/* A visit's papers next to its row (Today, My day): every prescription, lab / imaging request and referral, the invoice — then send them all on
   WhatsApp or by e-mail. Args: a (row with a.docs from withDocs, a.email), mailOn. */%>
<% if (a.docs && (a.docs.clinical || a.docs.billing) && a.status !== 'cancelled') { var D = a.docs; %>
      <div class="rec-sched-docs" role="group" aria-label="<%= a.patient_name %>">
        <% D.items.forEach(function (x) { var tip = t('share.icon.' + x.key) + (x.extra ? ': ' + x.extra : '') + (x.on ? '' : ' — ' + t('share.docs_none')); var pr = x.on && D.print && x.key !== 'invoice'; if (pr) tip = t('share.print') + ' — ' + tip; %>
          <% if (x.on) { %><a class="doc-ic is-on" href="<%= x.href %>"<%- pr ? ' target="_blank" rel="noopener"' : '' %> title="<%= tip %>" aria-label="<%= tip %>"><%- icon(x.ic, 'icon-sm') %></a><% } else { %><span class="doc-ic" title="<%= tip %>" aria-label="<%= tip %>" role="img"><%- icon(x.ic, 'icon-sm') %></span><% } %>
        <% }) %>
        <% if (typeof moduleOn === 'undefined' || moduleOn('patient_sharing')) { %>
        <span class="doc-sep" aria-hidden="true"></span>
        <span class="doc-share">
        <% if (a.status === 'completed' || a.payment_status === 'paid') { %>
          <a class="doc-ic is-thanks" href="/app/share/thanks?id=<%= a.id %>" target="_blank" rel="noopener" title="<%= t('share.thanks_btn') %>" aria-label="<%= t('share.thanks_btn') %>"><%- icon('star', 'icon-sm') %></a>
        <% } %>
        <% if (D.send && D.send.length) { var mailOk = mailOn && a.email; %>
          <details class="dropdown send-dd">
            <summary class="doc-ic is-wa" title="<%= t('share.send_visit') %>" aria-label="<%= t('share.send_visit') %>"><%- icon('message-circle', 'icon-sm') %></summary>
            <form class="menu send-menu" method="post" action="/app/share/wa" target="_blank" data-no-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="kind" value="visit"><input type="hidden" name="id" value="<%= a.id %>">
              <div class="menu-label"><%= t('share.pick_lead') %></div>
              <% D.send.forEach(function (x) { %><label class="send-opt"><input type="checkbox" name="pick" value="<%= x.kind %>:<%= x.id %>" checked><%- icon(x.ic, 'icon-sm') %><span dir="auto"><%= t(x.key, x.vars || {}) %></span></label><% }) %>
              <div class="sep"></div>
              <div class="send-acts">
                <button class="btn btn-primary btn-sm" type="submit"><%- icon('message-circle', 'icon-sm') %><%= t('share.send_wa_short') %></button>
                <button class="btn btn-secondary btn-sm" type="submit" formaction="/app/share/email" formtarget="_self"<%= mailOk ? '' : ' disabled' %> title="<%= !mailOn ? t('share.err.SHARE_NO_MAIL') : !a.email ? t('share.no_email') : a.email %>"><%- icon('mail', 'icon-sm') %><%= t('share.send_email_short') %></button>
              </div>
              <% if (!mailOk) { %><p class="tiny muted send-note"><%= !mailOn ? t('share.err.SHARE_NO_MAIL') : t('share.no_email') %></p><% } %>
            </form>
          </details>
        <% } %>
        </span>
        <% } %>
      </div>
<% } %>
