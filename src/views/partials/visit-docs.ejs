<%/* A visit's papers next to its row (Today, My day): every prescription, lab / imaging request and referral, the invoice — then send them all on
   WhatsApp or by e-mail. Args: a (row with a.docs from withDocs, a.email), mailOn. */%>
<% if (a.docs && (a.docs.clinical || a.docs.billing) && a.status !== 'cancelled') { var D = a.docs; %>
      <div class="rec-sched-docs" role="group" aria-label="<%= a.patient_name %>">
        <% D.items.forEach(function (x) { var tip = t('share.icon.' + x.key) + (x.extra ? ': ' + x.extra : '') + (x.on ? '' : ' — ' + t('share.docs_none')); var pr = x.on && D.print && x.key !== 'invoice'; if (pr) tip = t('share.print') + ' — ' + tip; %>
          <% if (x.on) { %><a class="doc-ic is-on" href="<%= x.href %>"<%- pr ? ' target="_blank" rel="noopener"' : '' %> title="<%= tip %>" aria-label="<%= tip %>"><%- icon(x.ic, 'icon-sm') %></a><% } else { %><span class="doc-ic" title="<%= tip %>" aria-label="<%= tip %>" role="img"><%- icon(x.ic, 'icon-sm') %></span><% } %>
        <% }) %>
        <span class="doc-sep" aria-hidden="true"></span>
        <span class="doc-share">
        <% if (D.any || a.status === 'completed') { %>
          <a class="doc-ic is-wa" href="/app/share/wa?kind=visit&id=<%= a.id %>" target="_blank" rel="noopener" title="<%= t('share.send_visit') %>" aria-label="<%= t('share.send_visit') %>"><%- icon('message-circle', 'icon-sm') %></a>
          <% var mailTip = !mailOn ? t('share.err.SHARE_NO_MAIL') : !a.email ? t('share.no_email') : t('share.send_email'); %>
          <form method="post" action="/app/share/email" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="kind" value="visit"><input type="hidden" name="id" value="<%= a.id %>">
            <button class="doc-ic<%= mailOn && a.email ? ' is-on' : '' %>" type="submit" title="<%= mailTip %>" aria-label="<%= mailTip %>"<%= mailOn && a.email ? '' : ' disabled' %>><%- icon('mail', 'icon-sm') %></button></form>
        <% } %>
        </span>
      </div>
<% } %>
