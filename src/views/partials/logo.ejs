<% if (brand.logo) { %><img class="brand-logo logo-light" src="<%= brand.logo %>" alt="<%= brandName %>"><img class="brand-logo logo-dark" src="<%= brand.logoOnDark || brand.logo %>" alt="<%= brandName %>"><% if (brand.showName) { %><span class="brand-word"><%= brandName %></span><% } %><% } else { %><svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="var(--primary)"/><path d="M20 16h14c9.4 0 16 6.8 16 16s-6.6 16-16 16H20z" fill="none" stroke="var(--primary-ink)" stroke-width="5" stroke-linejoin="round"/><path d="M28 26h8M28 32h10M28 38h6" stroke="var(--primary-ink)" stroke-width="4" stroke-linecap="round"/></svg><span class="brand-word"><%= brandName %></span><% } %>
