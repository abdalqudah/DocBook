<% if (brand.logo) { %><img class="brand-logo logo-light" src="<%= brand.logo %>" alt="<%= brandName %>"><img class="brand-logo logo-dark" src="<%= brand.logoOnDark || brand.logo %>" alt="<%= brandName %>"><% if (brand.showName) { %><span class="brand-word"><%= brandName %></span><% } %><% } else { %><svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="var(--primary)"/><%- brand.markInner('var(--primary-ink)') %></svg><span class="brand-word"><%= brandName %></span><% } %>
