<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>" data-theme="light">
<head><%- include('../partials/head') %></head>
<body class="print-page">
<main class="print-sheet">
  <% var _pub = typeof publicShare !== 'undefined' && publicShare; %>
  <% if (_pub && typeof shareBase !== 'undefined' && shareBase) { %>
  <div class="print-actions share-actions no-print">
    <button class="btn btn-primary btn-sm" type="button" data-print><%- icon('printer', 'icon-sm') %><%= t('share.print') %></button>
    <a class="btn btn-secondary btn-sm" href="<%= shareBase %>/pdf?dl=1" download><%- icon('download', 'icon-sm') %><%= t('share.save_pdf') %></a>
    <button class="btn btn-secondary btn-sm" type="button" data-share-pdf="<%= shareBase %>/pdf" data-share-title="<%= typeof title !== 'undefined' ? title : '' %>" hidden><%- icon('send', 'icon-sm') %><%= t('share.share_pdf') %></button>
  </div>
  <% } else { %>
  <div class="print-actions no-print"><% if (!_pub) { %><a class="btn btn-ghost btn-sm" href="<%= fullPath.replace(/([?&])print=1&?/, '$1').replace(/[?&]$/, '') %>"><%- icon('arrow-left', 'icon-sm flip-rtl') %><%= t('common.back') %></a><% } %><button class="btn btn-primary btn-sm" type="button" data-print><%- icon('printer', 'icon-sm') %><%= t('reports.print_pdf') %></button></div>
  <% } %>
  <%
    // One letterhead for every paper, set in Settings → Invoice template: logo on/off and size, clinic name on/off,
    // address and phones on/off (the invoice paper draws its own from the same settings).
    var _tpl = (typeof invoiceTpl !== 'undefined' && invoiceTpl) || {};
    var _on = function (f) { return _tpl[f] !== false; };
    var _size = ['s', 'm', 'l', 'xl'].indexOf(_tpl.logo_size) >= 0 ? _tpl.logo_size : 'm';
    var _bname = locale === 'en' && business.name_en ? business.name_en : business.name;
    var _contact = _on('show_contact') ? [[business.address, business.city].filter(Boolean).join(locale === 'en' ? ', ' : '، '), business.phone ? '\u2066' + business.phone + '\u2069' : ''].filter(Boolean).join(' · ') : '';
  %>
  <header class="print-letterhead plh-<%= _size %>">
    <% if (_on('show_logo') && business.logo_mime) { %><img class="plh-logo" src="<%= typeof logoSrc !== 'undefined' && logoSrc ? logoSrc : '/app/logo/' + business.id + '?v=' + business.logo_version %>" alt="<%= _bname %>"><% } %>
    <div class="grow">
      <% if (_on('show_name')) { %><div class="plh-name"><%= _bname %></div><% } %>
      <% if (_contact) { %><div class="muted small"><%= _contact %></div><% } %>
      <% if (_on('show_tax') && business.tax_number) { %><div class="muted small"><%= t('settings.tax_number') %>: <bdi dir="ltr"><%= business.tax_number %></bdi></div><% } %>
    </div>
    <div class="text-end small muted"><%= fmt.date(new Date(), { dateStyle: 'long' }) %></div>
  </header>
  <%- body %>
  <footer class="print-footer muted tiny"><span><%= typeof publicShare !== 'undefined' && publicShare ? business.name : t('reports.generated_by', { name: brandName, user: currentUser ? currentUser.name : '' }) %></span><% if (!_pub && !/^\/app\/certificates/.test(path)) { %><span><%= business.currency %></span><% } %></footer>
</main>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<% (typeof pageScripts !== 'undefined' ? pageScripts : []).forEach(function (h) { %><script src="<%= h %>?v=<%= assetV %>" defer></script><% }) %>
</body>
</html>
