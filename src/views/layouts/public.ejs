<%
  var chrome = typeof siteChrome !== 'undefined' && siteChrome ? siteChrome : null;
  var Lx = typeof L === 'function' ? L : function (v) { return v && typeof v === 'object' ? (v[locale] || v.ar || v.en || '') : (v || ''); };
  var portalClinic = typeof clinic !== 'undefined' && clinic ? clinic : null;
  var seoTitle = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : ((typeof title !== 'undefined' && title ? title + ' · ' : '') + brandName);
  var seoDesc = typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (chrome && chrome.seo ? Lx(chrome.seo.description) : '');
  var head = typeof seoHead !== 'undefined' && seoHead ? seoHead : null;
  var embed = typeof embedMode !== 'undefined' && embedMode && portalClinic; // booking page inside the booking widget (no site header/footer)
  var header = chrome ? chrome.header : null;
  var footer = chrome ? chrome.footer : null;
%><!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= head ? head.title : seoTitle %></title>
<% if (head) { %><%- head.html %>
<% } else { %><% if (seoDesc) { %><meta name="description" content="<%= seoDesc %>"><meta property="og:description" content="<%= seoDesc %>"><% } %>
<meta property="og:title" content="<%= seoTitle %>">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% } %><meta name="color-scheme" content="light dark">
<% if (typeof faviconHref !== 'undefined' && faviconHref) { %><link rel="icon" href="<%= faviconHref %>"><% } else { %><link rel="icon" type="image/svg+xml" href="<%= brand.favicon || '/favicon.svg' %>"><% } %>
<link rel="stylesheet" href="/theme.css?v=<%= assetV %>">
<link rel="stylesheet" href="/css/app.css?v=<%= assetV %>">
<link rel="stylesheet" href="/css/site.css?v=<%= assetV %>">
<% (typeof pageStyles !== 'undefined' ? pageStyles : []).forEach(function (h) { if (h === '/css/site.css') return; %><link rel="stylesheet" href="<%= h %><%= h.indexOf('?') === -1 ? '?v=' + assetV : '' %>"><% }) %>
<% if (embed) { %><link rel="stylesheet" href="/css/discover.css?v=<%= assetV %>"><% } %>
<meta name="csrf-token" content="<%= csrfToken %>">
<% if (head && head.pixels) { %><meta name="db-pixels" content="<%= JSON.stringify({ ids: head.pixels }) %>"><% } %>
</head>
<body class="site<%= portalClinic ? ' site-portal' : '' %><%= embed ? ' site-embed' : '' %><%= typeof bodyClass !== 'undefined' && bodyClass ? ' ' + bodyClass : '' %>">
<a class="sr-only" href="#main"><%= t('site.skip') %></a>
<% var _ws = typeof wsSite !== 'undefined' && wsSite && portalClinic ? wsSite : null; %>
<% if (embed) { %><div class="embed-bar"><span class="strong truncate"><%= portalClinic.displayName %></span><a href="/" target="_blank" rel="noopener"><%= t('portal.powered', { brand: brandName }) %></a></div><% } else if (_ws) { %><%- include('../pages/portal/_ws-header') %><% } else { %>
<header class="site-nav">
  <div class="container inner">
    <% if (portalClinic) { %>
      <a class="portal-brand" href="/<%= portalClinic.slug %>">
        <span class="portal-mark"><% if (portalClinic.logo_mime) { %><img src="/<%= portalClinic.slug %>/logo?v=<%= portalClinic.logo_version %>" alt=""><% } else { %><%- icon('hospital', 'icon-sm') %><% } %></span>
        <span class="portal-brand-name"><%= portalClinic.displayName %></span>
      </a>
    <% } else { %>
      <a class="row-sm" href="/" aria-label="<%= brandName %>"><%- include('../partials/logo') %></a>
      <% if (header && header.items && header.items.length) { %>
      <nav class="site-links" aria-label="<%= t('site.nav_label') %>">
        <% header.items.forEach(function (n) { if (!Lx(n.label) || !n.href) return; %><a href="<%= n.href %>"><%= Lx(n.label) %></a><% }) %>
      </nav>
      <% } %>
    <% } %>
    <div class="right">
      <a class="btn btn-ghost btn-sm lang-btn" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>" lang="<%= locale === 'ar' ? 'en' : 'ar' %>"><%- icon('languages') %><span class="hide-xs"><%= locale === 'ar' ? 'English' : 'العربية' %></span></a>
      <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button>
      <% if (!portalClinic && path !== '/clinics' && path.indexOf('/clinics/') !== 0) { %><a class="btn btn-ghost btn-sm" href="/clinics" aria-label="<%= t('directory.find_clinic') %>"><%- icon('search', 'icon-sm') %><span class="hide-sm"><%= t('directory.find_clinic') %></span></a><% } %>
      <% if (portalClinic) { %>
        <% if (portalClinic.booking_enabled && !(typeof hideBookCta !== 'undefined' && hideBookCta)) { %><a class="btn btn-primary btn-sm" href="/<%= portalClinic.slug %>/book"><%- icon('calendar-plus', 'icon-sm') %><span><%= t('portal.book') %></span></a><% } %>
      <% } else if (currentUser) { %>
        <a class="btn btn-primary btn-sm" href="/app"><%= t('site.open_app') %><%- icon('arrow-right', 'icon-sm flip-rtl') %></a>
      <% } else { %>
        <% if (!header || header.show_login !== 'no') { %><a class="btn btn-ghost btn-sm hide-sm" href="/login"><%= header ? Lx(header.login_label) || t('site.sign_in') : t('site.sign_in') %></a><% } %>
        <a class="btn btn-primary btn-sm" href="<%= header && header.signup_href ? header.signup_href : '/signup' %>"><%= header ? Lx(header.signup_label) || t('site.start_free') : t('site.start_free') %></a>
      <% } %>
      <% if (!portalClinic && header && header.items && header.items.length) { %>
      <details class="site-menu">
        <summary class="btn btn-ghost btn-icon" aria-label="<%= t('site.menu') %>"><%- icon('menu') %></summary>
        <div class="site-menu-panel">
          <% header.items.forEach(function (n) { if (!Lx(n.label) || !n.href) return; %><a href="<%= n.href %>" data-menu-close><%= Lx(n.label) %></a><% }) %>
          <% if (!currentUser) { %><a href="/login"><%= header ? Lx(header.login_label) || t('site.sign_in') : t('site.sign_in') %></a><% } %>
        </div>
      </details>
      <% } %>
    </div>
  </div>
</header>
<% } %>
<main id="main"><%- include('../partials/toasts') %><%- body %></main>
<% if (embed) { %>
<% } else if (_ws) { %><%- include('../pages/portal/_ws-footer') %>
<% } else if (portalClinic) { %>
<footer class="footer portal-footer">
  <div class="container inner">
    <span>© <%= new Date().getFullYear() %> <%= portalClinic.displayName %></span>
    <a class="row-sm" href="/"><%= t('portal.powered', { brand: brandName }) %></a>
  </div>
</footer>
<% } else { %>
<footer class="site-footer">
  <div class="container">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <a class="row-sm" href="/" aria-label="<%= brandName %>"><%- include('../partials/logo') %></a>
        <% if (footer && Lx(footer.tagline)) { %><p><%= Lx(footer.tagline) %></p><% } %>
        <% var _social = typeof siteSocial !== 'undefined' && siteSocial ? siteSocial : []; if (_social.length) { %>
        <nav class="site-social" aria-label="<%= t('growth.social_nav') %>">
          <% _social.forEach(function (s) { %><a class="btn btn-ghost btn-icon" href="<%= s.href %>" rel="noopener me" target="_blank" aria-label="<%= t('growth.social_' + s.key) %>" title="<%= t('growth.social_' + s.key) %>"><%- icon(s.icon) %></a><% }) %>
        </nav>
        <% } %>
      </div>
      <% if (footer) { ['1', '2', '3'].forEach(function (c) { var links = (footer.items || []).filter(function (l) { return String(l.column || '1') === c && l.href && Lx(l.label); }); if (!links.length) return; %>
      <div class="site-footer-col">
        <% if (Lx(footer['col' + c + '_title'])) { %><h3><%= Lx(footer['col' + c + '_title']) %></h3><% } %>
        <ul><% links.forEach(function (l) { %><li><a href="<%= l.href %>"><%= Lx(l.label) %></a></li><% }) %></ul>
      </div>
      <% }); } %>
      <% if (footer && (footer.email || footer.phone || Lx(footer.address))) { %>
      <div class="site-footer-col">
        <ul class="site-contact">
          <% if (footer.email) { %><li><%- icon('mail', 'icon-sm') %><a href="mailto:<%= footer.email %>" dir="ltr"><%= footer.email %></a></li><% } %>
          <% if (footer.phone) { %><li><%- icon('phone', 'icon-sm') %><a href="tel:<%= footer.phone.replace(/[^0-9+]/g, '') %>" dir="ltr"><%= footer.phone %></a></li><% } %>
          <% if (Lx(footer.address)) { %><li><%- icon('map-pin', 'icon-sm') %><span><%= Lx(footer.address) %></span></li><% } %>
        </ul>
      </div>
      <% } %>
    </div>
    <div class="site-footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= footer && footer.copyright ? footer.copyright : brandName %>. <%= t('site.rights') %></span>
      <span class="row wrap site-footer-links">
        <a href="/clinics"><%= t('directory.find_clinic') %></a>
        <a href="/vendors"><%= t('vendors.footer_link') %></a>
        <a href="/preferences/cookies"><%= t('growth.cookie_prefs') %></a>
        <a href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>" lang="<%= locale === 'ar' ? 'en' : 'ar' %>"><%= locale === 'ar' ? 'English' : 'العربية' %></a>
      </span>
    </div>
  </div>
</footer>
<% } %>
<% if (head && head.askConsent && !(typeof noConsentBanner !== 'undefined' && noConsentBanner)) { %>
<div class="consent-note" role="region" aria-label="<%= t('growth.consent_label') %>" data-consent-note>
  <p><%= t('growth.consent_text') %> <a href="/preferences/cookies"><%= t('growth.consent_more') %></a></p>
  <div class="consent-actions">
    <form method="post" action="/preferences/cookies"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= path %>"><input type="hidden" name="choice" value="reject"><button class="btn btn-secondary btn-sm" type="submit"><%= t('growth.consent_reject') %></button></form>
    <form method="post" action="/preferences/cookies"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= path %>"><input type="hidden" name="choice" value="accept"><button class="btn btn-primary btn-sm" type="submit"><%= t('growth.consent_accept') %></button></form>
  </div>
</div>
<% } %>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<% if (head && head.pixels) { %><script src="/js/pixels.js?v=<%= assetV %>" defer></script><% } %>
<script src="/js/site.js?v=<%= assetV %>" defer></script>
<% if (embed) { %><script src="/js/embed-frame.js?v=<%= assetV %>" defer></script><% } %>
<% (typeof pageScripts !== 'undefined' ? pageScripts : []).forEach(function (h) { if (h === '/js/site.js') return; %><script src="<%= h %>?v=<%= assetV %>" defer></script><% }) %>
</body>
</html>
