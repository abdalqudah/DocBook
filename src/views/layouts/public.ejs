<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head><%- include('../partials/head') %></head>
<body class="site">
<header class="site-nav">
  <div class="container inner">
    <a class="row-sm" href="/" aria-label="<%= brandName %>"><%- include('../partials/logo') %></a>
    <nav class="site-links" aria-label="<%= t('site.nav_label') %>">
      <a href="/#modules"><%= t('site.nav_modules') %></a>
      <a href="/#payroll"><%= t('site.nav_payroll') %></a>
      <a href="/#ai"><%= t('site.nav_ai') %></a>
      <a href="/#security"><%= t('site.nav_security') %></a>
      <a href="/#faq"><%= t('site.nav_faq') %></a>
    </nav>
    <div class="right">
      <a class="btn btn-ghost btn-sm" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>"><%- icon('languages') %><span class="hide-sm"><%= locale === 'ar' ? 'English' : 'العربية' %></span></a>
      <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button>
      <% if (currentUser) { %><a class="btn btn-primary btn-sm" href="/app"><%= t('site.open_app') %></a><% } else { %>
      <a class="btn btn-ghost btn-sm hide-sm" href="/login"><%= t('auth.login') %></a>
      <a class="btn btn-primary btn-sm" href="/signup"><%= t('site.cta_start') %></a><% } %>
    </div>
  </div>
</header>
<main id="main"><%- include('../partials/toasts') %><%- body %></main>
<footer class="footer">
  <div class="container inner">
    <div class="row-sm"><%- include('../partials/logo') %></div>
    <div class="row wrap small"><span>© <%= new Date().getFullYear() %> <%= brandName %></span><span><%= tagline %></span><% if (brand.supportEmail) { %><a href="mailto:<%= brand.supportEmail %>"><%= brand.supportEmail %></a><% } %></div>
  </div>
</footer>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<% (typeof pageScripts !== 'undefined' ? pageScripts : []).forEach(function (h) { %><script src="<%= h %>?v=<%= assetV %>" defer></script><% }) %>
</body>
</html>
