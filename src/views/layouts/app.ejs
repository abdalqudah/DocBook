<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head><%- include('../partials/head') %></head>
<body>
<div class="loading-bar" aria-hidden="true"></div>
<a class="sr-only" href="#main"><%= t('common.skip_to_content') %></a>
<div class="shell<%= typeof sidebarMini !== 'undefined' && sidebarMini ? ' sb-mini' : '' %>" data-shell>
  <aside class="sidebar" id="sidebar"><%- include('../partials/sidebar') %></aside>
  <div class="sidebar-backdrop" data-nav-close></div>
  <div class="main">
    <%- include('../partials/topbar') %>
    <% if (typeof verifyBanner !== 'undefined' && verifyBanner) { %><div class="banner info"><%- icon('mail') %><span><%= t('verify.banner', { email: currentUser.email }) %></span><form method="post" action="/verify-email/resend"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" type="submit"><%= t('verify.resend') %></button></form></div><% } %>
    <%- include('../pages/subscriptions/_banner') %>
    <main class="content" id="main">
      <%- include('../partials/section-tabs') %>
      <%- include('../partials/act-bar') %>
      <% if (typeof maintenanceOn !== 'undefined' && maintenanceOn) { %><div class="alert alert-warning mb-4" role="status"><%- icon('wrench', 'icon-sm') %><div class="grow"><%= t('maintenance.bar') %></div><a class="btn btn-secondary btn-sm" href="/admin/maintenance"><%= t('maintenance.bar_link') %></a></div><% } %>
      <%- body %>
    </main>
  </div>
</div>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/toasts') %>
<%- include('../partials/cmdk') %>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<script src="/js/live.js?v=<%= assetV %>" defer></script>
<script src="/js/teamops.js?v=<%= assetV %>" defer></script>
<script src="/js/nav.js?v=<%= assetV %>" defer></script>
<% (typeof pageScripts !== 'undefined' ? pageScripts : []).forEach(function (h) { %><script src="<%= h %>?v=<%= assetV %>" defer></script><% }) %>
<% if (typeof csrfToken !== 'undefined' && csrfToken) { %><form id="share-mail-form" method="post" action="/app/share/email" hidden><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %>
</body>
</html>
