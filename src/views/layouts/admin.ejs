<%
  var _p = typeof adminPath !== 'undefined' ? adminPath.replace(/\/$/, '') : '';
  var _nav = [['/admin', 'layout-dashboard', 'nav_overview', true], ['/admin/clinics', 'hospital', 'nav_clinics'], ['/admin/users', 'users', 'nav_users'], ['/admin/site', 'layout-template', 'nav_site'], ['/admin/seo', 'search', 'nav_seo'], ['/admin/growth', 'megaphone', 'nav_growth']];
  _nav.push(['/admin/domains', 'globe', 'identity.nav_domains'], ['/admin/country-pages', 'map-pin', 'cpages.nav', false, 'website'], ['/admin/help', 'life-buoy', 'helpc.admin_title', false, 'website']); // clinics' own domains; a page per country
  _nav.push(['/admin/vendors', 'briefcase-business', 'vendors.admin.nav']); // reps & warehouses
  _nav.push(['/admin/hub-links', 'link', 'hub.admin_nav', false, 'market']); // linked installations
  _nav.push(['/admin/vendor-billing', 'credit-card', 'vbill.admin.nav', false, 'market']); // reps' plans, trial, invoices and ads
  _nav.push(['/admin/reviews', 'star', 'reviews.admin.nav']); // patient reviews moderation
  _nav.push(['/admin/articles', 'notebook-pen', 'articles.admin.nav']); // doctors' articles for the main site
  _nav.push(['/admin/plans', 'wallet', 'subscriptions_admin.nav']);
  _nav.push(['/admin/crm', 'handshake', 'crm.nav', false, 'sales'], ['/admin/crm/finder', 'map-pin', 'crm.finder', false, 'sales'], ['/admin/activity', 'activity', 'pcomms.activity_nav', false, 'overview']); // CRM, who is active and from where
  _nav.push(['/admin/settings', 'settings', 'navx.admin_settings', false, 'platform']); // every platform setting, one place (below)
  _nav.push(['/admin/sales-dashboard', 'chart-no-axes-column', 'dash.nav', false, 'sales'], ['/admin/quotes', 'file-text', 'sales.nav_quotes', false, 'sales'], ['/admin/sales-invoices', 'receipt', 'sales.nav_invoices', false, 'sales'], ['/admin/sales-services', 'list', 'sales.nav_services', false, 'sales'], ['/admin/templates', 'file-text', 'tpl.nav', false, 'sales'], ['/admin/documents', 'copy', 'tpl.nav_docs', false, 'sales'], ['/admin/email-log', 'mail', 'sales.nav_email_log', false, 'sales']);
  var _under = function (base) { return _p === base || _p.indexOf(base + '/') === 0; };
  // Platform settings: one "Settings" entry in the sidebar; inside, a menu of every settings page.
  var _settings = [
    ['general', [['/admin/settings', 'mail', 'pcomms.nav_comms'], ['/admin/branding', 'image', 'branding_admin.nav'], ['/admin/login-page', 'log-in', 'loginpage.nav'], ['/admin/maintenance', 'wrench', 'maintenance.nav']]],
    ['money', [['/admin/payments', 'credit-card', 'ppay.admin.nav'], ['/admin/sales-profile', 'building-2', 'sales.nav_profile'], ['/admin/clinic-types', 'stethoscope', 'clinic_types.nav']]],
    ['integrations', [['/admin/google', 'key-round', 'identity.nav_google'], ['/admin/ai', 'sparkles', 'ai_admin.nav']]],
    ['system', [['/admin/security', 'shield-check', 'tfa.nav'], ['/admin/updates', 'cloud-upload', 'platformops.admin_nav'], ['/admin/databases', 'database', 'dbsep.nav'], ['/admin/images', 'minimize', 'imgopt.nav']]],
  ];
  var _inSettings = _settings.some(function (g) { return g[1].some(function (n) { return _p === n[0] || _p.indexOf(n[0] + '/') === 0; }); });
  var _active = function (n) { return n[3] ? (_p === '/admin' || _p === '') : n[0] === '/admin/settings' ? _inSettings : n[0] === '/admin/crm' && _under('/admin/crm/finder') ? false : (_under(n[0]) || (n[0] === '/admin/plans' && _under('/admin/subscriptions'))); };
  // Sidebar groups: an entry may name its group in a 5th field (n[4]); otherwise it is looked up by href; unknown → platform.
  var _groupOf = { '/admin': 'overview', '/admin/clinics': 'clinics', '/admin/plans': 'clinics', '/admin/users': 'clinics',
    '/admin/site': 'website', '/admin/seo': 'website', '/admin/growth': 'website', '/admin/domains': 'website', '/admin/google': 'website',
    '/admin/vendors': 'market', '/admin/reviews': 'market', '/admin/articles': 'website', '/admin/ai': 'platform', '/admin/updates': 'platform' };
  var _groups = ['overview', 'sales', 'clinics', 'website', 'market', 'platform'].map(function (g) {
    return { key: g, items: _nav.filter(function (n) { return (n[4] || _groupOf[n[0]] || 'platform') === g; }) };
  }).filter(function (g) { return g.items.length; });
  var _label = function (n) { return t(n[2].indexOf('.') > 0 ? n[2] : 'admin.' + n[2]); };
%><!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= t('admin.title') %> · <%= brandName %></title>
<meta name="color-scheme" content="light dark">
<link rel="icon" href="<%= brand.favicon || '/favicon.svg' %>">
<link rel="stylesheet" href="/theme.css?v=<%= assetV %>">
<link rel="stylesheet" href="/css/app.css?v=<%= assetV %>">
<% (typeof pageStyles !== 'undefined' ? pageStyles : []).forEach(function (h) { %><link rel="stylesheet" href="<%= h %>?v=<%= assetV %>"><% }) %>
<meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body class="admin-body">
<a class="sr-only" href="#main"><%= t('common.skip_to_content') %></a>
<div class="shell admin-shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand admin-brand">
      <a class="row-sm" href="/admin" aria-label="<%= brandName %>"><%- include('../partials/logo') %></a>
      <span class="badge badge-neutral admin-badge"><%- icon('shield-check', 'icon-sm') %><%= t('admin.title') %></span>
    </div>
    <nav class="nav" aria-label="<%= t('navx.admin_nav') %>">
      <% _groups.forEach(function (g) { %>
      <div class="nav-group">
        <% if (g.key !== 'overview') { %><div class="nav-title"><%= t('navx.admin_grp_' + g.key) %></div><% } %>
        <% g.items.forEach(function (n) { var on = _active(n); %><a href="<%= n[0] %>" class="<%= on ? 'active' : '' %>"<% if (on) { %> aria-current="page"<% } %>><%- icon(n[1]) %><span class="truncate"><%= _label(n) %></span></a><% }) %>
      </div>
      <% }) %>
    </nav>
    <div class="sidebar-foot">
      <a href="/app"><%- icon('layout-dashboard', 'icon-sm') %><span class="truncate"><%= t('admin.back_to_app') %></span></a>
    </div>
  </aside>
  <div class="sidebar-backdrop" data-nav-close></div>
  <div class="main">
    <header class="topbar admin-topbar">
      <button class="btn btn-ghost btn-icon mobile-only" type="button" data-nav-toggle aria-controls="sidebar" aria-label="<%= t('nav.menu') %>"><%- icon('menu') %></button>
      <div class="topbar-actions">
        <a class="btn btn-ghost btn-sm hide-sm-admin" href="/" target="_blank" rel="noopener"><%- icon('external-link', 'icon-sm') %><%= t('admin.view_site') %></a>
        <a class="btn btn-ghost btn-sm" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>" lang="<%= locale === 'ar' ? 'en' : 'ar' %>"><%- icon('languages', 'icon-sm') %><span class="hide-sm-admin"><%= locale === 'ar' ? 'English' : 'العربية' %></span></a>
<a class="btn btn-ghost btn-icon bell" href="/admin/notifications" aria-label="<%= t('pnotify.title') %><%= typeof pnUnread !== 'undefined' && pnUnread ? ' (' + pnUnread + ')' : '' %>" title="<%= t('pnotify.title') %>"><%- icon('bell') %><% if (typeof pnUnread !== 'undefined' && pnUnread) { %><span class="bell-count"><%= pnUnread > 9 ? '9+' : pnUnread %></span><% } %></a>
        <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button>
        <details class="dropdown">
          <summary class="user-chip" aria-label="<%= currentUser.name %>"><span class="avatar"><%= initials(currentUser.name) %></span></summary>
          <div class="menu">
            <div class="menu-label"><%= currentUser.email %></div>
            <a href="/app"><%- icon('layout-dashboard', 'icon-sm') %><%= t('admin.back_to_app') %></a>
            <div class="sep"></div>
            <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%- icon('log-out', 'icon-sm') %><%= t('admin.sign_out') %></button></form>
          </div>
        </details>
      </div>
    </header>
    <main class="content admin-content" id="main">
      <% if (typeof maintenanceOn !== 'undefined' && maintenanceOn) { %><div class="alert alert-warning mb-4" role="status"><%- icon('wrench', 'icon-sm') %><div class="grow"><%= t('maintenance.bar') %></div><a class="btn btn-secondary btn-sm" href="<%= edition.single ? '/app/settings/maintenance' : '/admin/maintenance' %>"><%= t('maintenance.bar_link') %></a></div><% } %>

      <% if (_inSettings) { %><div class="settings-layout" data-admin-settings>
        <nav class="settings-nav" aria-label="<%= t('navx.admin_settings') %>"><% _settings.forEach(function (g) { %><div class="group"><%= t('navx.set_grp_' + g[0]) %></div><% g[1].forEach(function (n) { var on = n[0] === '/admin/settings' ? (_p === n[0] || _p.indexOf('/admin/settings/') === 0) : _under(n[0]); %><a href="<%= n[0] %>" class="<%= on ? 'active' : '' %>"<% if (on) { %> aria-current="page"<% } %>><%- icon(n[1], 'icon-sm') %><span class="truncate"><%= t(n[2]) %></span></a><% }) %><% }) %></nav>
        <div><%- body %></div>
      </div><% } else { %><%- body %><% } %>
    </main>
  </div>
</div>
<%- include('../partials/toasts') %>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<% (typeof pageScripts !== 'undefined' ? pageScripts : []).forEach(function (h) { %><script src="<%= h %>?v=<%= assetV %>" defer></script><% }) %>
</body>
</html>
