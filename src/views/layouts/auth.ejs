<% var _light = typeof authClinic !== 'undefined' && authClinic && authClinic.light; /* the clinic turned dark mode off (Website → Theme & brand) */ %>
<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (_light) { %> data-theme="light"<% } else if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head><%- include('../partials/head') %></head>
<body>
<%
  var _lp = typeof loginPage !== 'undefined' && loginPage ? loginPage : { style: 'dark', show_points: true, text: function (k, f) { return t(f); } };
  var _ac = typeof authClinic !== 'undefined' && authClinic ? authClinic : null;
  var _acName = _ac ? (locale === 'en' && _ac.name_en ? _ac.name_en : _ac.name) : brandName;
  var _nameMode = _lp.name_mode || 'beside'; // beside | below | hidden (Settings → Sign-in page)
  // The clinic's logo with its name beside it, under it, or alone; on the dark / colour panel the logo for dark backgrounds.
  var _brand = function (side) {
    if (!_ac) return '<a class="row-sm' + (side ? '' : ' auth-mobile-logo') + '" href="/" aria-label="' + escapeHtml(brandName) + '">' + include('../partials/logo') + '</a>';
    var img = '';
    if (side && _ac.logoDark && _lp.style !== 'light') img = '<img class="auth-clinic-logo" src="' + escapeHtml(_ac.logoDark) + '" alt="' + escapeHtml(_acName) + '">';
    else if (_ac.logo) {
      img = '<img class="auth-clinic-logo' + (!side && _ac.logoDark && !_light ? ' logo-light' : '') + '" src="/' + escapeHtml(_ac.slug) + '/logo?v=' + escapeHtml(String(_ac.logoVersion || '')) + '" alt="' + escapeHtml(_acName) + '">';
      if (!side && _ac.logoDark && !_light) img += '<img class="auth-clinic-logo logo-dark" src="' + escapeHtml(_ac.logoDark) + '" alt="">';
    } else img = '<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="var(--primary)"/>' + brand.markInner('var(--primary-ink)') + '</svg>';
    var hasLogo = side ? Boolean((_ac.logoDark && _lp.style !== 'light') || _ac.logo) : Boolean(_ac.logo);
    var name = hasLogo && _nameMode === 'hidden' ? '' : '<span class="brand-word">' + escapeHtml(_acName) + '</span>';
    return '<a class="auth-brand is-' + (hasLogo ? _nameMode : 'beside') + (side ? '' : ' auth-mobile-logo') + '" href="/" aria-label="' + escapeHtml(_acName) + '">' + img + name + '</a>';
  };
%>
<div class="auth">
  <div class="auth-side is-<%= _lp.style %>">
    <%- _brand(true) %>
    <div>
      <h2><%= _lp.text('side_title', 'auth.side_title') %></h2>
      <p><%= _lp.text('side_text', 'auth.side_text') %></p>
      <% if (_lp.show_points) { %>
      <ul class="auth-points">
        <li><%- icon('circle-check') %><%= _lp.text('point_1', 'auth.side_point_1') %></li>
        <li><%- icon('circle-check') %><%= _lp.text('point_2', 'auth.side_point_2') %></li>
        <li><%- icon('circle-check') %><%= _lp.text('point_3', 'auth.side_point_3') %></li>
      </ul>
      <% } %>
    </div>
    <div class="small" style="opacity:.7">© <%= new Date().getFullYear() %> <%= _acName %></div>
  </div>
  <div class="auth-main">
    <div class="auth-top">
      <a class="btn btn-ghost btn-sm" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>"><%- icon('languages') %><%= locale === 'ar' ? 'English' : 'العربية' %></a>
      <% if (!_light) { %><button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button><% } %>
    </div>
    <div class="auth-card<%= typeof wide !== 'undefined' && wide ? ' wide' : '' %>">
      <%- _brand(false) %>
      <%- include('../partials/toasts') %>
      <%- body %>
    </div>
  </div>
</div>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<% (typeof pageScripts !== 'undefined' ? pageScripts : []).forEach(function (h) { %><script src="<%= h %>?v=<%= assetV %>" defer></script><% }) %>
</body>
</html>
