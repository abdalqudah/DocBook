{
  "name": "docbook",
  "version": "2.9.16",
  "description": "DocBook — clinic booking & management: appointments, online booking and consultations, front desk, patient records, billing, payroll, supplies and staff logins",
  "main": "app.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node app.js",
    "dev": "NODE_ENV=development AUTO_MIGRATE=true node app.js",
    "migrate": "node scripts/migrate.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "brand:check": "node scripts/brand-check.js",
    "build": "node scripts/build-dist.js",
    "build:editions": "node scripts/build-dist.js && node scripts/build-editions.js",
    "build:specialties": "node scripts/build-dist.js && SPECIALTIES=1 node scripts/build-editions.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.2",
    "bidi-js": "^1.1.0",
    "compression": "^1.8.1",
    "connect-session-knex": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "imapflow": "^2.2.1",
    "knex": "^3.1.0",
    "mailparser": "^3.9.33",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^4.10.38"
  }
}
