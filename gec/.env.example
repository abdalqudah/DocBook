# GEC platform — copy to .env and fill in.
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
# Long random strings. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Encrypts stored credentials (SMTP, WhatsApp, SMS, AI keys). Set once; changing it makes saved credentials unreadable.
APP_KEY=
AUTO_MIGRATE=true
TRUST_PROXY=true
DEFAULT_LOCALE=en

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gec
DB_USER=gec
DB_PASSWORD=
# DB_SOCKET=/var/lib/mysql/mysql.sock
# DB_NAME_TEST=gec_test

# First administrator, created at start-up if missing (an existing account is never changed).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional: e-mail fallback when Settings → Email is not configured.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=GEC <no-reply@your-domain.com>

# Where uploaded files are stored (outside the web root). Default: ./storage
# STORAGE_DIR=
