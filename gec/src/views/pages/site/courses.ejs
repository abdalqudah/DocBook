<section class="section">
  <div class="container">
    <div class="section-head"><span class="eyebrow"><%- icon('book-marked') %><%= t('courses.eyebrow') %></span><h1><%= t('courses.title') %></h1><p><%= t('courses.lead') %></p></div>
    <% if (!rows.length) { %><div class="card"><%- include('../../partials/empty', { title: t('courses.none'), text: t('courses.none_text'), emptyIcon: 'book-marked' }) %></div><% } else { %>
    <div class="grid-3">
      <% rows.forEach(function (c, i) { %>
      <a class="card stack" href="/courses/<%= c.slug %>" style="text-decoration:none;color:inherit">
        <span class="list-cover" style="<%= cover(c.image, ['campus','uk','hero'][i % 3]) %>"></span>
        <div class="spread"><h2 class="mb0" style="font-size:1.1rem"><%= L(c, 'name') %></h2><% if (c.is_demo) { %><span class="chip demo" title="<%= t('common.demo_hint') %>"><%= t('common.demo') %></span><% } %></div>
        <div class="cluster small muted"><span><%- icon('calendar', 'sm') %> <%= c.start_date ? fmt.date(c.start_date) : t('courses.rolling') %></span><span><%- icon(c.mode === 'online' ? 'video' : 'map-pin', 'sm') %> <%= t('courses.mode_' + c.mode) %></span></div>
        <div class="spread"><strong><%= c.price ? fmt.money(c.price, c.currency) : t('booking.free') %></strong><span class="chip <%= c.registration_open ? 'ok' : '' %>"><%= c.registration_open ? t('courses.open') : t('courses.closed') %></span></div>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
