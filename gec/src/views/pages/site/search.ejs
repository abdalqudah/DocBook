<section class="section tight">
  <div class="container" style="max-width:960px">
    <form action="/search" method="get" role="search" class="hero-search" style="max-width:none">
      <div class="searchbox"><%- icon('search', 'lg') %><label class="sr-only" for="sq"><%= t('site.search') %></label><input id="sq" type="search" name="q" value="<%= q %>" placeholder="<%= t('search.placeholder') %>" data-suggest autofocus><button class="btn primary" type="submit"><%= t('common.search') %></button></div>
    </form>
    <% if (q.length >= 2) { var total = (results.programsTotal || 0) + results.universities.length + results.scholarships.length + results.destinations.length; %>
      <p class="muted mt4"><%= t('search.results_for', { n: total, q: q }) %></p>
      <% if (!total) { %><div class="card mt4"><%- include('../../partials/empty', { title: t('search.none'), text: t('search.none_text'), href: '/book?about=' + encodeURIComponent(q), cta: t('finder.ask_counsellor'), ctaIcon: 'message-circle', emptyIcon: 'search' }) %></div><% } %>
      <% if (results.destinations.length) { %><div class="cluster mt4"><% results.destinations.forEach(function (d) { %><a class="filter-chip" href="/study/<%= d.slug %>"><%- flagImg(d.country_code) %> <%= t('dest.study_in', { name: L(d, 'name') }) %></a><% }) %></div><% } %>
      <% if (results.programs.length) { %><div class="spread mt6 mb4"><h2 class="mb0"><%= t('nav.programs') %> <span class="subtle">(<%= results.programsTotal %>)</span></h2><a class="btn ghost" href="/programs?q=<%= encodeURIComponent(q) %>"><%= t('search.all_programs') %><%- icon('arrow-right', 'flip-rtl') %></a></div><div class="grid" style="--min:300px"><% results.programs.slice(0, 6).forEach(function (p) { %><%- include('../../partials/program-card', { p: p }) %><% }) %></div><% } %>
      <% if (results.universities.length) { %><h2 class="mt6"><%= t('nav.universities') %></h2><div class="card pad-0"><div class="divider-list" style="padding:0 16px"><% results.universities.forEach(function (u) { %><a class="list-item" href="/universities/<%= u.slug %>"><span class="pcard-logo"><% if (u.logo) { %><img src="<%= u.logo %>" alt=""><% } else { %><%= L(u, 'name').charAt(0) %><% } %></span><div class="li-body"><div class="li-title"><%= L(u, 'name') %></div><div class="li-sub"><%= L(u, 'city') %></div></div><%- icon('chevron-right', 'flip-rtl subtle') %></a><% }) %></div></div><% } %>
      <% if (results.scholarships.length) { %><h2 class="mt6"><%= t('nav.scholarships') %></h2><div class="grid" style="--min:280px"><% results.scholarships.forEach(function (s) { %><%- include('../../partials/scholarship-card', { s: s }) %><% }) %></div><% } %>
    <% } else { %>
      <p class="muted mt4"><%= t('search.hint') %></p>
    <% } %>
  </div>
</section>
<%- include('../../partials/compare-bar') %>
