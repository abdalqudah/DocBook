<% if (dests.length) { %>
<section class="section">
  <div class="container">
    <div class="section-top">
      <div class="section-head mb0"><span class="eyebrow"><%- icon('globe', 'sm') %><%= t('home.dest_eyebrow') %></span><h2><%= T('title', 'home.dest_title') %></h2><p><%= T('lead', 'home.dest_lead') %></p></div>
      <a class="btn ghost" href="/study"><%= t('common.see_all') %><%- icon('arrow-right', 'flip-rtl') %></a>
    </div>
    <div class="dest-bento">
      <% dests.slice(0, 5).forEach(function (d, i) { %>
      <a class="dest-tile <%= i === 0 ? 'big' : '' %>" href="/study/<%= d.slug %>">
        <span class="tile-bg" style="<%= cover(d.hero_image, coverKey(d.slug)) %>"></span>
        <span class="tile-shade"></span>
        <span class="tile-body">
          <span class="tile-flag" aria-hidden="true"><%- flagImg(d.country_code) %></span>
          <span class="tile-title"><%= L(d, 'name') %></span>
          <span class="tile-text"><%= L(d, 'tagline') %></span>
          <span class="tile-go"><%= t('home.explore') %><%- icon('arrow-right', 'flip-rtl') %></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
