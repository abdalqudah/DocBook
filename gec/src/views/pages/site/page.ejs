<% var blks = typeof pageBlocks !== 'undefined' ? pageBlocks : []; var heroFirst = blks.length && blks[0].type === 'hero'; %>
<% if (typeof preview !== 'undefined' && preview) { %><div class="preview-bar" role="status"><%= t('blocks.preview_bar') %><%= p.is_published ? '' : ' · ' + t('blocks.not_published') %></div><% } %>
<% if (heroFirst) { %><%- include('../../partials/blocks', { blocks: blks.slice(0, 1) }) %><% } %>
<% if (!heroFirst || L(p, 'body')) { %>
<section class="section <%= blks.length ? 'tight' : '' %>">
  <div class="container" style="max-width:860px">
    <% if (!heroFirst) { %><div class="section-head"><h1><%= L(p, 'title') %></h1><% if (L(p, 'lead')) { %><p><%= L(p, 'lead') %></p><% } %></div>
    <% if (p.hero_image) { %><div class="article-hero" style="<%= cover(p.hero_image, 'campus') %>"></div><% } %><% } %>
    <% if (L(p, 'body')) { %><div class="prose"><%- md(L(p, 'body')) %></div><% } %>
  </div>
</section>
<% } %>
<% var rest = heroFirst ? blks.slice(1) : blks; if (rest.length) { %><%- include('../../partials/blocks', { blocks: rest, topLevel: !heroFirst }) %><% } %>
<% if (faqs.length || p.show_cta) { %>
<section class="section tight">
  <div class="container" style="max-width:860px">
    <% if (faqs.length) { %><h2><%= t('cms.faq_title') %></h2><div class="faq"><% faqs.forEach(function (f) { %><details class="card"><summary><strong><%= L(f, 'question') %></strong></summary><div class="prose mt2"><%- md(L(f, 'answer')) %></div></details><% }) %></div><% } %>
    <% if (p.show_cta) { %><div class="cta-band mt8"><div><h2><%= t('home.cta_title') %></h2><p><%= t('home.cta_text') %></p></div><a class="btn primary lg" href="/book?about=<%= encodeURIComponent(L(p, 'title')) %>"><%= t('site.book_consultation') %></a></div><% } %>
  </div>
</section>
<% } %>
