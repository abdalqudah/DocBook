<section class="section tight">
  <div class="container">
    <div class="section-head"><h1><%= t('unis.title') %></h1><p><%= t('unis.lead') %></p></div>
    <form class="toolbar" method="get" action="/universities">
      <div class="search-inline"><%- icon('search') %><input type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('unis.search_ph') %>" aria-label="<%= t('common.search') %>"></div>
      <select name="destination" data-autosubmit aria-label="<%= t('finder.destination') %>"><option value=""><%= t('leads.any_destination') %></option><% dests.forEach(function (d) { %><option value="<%= d.slug %>" <%= query.destination === d.slug ? 'selected' : '' %>><%= L(d, 'name') %></option><% }) %></select>
      <select name="type" data-autosubmit aria-label="<%= t('unis.type') %>"><option value=""><%= t('unis.any_type') %></option><% ['public','private','community_college','pathway','language_school'].forEach(function (x) { %><option value="<%= x %>" <%= query.type === x ? 'selected' : '' %>><%= t('catalog.type.' + x) %></option><% }) %></select>
      <button class="btn" type="submit"><%= t('common.search') %></button>
    </form>
    <% if (!rows.length) { %><div class="card"><%- include('../../partials/empty', { title: t('unis.none'), text: t('finder.none_text'), emptyIcon: 'building-2' }) %></div><% } else { %>
    <div class="grid" style="--min:300px">
      <% rows.forEach(function (u) { %>
      <article class="pcard has-cover"><a class="pcard-cover" href="/universities/<%= u.slug %>" tabindex="-1" aria-hidden="true" style="<%= cover(u.cover_image, coverKey(u.country_code)) %>"></a>
        <div class="pcard-top">
          <span class="pcard-logo"><%= L(u, 'name').charAt(0) %><% if (u.logo) { %><span class="logo-layer" style="background-image:url('<%= String(u.logo).replace(/["'()\s]/g, encodeURIComponent) %>')"></span><% } %></span>
          <div class="grow" style="min-width:0"><h3><a href="/universities/<%= u.slug %>"><%= L(u, 'name') %></a></h3><div class="pcard-sub"><%= ref.flag(u.country_code || u.dest_country) %> <%= [L(u, 'city'), L(u, 'destination')].filter(Boolean).join(', ') %></div></div>
          <% if (u.is_demo) { %><span class="chip demo"><%= t('common.demo') %></span><% } %>
        </div>
        <dl class="facts">
          <div><dt><%= t('unis.ranking') %></dt><dd><%= u.ranking_world ? '#' + u.ranking_world : (u.ranking_national ? '#' + u.ranking_national + ' ' + t('unis.national') : '—') %></dd></div>
          <div><dt><%= t('nav.programs') %></dt><dd><%= u.program_count %></dd></div>
          <div><dt><%= t('finder.tuition') %></dt><dd><%= u.tuition_min ? fmt.money(u.tuition_min, u.currency) + (u.tuition_max ? '–' + fmt.number(u.tuition_max) : '') : '—' %></dd></div>
          <div><dt><%= t('unis.type') %></dt><dd><%= u.institution_type ? t('catalog.type.' + u.institution_type) : '—' %></dd></div>
        </dl>
        <div class="pcard-foot"><a class="btn sm primary" href="/universities/<%= u.slug %>"><%= t('unis.view') %></a><span class="grow"></span><%- include('../../partials/save-toggle', { type: 'university', id: u.id }) %></div>
      </article>
      <% }) %>
    </div>
    <%- include('../../partials/pager', { meta: meta }) %>
    <% } %>
  </div>
</section>
