<%
  var hc = typeof homeCms !== 'undefined' ? homeCms : { hero: {}, services: [], testimonials: [], articles: [], slides: [], events: [] };
  var hv = function (k, fb) { return hc.hero[k + '_' + locale] || t(fb); };
  var destBy = function (slug) { return dests.find(function (d) { return d.slug === slug; }) || {}; };
  // Slides from Website → Home slider; until there are any, four built-in ones.
  var slides = (hc.slides && hc.slides.length) ? hc.slides.map(function (s) { return { eyebrow: L(s, 'eyebrow'), title: L(s, 'title'), text: L(s, 'text'), image: s.image, cover: s.cover, cta: L(s, 'cta_label') && s.cta_href ? { label: L(s, 'cta_label'), href: s.cta_href } : null, cta2: L(s, 'cta2_label') && s.cta2_href ? { label: L(s, 'cta2_label'), href: s.cta2_href } : null }; }) : [
    { eyebrow: t('home.s1_eyebrow'), title: hv('hero_title', 'home.s1_title'), text: hv('hero_lead', 'home.s1_text'), image: destBy('uk').hero_image, cover: 'uk', cta: { label: t('home.s1_cta'), href: '/programs' }, cta2: { label: t('site.book_consultation'), href: '/book' } },
    { eyebrow: t('home.s2_eyebrow'), title: t('home.s2_title'), text: t('home.s2_text'), image: null, cover: 'scholarship', cta: { label: t('home.s2_cta'), href: '/scholarships' }, cta2: { label: t('site.nav.calculator'), href: '/cost-calculator' } },
    { eyebrow: t('home.s3_eyebrow'), title: t('home.s3_title'), text: t('home.s3_text'), image: destBy('usa').hero_image, cover: 'usa', cta: { label: t('home.s3_cta'), href: '/study/usa' }, cta2: { label: t('site.book_consultation'), href: '/book' } },
    { eyebrow: t('home.s4_eyebrow'), title: t('home.s4_title'), text: t('home.s4_text'), image: null, cover: 'campus', cta: { label: t('home.s4_cta'), href: '/register' }, cta2: { label: t('site.nav.advisor'), href: '/advisor' } },
  ];
%>
<section class="hero-slider" data-slider aria-roledescription="carousel" aria-label="<%= t('home.slider_label') %>">
  <div class="slides">
    <% slides.forEach(function (s, i) { %>
    <article class="slide <%= i === 0 ? 'is-active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= (i + 1) + ' / ' + slides.length %>" <%- i === 0 ? '' : 'aria-hidden="true"' %> data-slide>
      <div class="slide-bg" style="<%= cover(s.image, s.cover) %>"></div>
      <div class="slide-shade"></div>
      <div class="container slide-inner">
        <div class="slide-copy">
          <% if (s.eyebrow) { %><span class="slide-eyebrow"><%- icon('sparkles', 'sm') %><%= s.eyebrow %></span><% } %>
          <% if (i === 0) { %><h1><%= s.title %></h1><% } else { %><h2 class="h1"><%= s.title %></h2><% } %>
          <% if (s.text) { %><p><%= s.text %></p><% } %>
          <div class="slide-ctas">
            <% if (s.cta) { %><a class="btn gold lg" href="<%= s.cta.href %>" <%- i === 0 ? '' : 'tabindex="-1"' %>><%= s.cta.label %><%- icon('arrow-right', 'flip-rtl') %></a><% } %>
            <% if (s.cta2) { %><a class="btn glass lg" href="<%= s.cta2.href %>" <%- i === 0 ? '' : 'tabindex="-1"' %>><%= s.cta2.label %></a><% } %>
          </div>
        </div>
      </div>
    </article>
    <% }) %>
  </div>
  <% if (slides.length > 1) { %>
  <div class="container slider-ui">
    <div class="slider-dots">
      <% slides.forEach(function (s, i) { %><button type="button" class="dot <%= i === 0 ? 'on' : '' %>" data-go="<%= i %>" aria-label="<%= t('home.slide_n', { n: i + 1 }) %>" <%- i === 0 ? 'aria-current="true"' : '' %>><span></span></button><% }) %>
    </div>
    <div class="slider-arrows">
      <button type="button" class="round-btn" data-pause aria-label="<%= t('home.slider_pause') %>" data-label-play="<%= t('home.slider_play') %>" data-label-pause="<%= t('home.slider_pause') %>"><%- icon('pause') %></button>
      <button type="button" class="round-btn" data-prev aria-label="<%= t('common.previous') %>"><%- icon('chevron-left', 'flip-rtl') %></button>
      <button type="button" class="round-btn" data-next aria-label="<%= t('common.next') %>"><%- icon('chevron-right', 'flip-rtl') %></button>
    </div>
  </div>
  <% } %>
</section>

<% (typeof homeLayout !== 'undefined' && homeLayout ? homeLayout : []).forEach(function (sec) { if (!sec.visible) return; %>
<%- include(sec.page ? 'home/page' : 'home/' + sec.key, { sec: sec, hc: hc, hv: hv, T: function (f, fb) { return (locale === 'ar' ? sec[f + '_ar'] || sec[f + '_en'] : sec[f + '_en'] || sec[f + '_ar']) || (fb ? t(fb) : ''); } }) %>
<% }) %>
