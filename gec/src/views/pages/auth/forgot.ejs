<h1><%= t('auth.forgot_title') %></h1>
<% if (sent) { %>
  <div class="alert ok" role="status"><%- icon('mail') %><p><%= t('auth.forgot_sent') %></p></div>
  <p class="auth-foot"><a href="<%= portal === 'staff' ? '/staff/login' : '/login' %>"><%= t('auth.back_to_sign_in') %></a></p>
<% } else { %>
  <p class="muted"><%= t('auth.forgot_lead') %></p>
  <form method="post" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="email"><%= t('auth.email') %></label><input id="email" type="email" name="email" autocomplete="email" required autofocus></div>
    <button class="btn primary block lg" type="submit"><%= t('auth.send_link') %></button>
  </form>
  <p class="auth-foot"><a href="<%= portal === 'staff' ? '/staff/login' : '/login' %>"><%= t('auth.back_to_sign_in') %></a></p>
<% } %>
