<h1><%= t('auth.new_password_title') %></h1>
<p class="muted"><%= t('auth.new_password_lead') %></p>
<form method="post" class="stack" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../partials/field', { name: 'current_password', label: t('auth.current_password'), type: 'password', required: true, attrs: 'autocomplete="current-password" autofocus' }) %>
  <%- include('../../partials/field', { name: 'password', label: t('auth.new_password'), type: 'password', required: true, hint: t('auth.password_rule'), attrs: 'autocomplete="new-password"' }) %>
  <%- include('../../partials/field', { name: 'password_confirm', label: t('auth.confirm_password'), type: 'password', required: true, attrs: 'autocomplete="new-password"' }) %>
  <button class="btn primary block lg" type="submit"><%= t('auth.save_password') %></button>
</form>
<form method="post" action="/staff/logout" class="auth-foot"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="linklike" type="submit"><%= t('auth.sign_out') %></button></form>
