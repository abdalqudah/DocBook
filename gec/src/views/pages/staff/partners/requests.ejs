<div class="page-head"><div><h1><%= title %></h1><p class="lead"><%= t('partnerp.requests_lead') %></p></div><a class="btn ghost" href="/for-universities" target="_blank" rel="noopener"><%- icon('external-link') %><%= t('partnerp.public_page') %></a></div>
<nav class="tabs mb4"><% ['new','approved','rejected'].forEach(function (s) { %><a href="?status=<%= s %>" <%- status === s ? 'aria-current="page"' : '' %>><%= t('partnerp.req_status.' + s) %></a><% }) %></nav>
<% if (!rows.length) { %><div class="card"><%- include('../../../partials/empty', { title: t('partnerp.no_requests'), emptyIcon: 'handshake', compact: true }) %></div>
<% } else { %><div class="card"><div class="divider-list"><% rows.forEach(function (r) { %><a class="list-item" href="/staff/partner-requests/<%= r.id %>"><span class="num small"><%= r.ref %></span><div class="li-body"><div class="li-title"><%- flagImg(r.country_code) %> <%= r.university_name %></div><div class="li-sub"><%= r.contact_name %><%= r.job_title ? ' · ' + r.job_title : '' %> · <%= r.email %> · <%= fmt.relative(r.created_at) %></div></div><span class="chip <%= r.status === 'approved' ? 'ok' : r.status === 'new' ? 'warn' : '' %>"><%= t('partnerp.req_status.' + r.status) %></span></a><% }) %></div></div><% } %>
