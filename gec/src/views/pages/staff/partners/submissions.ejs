<div class="page-head"><div><h1><%= title %></h1><p class="lead"><%= t('partnerp.queue_lead') %></p></div></div>
<nav class="tabs mb4"><% ['pending','changes_requested','approved','rejected'].forEach(function (s) { %><a href="?status=<%= s %>" <%- status === s ? 'aria-current="page"' : '' %>><%= t('partnerp.status.' + s) %></a><% }) %></nav>
<% if (!rows.length) { %><div class="card"><%- include('../../../partials/empty', { title: t('partnerp.queue_empty'), emptyIcon: 'inbox', compact: true }) %></div>
<% } else { %><div class="card"><div class="divider-list"><% rows.forEach(function (s) { %><a class="list-item" href="/staff/partner-submissions/<%= s.id %>"><span class="uni-crest sm" style="background-image:url('/art/crest/<%= s.uni_slug %>.svg')"></span><div class="li-body"><div class="li-title"><%= s.data.name_en || L({ name_en: s.uni_en, name_ar: s.uni_ar }, 'name') %></div><div class="li-sub"><%= t('partnerp.entity.' + s.entity) %> · <%= s.entity_id ? t('partnerp.change') : t('partnerp.new_item') %> · <%= L({ name_en: s.uni_en, name_ar: s.uni_ar }, 'name') %> · <%= s.by_name || '' %> · <%= fmt.relative(s.updated_at) %></div></div><span class="chip"><%= t('partnerp.status.' + s.status) %></span></a><% }) %></div></div><% } %>
