<div class="page-head"><div><h1><%= t('nav.templates') %></h1><p class="lead"><%= t('templates.lead') %></p></div>
  <form method="post" action="/staff/templates" class="cluster"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" required maxlength="120" placeholder="<%= t('templates.new_name') %>" aria-label="<%= t('templates.new_name') %>" style="width:auto"><button class="btn primary" type="submit"><%- icon('plus') %><%= t('templates.new') %></button></form></div>
<div class="table-wrap"><table class="table responsive"><thead><tr><th><%= t('common.name') %></th><th><%= t('templates.customised') %></th><th></th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr>
  <td class="primary"><a href="/staff/templates/<%= r.key %>"><strong><%= r.name %></strong></a><div class="small subtle" dir="ltr" style="text-align:start"><%= r.key %></div></td>
  <td data-label="<%= t('templates.customised') %>"><% if (!r.edited.length) { %><span class="small muted"><%= r.custom ? '—' : t('templates.default') %></span><% } else { r.edited.forEach(function (e) { var p = e.split(':'); %><span class="chip brand"><%= t('channels.' + p[0]) %> · <%= p[1].toUpperCase() %></span> <% }) } %></td>
  <td class="actions"><a class="btn sm" href="/staff/templates/<%= r.key %>"><%= t('common.edit') %></a></td>
</tr><% }) %>
</tbody></table></div>
