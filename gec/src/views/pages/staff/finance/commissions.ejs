<div class="page-head"><div><h1><%= t('nav.commissions') %></h1><p class="lead"><%= t('finance.commissions_lead') %></p></div><a class="btn" href="/staff/partners"><%- icon('handshake') %><%= t('nav.partners') %></a></div>
<nav class="tabs mb4"><a href="?" <%- !query.status ? 'aria-current="page"' : '' %>><%= t('common.all') %></a><% statuses.forEach(function (s) { %><a href="?status=<%= s %>" <%- query.status === s ? 'aria-current="page"' : '' %>><%= t('finance.cstatus.' + s) %></a><% }) %></nav>
<% if (!rows.length) { %><div class="card"><%- include('../../../partials/empty', { title: t('finance.no_commissions'), text: t('finance.no_commissions_text'), emptyIcon: 'percent' }) %></div><% } else { %>
<div class="table-wrap"><table class="table responsive"><thead><tr><th><%= t('finance.student') %></th><th><%= t('resources.fields.university_id') %></th><th class="text-end"><%= t('finance.expected') %></th><th><%= t('common.status') %></th><th></th></tr></thead><tbody>
<% rows.forEach(function (c) { %><tr>
  <td class="primary"><% if (c.sid) { %><a href="/staff/students/<%= c.sid %>"><%= fullName(c) %></a><% } else { %>—<% } %><div class="small subtle"><%= c.application_ref || '' %><%= c.basis ? ' · ' + c.basis : '' %></div></td>
  <td data-label="<%= t('resources.fields.university_id') %>"><%= c.university_name || '—' %></td>
  <td data-label="<%= t('finance.expected') %>" class="text-end num"><%= fmt.money(c.expected_amount, c.currency) %><% if (c.received_amount) { %><div class="small muted"><%= t('finance.received') %>: <%= fmt.money(c.received_amount, c.currency) %></div><% } %></td>
  <td data-label="<%= t('common.status') %>"><span class="chip <%= c.status === 'received' ? 'ok' : c.status === 'written_off' ? 'bad' : 'brand' %>"><%= t('finance.cstatus.' + c.status) %></span><% if (c.due_on && c.status !== 'received') { %><div class="small subtle"><%= t('finance.due') %> <%= fmt.date(c.due_on) %></div><% } %></td>
  <td class="actions"><% if (can('partners.manage')) { %><details class="menu"><summary class="btn sm"><%= t('common.edit') %></summary><form method="post" action="/staff/commissions/<%= c.id %>" class="menu-panel stack" style="min-width:260px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="small"><%= t('common.status') %><select name="status"><% statuses.forEach(function (s) { %><option value="<%= s %>" <%= c.status === s ? 'selected' : '' %>><%= t('finance.cstatus.' + s) %></option><% }) %></select></label>
    <label class="small"><%= t('finance.expected') %><input type="number" step="0.01" name="expected_amount" value="<%= Number(c.expected_amount) %>"></label>
    <label class="small"><%= t('finance.received') %><input type="number" step="0.01" name="received_amount" value="<%= c.received_amount != null ? Number(c.received_amount) : '' %>"></label>
    <label class="small"><%= t('finance.received_on') %><input type="date" name="received_on" value="<%= c.received_on ? fmt.dateInput(c.received_on) : '' %>"></label>
    <button class="btn sm primary" type="submit"><%= t('common.save') %></button></form></details><% } %></td>
</tr><% }) %>
</tbody></table></div>
<% } %>
