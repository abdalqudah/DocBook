<div class="spread mb4"><h2 class="mb0" style="font-size:1.1rem"><%= t('students.tab_finance') %></h2><% if (can('finance.manage')) { %><a class="btn primary sm" href="/staff/invoices/new?student_id=<%= s.id %>"><%- icon('plus') %><%= t('finance.new_invoice') %></a><% } %></div>
<section class="card mb4"><div class="card-head"><h2><%= t('nav.invoices') %></h2></div>
  <% if (!invoices.length) { %><p class="muted mb0"><%= t('finance.no_invoices') %></p><% } else { %><div class="divider-list"><% invoices.forEach(function (r) { %><a class="list-item" href="/staff/invoices/<%= r.id %>"><span class="num"><%= r.number %></span><div class="li-body"><div class="li-title"><%= fmt.money(r.total, r.currency) %></div><div class="li-sub"><%= r.due_date ? t('finance.due') + ' ' + fmt.date(r.due_date) : '' %></div></div><span class="chip <%= r.status === 'paid' ? 'ok' : r.status === 'void' ? 'bad' : 'brand' %>"><%= t('finance.status.' + r.status) %></span></a><% }) %></div><% } %>
</section>
<section class="card"><div class="card-head"><h2><%= t('nav.payments') %></h2></div>
  <% if (!payments.length) { %><p class="muted mb0"><%= t('finance.no_payments') %></p><% } else { %><div class="divider-list"><% payments.forEach(function (p) { %><div class="list-item"><span class="num small"><%= p.receipt_no %></span><div class="li-body"><div class="li-title"><%= fmt.money(p.amount, p.currency) %> · <%= t('finance.method.' + p.method) %></div><div class="li-sub"><%= fmt.date(p.received_on) %><%= p.number ? ' · ' + p.number : '' %></div></div><% if (p.status === 'refunded') { %><span class="chip bad"><%= t('finance.pstatus.refunded') %></span><% } %></div><% }) %></div><% } %>
</section>
