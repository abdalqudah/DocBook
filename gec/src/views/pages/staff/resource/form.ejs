<% var v = function (name) { return old && Object.prototype.hasOwnProperty.call(old, name) ? old[name] : row[name]; }; var ro = !canManage; %>
<nav class="breadcrumbs"><a href="<%= base %>"><%= t('resources.' + def.key + '.plural') %></a><%- icon('chevron-right') %><span><%= title %></span></nav>
<div class="page-head">
  <div><h1><%= title %> <% if (row.is_demo) { %><span class="chip demo" title="<%= t('common.demo_hint') %>"><%= t('common.demo') %></span><% } %></h1></div>
  <% if (publicUrl) { %><a class="btn ghost" href="<%= publicUrl %>" target="_blank" rel="noopener"><%- icon('external-link') %><%= t('resources.view_on_site') %></a><% } %>
</div>
<form method="post" action="<%= base %><%= row.id ? '/' + row.id : '' %>" class="stack" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% def.sections.forEach(function (sec) { if (sec.internal && !canInternal) return; %>
  <fieldset class="card" <%= ro ? 'disabled' : '' %> id="sec-<%= sec.key %>">
    <legend class="spread" style="width:100%"><span><%= t('resources.sections.' + sec.key) %></span><% if (sec.internal) { %><span class="chip warn"><%- icon('lock') %><%= t('resources.internal_only') %></span><% } %></legend>
    <div class="form-grid two">
    <% sec.fields.forEach(function (f) {
         if (f.internal && !canInternal) return;
         var names = f.bilingual ? [f.name + '_en', f.name + '_ar'] : [f.name];
         names.forEach(function (n, idx) {
           var lang = f.bilingual ? (idx ? 'ar' : 'en') : null;
           var label = t('resources.fields.' + f.name) + (lang ? (lang === 'ar' ? ' (العربية)' : ' (English)') : '');
           var wide = ['markdown', 'textarea', 'list', 'json', 'checks'].indexOf(f.type) >= 0 && !f.bilingual;
           var attrs = (lang === 'ar' ? 'dir="rtl" ' : '') + (f.step ? 'step="' + f.step + '" ' : (f.type === 'number' ? 'step="any" ' : '')) + (f.max && (f.type === 'int' || f.type === 'number') ? 'max="' + f.max + '" ' : '');
           var val = v(n);
           var common = { name: n, label: label, required: f.required && lang !== 'ar', hint: f.hint ? t(f.hint) : '', cls: wide ? 'span-all' : '', attrs: attrs };
           if (f.type === 'bool') { %><%- include('../../../partials/field', Object.assign(common, { type: 'checkbox', value: val })) %><% }
           else if (f.type === 'select') { %><%- include('../../../partials/field', Object.assign(common, { type: 'select', value: val === null || val === undefined ? '' : String(val), options: opts[f.name] || [] })) %><% }
           else if (f.type === 'checks') { %><%- include('../../../partials/field', Object.assign(common, { type: 'checks', value: (val || []).map(String), options: opts[f.name] || [] })) %><% }
           else if (f.type === 'markdown' || f.type === 'textarea') { %><%- include('../../../partials/field', Object.assign(common, { type: 'textarea', rows: f.rows || 4, value: val, hint: f.type === 'markdown' ? (common.hint || t('resources.markdown_hint')) : common.hint })) %><% }
           else if (f.type === 'list') { %><%- include('../../../partials/field', Object.assign(common, { type: 'textarea', rows: f.rows || 4, value: Array.isArray(val) ? val.join('\n') : (val || '') })) %><% }
           else if (f.type === 'json') { %><%- include('../../../partials/field', Object.assign(common, { type: 'textarea', rows: f.rows || 4, value: val && typeof val === 'object' ? JSON.stringify(val, null, 2) : (val || ''), attrs: 'dir="ltr" spellcheck="false" style="font-family:ui-monospace,monospace;font-size:.85rem"' })) %><% }
           else if (f.type === 'date') { %><%- include('../../../partials/field', Object.assign(common, { type: 'date', value: val ? fmt.dateInput(val) : '' })) %><% }
           else if (f.type === 'int' || f.type === 'number' || f.type === 'money') { %><%- include('../../../partials/field', Object.assign(common, { type: 'number', value: val })) %><% }
           else if (f.type === 'url' || f.type === 'image') { %><%- include('../../../partials/field', Object.assign(common, { type: 'url', value: val, attrs: 'dir="ltr" placeholder="https://"' })) %><% if (f.type === 'image' && val) { %><img src="<%= val %>" alt="" style="max-height:80px;border-radius:8px;margin-top:-6px"><% } %><% }
           else { %><%- include('../../../partials/field', Object.assign(common, { type: 'text', value: val })) %><% }
         });
       }); %>
    </div>
  </fieldset>
  <% }) %>
  <% if (!ro) { %><div class="form-actions sticky"><button class="btn primary" type="submit"><%= t('common.save') %></button><a class="btn ghost" href="<%= base %>"><%= t('common.cancel') %></a></div><% } %>
</form>
<% if (related && related.length) { %>
<section class="card mt4"><div class="card-head"><h2><%= t('resources.' + def.key + '.related') %> <span class="count"><%= related.length %></span></h2><% if (canManage && def.key === 'universities') { %><a class="btn sm tonal" href="/staff/programs/new?university_id=<%= row.id %>"><%- icon('plus') %><%= t('resources.programs.new') %></a><% } %></div>
  <div class="divider-list"><% related.forEach(function (r) { %><a class="list-item" href="<%= r.href %>"><div class="li-body"><div class="li-title"><%= r.title %></div><div class="li-sub"><%= r.sub ? t('ref.degree.' + r.sub) : '' %></div></div><% if (r.off) { %><span class="chip"><%= t('common.disabled') %></span><% } %></a><% }) %></div>
</section>
<% } %>
<% if (row.id && canManage) { %><form method="post" action="<%= base %>/<%= row.id %>/delete" data-confirm="<%= t('resources.delete_confirm') %>" class="mt6"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn danger-ghost sm" type="submit"><%- icon('trash-2') %><%= t('common.delete') %></button></form><% } %>
