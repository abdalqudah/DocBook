<%- include('_back') %>
<div class="page-head"><div><h1><%= title %></h1><p class="lead"><%= t('settings.pipeline_lead') %></p></div></div>
<form method="post" class="stack">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= t('settings.order') %></th><th>English</th><th>العربية</th><th><%= t('settings.colour') %></th><% if (sla) { %><th><%= t('settings.stuck_after') %></th><% } %><th><%= t('common.enabled') %></th></tr></thead>
    <tbody><% rows.forEach(function (r) { var fixed = r.is_won || r.is_lost || r.is_terminal; %><tr>
      <td><input type="number" name="position_<%= r.id %>" value="<%= r.position %>" style="width:72px" aria-label="<%= t('settings.order') %>"></td>
      <td><input name="name_en_<%= r.id %>" value="<%= r.name_en %>" required aria-label="English"><div class="small subtle"><code><%= r.key %></code></div></td>
      <td><input name="name_ar_<%= r.id %>" value="<%= r.name_ar || '' %>" dir="rtl" aria-label="العربية"></td>
      <td><select name="tone_<%= r.id %>" aria-label="<%= t('settings.colour') %>" style="width:auto"><% tones.forEach(function (tn) { %><option value="<%= tn %>" <%= r.tone === tn ? 'selected' : '' %>><%= t('settings.tone_' + tn) %></option><% }) %></select></td>
      <% if (sla) { %><td><input type="number" name="sla_days_<%= r.id %>" value="<%= r.sla_days || '' %>" min="1" max="365" style="width:90px" aria-label="<%= t('settings.stuck_after') %>"></td><% } %>
      <td><% if (fixed) { %><span class="chip"><%= t('settings.always_on') %></span><% } else { %><input type="hidden" name="is_active_<%= r.id %>" value="0"><input type="checkbox" name="is_active_<%= r.id %>" value="1" <%= r.is_active ? 'checked' : '' %> aria-label="<%= t('common.enabled') %>"><% } %></td>
    </tr><% }) %>
    <tr><td><input type="number" name="new_position" placeholder="<%= rows.length %>" style="width:72px" aria-label="<%= t('settings.order') %>"></td><td><input name="new_name_en" placeholder="<%= t('settings.new_stage') %>" aria-label="<%= t('settings.new_stage') %>"></td><td><input name="new_name_ar" dir="rtl" aria-label="العربية"></td><td colspan="<%= sla ? 3 : 2 %>" class="small subtle"><%= t('settings.new_stage_hint') %></td></tr>
    </tbody>
  </table></div>
  <div class="form-actions"><button class="btn primary" type="submit"><%= t('common.save') %></button></div>
</form>
