<div class="page-head"><div><h1><%= t('nav.home_page') %></h1><p class="lead"><%= t('cms.home_lead') %></p></div><a class="btn" href="/" target="_blank"><%- icon('external-link') %><%= t('resources.view_on_site') %></a></div>
<form method="post" class="card stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="grid-2">
    <% ['en','ar'].forEach(function (l) { %><div class="stack" dir="<%= l === 'ar' ? 'rtl' : 'ltr' %>" lang="<%= l %>"><strong><%= l === 'ar' ? 'العربية' : 'English' %></strong>
      <%- include('../../../partials/field', { name: 'hero_title_' + l, label: t('cms.hero_title'), value: h['hero_title_' + l], placeholder: t('cms.default_text') }) %>
      <%- include('../../../partials/field', { name: 'hero_lead_' + l, label: t('cms.hero_lead'), type: 'textarea', rows: 2, value: h['hero_lead_' + l], placeholder: t('cms.default_text') }) %>
      <%- include('../../../partials/field', { name: 'cta_title_' + l, label: t('cms.cta_title'), value: h['cta_title_' + l], placeholder: t('cms.default_text') }) %>
      <%- include('../../../partials/field', { name: 'cta_text_' + l, label: t('cms.cta_text'), type: 'textarea', rows: 2, value: h['cta_text_' + l], placeholder: t('cms.default_text') }) %>
    </div><% }) %>
  </div>
  <p class="small subtle mb0"><%= t('cms.home_hint') %></p>
  <div class="form-actions"><button class="btn primary" type="submit"><%= t('common.save') %></button></div>
</form>
