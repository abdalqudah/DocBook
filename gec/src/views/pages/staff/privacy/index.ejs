<div class="page-head"><div><h1><%= t('nav.privacy_requests') %></h1><p class="lead"><%= t('privacy.staff_lead') %></p></div><a class="btn" href="/staff/privacy/stale"><%- icon('clock') %><%= t('privacy.stale_btn', { n: stale }) %></a></div>
<nav class="tabs mb4"><a href="?" <%- !status ? 'aria-current="page"' : '' %>><%= t('privacy.open') %></a><% ['done','rejected'].forEach(function (s) { %><a href="?status=<%= s %>" <%- status === s ? 'aria-current="page"' : '' %>><%= t('privacy.st_' + s) %></a><% }) %></nav>
<% if (!rows.length) { %><div class="card"><%- include('../../../partials/empty', { title: t('privacy.none'), emptyIcon: 'shield-check', compact: true }) %></div>
<% } else { %><div class="card"><div class="divider-list"><% rows.forEach(function (r) { %><a class="list-item" href="/staff/privacy/<%= r.id %>"><span class="num small"><%= r.ref %></span><div class="li-body"><div class="li-title"><%= t('privacy.type_' + r.type) %> — <%= r.name || r.email %></div><div class="li-sub"><%= r.email %><%= r.student_ref ? ' · ' + r.student_ref : '' %> · <%= fmt.relative(r.created_at) %></div></div><span class="chip <%= r.identity_verified ? 'ok' : 'warn' %>"><%= r.identity_verified ? t('privacy.verified') : t('privacy.unverified') %></span><span class="chip"><%= t('privacy.st_' + r.status) %></span></a><% }) %></div></div><% } %>
