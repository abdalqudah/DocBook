<div class="page-head"><div><h1><%= t('portal.nav.appointments') %></h1><p class="lead"><%= t('portal.appointments_lead') %></p></div><a class="btn primary" href="/book/schedule"><%- icon('calendar-plus') %><%= t('portal.book_new') %></a></div>
<h2 class="section-title"><%= t('portal.upcoming') %></h2>
<% if (!upcoming.length) { %><div class="card mb6"><%- include('../../partials/empty', { title: t('portal.no_upcoming'), href: '/book/schedule', cta: t('booking.pick_service'), emptyIcon: 'calendar-days', compact: true }) %></div>
<% } else { %><div class="card mb6"><div class="divider-list"><% upcoming.forEach(function (a) { %><a class="list-item" href="<%= a.manage_token ? '/appointments/' + a.manage_token : '#' %>"><span class="queue-icon brand"><%- icon(a.mode === 'online' ? 'video' : 'map-pin') %></span><div class="li-body"><div class="li-title"><%= locale === 'ar' && a.name_ar ? a.name_ar : a.name_en %></div><div class="li-sub"><%= fmt.dateTime(a.start_at) %> · <%= a.counsellor || '' %></div></div><span class="chip brand"><%= t('booking.status_' + a.status) %></span></a><% }) %></div></div><% } %>
<% if (past.length) { %><h2 class="section-title"><%= t('portal.past') %></h2><div class="card"><div class="divider-list"><% past.forEach(function (a) { %><div class="list-item"><div class="li-body"><div class="li-title"><%= locale === 'ar' && a.name_ar ? a.name_ar : a.name_en %></div><div class="li-sub"><%= fmt.dateTime(a.start_at) %></div></div><span class="chip"><%= t('booking.status_' + a.status) %></span></div><% }) %></div></div><% } %>
