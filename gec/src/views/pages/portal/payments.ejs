<div class="page-head"><div><h1><%= t('portal.payments') %></h1><p class="lead"><%= t('portal.payments_lead') %></p></div></div>
<% if (!invoices.length && !payments.length) { %><div class="card"><%- include('../../partials/empty', { title: t('portal.no_payments'), emptyIcon: 'receipt', compact: true }) %></div><% } %>
<% if (invoices.length) { %><h2 class="section-title"><%= t('nav.invoices') %></h2><div class="card mb6"><div class="divider-list"><% invoices.forEach(function (i) { var bal = Number(i.total) - Number(i.paid); %><a class="list-item" href="/invoices/<%= i.public_token %>"><span class="num"><%= i.number %></span><div class="li-body"><div class="li-title"><%= fmt.money(i.total, i.currency) %></div><div class="li-sub"><%= i.due_date ? t('finance.due') + ' ' + fmt.date(i.due_date) : '' %><%= bal > 0 && i.status !== 'void' ? ' · ' + t('finance.balance') + ' ' + fmt.money(bal, i.currency) : '' %></div></div><% if (payOnline && bal > 0 && ['issued','partially_paid'].indexOf(i.status) >= 0) { %><span class="btn sm primary"><%- icon('credit-card') %><%= t('finance.pay_card') %></span><% } %><span class="chip <%= i.status === 'paid' ? 'ok' : i.status === 'void' ? 'bad' : 'brand' %>"><%= t('finance.status.' + i.status) %></span></a><% }) %></div></div><% } %>
<% if (payments.length) { %><h2 class="section-title"><%= t('nav.payments') %></h2><div class="card"><div class="divider-list"><% payments.forEach(function (p) { %><div class="list-item"><span class="num small"><%= p.receipt_no %></span><div class="li-body"><div class="li-title"><%= fmt.money(p.amount, p.currency) %></div><div class="li-sub"><%= fmt.date(p.received_on) %> · <%= t('finance.method.' + p.method) %></div></div><% if (p.status === 'refunded') { %><span class="chip bad"><%= t('finance.pstatus.refunded') %></span><% } %></div><% }) %></div></div><% } %>
