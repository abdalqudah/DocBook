<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <%- include('logo', { height: 40 }) %>
      <p class="muted mt4"><%= locale === 'ar' ? branding.tagline_ar : branding.tagline_en %></p>
      <ul class="footer-contact">
        <% if (company.email) { %><li><%- icon('mail') %><a href="mailto:<%= company.email %>"><%= company.email %></a></li><% } %>
        <% if (company.phone) { %><li><%- icon('phone') %><a href="tel:<%= company.phone.replace(/[^+\d]/g, '') %>" dir="ltr"><%= company.phone %></a></li><% } %>
        <% if (company['address_' + locale] || company.address_en) { %><li><%- icon('map-pin') %><span><%= company['address_' + locale] || company.address_en %></span></li><% } %>
      </ul>
      <% var soc = company.social || {}; var socKeys = Object.keys(soc).filter(function (k) { return soc[k]; }); if (socKeys.length) { %>
      <div class="cluster mt4"><% socKeys.forEach(function (k) { %><a class="btn sm ghost" href="<%= soc[k] %>" rel="noopener" target="_blank"><%= k === 'x' ? 'X' : k.charAt(0).toUpperCase() + k.slice(1) %></a><% }) %></div>
      <% } %>
    </div>
    <% site.footer.forEach(function (col) { %>
    <div><h2 class="footer-h"><%= t('site.footer.' + col.key) %></h2><ul class="footer-links"><% col.links.forEach(function (l) { %><li><a href="<%= l.href %>"><%= typeof l.label === 'object' ? (locale === 'ar' ? l.label.ar : l.label.en) : t(l.label) %></a></li><% }) %></ul></div>
    <% }) %>
  </div>
  <div class="container footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= branding.legal_name %></span>
    <span class="cluster"><a href="/privacy"><%= t('site.privacy') %></a><a href="/staff/login"><%= t('site.staff_login') %></a><button type="button" class="linklike" data-cookie-settings><%= t('site.cookie_settings') %></button></span>
  </div>
</footer>
<% if (company.whatsapp) { %>
<a class="wa-fab" href="/go/whatsapp?from=<%= encodeURIComponent(path) %>" target="_blank" rel="noopener" aria-label="<%= t('site.whatsapp_us') %>" data-track="whatsapp_click">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.1-1.2-.2-.2-.4-.3z"/></svg>
</a>
<% } %>
<%- include('cookie-bar') %>
