<% var on = state && state.comparing && state.comparing.indexOf(id) >= 0; %>
<form method="post" action="/compare/toggle" class="inline-toggle" data-toggle-form="compare">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= id %>">
  <button type="submit" class="icon-toggle" aria-pressed="<%= on ? 'true' : 'false' %>" aria-label="<%= on ? t('compare.remove') : t('compare.add') %>" title="<%= on ? t('compare.remove') : t('compare.add') %>" data-label-on="<%= t('compare.remove') %>" data-label-off="<%= t('compare.add') %>"><%- icon('scale') %></button>
</form>
