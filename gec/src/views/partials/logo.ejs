<% var h = typeof height !== 'undefined' ? height : 36; %>
<% if (branding.logo_media_id) { %><img class="logo-img logo-color" src="/media/<%= branding.logo_media_id %>" alt="<%= branding.legal_name %>" style="height:<%= h %>px"><% } else { %><img class="logo-img logo-color" src="/brand/logo-h.webp" width="<%= Math.round(h * 2.45) %>" height="<%= h %>" alt="<%= branding.legal_name %>" style="height:<%= h %>px"><% } %>
<% if (branding.logo_white_media_id) { %><img class="logo-img logo-white" src="/media/<%= branding.logo_white_media_id %>" alt="" aria-hidden="true" style="height:<%= h %>px"><% } else { %><img class="logo-img logo-white" src="/brand/logo-h-white.webp" width="<%= Math.round(h * 2.42) %>" height="<%= h %>" alt="" aria-hidden="true" style="height:<%= h %>px"><% } %>
