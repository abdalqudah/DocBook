<% if (flash && flash.length) { %><div class="toasts" role="status" aria-live="polite" data-autohide><% flash.forEach(function (f) { %>
  <div class="toast <%= f.type === 'error' ? 'error' : '' %>"><%- icon(f.type === 'error' ? 'alert-circle' : 'check-circle-2') %><span><%= f.message %></span><button type="button" data-dismiss aria-label="<%= t('common.dismiss') %>"><%= t('common.ok') %></button></div>
<% }) %></div><% } else { %><div class="toasts" role="status" aria-live="polite"></div><% } %>
