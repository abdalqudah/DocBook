<div class="empty <%= typeof compact !== 'undefined' && compact ? 'compact' : '' %>">
  <div class="empty-icon"><%- icon(typeof emptyIcon !== 'undefined' ? emptyIcon : 'inbox') %></div>
  <h3><%= title %></h3>
  <% if (typeof text !== 'undefined' && text) { %><p><%= text %></p><% } %>
  <% if (typeof href !== 'undefined' && href) { %><a class="btn primary" href="<%= href %>"><%- icon(typeof ctaIcon !== 'undefined' ? ctaIcon : 'plus') %><%= cta %></a><% } %>
</div>
