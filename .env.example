NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
# Long random string (≥ 32 chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Encrypts stored credentials (AI keys, SMTP). Set once and never change. Falls back to SESSION_SECRET.
# APP_KEY=
AUTO_MIGRATE=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=docbook
DB_USER=docbook
DB_PASSWORD=
# DB_SOCKET=/var/lib/mysql/mysql.sock
# Used by `npm test` only
DB_NAME_TEST=docbook_test

# Optional e-mail (password resets, invitations, e-mail verification)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=DocBook <no-reply@your-domain.com>

# Optional: AI provider defaults (each workspace can also set its own key in Settings → AI)
# AI_PROVIDER=anthropic   # anthropic | openai | gemini
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5

ALLOW_SIGNUP=true
DEFAULT_LOCALE=en
# SUPPORT_EMAIL=support@your-domain.com
