# ============================================================================
# DocBook — server settings. Copy to `.env` and fill in. Lines starting with # are optional.
# ============================================================================

# ---- Basics -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# The public https address of the site (used in e-mails, QR codes, WhatsApp/payment links, Google sign-in).
APP_URL=https://your-domain.com
# Long random string (≥ 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Encrypts stored credentials (SMTP, WhatsApp, payment gateways, external databases, Google).
# Set ONCE and never change it (changing it makes saved credentials unreadable). Same generator as above.
APP_KEY=
# Database tables are created/updated automatically at start-up. Set to false only to run `node app.js migrate` yourself.
AUTO_MIGRATE=true
# Behind a reverse proxy (nginx, cPanel/Passenger, Cloudflare) keep this true.
TRUST_PROXY=true
# Interface language for new visitors: ar (default) or en
DEFAULT_LOCALE=ar
# Allow clinics to sign up on their own (false = invite-only installation)
ALLOW_SIGNUP=true

# ---- Database (MySQL 8+ or MariaDB 10.6+) --------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=docbook
DB_USER=docbook
DB_PASSWORD=
# DB_SOCKET=/var/lib/mysql/mysql.sock
# DB_POOL_MAX=10
# Used by `npm test` only
# DB_NAME_TEST=docbook_test

# ---- Platform super admin (manages the landing page, clinics, reps, reviews at /admin) ----
# Created at start-up if missing; an existing account's password is never overwritten.
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform admin

# ---- E-mail (password resets, invitations, reminders, online-consultation links, purchase orders) ----
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=DocBook <no-reply@your-domain.com>
# SUPPORT_EMAIL=support@your-domain.com

# ---- Online video consultations ------------------------------------------------------
# STUN/TURN servers for the built-in video call (JSON). A TURN server is needed for some mobile networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.your-domain.com:3478","turns:turn.your-domain.com:5349"],"username":"USER","credential":"PASS"}]
# Optional self-hosted Jitsi for doctors who choose the Jitsi method
# JITSI_URL=https://meet.your-domain.com

# ---- Clinic custom domains -----------------------------------------------------------
# The server's public IPv4, shown to clinics that connect a bare domain (A record)
# SERVER_IP=203.0.113.10

# ---- WhatsApp Cloud API (per-clinic credentials are entered in Settings → Messages) ----
# WHATSAPP_GRAPH_VERSION=v21.0

# ---- Advanced ----------------------------------------------------------------------
# CACHE_TTL_MS=60000
# Only for on-premise installs that must reach private-network addresses (external DB copy, integrations):
# INTEGRATIONS_ALLOW_PRIVATE=false
# DATASYNC_ALLOW_PRIVATE=false
