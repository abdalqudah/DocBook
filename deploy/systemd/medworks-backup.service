# Daily encrypted backup of MedWorks (deploy/backup.sh). Install: see docs/BACKUP_AND_RESTORE.md
[Unit]
Description=MedWorks backup (databases and files)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/medworks
ExecStart=/opt/medworks/deploy/backup.sh
# Then the off-server copy (does nothing, with a warning, while OFFSITE_TARGET is empty; fails the unit if a copy fails).
ExecStartPost=/opt/medworks/deploy/offsite.sh push
Nice=10
IOSchedulingClass=idle
