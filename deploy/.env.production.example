# =====================================================================================================================
# MedWorks — production settings for the Docker deployment (compose.yaml). Copy to /opt/medworks/.env, fill in, then
# `chmod 600 .env`. Never commit the filled file. Every variable is described in docs/ENVIRONMENT_VARIABLES.md.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
# =====================================================================================================================

# ---- Domain and HTTPS (Caddy) ----------------------------------------------------------------------------------------
DOMAIN=medworks.app
ACME_EMAIL=info@medworks.app
# The public address the app writes into e-mails, QR codes, payment and Google callback links. Must be https.
APP_URL=https://medworks.app
# The server's public IPv4 (shown to clinics that connect a bare custom domain with an A record).
SERVER_IP=

# ---- Secrets (required; the app refuses to start without them) --------------------------------------------------------
SESSION_SECRET=
# APP_KEY encrypts stored credentials (SMTP, WhatsApp, payment gateways, Google, external databases).
# MOVING FROM THE OLD SERVER: use the old server's APP_KEY. If the old server had no APP_KEY, use its SESSION_SECRET
# here (that is what encrypted the stored credentials). A new value makes the saved credentials unreadable.
APP_KEY=

# ---- Database (MariaDB in compose.yaml; never published to the internet) -----------------------------------------------
DB_NAME=medworks
DB_USER=medworks
DB_PASSWORD=
DB_ROOT_PASSWORD=
# MariaDB memory for data and indexes (about half of the RAM you give the database).
DB_BUFFER_POOL=512M
DB_POOL_MAX=10

# ---- One database per clinic ------------------------------------------------------------------------------------------
# mysql: each new clinic gets its own database <DB_NAME>_<clinic> (the grants in deploy/mariadb/init allow it).
# off: every clinic in DB_NAME (separated by clinic id). Existing clinics are moved from Platform admin → Clinic databases.
TENANT_DB_DRIVER=mysql
TENANT_POOL_MAX=3

# ---- Platform super admin (created at first start if missing; an existing password is never overwritten) -------------
SUPER_ADMIN_EMAIL=info@medworks.app
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=MedWorks admin

# ---- Behaviour ---------------------------------------------------------------------------------------------------------
DEFAULT_LOCALE=ar
ALLOW_SIGNUP=true
# Database changes are applied at start, one process at a time. false = only with `docker compose run --rm app node app.js migrate`.
AUTO_MIGRATE=true

# ---- E-mail (or set it later in Platform admin → Settings) -------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=MedWorks <no-reply@medworks.app>
SUPPORT_EMAIL=info@medworks.app

# ---- Optional integrations ---------------------------------------------------------------------------------------------
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# JITSI_URL=
# WHATSAPP_GRAPH_VERSION=v21.0

# ---- Backups (deploy/backup.sh) ----------------------------------------------------------------------------------------
# Where backups are written on the server, how many days they are kept, and the passphrase that encrypts them
# (keep a copy of the passphrase outside the server: without it the backups cannot be restored).
BACKUP_DIR=/var/backups/medworks
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=
# Off-server copy of every encrypted backup (deploy/offsite.sh; run after each nightly backup). Empty = this server only.
#   rclone:<remote>:<bucket/path>   (configure the remote first with `rclone config`)
#   rsync:<user@host>:<path>        (another server, SSH key login)
OFFSITE_TARGET=
